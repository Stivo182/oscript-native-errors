#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПроверитьКодОшибки(Ошибка, ОжидаемыйКод)

	Результат = _Классификатор.Классифицировать(Ошибка);
	ФактическийКод = Неопределено;
	Если Результат <> Неопределено Тогда
		ФактическийКод = ДиагностикаОшибок.КодОшибки(Результат);
	КонецЕсли;

	Если ФактическийКод <> ОжидаемыйКод Тогда
		ВызватьИсключение СтрШаблон(
			"Ожидался код %1, получен %2",
			ОжидаемыйКод,
			ФактическийКод
		);
	КонецЕсли;

КонецПроцедуры

Функция ПолучитьОшибкуЧтенияJSONДоОткрытия()

	Попытка
		Чтение = Новый ЧтениеJSON;
		Результат = Чтение.Прочитать();
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	ВызватьИсключение "Ожидаемая ошибка чтения JSON не возникла";

КонецФункции

Функция ПолучитьОшибкуНеподдерживаемогоФорматаДатыJSON()

	Попытка
		Кавычка = Символ(34);
		ТекстJSON = Символ(123) + Кавычка + "date" + Кавычка + ":" + Кавычка
			+ "2020-01-01T00:00:00" + Кавычка + Символ(125);
		Чтение = Новый ЧтениеJSON;
		Чтение.УстановитьСтроку(ТекстJSON);
		ПрочитатьJSON(Чтение, Ложь, "date", ФорматДатыJSON.JavaScript);
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	ВызватьИсключение "Ожидаемая ошибка формата даты JSON не возникла";

КонецФункции

Функция ПолучитьОшибкуЧтенияОтсутствующегоФайла()

	Попытка
		Путь = ПолучитьИмяВременногоФайла();
		Чтение = Новый ЧтениеТекста(Путь);
		Результат = Чтение.Прочитать();
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	ВызватьИсключение "Ожидаемая ошибка чтения отсутствующего файла не возникла";

КонецФункции

Функция ПолучитьОшибкуЗакрытогоПотока()

	Попытка
		Поток = Новый ПотокВПамяти;
		Поток.Закрыть();
		Поток.Записать(Новый БуферДвоичныхДанных(1), 0, 1);
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	ВызватьИсключение "Ожидаемая ошибка закрытого потока не возникла";

КонецФункции

Функция ПолучитьОшибкуЗаписиXMLДоОткрытия()

	Попытка
		Запись = Новый ЗаписьXML;
		Запись.ЗаписатьНачалоЭлемента("root");
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	ВызватьИсключение "Ожидаемая ошибка записи XML не возникла";

КонецФункции

Функция ПолучитьОшибкуЧтенияТекстаДоОткрытия()

