Перем _НераспознаннаяЦепочка5Кадров; // ИнформацияОбОшибке
Перем _НераспознаннаяЦепочка10Кадров; // ИнформацияОбОшибке
Перем _НераспознаннаяЦепочка20Кадров; // ИнформацияОбОшибке
Перем _НераспознаннаяОшибкаВПодробномПредставлении; // ИнформацияОбОшибке
Перем _НормализованнаяОшибка; // ИнформацияОбОшибке
Перем _Классификатор; // КлассификаторОшибок

#Область ОбработчикиСобытий

&КоличествоИтераций(15)
&КоличествоПрогревочныхИтераций(6)
&МинимальноеВремяИтерации(100)
&МониторингПамяти
&КолонкаМакс
Процедура ПриСозданииОбъекта() Экспорт

КонецПроцедуры

&ПередКаждымКейсом
Процедура ПодготовитьДанные(Контекст) Экспорт

	_Классификатор = Новый КлассификаторОшибок;
	_Классификатор.ДобавитьПоставщикаПравил(Тип("ПравилаНативныхОшибок"));

	_ОшибкаJSON = ПолучитьОшибкуЧтенияJSONДоОткрытия();
	_ОшибкаФорматаДатыJSON = ПолучитьОшибкуНеподдерживаемогоФорматаДатыJSON();
	_ОшибкаФайловойСистемы = ПолучитьОшибкуЧтенияОтсутствующегоФайла();
	_ОшибкаПотока = ПолучитьОшибкуЗакрытогоПотока();
	_ОшибкаXML = ПолучитьОшибкуЗаписиXMLДоОткрытия();
	_ОшибкаТекста = ПолучитьОшибкуЧтенияТекстаДоОткрытия();
	_ОшибкаКодировкиURL = ПолучитьОшибкуЯвнойКодировкиURL();
	_ОшибкаДвоичныхДанных = ПолучитьОшибкуНекорректнойHexСтроки();
	_ОшибкаHTTP = ПолучитьОшибкуНекорректногоHTTPМетода();
	_ОшибкаКонструктораТипа = ПолучитьОшибкуОтсутствующегоКонструктораТипа();
	_ОшибкаКомпонентовДаты = ПолучитьОшибкуНекорректныхКомпонентовДаты();
	_ОшибкаВызова = ПолучитьОшибкуИзбыточныхАргументовВызова();
	_ОшибкаКоллекции = ПолучитьОшибкуИндексаКоллекцииВнеДиапазона();
	_ОшибкаТаблицы = ПолучитьОшибкуНекорректногоИмениКолонкиТаблицы();
	_ОшибкаСвойства = ПолучитьОшибкуОтсутствующегоСвойстваОбъекта();
	_ОшибкаФоновыхЗадач = ПолучитьОшибкуСбояФоновыхЗадач();

	_НераспознаннаяОшибка = Новый ИнформацияОбОшибке(
		"External exception (System.InvalidOperationException): unknown error",
		Новый Структура("Источник", "Бенчмарк")
	);
	_НераспознаннаяЦепочка5Кадров = СоздатьНераспознаннуюЦепочку(5);
	_НераспознаннаяЦепочка10Кадров = СоздатьНераспознаннуюЦепочку(10);
	_НераспознаннаяЦепочка20Кадров = СоздатьНераспознаннуюЦепочку(20);
	_ОшибкаJSONВПодробномПредставлении = ПолучитьОшибкуСПодробнымПредставлением(_ОшибкаJSON);
	_НераспознаннаяОшибкаВПодробномПредставлении = ПолучитьОшибкуСПодробнымПредставлением(
		_НераспознаннаяОшибка
	);
	_НормализованнаяОшибка = _Классификатор.Классифицировать(_ОшибкаJSON);

	ПроверитьКодОшибки(_ОшибкаФайловойСистемы, КодыНативныхОшибок.ФайловаяСистемаРесурсНеНайден());
	ПроверитьКодОшибки(_ОшибкаПотока, КодыНативныхОшибок.ПотокЗакрыт());
	ПроверитьКодОшибки(_ОшибкаJSON, КодыНативныхОшибок.JSONЧтениеНеОткрыто());
	ПроверитьКодОшибки(_ОшибкаФорматаДатыJSON, КодыНативныхОшибок.JSONФорматДатыНеПоддерживается());
	ПроверитьКодОшибки(_ОшибкаXML, КодыНативныхОшибок.XMLЗаписьНеОткрыта());
	ПроверитьКодОшибки(_ОшибкаТекста, КодыНативныхОшибок.ТекстовыйОбъектНеОткрыт());
	ПроверитьКодОшибки(_ОшибкаКодировкиURL, КодыНативныхОшибок.URLЯвнаяКодировкаНеПоддерживается());
	ПроверитьКодОшибки(_ОшибкаДвоичныхДанных, КодыНативныхОшибок.ДвоичныеДанныеНекорректнаяHexСтрока());
	ПроверитьКодОшибки(_ОшибкаHTTP, КодыНативныхОшибок.HTTPНекорректныйМетод());
	ПроверитьКодОшибки(_ОшибкаКонструктораТипа, КодыНативныхОшибок.КонструкторТипаНеНайден());
	ПроверитьКодОшибки(_ОшибкаКомпонентовДаты, КодыНативныхОшибок.НекорректныеКомпонентыДаты());
	ПроверитьКодОшибки(_ОшибкаВызова, КодыНативныхОшибок.СлишкомМногоАргументовВызова());
	ПроверитьКодОшибки(_ОшибкаКоллекции, КодыНативныхОшибок.ИндексКоллекцииВнеДиапазона());
	ПроверитьКодОшибки(_ОшибкаТаблицы, КодыНативныхОшибок.ТаблицаНекорректноеИмяКолонки());
	ПроверитьКодОшибки(_ОшибкаСвойства, КодыНативныхОшибок.СвойствоОбъектаНеНайдено());
	ПроверитьКодОшибки(_ОшибкаФоновыхЗадач, КодыНативныхОшибок.ФоновыеЗадачиЗавершилисьСОшибками());
	ПроверитьКодОшибки(_НераспознаннаяОшибка, Неопределено);
	ПроверитьКодОшибки(_НераспознаннаяЦепочка5Кадров, Неопределено);
	ПроверитьКодОшибки(_НераспознаннаяЦепочка10Кадров, Неопределено);
	ПроверитьКодОшибки(_НераспознаннаяЦепочка20Кадров, Неопределено);
	ПроверитьКодОшибки(_НормализованнаяОшибка, КодыНативныхОшибок.JSONЧтениеНеОткрыто());
	ПроверитьКодОшибки(_ОшибкаJSONВПодробномПредставлении, КодыНативныхОшибок.JSONЧтениеНеОткрыто());
	ПроверитьКодОшибки(_НераспознаннаяОшибкаВПодробномПредставлении, Неопределено);

КонецПроцедуры

#КонецОбласти

#Область Бенчмарки

&Бенчмарк(Наименование = "Классификация: создание классификатора")
