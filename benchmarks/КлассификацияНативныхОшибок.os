Функция ПолучитьОшибкуСбояФоновыхЗадач()

	ФоновыеЗадания.Очистить();
	Попытка
		ФоновыеЗадания.Выполнить(ЭтотОбъект, "ВызватьСбойФоновойЗадачи");
		ФоновыеЗадания.ОжидатьЗавершенияЗадач();
	Исключение
		ИсходнаяОшибка = ИнформацияОбОшибке();
		ФоновыеЗадания.Очистить();
		Возврат ИсходнаяОшибка;
	КонецПопытки;

	ФоновыеЗадания.Очистить();
	ВызватьИсключение "Ожидаемая ошибка фоновой задачи не возникла";

КонецФункции

Процедура ВызватьСбойФоновойЗадачи() Экспорт

	ВызватьИсключение "Сбой фоновой задачи";

КонецПроцедуры

