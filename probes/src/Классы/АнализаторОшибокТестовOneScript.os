#Использовать "../../../src"
#Использовать 1commands
#Использовать errors

#Область ПрограммныйИнтерфейс

// Формирует отчет об ошибках, воспроизведенных тестами указанной версии OneScript.
//
// Параметры:
//   КаталогТестов - Строка - каталог тестов анализируемой версии OneScript.
//   ПутьОтчета - Строка - путь создаваемого JSON-отчета.
//   ПутьЗапускателя - Строка - путь к сценарию запуска тестов.
//   КаталогБиблиотеки - Строка - каталог библиотеки для инструментированных тестов.
//   ПутьКOneScript - Строка - исполняемый файл анализируемой версии OneScript.
//
// Исключения:
//   Вызывает исключение при недоступности обязательных файлов или ошибке выполнения тестов.
Процедура Сформировать(КаталогТестов, ПутьОтчета, ПутьЗапускателя, КаталогБиблиотеки, ПутьКOneScript) Экспорт

	Если Не Новый Файл(КаталогТестов).Существует() Тогда
		ВызватьИсключение "Каталог тестов OneScript не найден: " + КаталогТестов;
	КонецЕсли;

	Если Не Новый Файл(ПутьЗапускателя).Существует() Тогда
		ВызватьИсключение "Запускатель тестов OneScript не найден: " + ПутьЗапускателя;
	КонецЕсли;

	Кандидаты = Новый Массив;
	ФайлыТестов = НайтиФайлы(КаталогТестов, "*.os", Истина);

	Для Каждого ФайлТеста Из ФайлыТестов Цикл
		ТекстТеста = ПрочитатьТекст(ФайлТеста.ПолноеИмя);
		ДобавитьКандидатыПопыток(Кандидаты, ФайлТеста, ТекстТеста, КаталогТестов);
		ДобавитьКандидатыОжиданий(Кандидаты, ФайлТеста, ТекстТеста, КаталогТестов);
	КонецЦикла;

	Группы = Новый Соответствие;
	ПропущеноЗапускателей = 0;

	Для Каждого Кандидат Из Кандидаты Цикл
		ПутьИсходника = ОбъединитьПути(КаталогТестов, Кандидат.Файл);
		Если НРег(Новый Файл(ПутьИсходника).ПолноеИмя) = НРег(Новый Файл(ПутьЗапускателя).ПолноеИмя) Тогда
			ПропущеноЗапускателей = ПропущеноЗапускателей + 1;
			Продолжить;
		КонецЕсли;

		Если Группы.Получить(Кандидат.Файл) = Неопределено Тогда
			Группы.Вставить(Кандидат.Файл, Новый Массив);
		КонецЕсли;

		Группы.Получить(Кандидат.Файл).Добавить(
			Новый Структура("Идентификатор, Кандидат, ПутьИсходника, Текст", 0, Кандидат, ПутьИсходника, "")
		);
	КонецЦикла;

	Идентификатор = 1;
	Результаты = Новый Массив;
	Для Каждого Группа Из Группы Цикл
		Для Каждого Запись Из Группа.Значение Цикл
			Запись.Идентификатор = Идентификатор;
			Запись.Текст = ПрочитатьТекст(Запись.ПутьИсходника);
			Идентификатор = Идентификатор + 1;
		КонецЦикла;

		ОбработатьФайл(
			Группа.Значение,
			ПутьКOneScript,
			ПутьЗапускателя,
			КаталогБиблиотеки,
			КаталогТестов,
			Результаты
		);
	КонецЦикла;

	СистемнаяИнформация = Новый СистемнаяИнформация;

	Отчет = Новый Структура;
	Отчет.Вставить("SchemaVersion", 1);
	Отчет.Вставить("SourceRevision", ПолучитьРевизиюИсходников(КаталогТестов));
	Отчет.Вставить("SourceDirty", ИсходникиИзменены(КаталогТестов));
	Отчет.Вставить("RuntimeVersion", СистемнаяИнформация.Версия);
	Отчет.Вставить("Environment", Новый Структура("OperatingSystem, DotNetVersion", СистемнаяИнформация.ВерсияОС, ""));
	Отчет.Вставить("TestDirectory", ".");
	Отчет.Вставить("FileCount", ФайлыТестов.Количество());
	Отчет.Вставить("CandidateCount", Результаты.Количество());
	Отчет.Вставить("ExecutionCount", Группы.Количество());
	Отчет.Вставить("ClassifiedCount", 0);
	Отчет.Вставить("UnclassifiedCount", 0);
	Отчет.Вставить("NoExceptionCount", 0);
	Отчет.Вставить("NotObservedCount", 0);
	Отчет.Вставить("RuntimeFailureCount", 0);
	Отчет.Вставить("SkippedRunnerCount", ПропущеноЗапускателей);

	Для Каждого Результат Из Результаты Цикл
		Отчет[Результат.Status + "Count"] = Отчет[Результат.Status + "Count"] + 1;
	КонецЦикла;

	Отчет.Вставить("Results", ОтсортироватьРезультаты(Результаты));
	ЗаписатьJSONВФайл(ПутьОтчета, Отчет);

	Сообщить(СтрШаблон("Кандидатов: %1; запусков: %2", Отчет.CandidateCount, Отчет.ExecutionCount));

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПрочитатьТекст(Путь)

	Чтение = Новый ЧтениеТекста(Путь, КодировкаТекста.UTF8);
	Текст = Чтение.Прочитать();
	Чтение.Закрыть();

	Возврат Текст;

КонецФункции

Процедура ЗаписатьТекст(Путь, Текст)

	Запись = Новый ЗаписьТекста(Путь, КодировкаТекста.UTF8);
	Запись.Записать(Текст);
	Запись.Закрыть();

КонецПроцедуры

Процедура ЗаписатьJSONВФайл(Путь, Данные)

	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, Данные);
	ЗаписатьТекст(Путь, ЗаписьJSON.Закрыть());

КонецПроцедуры

Функция ПолучитьНомерСтроки(Текст, Индекс)

	Возврат СтрРазделить(Лев(Текст, Индекс), Символы.ПС).Количество();

КонецФункции

Функция ПолучитьОтступ(Строка)

	Отступ = "";
	Для Индекс = 1 По СтрДлина(Строка) Цикл
		Символ = Сред(Строка, Индекс, 1);
		Если Символ <> " " И Символ <> Символы.Таб Тогда
			Прервать;
		КонецЕсли;

		Отступ = Отступ + Символ;
	КонецЦикла;

	Возврат Отступ;

КонецФункции

Функция ПолучитьОтносительныйПуть(Корень, Путь)

	ПолныйКорень = Новый Файл(Корень).ПолноеИмя;
	Пока СтрДлина(ПолныйКорень) > 0
		И (Сред(ПолныйКорень, СтрДлина(ПолныйКорень), 1) = ПолучитьРазделительПути()
			Или Сред(ПолныйКорень, СтрДлина(ПолныйКорень), 1) = "/") Цикл
		ПолныйКорень = Лев(ПолныйКорень, СтрДлина(ПолныйКорень) - 1);
	КонецЦикла;

	ПолныйПуть = Новый Файл(Путь).ПолноеИмя;
	Префикс = ПолныйКорень + ПолучитьРазделительПути();

	Если Лев(НРег(ПолныйПуть), СтрДлина(Префикс)) <> НРег(Префикс) Тогда
		ВызватьИсключение "Путь находится вне каталога тестов: " + ПолныйПуть;
	КонецЕсли;

	Возврат СтрЗаменить(Сред(ПолныйПуть, СтрДлина(Префикс) + 1), ПолучитьРазделительПути(), "/");

КонецФункции

Функция ПолучитьИмяТестовогоМетода(Текст, Индекс)

	ШаблонМетода = Новый РегулярноеВыражение(
		"^[ \t]*(?:Процедура|Функция)\s+(?<Имя>[A-Za-zА-Яа-яеё_][A-Za-zА-Яа-яеё0-9_]*)"
	);
	ШаблонМетода.Многострочный = Истина;
	ШаблонМетода.ИгнорироватьРегистр = Истина;

	ПоследнееСовпадение = Неопределено;
	Для Каждого Совпадение Из ШаблонМетода.НайтиСовпадения(Текст) Цикл
		Если Совпадение.Индекс > Индекс Тогда
			Прервать;
		КонецЕсли;

		ПоследнееСовпадение = Совпадение;
	КонецЦикла;

	Если ПоследнееСовпадение = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	ШаблонКонцаМетода = Новый РегулярноеВыражение("^[ \t]*Конец(?:Процедуры|Функции)\b");
	ШаблонКонцаМетода.Многострочный = Истина;
	ШаблонКонцаМетода.ИгнорироватьРегистр = Истина;
	КонцыМетодов = ШаблонКонцаМетода.НайтиСовпадения(
		Сред(Текст, ПоследнееСовпадение.Индекс + ПоследнееСовпадение.Длина + 1)
	);

	Если КонцыМетодов.Количество() > 0 Тогда
		КонецМетода = ПоследнееСовпадение.Индекс + ПоследнееСовпадение.Длина + КонцыМетодов[0].Индекс;
		Если КонецМетода < Индекс Тогда
			Возврат "";
		КонецЕсли;
	КонецЕсли;

	Возврат ПоследнееСовпадение.Группы.ПоИмени("Имя").Значение;

КонецФункции

Функция ПолучитьБлокиПопыток(Текст)

	Шаблон = Новый РегулярноеВыражение("^[ \t]*(?<Токен>Попытка|Исключение|КонецПопытки)\b[^\r\n]*");
	Шаблон.Многострочный = Истина;
	Шаблон.ИгнорироватьРегистр = Истина;
	Стек = Новый Массив;
	Блоки = Новый Массив;

	Для Каждого Совпадение Из Шаблон.НайтиСовпадения(Текст) Цикл
		Токен = Совпадение.Группы.ПоИмени("Токен").Значение;
		Если НРег(Токен) = НРег("Попытка") Тогда
			Стек.Добавить(Новый Структура("Попытка, Исключение", Совпадение, Неопределено));
			Продолжить;
		КонецЕсли;

		Если Стек.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;

		ИндексБлока = Стек.ВГраница();
		Блок = Стек[ИндексБлока];
		Если НРег(Токен) = НРег("Исключение") Тогда
			Если Блок.Исключение = Неопределено Тогда
				Блок.Исключение = Совпадение;
				Стек[ИндексБлока] = Блок;
			КонецЕсли;
			Продолжить;
		КонецЕсли;

		Стек.Удалить(ИндексБлока);
		Если Блок.Исключение <> Неопределено Тогда
			Блоки.Добавить(Новый Структура("Попытка, Исключение, Конец", Блок.Попытка, Блок.Исключение, Совпадение));
		КонецЕсли;
	КонецЦикла;

	Возврат Блоки;

КонецФункции

Функция ОбработчикПробрасываетИсключение(Текст, Блок)

	НачалоОбработчика = Блок.Исключение.Индекс + Блок.Исключение.Длина + 1;
	ДлинаОбработчика = Блок.Конец.Индекс - НачалоОбработчика + 1;
	Обработчик = Сред(Текст, НачалоОбработчика, ДлинаОбработчика);
	Шаблон = Новый РегулярноеВыражение("^[ \t]*ВызватьИсключение[ \t]*;[ \t]*(?://.*)?$");
	Шаблон.Многострочный = Истина;

	Возврат Шаблон.Совпадает(Обработчик);

КонецФункции

Процедура ДобавитьКандидатыПопыток(Кандидаты, ФайлТеста, Текст, КаталогТестов)

	Для Каждого Блок Из ПолучитьБлокиПопыток(Текст) Цикл
		ИмяМетода = ПолучитьИмяТестовогоМетода(Текст, Блок.Попытка.Индекс);
		Если ПустаяСтрока(ИмяМетода) Тогда
			Продолжить;
		КонецЕсли;

		Кандидат = Новый Структура;
		Кандидат.Вставить("Файл", ПолучитьОтносительныйПуть(КаталогТестов, ФайлТеста.ПолноеИмя));
		Кандидат.Вставить("Строка", ПолучитьНомерСтроки(Текст, Блок.Попытка.Индекс));
		Кандидат.Вставить("ТестовыйМетод", ИмяМетода);
		Кандидат.Вставить("Источник", "ПопыткаИсключение");
		Кандидат.Вставить(
			"Наблюдение",
			?(ОбработчикПробрасываетИсключение(Текст, Блок), "ПроброшенноеИсключение", "ОбработанноеИсключение")
		);
		Кандидат.Вставить("Объект", "");
		Кандидат.Вставить("Метод", "");
		Кандидат.Вставить("Позиция", -1);
		Кандидат.Вставить("Длина", 0);
		Кандидат.Вставить("Блок", Блок);
		Кандидаты.Добавить(Кандидат);
	КонецЦикла;

КонецПроцедуры

Процедура ДобавитьКандидатыОжиданий(Кандидаты, ФайлТеста, Текст, КаталогТестов)

	Шаблон = Новый РегулярноеВыражение(
		"(?s)Ожидаем\s*\.\s*Что\s*\(\s*(?<Объект>.*?)\s*\)\s*\.\s*Метод\s*\(\s*"
			+ """(?<Метод>(?:[^""]|"""")*)""\s*\)\s*\.\s*ВыбрасываетИсключение\s*\(\s*"
			+ """(?<Сообщение>(?:[^""]|"""")*)""\s*\)\s*;?"
	);

	Для Каждого Совпадение Из Шаблон.НайтиСовпадения(Текст) Цикл
		ИмяМетода = ПолучитьИмяТестовогоМетода(Текст, Совпадение.Индекс);
		Если ПустаяСтрока(ИмяМетода) Тогда
			Продолжить;
		КонецЕсли;

		Кандидат = Новый Структура;
		Кандидат.Вставить("Файл", ПолучитьОтносительныйПуть(КаталогТестов, ФайлТеста.ПолноеИмя));
		Кандидат.Вставить("Строка", ПолучитьНомерСтроки(Текст, Совпадение.Индекс));
		Кандидат.Вставить("ТестовыйМетод", ИмяМетода);
		Кандидат.Вставить("Источник", "ОжиданиеИсключения");
		Кандидат.Вставить("Наблюдение", "ПроверяемоеИсключение");
		Кандидат.Вставить("Объект", СокрЛП(Совпадение.Группы.ПоИмени("Объект").Значение));
		Кандидат.Вставить("Метод", СтрЗаменить(Совпадение.Группы.ПоИмени("Метод").Значение, """""", """"));
		Кандидат.Вставить("Позиция", Совпадение.Индекс);
		Кандидат.Вставить("Длина", Совпадение.Длина);
		Кандидат.Вставить("Блок", Неопределено);
		Кандидаты.Добавить(Кандидат);
	КонецЦикла;

КонецПроцедуры

Функция ПолучитьСтрокиЗахвата(Идентификатор, Отступ)

	Строки = Новый Массив;
	Строки.Добавить(Отступ + "ИсходнаяОшибка = ИнформацияОбОшибке();");
	Строки.Добавить(Отступ + "Классификатор = Новый КлассификаторОшибок;");
	Строки.Добавить(
		Отступ + "Классификатор.ДобавитьПравила(Новый ПравилаНативныхОшибок().Все());"
	);
	Строки.Добавить(
		Отступ + "НормализованнаяОшибка = Классификатор.Классифицировать(ИсходнаяОшибка);"
	);
	Строки.Добавить(Отступ + "Если НормализованнаяОшибка = Неопределено Тогда");
	Строки.Добавить(Отступ + Символы.Таб + "Сообщить(""__NATIVE_ERRORS_CODE__:" + Идентификатор + "=Неопределено"");");
	Строки.Добавить(Отступ + "Иначе");
	Строки.Добавить(
		Отступ + Символы.Таб + "Сообщить(""__NATIVE_ERRORS_CODE__:" + Идентификатор
			+ "="" + ДиагностикаОшибок.КодОшибки(НормализованнаяОшибка));"
	);
	Строки.Добавить(Отступ + "КонецЕсли;");
	Строки.Добавить(
		Отступ + "Сообщить(""__NATIVE_ERRORS_DESCRIPTION__:" + Идентификатор
			+ "="" + СтрЗаменить(ИсходнаяОшибка.Описание, Символы.ПС, "" ""));"
	);

	Возврат Строки;

КонецФункции

Функция ПоследнийСимволПередИсключением(Текст, Индекс)

	Позиция = Индекс;
	Пока Позиция > 0 Цикл
		Символ = Сред(Текст, Позиция, 1);
		Если Символ <> " " И Символ <> Символы.ПС И Символ <> Символы.ВК И Символ <> Символы.Таб Тогда
			Возврат Символ;
		КонецЕсли;

		Позиция = Позиция - 1;
	КонецЦикла;

	Возврат "";

КонецФункции

Процедура ДобавитьИзмененияДляПопытки(Изменения, Запись, НоваяСтрока)

	Блок = Запись.Кандидат.Блок;
	ОтступПопытки = ПолучитьОтступ(Блок.Попытка.Значение);
	ОтступОбработчика = ПолучитьОтступ(Блок.Исключение.Значение) + Символы.Таб;
	СтрокиЗахвата = ПолучитьСтрокиЗахвата(Запись.Идентификатор, ОтступОбработчика);

	Изменения.Добавить(
		Новый Структура(
			"Начало, Длина, Текст",
			Блок.Исключение.Индекс + Блок.Исключение.Длина,
			0,
			НоваяСтрока + СтрСоединить(СтрокиЗахвата, НоваяСтрока)
		)
	);

	Терминатор = ?(
		ПоследнийСимволПередИсключением(Запись.Текст, Блок.Исключение.Индекс) = ";",
		"",
		";"
	);
	Изменения.Добавить(
		Новый Структура(
			"Начало, Длина, Текст",
			Блок.Исключение.Индекс,
			0,
			Терминатор + ОтступПопытки + Символы.Таб
				+ "Сообщить(""__NATIVE_ERRORS_STATUS__:" + Запись.Идентификатор + "=NoException"");" + НоваяСтрока
		)
	);

КонецПроцедуры

Функция ПолучитьОтступСтроки(Текст, Индекс)

	НачалоСтроки = Индекс;
	Пока НачалоСтроки > 0 И Сред(Текст, НачалоСтроки, 1) <> Символы.ПС Цикл
		НачалоСтроки = НачалоСтроки - 1;
	КонецЦикла;

	Возврат ПолучитьОтступ(Сред(Текст, НачалоСтроки + 1));

КонецФункции

Процедура ДобавитьИзменениеДляОжидания(Изменения, Запись, НоваяСтрока)

	Кандидат = Запись.Кандидат;
	Если Новый РегулярноеВыражение("^[A-Za-zА-Яа-яеё_][A-Za-zА-Яа-яеё0-9_]*$").Совпадает(Кандидат.Метод) = Ложь Тогда
		ВызватьИсключение "Недопустимое имя метода в ожидании исключения: " + Кандидат.Метод;
	КонецЕсли;

	Отступ = ПолучитьОтступСтроки(Запись.Текст, Кандидат.Позиция);
	ИмяОбъекта = "ОбъектНативнойОшибки" + Запись.Идентификатор;
	Строки = Новый Массив;
	Строки.Добавить(ИмяОбъекта + " = (" + Кандидат.Объект + ");");
	Строки.Добавить(Отступ + "Попытка");
	Строки.Добавить(Отступ + Символы.Таб + ИмяОбъекта + "." + Кандидат.Метод + "();");
	Строки.Добавить(
		Отступ + Символы.Таб + "Сообщить(""__NATIVE_ERRORS_STATUS__:" + Запись.Идентификатор + "=NoException"");"
	);
	Строки.Добавить(Отступ + "Исключение");
	Для Каждого СтрокаЗахвата Из ПолучитьСтрокиЗахвата(Запись.Идентификатор, Отступ + Символы.Таб) Цикл
		Строки.Добавить(СтрокаЗахвата);
	КонецЦикла;
	Строки.Добавить(Отступ + "КонецПопытки;");

	Изменения.Добавить(
		Новый Структура("Начало, Длина, Текст", Кандидат.Позиция, Кандидат.Длина, СтрСоединить(Строки, НоваяСтрока))
	);

КонецПроцедуры

Функция ПрименитьИзменения(Текст, Изменения)

	Пока Изменения.Количество() > 0 Цикл
		ИндексИзменения = 0;
		Для Индекс = 1 По Изменения.ВГраница() Цикл
			Если Изменения[Индекс].Начало > Изменения[ИндексИзменения].Начало Тогда
				ИндексИзменения = Индекс;
			КонецЕсли;
		КонецЦикла;

		Изменение = Изменения[ИндексИзменения];
		Текст = Лев(Текст, Изменение.Начало)
			+ Изменение.Текст
			+ Сред(Текст, Изменение.Начало + Изменение.Длина + 1);
		Изменения.Удалить(ИндексИзменения);
	КонецЦикла;

	Возврат Текст;

КонецФункции

Функция ПолучитьИнструментированныйТекст(Текст, Записи, КаталогБиблиотеки)

	НоваяСтрока = ?(СтрНайти(Текст, Символы.ВК + Символы.ПС) > 0, Символы.ВК + Символы.ПС, Символы.ПС);
	Изменения = Новый Массив;

	Для Каждого Запись Из Записи Цикл
		Если Запись.Кандидат.Источник = "ОжиданиеИсключения" Тогда
			ДобавитьИзменениеДляОжидания(Изменения, Запись, НоваяСтрока);
		Иначе
			ДобавитьИзмененияДляПопытки(Изменения, Запись, НоваяСтрока);
		КонецЕсли;
	КонецЦикла;

	ПутьИсходников = СтрЗаменить(
		Новый Файл(ОбъединитьПути(КаталогБиблиотеки, "src")).ПолноеИмя,
		"\\",
		"/"
	);
	ПутьОшибок = СтрЗаменить(
		Новый Файл(ОбъединитьПути(КаталогБиблиотеки, "oscript_modules", "errors")).ПолноеИмя,
		"\\",
		"/"
	);
	Импорты = "#Использовать """ + ПутьИсходников + """" + НоваяСтрока
		+ "#Использовать """ + ПутьОшибок + """";

	Возврат Импорты + НоваяСтрока + НоваяСтрока
		+ ПрименитьИзменения(Текст, Изменения)
		+ НоваяСтрока + "Сообщить(""__NATIVE_ERRORS_FILE_LOADED__"");" + НоваяСтрока;

КонецФункции

Процедура СкопироватьСодержимоеКаталога(ИсходныйКаталог, ЦелевойКаталог)

	Для Каждого ИсходныйФайл Из НайтиФайлы(ИсходныйКаталог, ПолучитьМаскуВсеФайлы(), Истина) Цикл
		Если Не ИсходныйФайл.ЭтоФайл() Тогда
			Продолжить;
		КонецЕсли;

		ОтносительныйПуть = ПолучитьОтносительныйПуть(ИсходныйКаталог, ИсходныйФайл.ПолноеИмя);
		ЦелевойФайл = ОбъединитьПути(ЦелевойКаталог, ОтносительныйПуть);
		ЦелевойКаталогФайла = Новый Файл(ЦелевойФайл).Путь;
		СоздатьКаталог(ЦелевойКаталогФайла);
		КопироватьФайл(ИсходныйФайл.ПолноеИмя, ЦелевойФайл);
	КонецЦикла;

КонецПроцедуры

Процедура СкопироватьСоседниеКаталоги(ИсходныйКаталог, ВременноеОкружение, Текст)

	ШаблонКаталога = Новый РегулярноеВыражение("(?<!\.)\.\.[\\/](?<Имя>[A-Za-z0-9._-]+)");
	ИменаКаталогов = Новый Соответствие;
	РодительИсходногоКаталога = Новый Файл(ИсходныйКаталог).Путь;

	Для Каждого Совпадение Из ШаблонКаталога.НайтиСовпадения(Текст) Цикл
		ИмяКаталога = Совпадение.Группы.ПоИмени("Имя").Значение;
		Если ИменаКаталогов.Получить(ИмяКаталога) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;

		ИменаКаталогов.Вставить(ИмяКаталога, Истина);
		ИсходныйСоседнийКаталог = ОбъединитьПути(РодительИсходногоКаталога, ИмяКаталога);
		Если Не Новый Файл(ИсходныйСоседнийКаталог).Существует()
			Или Не Новый Файл(ИсходныйСоседнийКаталог).ЭтоКаталог() Тогда
			Продолжить;
		КонецЕсли;

		СкопироватьСодержимоеКаталога(
			ИсходныйСоседнийКаталог,
			ОбъединитьПути(ВременноеОкружение, ИмяКаталога)
		);
	КонецЦикла;

КонецПроцедуры

Функция ЗапуститьТестовыйФайл(ПутьКOneScript, ПутьЗапускателя, ПутьТеста, РабочийКаталог)

	ВнешняяКоманда = Новый Команда;
	ВнешняяКоманда.УстановитьКоманду(ПутьКOneScript);
	ВнешняяКоманда.ДобавитьПараметр("-encoding=utf-8");
	ВнешняяКоманда.ДобавитьПараметр(ВнешняяКоманда.ОбернутьВКавычки(ПутьЗапускателя));
	ВнешняяКоманда.ДобавитьПараметр(ВнешняяКоманда.ОбернутьВКавычки(ПутьТеста));
	ВнешняяКоманда.УстановитьРабочийКаталог(РабочийКаталог);
	ВнешняяКоманда.УстановитьИсполнениеЧерезКомандыСистемы(Ложь);
	ВнешняяКоманда.УстановитьКодировкуВывода(КодировкаТекста.UTF8);

	КодВозврата = ВнешняяКоманда.Исполнить();

	Результат = Новый Структура;
	Результат.Вставить("Вывод", ВнешняяКоманда.ПолучитьВывод());
	Результат.Вставить("КодВозврата", КодВозврата);

	Возврат Результат;

КонецФункции

Функция ПолучитьЗначениеМаркера(Вывод, Имя, Идентификатор)

	Шаблон = Новый РегулярноеВыражение(
		"(?m)^__NATIVE_ERRORS_" + Имя + "__:" + Идентификатор + "=(?<Значение>.*)\r?$"
	);
	Совпадения = Шаблон.НайтиСовпадения(Вывод);

	Если Совпадения.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат СокрЛП(Совпадения[0].Группы.ПоИмени("Значение").Значение);

КонецФункции

Функция НормализоватьТекстРезультата(Текст, КаталогТестов)

	Если ПустаяСтрока(Текст) Тогда
		Возврат "";
	КонецЕсли;

	ВременныйКаталог = Новый Файл(КаталогВременныхФайлов()).ПолноеИмя;
	Пока СтрДлина(ВременныйКаталог) > 1
		И (Сред(ВременныйКаталог, СтрДлина(ВременныйКаталог), 1) = ПолучитьРазделительПути()
			Или Сред(ВременныйКаталог, СтрДлина(ВременныйКаталог), 1) = "/") Цикл
		ВременныйКаталог = Лев(ВременныйКаталог, СтрДлина(ВременныйКаталог) - 1);
	КонецЦикла;

	Текст = СтрЗаменить(Текст, Новый Файл(КаталогТестов).ПолноеИмя, "<OneScriptTests>");
	Текст = СтрЗаменить(Текст, ВременныйКаталог, "<Temp>");
	ШаблонВременногоПути = Новый РегулярноеВыражение("<Temp>[\\/][^'\""}\r\n]+");

	Возврат ШаблонВременногоПути.Заменить(Текст, "<Temp>\<temporary>");

КонецФункции

Функция СоздатьРезультатКандидата(Кандидат)

	Возврат Новый Структура(
		"File, Line, TestMethod, Source, Observation, Status, Code, Description, Output",
		Кандидат.Файл,
		Кандидат.Строка,
		Кандидат.ТестовыйМетод,
		Кандидат.Источник,
		Кандидат.Наблюдение,
		"RuntimeFailure",
		"",
		"",
		""
	);

КонецФункции

Функция ОтсортироватьРезультаты(Результаты)

	ТаблицаРезультатов = Новый ТаблицаЗначений;
	ТаблицаРезультатов.Колонки.Добавить("Файл");
	ТаблицаРезультатов.Колонки.Добавить("Строка");
	ТаблицаРезультатов.Колонки.Добавить("Источник");
	ТаблицаРезультатов.Колонки.Добавить("Результат");

	Для Каждого Результат Из Результаты Цикл
		Строка = ТаблицаРезультатов.Добавить();
		Строка.Файл = Результат.File;
		Строка.Строка = Результат.Line;
		Строка.Источник = Результат.Source;
		Строка.Результат = Результат;
	КонецЦикла;

	ТаблицаРезультатов.Сортировать("Файл, Строка, Источник");
	ОтсортированныеРезультаты = Новый Массив;
	Для Каждого Строка Из ТаблицаРезультатов Цикл
		ОтсортированныеРезультаты.Добавить(Строка.Результат);
	КонецЦикла;

	Возврат ОтсортированныеРезультаты;

КонецФункции

Процедура ОбработатьФайл(
	Записи,
	ПутьКOneScript,
	ПутьЗапускателя,
	КаталогБиблиотеки,
	КаталогТестов,
	Результаты)

	ПутьИсходника = Записи[0].ПутьИсходника;
	ИсходныйКаталог = Новый Файл(ПутьИсходника).Путь;
	ВременныйКаталог = Неопределено;
	ВременноеОкружение = Неопределено;
	РезультатыФайла = Новый Массив;

	Для Каждого Запись Из Записи Цикл
		РезультатыФайла.Добавить(СоздатьРезультатКандидата(Запись.Кандидат));
	КонецЦикла;

	Попытка
		Текст = ПрочитатьТекст(ПутьИсходника);
		ВременноеОкружение = ПолучитьИмяВременногоФайла();
		УдалитьФайлы(ВременноеОкружение);
		СоздатьКаталог(ВременноеОкружение);
		ВременныйКаталог = ОбъединитьПути(ВременноеОкружение, Новый Файл(ИсходныйКаталог).Имя);
		СкопироватьСодержимоеКаталога(ИсходныйКаталог, ВременныйКаталог);
		СкопироватьСоседниеКаталоги(ИсходныйКаталог, ВременноеОкружение, Текст);

		ПутьКопии = ОбъединитьПути(ВременныйКаталог, Новый Файл(ПутьИсходника).Имя);
		ЗаписатьТекст(ПутьКопии, ПолучитьИнструментированныйТекст(Текст, Записи, КаталогБиблиотеки));

		РабочийКаталог = ?(
			Лев(НРег(ПутьИсходника), СтрДлина(Новый Файл(КаталогТестов).ПолноеИмя))
				= НРег(Новый Файл(КаталогТестов).ПолноеИмя),
			КаталогТестов,
			ИсходныйКаталог
		);
		Запуск = ЗапуститьТестовыйФайл(ПутьКOneScript, ПутьЗапускателя, ПутьКопии, РабочийКаталог);
		Вывод = Запуск.Вывод;
		ФайлЗагружен = СтрНайти(Вывод, "__NATIVE_ERRORS_FILE_LOADED__") > 0;

		Для Индекс = 0 По Записи.ВГраница() Цикл
			Запись = Записи[Индекс];
			Код = ПолучитьЗначениеМаркера(Вывод, "CODE", Запись.Идентификатор);
			БезИсключения = ПолучитьЗначениеМаркера(Вывод, "STATUS", Запись.Идентификатор);

			Если Код <> Неопределено Тогда
				РезультатыФайла[Индекс].Code = Код;
				РезультатыФайла[Индекс].Description = НормализоватьТекстРезультата(
					ПолучитьЗначениеМаркера(Вывод, "DESCRIPTION", Запись.Идентификатор),
					КаталогТестов
				);
				РезультатыФайла[Индекс].Status = ?(Код = "Неопределено", "Unclassified", "Classified");
			ИначеЕсли БезИсключения = "NoException" Тогда
				РезультатыФайла[Индекс].Status = "NoException";
			ИначеЕсли ФайлЗагружен Тогда
				РезультатыФайла[Индекс].Status = "NotObserved";
			Иначе
				РезультатыФайла[Индекс].Output = НормализоватьТекстРезультата(Вывод, КаталогТестов);
			КонецЕсли;
		КонецЦикла;
	Исключение
		Для Каждого Результат Из РезультатыФайла Цикл
			Результат.Output = НормализоватьТекстРезультата(ОписаниеОшибки(), КаталогТестов);
		КонецЦикла;
	КонецПопытки;

	Если ВременноеОкружение <> Неопределено
		И СтрНайти(НРег(ВременноеОкружение), НРег(Новый Файл(КаталогВременныхФайлов()).ПолноеИмя)) = 1 Тогда
		УдалитьФайлы(ВременноеОкружение);
	КонецЕсли;

	Для Каждого Результат Из РезультатыФайла Цикл
		Результаты.Добавить(Результат);
	КонецЦикла;

КонецПроцедуры

Функция ПолучитьРевизиюИсходников(КаталогТестов)

	ВнешняяКоманда = Новый Команда;
	ВнешняяКоманда.УстановитьКоманду("git");
	ВнешняяКоманда.ДобавитьПараметр("-C");
	ВнешняяКоманда.ДобавитьПараметр(ВнешняяКоманда.ОбернутьВКавычки(КаталогТестов));
	ВнешняяКоманда.ДобавитьПараметр("rev-parse");
	ВнешняяКоманда.ДобавитьПараметр("HEAD");
	ВнешняяКоманда.УстановитьРабочийКаталог(КаталогТестов);
	ВнешняяКоманда.УстановитьИсполнениеЧерезКомандыСистемы(Ложь);

	КодВозврата = ВнешняяКоманда.Исполнить();

	Если КодВозврата <> 0 Тогда
		ВызватьИсключение "Не удалось определить ревизию исходников: "
			+ СокрЛП(ВнешняяКоманда.ПолучитьВывод());
	КонецЕсли;

	Возврат СокрЛП(ВнешняяКоманда.ПолучитьВывод());

КонецФункции

Функция ИсходникиИзменены(КаталогТестов)

	ВнешняяКоманда = Новый Команда;
	ВнешняяКоманда.УстановитьКоманду("git");
	ВнешняяКоманда.ДобавитьПараметр("-C");
	ВнешняяКоманда.ДобавитьПараметр(ВнешняяКоманда.ОбернутьВКавычки(КаталогТестов));
	ВнешняяКоманда.ДобавитьПараметр("status");
	ВнешняяКоманда.ДобавитьПараметр("--porcelain");
	ВнешняяКоманда.УстановитьРабочийКаталог(КаталогТестов);
	ВнешняяКоманда.УстановитьИсполнениеЧерезКомандыСистемы(Ложь);

	КодВозврата = ВнешняяКоманда.Исполнить();

	Если КодВозврата <> 0 Тогда
		ВызватьИсключение "Не удалось определить состояние исходников: "
			+ СокрЛП(ВнешняяКоманда.ПолучитьВывод());
	КонецЕсли;

	Возврат Не ПустаяСтрока(СокрЛП(ВнешняяКоманда.ПолучитьВывод()));

КонецФункции

#КонецОбласти
