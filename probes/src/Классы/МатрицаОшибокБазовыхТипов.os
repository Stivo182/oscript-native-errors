#Использовать "../../../src"
#Использовать errors

#Область ПрограммныйИнтерфейс

// Формирует матрицу ошибок базовых типов текущей локали.
//
// Параметры:
//   ПутьКОтчету - Строка - путь создаваемого JSON-отчета.
Процедура Сформировать(ПутьКОтчету) Экспорт

	Типы = Новый Массив;

	ДобавитьТип(Типы, "Неопределено", "Неопределено");
	ДобавитьТип(Типы, "Null", "Null");
	ДобавитьТип(Типы, "Булево", "Истина");
	ДобавитьТип(Типы, "Число", "1");
	ДобавитьТип(Типы, "Строка", """строка""");
	ДобавитьТип(Типы, "Дата", "Дата(2024, 1, 2)");
	ДобавитьТип(Типы, "Тип", "Тип(""Число"")");

	Группы = Новый Массив;
	Группы.Добавить("Unary");
	Группы.Добавить("Arithmetic");
	Группы.Добавить("Comparison");
	Группы.Добавить("Conversion");
	Группы.Добавить("Index");
	Группы.Добавить("Property");
	Группы.Добавить("Method");

	УнарныеОперации = Новый Массив;
	УнарныеОперации.Добавить("+");
	УнарныеОперации.Добавить("-");
	УнарныеОперации.Добавить("Не");

	АрифметическиеОперации = Новый Массив;
	АрифметическиеОперации.Добавить("+");
	АрифметическиеОперации.Добавить("-");
	АрифметическиеОперации.Добавить("*");
	АрифметическиеОперации.Добавить("/");
	АрифметическиеОперации.Добавить("%");

	ОперацииСравнения = Новый Массив;
	ОперацииСравнения.Добавить("=");
	ОперацииСравнения.Добавить("<>");
	ОперацииСравнения.Добавить("<");
	ОперацииСравнения.Добавить("<=");
	ОперацииСравнения.Добавить(">");
	ОперацииСравнения.Добавить(">=");

	Преобразования = Новый Массив;
	Преобразования.Добавить("Булево");
	Преобразования.Добавить("Число");
	Преобразования.Добавить("Строка");
	Преобразования.Добавить("Дата");

	Результаты = Новый Массив;
	Классификатор = Новый КлассификаторОшибок;
	Классификатор.ДобавитьПравила(Новый ПравилаНативныхОшибок().Все());

	ВыполнитьУнарныеОперации(Результаты, Классификатор, Типы, УнарныеОперации);
	ВыполнитьБинарныеОперации(Результаты, Классификатор, Типы, "Arithmetic", АрифметическиеОперации);

	ДобавитьРезультат(
		Результаты,
		Классификатор,
		"Деление на ноль",
		"Arithmetic",
		"Число",
		"Число",
		"/",
		"1 / 0");

	ДобавитьРезультат(
		Результаты,
		Классификатор,
		"Остаток от деления на ноль",
		"Arithmetic",
		"Число",
		"Число",
		"%",
		"1 % 0");

	ВыполнитьБинарныеОперации(Результаты, Классификатор, Типы, "Comparison", ОперацииСравнения);
	ВыполнитьПреобразования(Результаты, Классификатор, Типы, Преобразования);
	ВыполнитьОперациюНадЗначениями(Результаты, Классификатор, Типы, "Index", "[]", "(%1)[0]");
	ВыполнитьОперациюНадЗначениями(
		Результаты,
		Классификатор,
		Типы,
		"Property",
		"НесуществующееСвойство",
		"(%1).НесуществующееСвойство");
	ВыполнитьОперациюНадЗначениями(
		Результаты,
		Классификатор,
		Типы,
		"Method",
		"НесуществующийМетод()",
		"(%1).НесуществующийМетод()");

	Данные = Новый Структура;
	Данные.Вставить("Locale", НСтр("ru = 'ru'; en = 'en'"));
	Данные.Вставить("TypeCount", Типы.Количество());
	Данные.Вставить("GroupCount", Группы.Количество());
	Данные.Вставить("ScenarioCount", Результаты.Количество());
	Данные.Вставить("Types", Типы);
	Данные.Вставить("Groups", Группы);
	Данные.Вставить("Results", Результаты);

	ЗаписатьРезультат(ПутьКОтчету, Данные);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ДобавитьТип(Типы, Имя, Выражение)
	Типы.Добавить(Новый Структура("Name, Expression", Имя, Выражение));
КонецПроцедуры

Процедура ДобавитьРезультат(
	Результаты,
	Классификатор,
	Имя,
	Группа,
	ЛевыйТип,
	ПравыйТип,
	Операция,
	Выражение)

	Ошибка = Неопределено;
	Значение = Неопределено;

	Попытка
		Значение = Вычислить(Выражение);
	Исключение
		Ошибка = ИнформацияОбОшибке();
	КонецПопытки;

	Результат = Новый Структура;
	Результат.Вставить("Name", Имя);
	Результат.Вставить("Group", Группа);
	Результат.Вставить("LeftType", ЛевыйТип);
	Результат.Вставить("RightType", ПравыйТип);
	Результат.Вставить("Operation", Операция);
	Результат.Вставить("Expression", Выражение);

	Если Ошибка = Неопределено Тогда
		Результат.Вставить("Status", "Success");
		Результат.Вставить("ResultType", Строка(ТипЗнч(Значение)));
		Результат.Вставить("Description", "");
		Результат.Вставить("Code", "");
	Иначе
		КлассифицированнаяОшибка = Классификатор.Классифицировать(Ошибка);
		Код = "";

		Если КлассифицированнаяОшибка <> Неопределено Тогда
			Код = ДиагностикаОшибок.КодОшибки(КлассифицированнаяОшибка);
		КонецЕсли;

		Результат.Вставить("Status", ?(ПустаяСтрока(Код), "Unclassified", "Classified"));
		Результат.Вставить("ResultType", "");
		Результат.Вставить("Description", Ошибка.Описание);
		Результат.Вставить("Code", Код);
	КонецЕсли;

	Результаты.Добавить(Результат);

КонецПроцедуры

Процедура ВыполнитьУнарныеОперации(Результаты, Классификатор, Типы, Операции)
	Для Каждого ОписаниеТипа Из Типы Цикл
		Для Каждого Операция Из Операции Цикл
			Если Операция = "Не" Тогда
				Выражение = Операция + " (" + ОписаниеТипа.Expression + ")";
			Иначе
				Выражение = Операция + "(" + ОписаниеТипа.Expression + ")";
			КонецЕсли;

			ДобавитьРезультат(
				Результаты,
				Классификатор,
				Выражение,
				"Unary",
				ОписаниеТипа.Name,
				"",
				Операция,
				Выражение);
		КонецЦикла;
	КонецЦикла;
КонецПроцедуры

Процедура ВыполнитьБинарныеОперации(Результаты, Классификатор, Типы, Группа, Операции)
	Для Каждого ЛевыйТип Из Типы Цикл
		Для Каждого ПравыйТип Из Типы Цикл
			Для Каждого Операция Из Операции Цикл
				Выражение = "(" + ЛевыйТип.Expression + ") " + Операция + " (" + ПравыйТип.Expression + ")";

				ДобавитьРезультат(
					Результаты,
					Классификатор,
					Выражение,
					Группа,
					ЛевыйТип.Name,
					ПравыйТип.Name,
					Операция,
					Выражение);
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
КонецПроцедуры

Процедура ВыполнитьПреобразования(Результаты, Классификатор, Типы, Преобразования)
	Для Каждого ОписаниеТипа Из Типы Цикл
		Для Каждого Преобразование Из Преобразования Цикл
			Выражение = Преобразование + "(" + ОписаниеТипа.Expression + ")";

			ДобавитьРезультат(
				Результаты,
				Классификатор,
				Выражение,
				"Conversion",
				ОписаниеТипа.Name,
				"",
				Преобразование,
				Выражение);
		КонецЦикла;
	КонецЦикла;
КонецПроцедуры

Процедура ВыполнитьОперациюНадЗначениями(Результаты, Классификатор, Типы, Группа, Операция, Шаблон)
	Для Каждого ОписаниеТипа Из Типы Цикл
		Выражение = СтрШаблон(Шаблон, ОписаниеТипа.Expression);

		ДобавитьРезультат(
			Результаты,
			Классификатор,
			Выражение,
			Группа,
			ОписаниеТипа.Name,
			"",
			Операция,
			Выражение);
	КонецЦикла;
КонецПроцедуры

Процедура ЗаписатьРезультат(Путь, Данные)

	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Данные);

	Файл = Новый ЗаписьТекста(Путь, КодировкаТекста.UTF8);
	Файл.Записать(Запись.Закрыть());
	Файл.Закрыть();

КонецПроцедуры

#КонецОбласти
