#Использовать 1commands

&Опция(Имя = "engine-root e", Описание = "Каталог исходников OneScript")
Перем КаталогИсходников;

#Область ОбработчикиСобытий

&ПодкомандаПриложения(Имя = "refresh-source rs", Описание = "Обновляет статические отчеты")
Процедура ПриСозданииОбъекта()
КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

&ВыполнениеКоманды
Процедура ОбновитьИсходники() Экспорт

	КаталогПроб = Новый Файл(ОбъединитьПути(ТекущийСценарий().Каталог, "../..")).ПолноеИмя;

	Если ПустаяСтрока(КаталогИсходников) Тогда
		КаталогИсходников = Новый Файл(ОбъединитьПути(КаталогПроб, "../../OneScript")).ПолноеИмя;
	Иначе
		КаталогИсходников = Новый Файл(КаталогИсходников).ПолноеИмя;
	КонецЕсли;

	Если Не Новый Файл(КаталогИсходников).Существует() Тогда
		ВызватьИсключение "Не найдены исходники OneScript: " + КаталогИсходников;
	КонецЕсли;

	ПутьКПроектуВебСервера = ОбъединитьПути(
		КаталогИсходников,
		"src",
		"OneScript.Web.Server",
		"OneScript.Web.Server.csproj"
	);

	Если Не Новый Файл(ПутьКПроектуВебСервера).Существует() Тогда
		ВызватьИсключение "Не найден проект веб-сервера OneScript: " + ПутьКПроектуВебСервера;
	КонецЕсли;

	КаталогДанных = ОбъединитьПути(КаталогПроб, "data");
	Идентификатор = СтрЗаменить(Строка(Новый УникальныйИдентификатор), "-", "");
	КаталогПодготовки = ОбъединитьПути(КаталогДанных, ".refresh-" + Идентификатор);

	СоздатьКаталог(КаталогПодготовки);

	Попытка

		ВнешняяКоманда = Новый Команда;
		ВнешняяКоманда.УстановитьКоманду("dotnet");
		ВнешняяКоманда.ДобавитьПараметр("build");
		ВнешняяКоманда.ДобавитьПараметр(ВнешняяКоманда.ОбернутьВКавычки(ПутьКПроектуВебСервера));
		ВнешняяКоманда.ДобавитьПараметр("-c");
		ВнешняяКоманда.ДобавитьПараметр("Release");
		ВнешняяКоманда.УстановитьРабочийКаталог(КаталогИсходников);
		ВнешняяКоманда.УстановитьИсполнениеЧерезКомандыСистемы(Ложь);
		ВнешняяКоманда.УстановитьПравильныйКодВозврата(0);
		ВнешняяКоманда.Исполнить();

		АнализаторИсходников = Новый АнализаторОшибокИсходников;
		АнализаторИсходников.Сформировать(
			КаталогИсходников,
			ОбъединитьПути(КаталогПодготовки, "source-error-report.json")
		);

		АнализаторГраниц = Новый АнализаторВнешнихГраниц;
		АнализаторГраниц.Сформировать(
			КаталогПроб,
			КаталогИсходников,
			ОбъединитьПути(КаталогПодготовки, "external-call-boundaries.json")
		);

		Проверка = Новый ПроверкаДанныхПроб;
		Проверка.ПроверитьФайл(ОбъединитьПути(КаталогПодготовки, "source-error-report.json"), "SourceReport");
		Проверка.ПроверитьВнешниеГраницы(
			КаталогПроб,
			ОбъединитьПути(КаталогПодготовки, "external-call-boundaries.json"),
			ОбъединитьПути(КаталогДанных, "external-call-boundary-review.json")
		);

		Имена = Новый Массив;
		Имена.Добавить("source-error-report.json");
		Имена.Добавить("external-call-boundaries.json");

		Публикация = Новый ОбновлениеRuntimeДанныхПроб;
		Публикация.Опубликовать(КаталогПодготовки, КаталогДанных, Имена);

	Исключение
		УдалитьФайлы(КаталогПодготовки);
		ВызватьИсключение;
	КонецПопытки;

	УдалитьФайлы(КаталогПодготовки);

КонецПроцедуры

#КонецОбласти
