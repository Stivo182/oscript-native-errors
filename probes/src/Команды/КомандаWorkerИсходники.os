&Опция(Имя = "engine-root", Описание = "Каталог исходников OneScript")
Перем КаталогИсходников;

&Опция(Имя = "source-directory", Описание = "Каталог исходников для анализа")
Перем КаталогИсходниковДляАнализа;

&Опция(Имя = "output-file", Описание = "Путь к JSON-отчету")
Перем ПутьКОтчету;

#Область ОбработчикиСобытий

&СкрытьВСправке
&ПодкомандаПриложения(Имя = "source-errors", Описание = "Формирует статический отчет")
Процедура ПриСозданииОбъекта()
КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

&ВыполнениеКоманды
Процедура СформироватьОтчет() Экспорт

	Если ПустаяСтрока(ПутьКОтчету) Тогда
		ВызватьИсключение "Для worker source-errors укажите --output-file";
	КонецЕсли;

	Анализатор = Новый АнализаторОшибокИсходников;
	Если Не ПустаяСтрока(КаталогИсходниковДляАнализа) Тогда
		КаталогиИсходников = Новый Массив;
		КаталогиИсходников.Добавить(КаталогИсходниковДляАнализа);
		Анализатор.СформироватьПоКаталогам(КаталогиИсходников, ПутьКОтчету);
	Иначе
		Анализатор.Сформировать(КаталогИсходников, ПутьКОтчету);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти
