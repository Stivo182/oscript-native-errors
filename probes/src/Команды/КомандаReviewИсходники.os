&Опция(Имя = "limit l", Описание = "Максимальное число элементов")
&ТЧисло
&ПоУмолчанию(50)
Перем Лимит; // Число

&Опция(Имя = "include-reviewed", Описание = "Включать рассмотренные сигнатуры")
&ТБулево
&ПоУмолчанию(Ложь)
Перем ВключаяРассмотренные; // Булево

#Область ОбработчикиСобытий

&ПодкомандаПриложения(Имя = "source s", Описание = "Показывает очередь сигнатур исходников")
Процедура ПриСозданииОбъекта()
КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

&ВыполнениеКоманды
Процедура ОбработатьКоманду() Экспорт

	ПоказатьОчередьИсходников();

КонецПроцедуры

Процедура ПоказатьОчередьИсходников(КаталогПробДляВызова = Неопределено, ЛимитДляВызова = Неопределено) Экспорт

	КаталогПроб = КаталогПробДляВызова;
	Если КаталогПроб = Неопределено Тогда
		КаталогПроб = Новый Файл(ОбъединитьПути(ТекущийСценарий().Каталог, "../..")).ПолноеИмя;
	КонецЕсли;

	ЛимитОчереди = ЛимитДляВызова;
	Если ЛимитОчереди = Неопределено Тогда
		ЛимитОчереди = Лимит;
	КонецЕсли;

	КаталогДанных = ОбъединитьПути(КаталогПроб, "data");
	ПутьКОтчету = ОбъединитьПути(КаталогДанных, "source-error-report.json");
	ПутьКЖурналу = ОбъединитьПути(КаталогДанных, "source-error-review.json");

	Проверка = Новый ПроверкаДанныхПроб;
	Проверка.ПроверитьФайл(ПутьКОтчету, "SourceReport");
	Проверка.ПроверитьФайл(ПутьКЖурналу, "SourceReview");

	Элементы = Новый ОчередьОшибокИсходников().ПолучитьЭлементы(
		ПутьКОтчету,
		ПутьКЖурналу,
		ЛимитОчереди,
		ВключаяРассмотренные
	);

	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Элементы);

	Сообщить(Запись.Закрыть());

КонецПроцедуры

#КонецОбласти
