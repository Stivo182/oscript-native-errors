&Опция(Имя = "limit l", Описание = "Максимальное число элементов")
&ТЧисло
&ПоУмолчанию(50)
Перем Лимит; // Число

&Опция(Имя = "include-reviewed", Описание = "Включать рассмотренные границы")
&ТБулево
&ПоУмолчанию(Ложь)
Перем ВключаяРассмотренные; // Булево

&Опция(Имя = "orphans", Описание = "Показать осиротевшие решения")
&ТБулево
&ПоУмолчанию(Ложь)
Перем ПоказатьОсиротевшие; // Булево

&Опция(Имя = "remove-not-applicable-orphans", Описание = "Удалить осиротевшие решения NotApplicable")
&ТБулево
&ПоУмолчанию(Ложь)
Перем УдалитьОсиротевшиеНеприменимые; // Булево

#Область ОбработчикиСобытий

&ПодкомандаПриложения(Имя = "external e", Описание = "Показывает очередь внешних границ")
Процедура ПриСозданииОбъекта()
КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

&ВыполнениеКоманды
Процедура ПоказатьОчередьВнешнихГраниц() Экспорт

	КаталогПроб = Новый Файл(ОбъединитьПути(ТекущийСценарий().Каталог, "../..")).ПолноеИмя;
	КаталогДанных = ОбъединитьПути(КаталогПроб, "data");
	Режим = ПолучитьРежим();

	Сообщить(Новый ОчередьВнешнихГраниц().ПолучитьЭлементы(
		КаталогПроб,
		ОбъединитьПути(КаталогДанных, "external-call-boundaries.json"),
		ОбъединитьПути(КаталогДанных, "external-call-boundary-review.json"),
		Лимит,
		Режим
	));

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПолучитьРежим()

	Режимы = Новый Массив;

	Если ВключаяРассмотренные Тогда
		Режимы.Добавить("--include-reviewed");
	КонецЕсли;

	Если ПоказатьОсиротевшие Тогда
		Режимы.Добавить("--orphans");
	КонецЕсли;

	Если УдалитьОсиротевшиеНеприменимые Тогда
		Режимы.Добавить("--remove-not-applicable-orphans");
	КонецЕсли;

	Если Режимы.Количество() > 1 Тогда
		ВызватьИсключение "Опции include-reviewed, orphans и remove-not-applicable-orphans взаимоисключающие";
	КонецЕсли;

	Если Режимы.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;

	Возврат Режимы[0];

КонецФункции

#КонецОбласти
