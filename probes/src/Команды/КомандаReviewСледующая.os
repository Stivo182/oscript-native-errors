#Область ОбработчикиСобытий

&ПодкомандаПриложения(Имя = "next n", Описание = "Показывает следующие нерассмотренные элементы")
Процедура ПриСозданииОбъекта()
КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

&ВыполнениеКоманды
Процедура ОбработатьКоманду() Экспорт

	ПоказатьСледующиеЭлементы();

КонецПроцедуры

Процедура ПоказатьСледующиеЭлементы(
	КаталогПробДляВызова = Неопределено,
	КаталогИнструментовДляВызова = Неопределено
) Экспорт

	КаталогПроб = КаталогПробДляВызова;
	Если КаталогПроб = Неопределено Тогда
		КаталогПроб = Новый Файл(ОбъединитьПути(ТекущийСценарий().Каталог, "../..")).ПолноеИмя;
	КонецЕсли;

	КаталогИнструментов = КаталогИнструментовДляВызова;
	Если КаталогИнструментов = Неопределено Тогда
		КаталогИнструментов = КаталогПроб;
	КонецЕсли;

	КаталогДанных = ОбъединитьПути(КаталогПроб, "data");
	ПутьКОтчетуИсходников = ОбъединитьПути(КаталогДанных, "source-error-report.json");
	ПутьКЖурналуИсходников = ОбъединитьПути(КаталогДанных, "source-error-review.json");
	ПутьКОтчетуГраниц = ОбъединитьПути(КаталогДанных, "external-call-boundaries.json");
	ПутьКЖурналуГраниц = ОбъединитьПути(КаталогДанных, "external-call-boundary-review.json");
	ПутьКОтчетуВыполнения = ОбъединитьПути(КаталогДанных, "onescript-test-error-results.json");
	ПутьКОтчетуМатрицы = ОбъединитьПути(КаталогДанных, "base-type-error-matrix-results.json");

	Проверка = Новый ПроверкаДанныхПроб;
	Проверка.ПроверитьФайл(ПутьКОтчетуИсходников, "SourceReport");
	Проверка.ПроверитьФайл(ПутьКЖурналуИсходников, "SourceReview");
	Проверка.ПроверитьФайл(ПутьКОтчетуВыполнения, "RuntimeReport");
	Проверка.ПроверитьФайл(ПутьКОтчетуМатрицы, "MatrixReport");
	Проверка.ПроверитьВнешниеГраницы(КаталогИнструментов, ПутьКОтчетуГраниц, ПутьКЖурналуГраниц);

	ОчередьИсходников = Новый ОчередьОшибокИсходников;
	ОсиротевшиеИсходники = Проверка.ПолучитьОсиротевшиеРешения(
		ПутьКОтчетуИсходников,
		ПутьКЖурналуИсходников
	);

	Если ОсиротевшиеИсходники.Количество() > 0 Тогда
		Сообщить("Осиротевшие решения по исходникам:");
		Сообщить(ЗаписатьЭлементыJSON(ОсиротевшиеИсходники));
	КонецЕсли;

	ОсиротевшиеГраницы = Новый ОчередьВнешнихГраниц().ПолучитьЭлементы(
		КаталогИнструментов,
		ПутьКОтчетуГраниц,
		ПутьКЖурналуГраниц,
		1,
		"--orphans"
	);

	Если СокрЛП(ОсиротевшиеГраницы) <> "[]" Тогда
		Сообщить("Осиротевшие решения по внешним границам:");
		Сообщить(ОсиротевшиеГраницы);
	КонецЕсли;

	Сообщить("Следующая сигнатура ошибки исходников:");
	Сообщить(ЗаписатьЭлементыJSON(
		ОчередьИсходников.ПолучитьЭлементы(
			ПутьКОтчетуИсходников,
			ПутьКЖурналуИсходников,
			1
		)
	));
	Сообщить("Следующая граница внешнего вызова:");
	Сообщить(Новый ОчередьВнешнихГраниц().ПолучитьЭлементы(
		КаталогИнструментов,
		ПутьКОтчетуГраниц,
		ПутьКЖурналуГраниц,
		1
	));

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ЗаписатьЭлементыJSON(Элементы)

	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Элементы);

	Возврат Запись.Закрыть();

КонецФункции

#КонецОбласти
