#Использовать 1commands

#Область ПрограммныйИнтерфейс

// Формирует общую матрицу для русской и английской локалей.
//
// Параметры:
//   КаталогПроб - Строка - каталог probes.
//   КаталогПроекта - Строка - корень native-errors.
//   ПутьКОтчету - Строка - путь создаваемого JSON-отчета.
//   ПутьКOneScript - Строка - исполняемый файл исследуемой версии OneScript.
Процедура Сформировать(КаталогПроб, КаталогПроекта, ПутьКОтчету, ПутьКOneScript) Экспорт

	Локали = Новый Массив;
	Локали.Добавить("ru");
	Локали.Добавить("en");

	ОтчетыЛокалей = Новый Массив;

	Для Каждого Локаль Из Локали Цикл
		ВременныйОтчет = ПолучитьИмяВременногоФайла("json");

		Попытка
			ЗапуститьМатрицуЛокали(
				ПутьКOneScript,
				КаталогПроб,
				ОбъединитьПути(КаталогПроекта, "tests", "locales", Локаль),
				ВременныйОтчет
			);

			ОтчетЛокали = ПрочитатьJSONИзФайла(ВременныйОтчет);
			Если ОтчетЛокали.Locale <> Локаль Тогда
				ВызватьИсключение "Неожиданная локаль в отчете матрицы: " + ОтчетЛокали.Locale;
			КонецЕсли;

			ОтчетыЛокалей.Добавить(ОтчетЛокали);
		Исключение
			УдалитьФайлы(ВременныйОтчет);
			ВызватьИсключение;
		КонецПопытки;

		УдалитьФайлы(ВременныйОтчет);
	КонецЦикла;

	Система = Новый СистемнаяИнформация;
	
	Отчет = Новый Структура;
	Отчет.Вставить("SchemaVersion", 1);
	Отчет.Вставить("RuntimeVersion", ПолучитьВерсиюRuntime(ПутьКOneScript));
	Отчет.Вставить("Environment", Новый Структура("OperatingSystem, DotNetVersion", Система.ВерсияОС, ""));
	Отчет.Вставить("Locales", ОтчетыЛокалей);
	Отчет.Вставить("LocaleCount", ОтчетыЛокалей.Количество());
	Отчет.Вставить("ScenarioCount", ОтчетыЛокалей[0].ScenarioCount);
	Отчет.Вставить("ClassifiedCount", ПолучитьСчетчик(ОтчетыЛокалей, "ClassifiedCount"));
	Отчет.Вставить("UnclassifiedCount", ПолучитьСчетчик(ОтчетыЛокалей, "UnclassifiedCount"));
	Отчет.Вставить("SuccessCount", ПолучитьСчетчик(ОтчетыЛокалей, "SuccessCount"));
	Отчет.Вставить("RuntimeFailureCount", ПолучитьСчетчик(ОтчетыЛокалей, "RuntimeFailureCount"));
	
	ЗаписатьJSONВФайл(ПутьКОтчету, Отчет);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПрочитатьТекст(Путь)

	Чтение = Новый ЧтениеТекста(Путь, КодировкаТекста.UTF8);
	Текст = Чтение.Прочитать();
	Чтение.Закрыть();

	Возврат Текст;

КонецФункции

Функция ПрочитатьJSONИзФайла(Путь)

	Чтение = Новый ЧтениеJSON;
	Чтение.ОткрытьФайл(Путь);
	Данные = ПрочитатьJSON(Чтение);
	Чтение.Закрыть();

	Возврат Данные;

КонецФункции

Процедура ЗаписатьJSONВФайл(Путь, Данные)

	Запись = Новый ЗаписьJSON;
	Запись.ОткрытьФайл(Путь);
	ЗаписатьJSON(Запись, Данные);
	Запись.Закрыть();

КонецПроцедуры

Процедура ЗапуститьМатрицуЛокали(ПутьКOneScript, КаталогПроб, КаталогЛокали, ПутьКОтчету)

	ИсходнаяКонфигурация = ПолучитьПеременнуюСреды("OSCRIPT_CONFIG");
	Попытка
		Конфигурация = СтрСоединить(
			СтрРазделить(СтрЗаменить(ПрочитатьТекст(ОбъединитьПути(КаталогЛокали, "oscript.cfg")), Символы.ВК, ""), Символы.ПС),
			";"
		);
		УстановитьПеременнуюСреды("OSCRIPT_CONFIG", Конфигурация);
		ПутьКБиблиотеке = СтрЗаменить(ОбъединитьПути(КаталогПроб, "src"), "\", "/");
		КодЗапуска = "#Использовать """ + ПутьКБиблиотеке + """" + Символы.ПС
			+ "Матрица = Новый МатрицаОшибокБазовыхТипов;" + Символы.ПС
			+ "Матрица.Сформировать(АргументыКоманднойСтроки[0]);";

		ВнешняяКоманда = Новый Команда;
		ВнешняяКоманда.УстановитьКоманду(ПутьКOneScript);
		ВнешняяКоманда.ДобавитьПараметр("-encoding=utf-8");
		ВнешняяКоманда.ДобавитьПараметр("-c");
		ВнешняяКоманда.ДобавитьПараметр(ВнешняяКоманда.ОбернутьВКавычки(КодЗапуска));
		ВнешняяКоманда.ДобавитьПараметр(ВнешняяКоманда.ОбернутьВКавычки(ПутьКОтчету));
		ВнешняяКоманда.УстановитьРабочийКаталог(КаталогЛокали);
		ВнешняяКоманда.УстановитьИсполнениеЧерезКомандыСистемы(Ложь);
		ВнешняяКоманда.УстановитьПравильныйКодВозврата(0);
		ВнешняяКоманда.Исполнить();
	Исключение
		УстановитьПеременнуюСреды("OSCRIPT_CONFIG", ИсходнаяКонфигурация);
		ВызватьИсключение;
	КонецПопытки;

	УстановитьПеременнуюСреды("OSCRIPT_CONFIG", ИсходнаяКонфигурация);

КонецПроцедуры

Функция ПолучитьВерсиюRuntime(ПутьКOneScript)

	ВнешняяКоманда = Новый Команда;
	ВнешняяКоманда.УстановитьКоманду(ПутьКOneScript);
	ВнешняяКоманда.ДобавитьПараметр("-version");
	ВнешняяКоманда.УстановитьРабочийКаталог(ТекущийСценарий().Каталог);
	ВнешняяКоманда.УстановитьИсполнениеЧерезКомандыСистемы(Ложь);

	КодВозврата = ВнешняяКоманда.Исполнить();
	Если КодВозврата <> 0 Тогда
		ВызватьИсключение "Не удалось определить версию OneScript: " + ВнешняяКоманда.ПолучитьВывод();
	КонецЕсли;

	Возврат СокрЛП(ВнешняяКоманда.ПолучитьВывод());

КонецФункции

Функция ПолучитьСчетчик(Отчеты, ИмяСчетчика)

	Результат = 0;
	Для Каждого Отчет Из Отчеты Цикл
		Для Каждого СтрокаРезультата Из Отчет.Results Цикл
			Если СтрокаРезультата.Status = СтрЗаменить(ИмяСчетчика, "Count", "") Тогда
				Результат = Результат + 1;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Возврат Результат;

КонецФункции

#КонецОбласти

