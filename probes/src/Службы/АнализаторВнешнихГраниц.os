#Использовать 1commands

#Область ПрограммныйИнтерфейс

// Формирует отчет о внешних вызовах сборок OneScript.
//
// Параметры:
//   КаталогПроб - Строка - каталог probes.
//   КаталогИсходников - Строка - каталог исходников OneScript.
//   ПутьКОтчету - Строка - путь создаваемого JSON-отчета.
//
// Исключения:
//   Вызывает исключение при отсутствии сборок или ошибке анализатора.
Процедура Сформировать(КаталогПроб, КаталогИсходников, ПутьКОтчету) Экспорт

	КаталогИсходников = Новый Файл(КаталогИсходников).ПолноеИмя;
	ПутьКОтчету = Новый Файл(ПутьКОтчету).ПолноеИмя;
	КаталогСборок = ОбъединитьПути(
		ОбъединитьПути(
			ОбъединитьПути(КаталогИсходников, "src"),
			"OneScript.Web.Server"
		),
		"bin/Release/net8.0"
	);

	СборкиВхода = Новый Массив;
	СборкиВхода.Добавить("OneScript.Core");
	СборкиВхода.Добавить("OneScript.Native");
	СборкиВхода.Добавить("OneScript.StandardLibrary");
	СборкиВхода.Добавить("OneScript.Web.Server");

	Для Каждого ИмяСборки Из СборкиВхода Цикл
		Если Не Новый Файл(ОбъединитьПути(КаталогСборок, ИмяСборки + ".dll")).Существует() Тогда
			ВызватьИсключение "Не найдена входная сборка: " + ИмяСборки;
		КонецЕсли;
	КонецЦикла;

	ПутьКПроекту = ОбъединитьПути(КаталогПроб, "tools", "ExternalCallBoundaryAnalyzer");
	ВременныйОтчет = ПолучитьИмяВременногоФайла("json");
	Состояние = ПолучитьСостояниеИсходников(КаталогИсходников);

	ВнешняяКоманда = Новый Команда;
	ВнешняяКоманда.УстановитьКоманду("dotnet");
	ВнешняяКоманда.ДобавитьПараметр("run");
	ВнешняяКоманда.ДобавитьПараметр("--project");
	ВнешняяКоманда.ДобавитьПараметр(ВнешняяКоманда.ОбернутьВКавычки(ПутьКПроекту));
	ВнешняяКоманда.ДобавитьПараметр("--verbosity");
	ВнешняяКоманда.ДобавитьПараметр("quiet");
	ВнешняяКоманда.ДобавитьПараметр("--");
	ВнешняяКоманда.ДобавитьПараметр("--assembly-directory");
	ВнешняяКоманда.ДобавитьПараметр(ВнешняяКоманда.ОбернутьВКавычки(КаталогСборок));
	ВнешняяКоманда.ДобавитьПараметр("--output");
	ВнешняяКоманда.ДобавитьПараметр(ВнешняяКоманда.ОбернутьВКавычки(ВременныйОтчет));
	ВнешняяКоманда.ДобавитьПараметр("--source-dirty");
	ВнешняяКоманда.ДобавитьПараметр(?(Состояние.Dirty, "true", "false"));
	ВнешняяКоманда.ДобавитьПараметр("--operating-system");
	ВнешняяКоманда.ДобавитьПараметр(ВнешняяКоманда.ОбернутьВКавычки(ПолучитьВерсиюОС()));

	Если НЕ ПустаяСтрока(Состояние.Revision) Тогда
		ВнешняяКоманда.ДобавитьПараметр("--source-revision");
		ВнешняяКоманда.ДобавитьПараметр(ВнешняяКоманда.ОбернутьВКавычки(Состояние.Revision));
	КонецЕсли;

	Для Каждого ИмяСборки Из СборкиВхода Цикл
		ВнешняяКоманда.ДобавитьПараметр("--entry-assembly");
		ВнешняяКоманда.ДобавитьПараметр(ВнешняяКоманда.ОбернутьВКавычки(ИмяСборки));
	КонецЦикла;

	Для Каждого ИмяСборки Из ПолучитьВнутренниеСборки(КаталогСборок) Цикл
		ВнешняяКоманда.ДобавитьПараметр("--internal-assembly");
		ВнешняяКоманда.ДобавитьПараметр(ВнешняяКоманда.ОбернутьВКавычки(ИмяСборки));
	КонецЦикла;

	Попытка
		ВнешняяКоманда.УстановитьРабочийКаталог(КаталогПроб);
		ВнешняяКоманда.УстановитьИсполнениеЧерезКомандыСистемы(Ложь);
		ВнешняяКоманда.УстановитьПравильныйКодВозврата(0);
		ВнешняяКоманда.Исполнить();

		КопироватьФайл(ВременныйОтчет, ПутьКОтчету);
	Исключение
		УдалитьФайлы(ВременныйОтчет);
		ВызватьИсключение;
	КонецПопытки;

	УдалитьФайлы(ВременныйОтчет);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПолучитьСостояниеИсходников(Каталог)

	Ревизия = "";
	Изменены = Ложь;

	ВнешняяКоманда = Новый Команда;
	ВнешняяКоманда.УстановитьКоманду("git");
	ВнешняяКоманда.ДобавитьПараметр("-C");
	ВнешняяКоманда.ДобавитьПараметр(ВнешняяКоманда.ОбернутьВКавычки(Каталог));
	ВнешняяКоманда.ДобавитьПараметр("rev-parse");
	ВнешняяКоманда.ДобавитьПараметр("HEAD");
	ВнешняяКоманда.УстановитьРабочийКаталог(Каталог);
	ВнешняяКоманда.УстановитьИсполнениеЧерезКомандыСистемы(Ложь);
	
	КодВозврата = ВнешняяКоманда.Исполнить();
	Если КодВозврата <> 0 Тогда
		ВызватьИсключение "Не удалось определить ревизию исходников: "
			+ СокрЛП(ВнешняяКоманда.ПолучитьВывод());
	КонецЕсли;

	Ревизия = СокрЛП(ВнешняяКоманда.ПолучитьВывод());

	ВнешняяКоманда = Новый Команда;
	ВнешняяКоманда.УстановитьКоманду("git");
	ВнешняяКоманда.ДобавитьПараметр("-C");
	ВнешняяКоманда.ДобавитьПараметр(ВнешняяКоманда.ОбернутьВКавычки(Каталог));
	ВнешняяКоманда.ДобавитьПараметр("status");
	ВнешняяКоманда.ДобавитьПараметр("--porcelain");
	ВнешняяКоманда.УстановитьРабочийКаталог(Каталог);
	ВнешняяКоманда.УстановитьИсполнениеЧерезКомандыСистемы(Ложь);
	
	КодВозврата = ВнешняяКоманда.Исполнить();
	Если КодВозврата <> 0 Тогда
		ВызватьИсключение "Не удалось определить состояние исходников: "
			+ СокрЛП(ВнешняяКоманда.ПолучитьВывод());
	КонецЕсли;

	Изменены = Не ПустаяСтрока(СокрЛП(ВнешняяКоманда.ПолучитьВывод()));

	Возврат Новый Структура("Revision,Dirty", Ревизия, Изменены);

КонецФункции

Функция ПолучитьВнутренниеСборки(КаталогСборок)

	Результат = Новый Массив;
	Для Каждого ФайлСборки Из НайтиФайлы(КаталогСборок, "*.dll") Цикл
		Имя = ФайлСборки.ИмяБезРасширения;
		Если Лев(Имя, 9) = "OneScript" Или Имя = "ScriptEngine" Тогда
			Результат.Добавить(Имя);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ПолучитьВерсиюОС()

	Система = Новый СистемнаяИнформация;
	Возврат Система.ВерсияОС;

КонецФункции

#КонецОбласти
