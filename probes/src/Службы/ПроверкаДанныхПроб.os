#Область ПрограммныйИнтерфейс

// Проверяет JSON-файл данных проб по указанному контракту.
//
// Параметры:
//   Путь - Строка - путь к JSON-файлу.
//   Вид - Строка - SourceReport, SourceReview, RuntimeReport или MatrixReport.
//
// Исключения:
//   Вызывает исключение, если файл отсутствует, JSON некорректен или контракт нарушен.
Процедура ПроверитьФайл(Путь, Вид) Экспорт

	ПроверитьЦелочисленныеТокены(Путь, Вид);
	Документ = ПрочитатьДокументJSON(Путь);
	Если Вид = "SourceReport" Тогда
		ПроверитьОтчетИсходников(Документ);
	ИначеЕсли Вид = "SourceReview" Тогда
		ПроверитьЖурналИсходников(Документ);
	ИначеЕсли Вид = "RuntimeReport" Тогда
		ПроверитьRuntimeОтчет(Документ);
	ИначеЕсли Вид = "MatrixReport" Тогда
		ПроверитьОтчетМатрицы(Документ);
	Иначе
		ВызватьИсключение "Unknown probe data kind: " + Вид;
	КонецЕсли;

КонецПроцедуры

// Возвращает решения, для которых в текущем отчете больше нет сигнатуры.
//
// Параметры:
//   ПутьКОтчету - Строка - путь к source-error-report.json.
//   ПутьКЖурналу - Строка - путь к source-error-review.json.
//
// Возвращаемое значение:
//   Массив - осиротевшие записи Reviewed.
//
// Исключения:
//   Вызывает исключение, если файл отсутствует, JSON некорректен или контракт нарушен.
Функция ПолучитьОсиротевшиеРешения(ПутьКОтчету, ПутьКЖурналу) Экспорт

	ПроверитьФайл(ПутьКОтчету, "SourceReport");
	ПроверитьФайл(ПутьКЖурналу, "SourceReview");

	Отчет = ПрочитатьДокументJSON(ПутьКОтчету);
	Журнал = ПрочитатьДокументJSON(ПутьКЖурналу);

	КлючиОтчета = Новый Соответствие;

	Для Каждого ИмяКоллекции Из ИменаКоллекцийСигнатур() Цикл
		Для Каждого Запись Из Отчет[ИмяКоллекции] Цикл
			КлючиОтчета.Вставить(НРег(КлючСигнатуры(Запись)), Истина);
		КонецЦикла;
	КонецЦикла;

	Результат = Новый Массив;
	Для Каждого Запись Из Журнал.Reviewed Цикл
		Если КлючиОтчета.Получить(НРег(КлючСигнатуры(Запись))) = Неопределено Тогда
			Результат.Добавить(Запись);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Проверяет отчет и журнал внешних границ потоковым .NET-анализатором.
//
// Параметры:
//   КаталогПроб - Строка - каталог probes.
//   ПутьКОтчету - Строка - путь к external-call-boundaries.json.
//   ПутьКЖурналу - Строка - путь к external-call-boundary-review.json.
//
// Исключения:
//   Вызывает исключение при нарушении контракта или ошибке процесса dotnet.
Процедура ПроверитьВнешниеГраницы(КаталогПроб, ПутьКОтчету, ПутьКЖурналу) Экспорт

	Очередь = Новый ОчередьВнешнихГраниц;
	Очередь.ПолучитьЭлементы(КаталогПроб, ПутьКОтчету, ПутьКЖурналу, 50, "--validate");

КонецПроцедуры

// Проверяет точную форму матрицы операций над базовыми типами.
//
// Параметры:
//   Отчет - Структура - отчет для одной локали.
//   Контекст - Строка - описание отчета для сообщений об ошибках.
//
// Исключения:
//   Вызывает исключение, если набор типов, операций или декартовых комбинаций неполон.
Процедура ПроверитьФормуМатрицы(Отчет, Контекст) Экспорт

	ОжидаемыеТипы = МассивСтрок("Неопределено|Null|Булево|Число|Строка|Дата|Тип");
	ОпределенияОпераций = Новый Структура;
	ОпределенияОпераций.Вставить("Unary", МассивСтрок("+|-|Не"));
	ОпределенияОпераций.Вставить("Arithmetic", МассивСтрок("+|-|*|/|%"));
	ОпределенияОпераций.Вставить("Comparison", МассивСтрок("=|<>|<|<=|>|>="));
	ОпределенияОпераций.Вставить("Conversion", МассивСтрок("Булево|Число|Строка|Дата"));
	ОпределенияОпераций.Вставить("Index", МассивСтрок("[]"));
	ОпределенияОпераций.Вставить("Property", МассивСтрок("НесуществующееСвойство"));
	ОпределенияОпераций.Вставить("Method", МассивСтрок("НесуществующийМетод()"));

	ИменаТипов = Новый Массив;
	Для Каждого ОписаниеТипа Из Отчет.Types Цикл
		ИменаТипов.Добавить(ОписаниеТипа.Name);
	КонецЦикла;

	ПроверитьТочныеЗначения(ИменаТипов, ОжидаемыеТипы, "type", Контекст);

	ОжидаемыеГруппы = Новый Массив;
	Для Каждого Определение Из ОпределенияОпераций Цикл
		ОжидаемыеГруппы.Добавить(Определение.Ключ);
	КонецЦикла;

	ПроверитьТочныеЗначения(Отчет.Groups, ОжидаемыеГруппы, "group", Контекст);

	ПроверитьОсобуюСтроку(
		Отчет.Results,
		"Деление на ноль",
		"1 / 0",
		"/",
		ОжидаемыеТипы[3],
		Контекст
	);
	ПроверитьОсобуюСтроку(
		Отчет.Results,
		"Остаток от деления на ноль",
		"1 % 0",
		"%",
		ОжидаемыеТипы[3],
		Контекст
	);

	РегулярныеРезультаты = Новый Массив;
	Для Каждого Результат Из Отчет.Results Цикл
		Если Результат.Expression <> "1 / 0" И Результат.Expression <> "1 % 0" Тогда
			РегулярныеРезультаты.Добавить(Результат);
		КонецЕсли;
	КонецЦикла;

	Если РегулярныеРезультаты.Количество() <> 609 Тогда
		ВызватьИсключение Контекст + " has " + РегулярныеРезультаты.Количество()
			+ " regular matrix rows; expected 609";
	КонецЕсли;

	Для Каждого Определение Из ОпределенияОпераций Цикл
		Группа = Определение.Ключ;
		Операции = Определение.Значение;

		ФактическиеОперации = ПолучитьУникальныеОперации(РегулярныеРезультаты, Группа);
		ПроверитьТочныеЗначения(ФактическиеОперации, Операции, "operation", Контекст + " group '" + Группа + "'");

		ПравыеТипы = Новый Массив;
		Если Группа = "Arithmetic" Или Группа = "Comparison" Тогда
			Для Каждого ИмяТипа Из ОжидаемыеТипы Цикл
				ПравыеТипы.Добавить(ИмяТипа);
			КонецЦикла;
		Иначе
			ПравыеТипы.Добавить("");
		КонецЕсли;

		Для Каждого Операция Из Операции Цикл
			Для Каждого ЛевыйТип Из ОжидаемыеТипы Цикл
				Для Каждого ПравыйТип Из ПравыеТипы Цикл
					ПроверитьКомбинацию(
						РегулярныеРезультаты,
						Группа,
						Операция,
						ЛевыйТип,
						ПравыйТип,
						Контекст
					);
				КонецЦикла;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПрочитатьДокументJSON(Путь)

	Если Не Новый Файл(Путь).Существует() Тогда
		ВызватьИсключение "Probe data file was not found: " + Путь;
	КонецЕсли;

	Чтение = Новый ЧтениеJSON;
	Попытка
		Чтение.ОткрытьФайл(Путь);
		Документ = ПрочитатьJSON(Чтение);
		Чтение.Закрыть();
	Исключение
		Попытка
			Чтение.Закрыть();
		Исключение
		КонецПопытки;
		ВызватьИсключение "Probe data file contains invalid JSON: " + Путь + ". " + ОписаниеОшибки();
	КонецПопытки;

	Возврат Документ;

КонецФункции

Процедура ПроверитьЦелочисленныеТокены(Путь, Вид)

	Если Не Новый Файл(Путь).Существует() Тогда
		ВызватьИсключение "Probe data file was not found: " + Путь;
	КонецЕсли;

	ЧтениеТекста = Новый ЧтениеТекста(Путь, КодировкаТекста.UTF8);
	Текст = ЧтениеТекста.Прочитать();
	ЧтениеТекста.Закрыть();

	Строки = СтрРазделить(СтрЗаменить(Текст, Символы.ВК, ""), Символы.ПС, Истина);
	Чтение = Новый ЧтениеJSON;
	Нарушение = "";

	Попытка
		Чтение.УстановитьСтроку(Текст);
		Глубина = 0;
		ТекущееСвойство = "";

		Пока Чтение.Прочитать() Цикл
			ТипЗначения = Чтение.ТипТекущегоЗначения;
			Если ТипЗначения = ТипЗначенияJSON.НачалоОбъекта
				Или ТипЗначения = ТипЗначенияJSON.НачалоМассива Тогда
				Глубина = Глубина + 1;
				ТекущееСвойство = "";
			ИначеЕсли ТипЗначения = ТипЗначенияJSON.КонецОбъекта
				Или ТипЗначения = ТипЗначенияJSON.КонецМассива Тогда
				Глубина = Глубина - 1;
				ТекущееСвойство = "";
			ИначеЕсли ТипЗначения = ТипЗначенияJSON.ИмяСвойства Тогда
				ТекущееСвойство = Чтение.ТекущееЗначение;
			Иначе
				Если ТипЗначения = ТипЗначенияJSON.Число
					И ТребуетсяПроверкаЦелого(Вид, ТекущееСвойство, Глубина) Тогда
					СтрокаТокена = Строки[Чтение.ТекущаяСтрока - 1];
					Токен = ПолучитьЧисловойТокен(СтрокаТокена, Чтение.ТекущаяПозиция);
					Если Не КорректныйТокенInt64(Токен) Тогда
						Нарушение = КонтекстКонтракта(Вид) + " " + ТекущееСвойство
							+ " must be an Int32 or Int64";
						Прервать;
					КонецЕсли;
				КонецЕсли;

				ТекущееСвойство = "";
			КонецЕсли;
		КонецЦикла;

		Чтение.Закрыть();
	Исключение
		Попытка
			Чтение.Закрыть();
		Исключение
		КонецПопытки;
		ВызватьИсключение "Probe data file contains invalid JSON: " + Путь + ". " + ОписаниеОшибки();
	КонецПопытки;

	Если Не ПустаяСтрока(Нарушение) Тогда
		ВызватьИсключение Нарушение;
	КонецЕсли;

КонецПроцедуры

Функция ТребуетсяПроверкаЦелого(Вид, Свойство, Глубина)

	Если ПустаяСтрока(Свойство) Тогда
		Возврат Ложь;
	КонецЕсли;

	Если Вид = "SourceReport" И Глубина = 1 Тогда
		Имена = Новый Массив;
		Имена.Добавить("SchemaVersion");
		Имена.Добавить("ExceptionCount");
		Имена.Добавить("CaughtExceptionCount");
		Имена.Добавить("CandidateCount");
		Имена.Добавить("OperationalCandidateCount");
		Имена.Добавить("ProgrammingErrorCount");
		Имена.Добавить("UnknownThrowCount");

		Возврат Имена.Найти(Свойство) <> Неопределено;
	ИначеЕсли Вид = "SourceReview" И Глубина = 1 Тогда
		Возврат Свойство = "Version";
	ИначеЕсли Вид = "RuntimeReport" И Глубина = 1 Тогда
		Имена = Новый Массив;
		Имена.Добавить("SchemaVersion");
		Имена.Добавить("CandidateCount");
		Имена.Добавить("ClassifiedCount");
		Имена.Добавить("UnclassifiedCount");
		Имена.Добавить("NoExceptionCount");
		Имена.Добавить("NotObservedCount");
		Имена.Добавить("RuntimeFailureCount");

		Возврат Имена.Найти(Свойство) <> Неопределено;
	ИначеЕсли Вид = "MatrixReport" И Глубина = 1 Тогда
		Имена = Новый Массив;
		Имена.Добавить("SchemaVersion");
		Имена.Добавить("LocaleCount");
		Имена.Добавить("ScenarioCount");
		Имена.Добавить("ClassifiedCount");
		Имена.Добавить("UnclassifiedCount");
		Имена.Добавить("SuccessCount");
		Имена.Добавить("RuntimeFailureCount");

		Возврат Имена.Найти(Свойство) <> Неопределено;
	ИначеЕсли Вид = "MatrixReport" И Глубина = 3 Тогда
		Возврат Свойство = "TypeCount" Или Свойство = "GroupCount" Или Свойство = "ScenarioCount";
	КонецЕсли;

	Возврат Ложь;

КонецФункции

Функция ПолучитьЧисловойТокен(Текст, ТекущаяПозиция)

	Начало = ТекущаяПозиция;
	Цифры = "0123456789+-.eE";

	Пока Начало > 0 И СтрНайти(Цифры, Сред(Текст, Начало, 1)) > 0 Цикл
		Начало = Начало - 1;
	КонецЦикла;

	Возврат Сред(Текст, Начало + 1, ТекущаяПозиция - Начало);

КонецФункции

Функция КорректныйТокенInt64(Токен)

	Если Не Новый РегулярноеВыражение("^-?(?:0|[1-9][0-9]*)$").Совпадает(Токен) Тогда
		Возврат Ложь;
	КонецЕсли;

	Отрицательное = Лев(Токен, 1) = "-";
	Цифры = ?(Отрицательное, Сред(Токен, 2), Токен);
	Максимум = ?(Отрицательное, "9223372036854775808", "9223372036854775807");

	Если СтрДлина(Цифры) <> СтрДлина(Максимум) Тогда
		Возврат СтрДлина(Цифры) < СтрДлина(Максимум);
	КонецЕсли;

	Для Индекс = 1 По СтрДлина(Максимум) Цикл
		Цифра = Число(Сред(Цифры, Индекс, 1));
		ЦифраМаксимума = Число(Сред(Максимум, Индекс, 1));
		Если Цифра <> ЦифраМаксимума Тогда
			Возврат Цифра < ЦифраМаксимума;
		КонецЕсли;
	КонецЦикла;

	Возврат Истина;

КонецФункции

Функция КонтекстКонтракта(Вид)

	Если Вид = "SourceReport" Тогда
		Возврат "Source error report";
	ИначеЕсли Вид = "SourceReview" Тогда
		Возврат "Source review";
	ИначеЕсли Вид = "RuntimeReport" Тогда
		Возврат "Runtime report";
	ИначеЕсли Вид = "MatrixReport" Тогда
		Возврат "Matrix report";
	КонецЕсли;

	Возврат "Probe data";

КонецФункции

Процедура ПроверитьОтчетИсходников(Документ)

	Контекст = "Source error report";
	ПроверитьВерсию(Документ, "SchemaVersion", Контекст);

	Коллекции = Новый Структура;
	Коллекции.Вставить("UnknownThrows", "UnknownThrowCount");
	Коллекции.Вставить("OperationalCandidates", "OperationalCandidateCount");
	Коллекции.Вставить("ProgrammingErrors", "ProgrammingErrorCount");
	Коллекции.Вставить("Candidates", "CandidateCount");
	Коллекции.Вставить("CaughtExceptions", "CaughtExceptionCount");

	Для Каждого Коллекция Из Коллекции Цикл
		ПроверитьМассив(Документ, Коллекция.Ключ, Контекст);
		ПроверитьСчетчик(Документ, Коллекция.Значение, Коллекция.Ключ, Контекст);
	КонецЦикла;

	ПроверитьМассив(Документ, "SourceDirectories", Контекст);
	ПроверитьЦелоеСвойство(Документ, "ExceptionCount", Контекст);

	Если Документ.ExceptionCount <> Документ.CandidateCount + Документ.UnknownThrowCount Тогда
		ВызватьИсключение
			"Source error report ExceptionCount does not match candidate and unknown throw counts";
	КонецЕсли;

	ПоляСигнатуры = Новый Массив;
	ПоляСигнатуры.Добавить("File");
	ПоляСигнатуры.Добавить("Line");
	ПоляСигнатуры.Добавить("ExceptionType");
	ПоляСигнатуры.Добавить("Statement");

	ИменаКоллекций = Новый Массив;
	ИменаКоллекций.Добавить("UnknownThrows");
	ИменаКоллекций.Добавить("OperationalCandidates");
	ИменаКоллекций.Добавить("ProgrammingErrors");
	ИменаКоллекций.Добавить("Candidates");

	Для Каждого ИмяКоллекции Из ИменаКоллекций Цикл
		ПроверитьКлючиЗаписей(
			Документ[ИмяКоллекции],
			ПоляСигнатуры,
			Контекст + " " + ИмяКоллекции,
			Контекст + " " + ИмяКоллекции + " contains duplicate key"
		);
	КонецЦикла;

	ПоляПерехваченногоИсключения = Новый Массив;
	ПоляПерехваченногоИсключения.Добавить("File");
	ПоляПерехваченногоИсключения.Добавить("Line");
	ПоляПерехваченногоИсключения.Добавить("ExceptionType");

	ПроверитьКлючиЗаписей(
		Документ.CaughtExceptions,
		ПоляПерехваченногоИсключения,
		Контекст + " CaughtExceptions",
		Контекст + " CaughtExceptions contains duplicate key"
	);

	Если Документ.CandidateCount <>
		Документ.OperationalCandidateCount + Документ.ProgrammingErrorCount Тогда
		ВызватьИсключение "Source error report CandidateCount must equal categorized candidate counts";
	КонецЕсли;

	ПроверитьСоответствиеКатегорийКандидатов(Документ);

	Для Каждого ИмяКоллекции Из ИменаКоллекций Цикл
		Для Каждого Запись Из Документ[ИмяКоллекции] Цикл
			ПроверитьОбязательнуюСтроку(Запись, "OneScriptObject", Контекст);
			ПроверитьОбязательнуюСтроку(Запись, "OneScriptMethod", Контекст);
			ПроверитьОбязательнуюСтроку(Запись, "Disposition", Контекст);
			ПроверитьОбязательнуюСтроку(Запись, "Message", Контекст);
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

Процедура ПроверитьЖурналИсходников(Документ)

	Контекст = "Source review";
	ПроверитьВерсию(Документ, "Version", Контекст);
	ПроверитьМассив(Документ, "Reviewed", Контекст);

	Поля = Новый Массив;
	Поля.Добавить("File");
	Поля.Добавить("ExceptionType");
	Поля.Добавить("Statement");

	ПроверитьКлючиЗаписей(Документ.Reviewed, Поля, Контекст, "Duplicate reviewed signature");

	ДопустимыеСтатусы = Новый Массив;
	ДопустимыеСтатусы.Добавить("Unreviewed");
	ДопустимыеСтатусы.Добавить("Covered");
	ДопустимыеСтатусы.Добавить("NotApplicable");
	ДопустимыеСтатусы.Добавить("Implemented");
	ДопустимыеСтатусы.Добавить("Deferred");

	Для Каждого Запись Из Документ.Reviewed Цикл
		ПроверитьОбязательнуюСтроку(Запись, "Code", Контекст);
		ПроверитьОбязательнуюСтроку(Запись, "Note", Контекст);

		Статус = Неопределено;
		Если Не Запись.Свойство("Status", Статус) Или ДопустимыеСтатусы.Найти(Статус) = Неопределено Тогда
			ВызватьИсключение "Source review contains unknown status '" + Строка(Статус) + "'";
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура ПроверитьОбязательнуюСтроку(Запись, Свойство, Контекст)

	Значение = Неопределено;
	Если Не Запись.Свойство(Свойство, Значение) Или ТипЗнч(Значение) <> Тип("Строка") Тогда
		ВызватьИсключение Контекст + " record must contain " + Свойство;
	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьRuntimeОтчет(Документ)

	Контекст = "Runtime report";
	ПроверитьВерсию(Документ, "SchemaVersion", Контекст);
	ПроверитьМассив(Документ, "Results", Контекст);
	ПроверитьСчетчик(Документ, "CandidateCount", "Results", Контекст);

	Поля = Новый Массив;
	Поля.Добавить("File");
	Поля.Добавить("Line");
	Поля.Добавить("TestMethod");

	ПроверитьКлючиЗаписей(Документ.Results, Поля, Контекст, "Runtime report contains duplicate key");

	СчетчикиСтатусов = Новый Структура;
	СчетчикиСтатусов.Вставить("Classified", "ClassifiedCount");
	СчетчикиСтатусов.Вставить("Unclassified", "UnclassifiedCount");
	СчетчикиСтатусов.Вставить("NoException", "NoExceptionCount");
	СчетчикиСтатусов.Вставить("NotObserved", "NotObservedCount");
	СчетчикиСтатусов.Вставить("RuntimeFailure", "RuntimeFailureCount");

	ПроверитьСчетчикиСтатусов(
		Документ,
		Документ.Results,
		СчетчикиСтатусов,
		Контекст,
		"Runtime report status counts do not match Results.Count"
	);

КонецПроцедуры

Процедура ПроверитьОтчетМатрицы(Документ)

	Контекст = "Matrix report";
	ПроверитьВерсию(Документ, "SchemaVersion", Контекст);
	ПроверитьМассив(Документ, "Locales", Контекст);
	ПроверитьСчетчик(Документ, "LocaleCount", "Locales", Контекст);
	ПроверитьЦелоеСвойство(Документ, "ScenarioCount", Контекст);

	ПоляЛокали = Новый Массив;
	ПоляЛокали.Добавить("Locale");

	ПроверитьКлючиЗаписей(
		Документ.Locales,
		ПоляЛокали,
		Контекст + " locales",
		"Matrix report contains duplicate locale key"
	);

	ВсеРезультаты = Новый Массив;
	Для Каждого Локаль Из Документ.Locales Цикл
		ПроверитьЛокальМатрицы(Локаль, Документ.ScenarioCount, ВсеРезультаты, Контекст);
		ПроверитьФормуМатрицы(Локаль, Контекст + " locale '" + Локаль.Locale + "'");
	КонецЦикла;

	СчетчикиСтатусов = Новый Структура;
	СчетчикиСтатусов.Вставить("Classified", "ClassifiedCount");
	СчетчикиСтатусов.Вставить("Unclassified", "UnclassifiedCount");
	СчетчикиСтатусов.Вставить("Success", "SuccessCount");
	СчетчикиСтатусов.Вставить("RuntimeFailure", "RuntimeFailureCount");

	ПроверитьСчетчикиСтатусов(
		Документ,
		ВсеРезультаты,
		СчетчикиСтатусов,
		Контекст,
		"Matrix report status counts do not match all locale results"
	);

КонецПроцедуры

Функция МассивСтрок(СтрокаЗначений)

	Возврат СтрРазделить(СтрокаЗначений, "|", Истина);

КонецФункции

Процедура ПроверитьТочныеЗначения(Фактические, Ожидаемые, Метка, Контекст)

	Если Фактические.Количество() <> Ожидаемые.Количество() Тогда
		ВызватьИсключение Контекст + " has " + Фактические.Количество() + " " + Метка
			+ " values; expected " + Ожидаемые.Количество();
	КонецЕсли;

	Для Каждого Ожидаемое Из Ожидаемые Цикл
		Количество = 0;
		Для Каждого Фактическое Из Фактические Цикл
			Если Фактическое = Ожидаемое Тогда
				Количество = Количество + 1;
			КонецЕсли;
		КонецЦикла;
	
		Если Количество <> 1 Тогда
			ВызватьИсключение Контекст + " does not contain exactly one '" + Ожидаемое + "' " + Метка + " value";
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура ПроверитьОсобуюСтроку(Результаты, Имя, Выражение, Операция, ИмяТипа, Контекст)

	Совпадения = Новый Массив;
	Для Каждого Результат Из Результаты Цикл
		Если Результат.Expression = Выражение Тогда
			Совпадения.Добавить(Результат);
		КонецЕсли;
	КонецЦикла;

	Если Совпадения.Количество() <> 1 Тогда
		ВызватьИсключение Контекст + " must contain exactly one '" + Выражение + "' row";
	КонецЕсли;

	Результат = Совпадения[0];
	Если Результат.Name <> Имя
		Или Результат.Group <> "Arithmetic"
		Или Результат.Operation <> Операция
		Или Результат.LeftType <> ИмяТипа
		Или Результат.RightType <> ИмяТипа Тогда
		ВызватьИсключение Контекст + " has an invalid '" + Выражение + "' row";
	КонецЕсли;

КонецПроцедуры

Функция ПолучитьУникальныеОперации(Результаты, Группа)

	Операции = Новый Массив;
	Для Каждого Результат Из Результаты Цикл
		Если Результат.Group = Группа И Операции.Найти(Результат.Operation) = Неопределено Тогда
			Операции.Добавить(Результат.Operation);
		КонецЕсли;
	КонецЦикла;

	Возврат Операции;

КонецФункции

Процедура ПроверитьКомбинацию(Результаты, Группа, Операция, ЛевыйТип, ПравыйТип, Контекст)

	Количество = 0;
	Для Каждого Результат Из Результаты Цикл
		Если Результат.Group = Группа
			И Результат.Operation = Операция
			И Результат.LeftType = ЛевыйТип
			И Результат.RightType = ПравыйТип Тогда
			Количество = Количество + 1;
		КонецЕсли;
	КонецЦикла;

	Если Количество <> 1 Тогда
		ВызватьИсключение Контекст + " has " + Количество + " rows for " + Группа + "/" + Операция
			+ "/" + ЛевыйТип + "/" + ПравыйТип;
	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьЛокальМатрицы(Локаль, ЧислоСценариев, ВсеРезультаты, Контекст)

	КонтекстЛокали = Контекст + " locale '" + Локаль.Locale + "'";

	Коллекции = Новый Структура;
	Коллекции.Вставить("Types", "TypeCount");
	Коллекции.Вставить("Groups", "GroupCount");
	Коллекции.Вставить("Results", "ScenarioCount");

	Для Каждого Коллекция Из Коллекции Цикл
		ПроверитьМассив(Локаль, Коллекция.Ключ, КонтекстЛокали);
		ПроверитьСчетчик(Локаль, Коллекция.Значение, Коллекция.Ключ, КонтекстЛокали);
	КонецЦикла;

	Если Локаль.ScenarioCount <> ЧислоСценариев Тогда
		ВызватьИсключение КонтекстЛокали + " ScenarioCount does not match matrix ScenarioCount";
	КонецЕсли;

	Поля = Новый Массив;
	Поля.Добавить("Name");

	ПроверитьКлючиЗаписей(
		Локаль.Types,
		Поля,
		КонтекстЛокали + " types",
		КонтекстЛокали + " contains duplicate type key"
	);

	ПроверитьКлючиЗаписей(
		Локаль.Results,
		Поля,
		КонтекстЛокали + " results",
		КонтекстЛокали + " contains duplicate result key"
	);

	ПроверитьГруппыМатрицы(Локаль.Groups, КонтекстЛокали);

	Для Каждого Результат Из Локаль.Results Цикл
		Статус = Неопределено;
		Если Не Результат.Свойство("Status", Статус) Тогда
			ВызватьИсключение КонтекстЛокали + " result must contain Status";
		КонецЕсли;

		ВсеРезультаты.Добавить(Результат);
	КонецЦикла;

КонецПроцедуры

Процедура ПроверитьГруппыМатрицы(Группы, Контекст)

	Ключи = Новый Соответствие;
	Для Каждого Группа Из Группы Цикл
		Если ТипЗнч(Группа) <> Тип("Строка") Или ПустаяСтрока(Группа) Тогда
			ВызватьИсключение Контекст + " groups must contain non-empty keys";
		КонецЕсли;

		НормализованнаяГруппа = НРег(Группа);
		Если Ключи.Получить(НормализованнаяГруппа) <> Неопределено Тогда
			ВызватьИсключение Контекст + " contains duplicate group key: " + Группа;
		КонецЕсли;
	
		Ключи.Вставить(НормализованнаяГруппа, Истина);
	КонецЦикла;

КонецПроцедуры

Процедура ПроверитьСчетчикиСтатусов(Документ, Результаты, Счетчики, Контекст, СообщениеИтога)

	Итого = 0;
	Для Каждого Счетчик Из Счетчики Цикл
		ПроверитьЦелоеСвойство(Документ, Счетчик.Значение, Контекст);
		Итого = Итого + Документ[Счетчик.Значение];
	КонецЦикла;

	Если Итого <> Результаты.Количество() Тогда
		ВызватьИсключение СообщениеИтога;
	КонецЕсли;

	Для Каждого Счетчик Из Счетчики Цикл
		ФактическоеКоличество = 0;

		Для Каждого Результат Из Результаты Цикл
			Статус = Неопределено;
			Результат.Свойство("Status", Статус);

			Если Статус = Счетчик.Ключ Тогда
				ФактическоеКоличество = ФактическоеКоличество + 1;
			КонецЕсли;
		КонецЦикла;

		Если Документ[Счетчик.Значение] <> ФактическоеКоличество Тогда
			ВызватьИсключение Контекст + " " + Счетчик.Значение
				+ " does not match results with status " + Счетчик.Ключ;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура ПроверитьВерсию(Документ, Свойство, Контекст)

	ПроверитьЦелоеСвойство(Документ, Свойство, Контекст);
	Если Документ[Свойство] <> 1 Тогда
		ВызватьИсключение Контекст + " must have " + Свойство + " 1";
	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьЦелоеСвойство(Документ, Свойство, Контекст)

	Значение = Неопределено;
	Если Не Документ.Свойство(Свойство, Значение) Тогда
		ВызватьИсключение Контекст + " must contain " + Свойство;
	КонецЕсли;

	Если ТипЗнч(Значение) <> Тип("Число") Или Значение <> Цел(Значение) Тогда
		ВызватьИсключение Контекст + " " + Свойство + " must be an Int32 or Int64";
	КонецЕсли;

	Если Значение < 0 Тогда
		ВызватьИсключение Контекст + " " + Свойство + " must be nonnegative";
	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьМассив(Документ, Свойство, Контекст)

	Значение = Неопределено;
	Если Не Документ.Свойство(Свойство, Значение) Или ТипЗнч(Значение) <> Тип("Массив") Тогда
		ВызватьИсключение Контекст + " must contain " + Свойство;
	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьСчетчик(Документ, СвойствоСчетчика, СвойствоМассива, Контекст)

	ПроверитьЦелоеСвойство(Документ, СвойствоСчетчика, Контекст);

	Если Документ[СвойствоСчетчика] <> Документ[СвойствоМассива].Количество() Тогда
		ВызватьИсключение Контекст + " " + СвойствоСчетчика
			+ " does not match " + СвойствоМассива + ".Count";
	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьКлючиЗаписей(Записи, Поля, Контекст, СообщениеПовтора)

	Ключи = Новый Соответствие;
	Для Каждого Запись Из Записи Цикл
		Части = Новый Массив;

		Для Каждого Поле Из Поля Цикл
			Значение = Неопределено;

			Если Не Запись.Свойство(Поле, Значение) Или Не ЗаполненоКлючевоеПоле(Значение) Тогда
				ВызватьИсключение Контекст + " record must contain key field " + Поле;
			КонецЕсли;

			Части.Добавить(Строка(Значение));
		КонецЦикла;

		Ключ = НРег(СтрСоединить(Части, Символы.ПС));
		Если Ключи.Получить(Ключ) <> Неопределено Тогда
			ВызватьИсключение СообщениеПовтора + ": " + Ключ;
		КонецЕсли;

		Ключи.Вставить(Ключ, Истина);
	КонецЦикла;

КонецПроцедуры

Функция ЗаполненоКлючевоеПоле(Значение)

	Если Значение = Неопределено Или Значение = Null Тогда
		Возврат Ложь;
	КонецЕсли;

	Если ТипЗнч(Значение) = Тип("Строка") Тогда
		Возврат Не ПустаяСтрока(Значение);
	КонецЕсли;

	Возврат Истина;

КонецФункции

Процедура ПроверитьСоответствиеКатегорийКандидатов(Документ)

	КлючиКандидатов = Новый Соответствие;

	Для Каждого Запись Из Документ.Candidates Цикл
		Ключ = КлючСигнатуры(Запись);
		Количество = КлючиКандидатов.Получить(Ключ);
		Если Количество = Неопределено Тогда
			Количество = 0;
		КонецЕсли;

		КлючиКандидатов.Вставить(Ключ, Количество + 1);
	КонецЦикла;

	Категории = Новый Массив;
	Категории.Добавить(Документ.OperationalCandidates);
	Категории.Добавить(Документ.ProgrammingErrors);

	Для Каждого Категория Из Категории Цикл
		Для Каждого Запись Из Категория Цикл
			Ключ = КлючСигнатуры(Запись);
			Количество = КлючиКандидатов.Получить(Ключ);

			Если Количество = Неопределено Тогда
				ВызватьИсключение
					"Source error report Candidates do not match categorized candidate semantic keys";
			КонецЕсли;

			Если Количество = 1 Тогда
				КлючиКандидатов.Удалить(Ключ);
			Иначе
				КлючиКандидатов.Вставить(Ключ, Количество - 1);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Если КлючиКандидатов.Количество() > 0 Тогда
		ВызватьИсключение "Source error report Candidates do not match categorized candidate semantic keys";
	КонецЕсли;

КонецПроцедуры

Функция ИменаКоллекцийСигнатур()

	Результат = Новый Массив;
	Результат.Добавить("UnknownThrows");
	Результат.Добавить("OperationalCandidates");
	Результат.Добавить("ProgrammingErrors");

	Возврат Результат;

КонецФункции

Функция КлючСигнатуры(Запись)

	Возврат Запись.File + Символы.ПС + Запись.ExceptionType + Символы.ПС + Запись.Statement;

КонецФункции

#КонецОбласти
