#Использовать 1commands

#Область ПрограммныйИнтерфейс

// Возвращает JSON-список внешних границ через потоковый .NET-анализатор.
//
// Параметры:
//   КаталогПроб - Строка - каталог probes.
//   ПутьКОтчету - Строка - путь к external-call-boundaries.json.
//   ПутьКЖурналу - Строка - путь к external-call-boundary-review.json.
//   Лимит - Число - максимальное число элементов.
//
// Возвращаемое значение:
//   Строка - JSON, сформированный анализатором.
//
// Исключения:
//   Вызывает исключение при некорректном лимите или ненулевом коде процесса dotnet.
Функция ПолучитьЭлементы(КаталогПроб, ПутьКОтчету, ПутьКЖурналу, Лимит = 50, Режим = "") Экспорт

	Если Лимит <= 0 Или Лимит <> Цел(Лимит) Тогда
		ВызватьИсключение "Limit must be a positive integer";
	КонецЕсли;

	ПутьКПроекту = ОбъединитьПути(КаталогПроб, "tools/ExternalCallBoundaryAnalyzer");

	ВнешняяКоманда = Новый Команда;
	ВнешняяКоманда.УстановитьКоманду("dotnet");
	ВнешняяКоманда.ДобавитьПараметр("run");
	ВнешняяКоманда.ДобавитьПараметр("--project");
	ВнешняяКоманда.ДобавитьПараметр(ВнешняяКоманда.ОбернутьВКавычки(ПутьКПроекту));
	ВнешняяКоманда.ДобавитьПараметр("--verbosity");
	ВнешняяКоманда.ДобавитьПараметр("quiet");
	ВнешняяКоманда.ДобавитьПараметр("--");
	ВнешняяКоманда.ДобавитьПараметр("--worklist");
	ВнешняяКоманда.ДобавитьПараметр(ВнешняяКоманда.ОбернутьВКавычки(ПутьКОтчету));
	ВнешняяКоманда.ДобавитьПараметр(ВнешняяКоманда.ОбернутьВКавычки(ПутьКЖурналу));
	ВнешняяКоманда.ДобавитьПараметр(Лимит);
	ВнешняяКоманда.ДобавитьПараметр(Режим);
	ВнешняяКоманда.УстановитьРабочийКаталог(КаталогПроб);
	ВнешняяКоманда.УстановитьИсполнениеЧерезКомандыСистемы(Ложь);

	КодВозврата = ВнешняяКоманда.Исполнить();
	Вывод = ВнешняяКоманда.ПолучитьВывод();

	Если КодВозврата <> 0 Тогда
		ВызватьИсключение "External call worklist failed: " + Вывод;
	КонецЕсли;

	Возврат Вывод;

КонецФункции

#КонецОбласти
