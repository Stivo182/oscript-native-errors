#Использовать 1commands

#Область ПрограммныйИнтерфейс

// Обновляет отчеты выполнения во временном каталоге и публикует их после проверки контрактов.
//
// Параметры:
//   КаталогПроб - Строка - каталог probes.
//   КаталогИсходников - Строка - каталог исходников OneScript.
//   ПутьКOneScript - Строка - путь к исполняемому файлу OneScript.
//
// Исключения:
//   Вызывает исключение при ошибке анализатора, контракта или публикации.
Процедура Обновить(КаталогПроб, КаталогИсходников, ПутьКOneScript) Экспорт

	ПроверитьПараметры(КаталогИсходников, ПутьКOneScript);
	ПроверитьИсходникиБезИзменений(КаталогИсходников);

	КаталогДанных = ОбъединитьПути(КаталогПроб, "data");
	Идентификатор = СтрЗаменить(Строка(Новый УникальныйИдентификатор), "-", "");
	КаталогПодготовки = ОбъединитьПути(КаталогДанных, ".refresh-" + Идентификатор);

	СоздатьКаталог(КаталогПодготовки);

	ИменаФайлов = Новый Массив;
	ИменаФайлов.Добавить("onescript-test-error-results.json");
	ИменаФайлов.Добавить("base-type-error-matrix-results.json");

	Попытка
		ЗапуститьАнализаторы(КаталогПроб, КаталогИсходников, ПутьКOneScript, КаталогПодготовки);
		ПутиКОтчетам = Новый Массив;

		Для Каждого ИмяФайла Из ИменаФайлов Цикл
			ПутиКОтчетам.Добавить(ОбъединитьПути(КаталогПодготовки, ИмяФайла));
		КонецЦикла;

		ДобавитьКонтрольнуюСуммуRuntime(ПутиКОтчетам, ПутьКOneScript);

		Проверка = Новый ПроверкаДанныхПроб;
		Проверка.ПроверитьФайл(
			ОбъединитьПути(КаталогПодготовки, "onescript-test-error-results.json"),
			"RuntimeReport"
		);
		Проверка.ПроверитьФайл(
			ОбъединитьПути(КаталогПодготовки, "base-type-error-matrix-results.json"),
			"MatrixReport"
		);

		Опубликовать(КаталогПодготовки, КаталогДанных, ИменаФайлов);
	Исключение
		УдалитьФайлы(КаталогПодготовки);
		ВызватьИсключение;
	КонецПопытки;

	УдалитьФайлы(КаталогПодготовки);

КонецПроцедуры

// Добавляет в JSON-отчеты SHA-256 исполняемого файла OneScript.
//
// Параметры:
//   ПутиКОтчетам - Массив - пути к JSON-отчетам.
//   ПутьКOneScript - Строка - путь к исполняемому файлу OneScript.
//
// Исключения:
//   Вызывает исключение, если исполняемый файл или отчет отсутствует либо JSON некорректен.
Процедура ДобавитьКонтрольнуюСуммуRuntime(ПутиКОтчетам, ПутьКOneScript) Экспорт

	Если Не СуществующийФайл(ПутьКOneScript) Тогда
		ВызватьИсключение "OneScript runtime executable was not found: " + ПутьКOneScript;
	КонецЕсли;

	Хеширование = Новый ХешированиеДанных(ХешФункция.SHA256);
	Хеширование.ДобавитьФайл(ПутьКOneScript);
	КонтрольнаяСумма = Хеширование.ХешСуммаСтрокой;

	Для Каждого Путь Из ПутиКОтчетам Цикл
		Если Не СуществующийФайл(Путь) Тогда
			ВызватьИсключение "Runtime probe report was not found: " + Путь;
		КонецЕсли;

		Попытка
			Чтение = Новый ЧтениеJSON;
			Чтение.ОткрытьФайл(Путь);
			Документ = ПрочитатьJSON(Чтение);
			Чтение.Закрыть();
		Исключение
			ВызватьИсключение "Runtime probe report contains invalid JSON: " + Путь + ". " + ОписаниеОшибки();
		КонецПопытки;

		Документ.Вставить("RuntimeExecutableSha256", КонтрольнаяСумма);

		Запись = Новый ЗаписьJSON;
		Запись.ОткрытьФайл(Путь);
		ЗаписатьJSON(Запись, Документ);
		Запись.Закрыть();
	КонецЦикла;

КонецПроцедуры

// Публикует подготовленные файлы данных с резервным копированием и откатом.
//
// Параметры:
//   КаталогПодготовки - Строка - каталог подготовленных файлов.
//   КаталогДанных - Строка - каталог публикуемых данных.
//   ИменаФайлов - Массив - уникальные имена файлов без частей пути.
//
// Исключения:
//   Вызывает исключение при неверных параметрах, ошибке публикации или отката.
Процедура Опубликовать(КаталогПодготовки, КаталогДанных, ИменаФайлов) Экспорт

	ПроверитьПубликацию(КаталогПодготовки, КаталогДанных, ИменаФайлов);
	Идентификатор = СтрЗаменить(Строка(Новый УникальныйИдентификатор), "-", "");
	КаталогРезерва = ОбъединитьПути(КаталогДанных, ".backup-" + Идентификатор);

	СоздатьКаталог(КаталогРезерва);

	ЗамененныеФайлы = Новый Массив;

	Попытка
		Для Каждого ИмяФайла Из ИменаФайлов Цикл
			КопироватьФайл(ОбъединитьПути(КаталогДанных, ИмяФайла), ОбъединитьПути(КаталогРезерва, ИмяФайла));
		КонецЦикла;

		Для Каждого ИмяФайла Из ИменаФайлов Цикл
			КопироватьФайл(ОбъединитьПути(КаталогПодготовки, ИмяФайла), ОбъединитьПути(КаталогДанных, ИмяФайла));
			ЗамененныеФайлы.Добавить(ИмяФайла);
		КонецЦикла;
	Исключение
		ОписаниеОшибкиПубликации = ОписаниеОшибки();
		ОписаниеОшибкиОтката = "";

		Индекс = ЗамененныеФайлы.Количество();
		Пока Индекс > 0 Цикл
			Индекс = Индекс - 1;
			ИмяФайла = ЗамененныеФайлы[Индекс];

			Попытка
				КопироватьФайл(
					ОбъединитьПути(КаталогРезерва, ИмяФайла),
					ОбъединитьПути(КаталогДанных, ИмяФайла)
				);
			Исключение
				Если ПустаяСтрока(ОписаниеОшибкиОтката) Тогда
					ОписаниеОшибкиОтката = ОписаниеОшибки();
				КонецЕсли;
			КонецПопытки;
		КонецЦикла;

		Если ПустаяСтрока(ОписаниеОшибкиОтката) Тогда
			Попытка
				УдалитьРезервнуюКопию(КаталогРезерва);
			Исключение
				ОписаниеОшибкиОтката = ОписаниеОшибки();
			КонецПопытки;
		КонецЕсли;

		Если Не ПустаяСтрока(ОписаниеОшибкиОтката) Тогда
			ВызватьИсключение "Probe data rollback failed. Backup preserved at '" + КаталогРезерва
				+ "'. Publication error: " + ОписаниеОшибкиПубликации
				+ " Rollback error: " + ОписаниеОшибкиОтката;
		КонецЕсли;

		ВызватьИсключение ОписаниеОшибкиПубликации;
	КонецПопытки;

	УдалитьРезервнуюКопию(КаталогРезерва);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура УдалитьРезервнуюКопию(КаталогРезерва)

	Для Каждого Файл Из НайтиФайлы(КаталогРезерва, "*", Истина) Цикл
		Если Файл.ЭтоФайл() Тогда
			Файл.УстановитьТолькоЧтение(Ложь);
		КонецЕсли;
	КонецЦикла;

	УдалитьФайлы(КаталогРезерва);

КонецПроцедуры

Процедура ПроверитьПараметры(КаталогИсходников, ПутьКOneScript)

	Если Не Новый Файл(ПутьКOneScript).Существует() Тогда
		ВызватьИсключение "Не найден исполняемый файл OneScript: " + ПутьКOneScript;
	КонецЕсли;

	КаталогТестов = Новый Файл(ОбъединитьПути(КаталогИсходников, "tests"));
	Если Не КаталогТестов.Существует() Или Не КаталогТестов.ЭтоКаталог() Тогда
		ВызватьИсключение "Не найден каталог тестов OneScript: " + КаталогИсходников;
	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьИсходникиБезИзменений(КаталогИсходников)

	ИменаФайлов = Новый Массив;
	ИменаФайлов.Добавить("Directory.Build.props");
	ИменаФайлов.Добавить("Directory.Build.targets");
	ИменаФайлов.Добавить("Directory.Packages.props");
	ИменаФайлов.Добавить("global.json");

	ВнешняяКоманда = Новый Команда;
	ВнешняяКоманда.УстановитьКоманду("git");
	ВнешняяКоманда.ДобавитьПараметр("-C");
	ВнешняяКоманда.ДобавитьПараметр(ВнешняяКоманда.ОбернутьВКавычки(КаталогИсходников));
	ВнешняяКоманда.ДобавитьПараметр("status");
	ВнешняяКоманда.ДобавитьПараметр("--porcelain");
	ВнешняяКоманда.ДобавитьПараметр("--");
	ВнешняяКоманда.ДобавитьПараметр("src");
	ВнешняяКоманда.ДобавитьПараметр("tests");

	Для Каждого ИмяФайла Из ИменаФайлов Цикл
		Если Новый Файл(ОбъединитьПути(КаталогИсходников, ИмяФайла)).Существует() Тогда
			ВнешняяКоманда.ДобавитьПараметр(ВнешняяКоманда.ОбернутьВКавычки(ИмяФайла));
		КонецЕсли;
	КонецЦикла;

	ВнешняяКоманда.УстановитьРабочийКаталог(КаталогИсходников);
	ВнешняяКоманда.УстановитьИсполнениеЧерезКомандыСистемы(Ложь);

	КодВозврата = ВнешняяКоманда.Исполнить();
	Вывод = ВнешняяКоманда.ПолучитьВывод();

	Если КодВозврата <> 0 Тогда
		ВызватьИсключение "Не удалось проверить состояние исходников OneScript: " + Вывод;
	КонецЕсли;

	Если НЕ ПустаяСтрока(СокрЛП(Вывод)) Тогда
		ВызватьИсключение "Исходники OneScript содержат незакоммиченные изменения:" + Символы.ПС + Вывод;
	КонецЕсли;

КонецПроцедуры

Процедура ЗапуститьАнализаторы(КаталогПроб, КаталогИсходников, ПутьКOneScript, КаталогПодготовки)

	ПутьКТестам = ОбъединитьПути(КаталогИсходников, "tests");
	ПутьКЗапускателю = ОбъединитьПути(ПутьКТестам, "testrunner.os");
	КаталогПроекта = Новый Файл(ОбъединитьПути(КаталогПроб, "..")).ПолноеИмя;

	Анализатор = Новый АнализаторОшибокТестовOneScript;
	Анализатор.Сформировать(
		ПутьКТестам,
		ОбъединитьПути(КаталогПодготовки, "onescript-test-error-results.json"),
		ПутьКЗапускателю,
		КаталогПроекта,
		ПутьКOneScript
	);

	Матрица = Новый МатрицаОшибокБазовыхТиповЛокалей;
	Матрица.Сформировать(
		КаталогПроб,
		КаталогПроекта,
		ОбъединитьПути(КаталогПодготовки, "base-type-error-matrix-results.json"),
		ПутьКOneScript
	);

КонецПроцедуры

Процедура ПроверитьПубликацию(КаталогПодготовки, КаталогДанных, ИменаФайлов)

	Если Не СуществующийКаталог(КаталогПодготовки) Тогда
		ВызватьИсключение "Staging directory was not found: " + КаталогПодготовки;
	КонецЕсли;

	Если Не СуществующийКаталог(КаталогДанных) Тогда
		ВызватьИсключение "Data directory was not found: " + КаталогДанных;
	КонецЕсли;

	Имена = Новый Соответствие;
	Для Каждого ИмяФайла Из ИменаФайлов Цикл
		Если ТипЗнч(ИмяФайла) <> Тип("Строка") Или ПустаяСтрока(ИмяФайла)
			Или ИмяФайла <> СокрЛП(ИмяФайла)
			Или СтрНайти(ИмяФайла, "/") > 0
			Или СтрНайти(ИмяФайла, "\") > 0
			Или СтрНайти(ИмяФайла, ":") > 0 Тогда
			ВызватьИсключение "Probe data file name must be a relative leaf name: " + Строка(ИмяФайла);
		КонецЕсли;

		НормализованноеИмя = НРег(ИмяФайла);
		Если Имена.Получить(НормализованноеИмя) <> Неопределено Тогда
			ВызватьИсключение "Probe data file name must be unique: " + ИмяФайла;
		КонецЕсли;

		Имена.Вставить(НормализованноеИмя, Истина);

		ПутьПодготовленногоФайла = ОбъединитьПути(КаталогПодготовки, ИмяФайла);
		Если Не СуществующийФайл(ПутьПодготовленногоФайла) Тогда
			ВызватьИсключение "Staged probe data file was not found: " + ПутьПодготовленногоФайла;
		КонецЕсли;

		ПутьДанных = ОбъединитьПути(КаталогДанных, ИмяФайла);
		Если Не СуществующийФайл(ПутьДанных) Тогда
			ВызватьИсключение "Destination probe data file was not found: " + ПутьДанных;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Функция СуществующийКаталог(Путь)

	Файл = Новый Файл(Путь);
	Возврат Файл.Существует() И Файл.ЭтоКаталог();

КонецФункции

Функция СуществующийФайл(Путь)

	Файл = Новый Файл(Путь);
	Возврат Файл.Существует() И Не Файл.ЭтоКаталог();

КонецФункции

#КонецОбласти
