#Использовать 1commands

#Область ПрограммныйИнтерфейс

// Формирует отчет о местах выброса исключений в исходниках OneScript.
//
// Параметры:
//   КаталогИсходников - Строка - корневой каталог исходников OneScript.
//   ПутьКОтчету - Строка - путь создаваемого JSON-отчета.
//
// Исключения:
//   Вызывает исключение при ошибке чтения исходников или записи отчета.
Процедура Сформировать(КаталогИсходников, ПутьКОтчету) Экспорт

	Параметры = Новый Структура("EngineRoot, SourceDirectories, JsonPath, Quiet");
	Параметры.EngineRoot = КаталогИсходников;
	Параметры.SourceDirectories = Новый Массив;
	Параметры.JsonPath = ПутьКОтчету;
	Параметры.Quiet = Истина;
	СформироватьПоПараметрам(Параметры);

КонецПроцедуры

// Формирует отчет по явно указанным каталогам исходников.
//
// Параметры:
//   КаталогиИсходников - Массив - анализируемые каталоги исходников.
//   ПутьКОтчету - Строка - путь создаваемого JSON-отчета.
Процедура СформироватьПоКаталогам(КаталогиИсходников, ПутьКОтчету) Экспорт

	Параметры = Новый Структура("EngineRoot, SourceDirectories, JsonPath, Quiet");
	Параметры.EngineRoot = "";
	Параметры.SourceDirectories = КаталогиИсходников;
	Параметры.JsonPath = ПутьКОтчету;
	Параметры.Quiet = Истина;
	СформироватьПоПараметрам(Параметры);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СоздатьШаблон(ТекстШаблона, ИгнорироватьРегистр = Истина)

	Шаблон = Новый РегулярноеВыражение(ТекстШаблона);
	Шаблон.ИгнорироватьРегистр = ИгнорироватьРегистр;

	Возврат Шаблон;

КонецФункции

Функция СоздатьШаблоны()

	Шаблоны = Новый Структура;
	Шаблоны.Вставить("ContextClass", СоздатьШаблон("\[ContextClass\s*\(\s*""(?<Name>[^""]+)"""));
	Шаблоны.Вставить("GlobalContext", СоздатьШаблон("\[GlobalContext"));
	Шаблоны.Вставить(
		"ContextMethod",
		СоздатьШаблон("\[Context(?:Method|Property)\s*\(\s*""(?<Name>[^""]+)""")
	);
	Шаблоны.Вставить("ScriptConstructor", СоздатьШаблон("\[ScriptConstructor"));
	Шаблоны.Вставить("Class", СоздатьШаблон("\bclass\s+(?<Name>[A-Za-z_][A-Za-z0-9_]*)"));
	Шаблоны.Вставить(
		"Method",
		СоздатьШаблон(
			"\b(?:public|private|protected|internal)\s+(?:static\s+)?[^;{}()]+\s+"
				+ "(?<Name>[A-Za-z_][A-Za-z0-9_]*)\s*\("
		)
	);
	Шаблоны.Вставить(
		"Property",
		СоздатьШаблон(
			"\b(?:public|private|protected|internal)\s+[^;{}()]+\s+"
				+ "(?<Name>[A-Za-z_][A-Za-z0-9_]*)\s*\{"
		)
	);
	Шаблоны.Вставить(
		"Catch",
		СоздатьШаблон("\bcatch\s*\(\s*(?<Type>[A-Za-z_][A-Za-z0-9_.]*)")
	);
	Шаблоны.Вставить("Throw", СоздатьШаблон("\bthrow\b"));
	Шаблоны.Вставить("OpeningBrace", СоздатьШаблон("\{", Ложь));
	Шаблоны.Вставить("ClosingBrace", СоздатьШаблон("\}", Ложь));
	Шаблоны.Вставить(
		"NewException",
		СоздатьШаблон(
			"throw\s+new\s+(?<Type>[A-Za-z_][A-Za-z0-9_.]*)\s*\((?<Arguments>.*)\)\s*;"
		)
	);
	Шаблоны.Вставить(
		"FactoryException",
		СоздатьШаблон("throw\s+(?<Type>[A-Za-z_][A-Za-z0-9_.]*)\s*\((?<Arguments>.*)\)\s*;")
	);
	Шаблоны.Вставить(
		"NamedException",
		СоздатьШаблон("throw\s+(?<Type>[A-Za-z_][A-Za-z0-9_.]*)\s*;")
	);
	Шаблоны.Вставить("Rethrow", СоздатьШаблон("throw\s*;"));
	Шаблоны.Вставить("Message", СоздатьШаблон("""(?<Message>(?:[^""\\]|\\.)*)""", Ложь));
	Шаблоны.Вставить(
		"ProgrammingError",
		СоздатьШаблон("(^|\.)Argument|IndexOutOfRange|KeyNotFound|NotImplemented|NotSupported|RuntimeException\.Invalid")
	);
	Шаблоны.Вставить(
		"OperationalError",
		СоздатьШаблон(
			"IOException|FileNotFound|DirectoryNotFound|Unauthorized|Socket|WebException|Http|Zip|Process|"
				+ "Win32|Drive|COMException|WebSocket|XmlException|Xsl|Xslt|Cryptographic|TimeoutException|"
				+ "AggregateException|RuntimeException\."
				+ "(ClosedStream|NonWritableStream|IncorrectOffset|InvalidEncoding)"
		)
	);

	Возврат Шаблоны;

КонецФункции

Функция ПолучитьПервоеСовпадение(Шаблон, Текст)

	Совпадения = Шаблон.НайтиСовпадения(Текст);
	Если Совпадения.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Совпадения[0];

КонецФункции

Функция КоличествоСовпадений(Шаблон, Текст)

	Возврат Шаблон.НайтиСовпадения(Текст).Количество();

КонецФункции

Функция ПрочитатьСтроки(Путь)

	Чтение = Новый ЧтениеТекста(Путь, КодировкаТекста.UTF8);
	Текст = Чтение.Прочитать();
	Чтение.Закрыть();

	Текст = СтрЗаменить(Текст, Символы.ВК + Символы.ПС, Символы.ПС);
	Текст = СтрЗаменить(Текст, Символы.ВК, Символы.ПС);

	Возврат СтрРазделить(Текст, Символы.ПС);

КонецФункции

Процедура ЗаписатьJSONВФайл(Путь, Данные)

	ПолныйПуть = Новый Файл(Путь).ПолноеИмя;
	СоздатьКаталог(Новый Файл(ПолныйПуть).Путь);

	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, Данные);

	Запись = Новый ЗаписьТекста(ПолныйПуть, КодировкаТекста.UTF8);
	Запись.Записать(ЗаписьJSON.Закрыть());
	Запись.Закрыть();

КонецПроцедуры

Функция БезЗавершающегоРазделителя(Путь)

	Результат = Новый Файл(Путь).ПолноеИмя;
	Пока СтрДлина(Результат) > 1 Цикл
		ПоследнийСимвол = Прав(Результат, 1);
		Если ПоследнийСимвол <> "\" И ПоследнийСимвол <> "/" Тогда
			Прервать;
		КонецЕсли;

		Результат = Лев(Результат, СтрДлина(Результат) - 1);
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ПолучитьОтносительныйПуть(Корень, Путь)

	ПолныйКорень = БезЗавершающегоРазделителя(Корень);
	ПолныйПуть = Новый Файл(Путь).ПолноеИмя;

	Если НРег(ПолныйПуть) = НРег(ПолныйКорень) Тогда
		Возврат ".";
	КонецЕсли;

	Префикс = ПолныйКорень + ПолучитьРазделительПути();
	Если Лев(НРег(ПолныйПуть), СтрДлина(Префикс)) <> НРег(Префикс) Тогда
		ВызватьИсключение "Путь находится вне корня исходников: " + ПолныйПуть;
	КонецЕсли;

	Возврат СтрЗаменить(Сред(ПолныйПуть, СтрДлина(Префикс) + 1), ПолучитьРазделительПути(), "/");

КонецФункции

Функция ПолучитьСостояниеGit(Корень, Каталоги)

	Ревизия = "";
	Изменены = Ложь;
	ВнешняяКоманда = Новый Команда;
	ВнешняяКоманда.УстановитьКоманду("git");
	ВнешняяКоманда.ДобавитьПараметр("-C");
	ВнешняяКоманда.ДобавитьПараметр(ВнешняяКоманда.ОбернутьВКавычки(Корень));
	ВнешняяКоманда.ДобавитьПараметр("rev-parse");
	ВнешняяКоманда.ДобавитьПараметр("HEAD");
	ВнешняяКоманда.УстановитьРабочийКаталог(Корень);
	ВнешняяКоманда.УстановитьИсполнениеЧерезКомандыСистемы(Ложь);

	КодВозврата = ВнешняяКоманда.Исполнить();
	Если КодВозврата <> 0 Тогда
		ВызватьИсключение "Не удалось определить ревизию исходников: "
			+ СокрЛП(ВнешняяКоманда.ПолучитьВывод());
	КонецЕсли;

	Ревизия = СокрЛП(ВнешняяКоманда.ПолучитьВывод());

	ВнешняяКоманда = Новый Команда;
	ВнешняяКоманда.УстановитьКоманду("git");
	ВнешняяКоманда.ДобавитьПараметр("-C");
	ВнешняяКоманда.ДобавитьПараметр(ВнешняяКоманда.ОбернутьВКавычки(Корень));
	ВнешняяКоманда.ДобавитьПараметр("status");
	ВнешняяКоманда.ДобавитьПараметр("--porcelain");
	ВнешняяКоманда.ДобавитьПараметр("--");

	Для Каждого Каталог Из Каталоги Цикл
		ОтносительныйПуть = ПолучитьОтносительныйПуть(Корень, Каталог);
		ВнешняяКоманда.ДобавитьПараметр(ВнешняяКоманда.ОбернутьВКавычки(ОтносительныйПуть));
	КонецЦикла;

	ВнешняяКоманда.УстановитьРабочийКаталог(Корень);
	ВнешняяКоманда.УстановитьИсполнениеЧерезКомандыСистемы(Ложь);
	
	КодВозврата = ВнешняяКоманда.Исполнить();
	Если КодВозврата <> 0 Тогда
		ВызватьИсключение "Не удалось определить состояние исходников: "
			+ СокрЛП(ВнешняяКоманда.ПолучитьВывод());
	КонецЕсли;

	Изменены = Не ПустаяСтрока(СокрЛП(ВнешняяКоманда.ПолучитьВывод()));

	Возврат Новый Структура("Revision, Dirty", Ревизия, Изменены);

КонецФункции

Функция СоздатьЗаписьИсключения(
	Выражение,
	Файл,
	НомерСтроки,
	ОбъектOneScript,
	МетодOneScript,
	ТипПерехваченногоИсключения,
	Шаблоны)

	ТипИсключения = "Rethrow";
	СообщениеИсключения = "";
	Совпадение = ПолучитьПервоеСовпадение(Шаблоны.NewException, Выражение);

	Если Совпадение <> Неопределено Тогда
		ТипИсключения = Совпадение.Группы.ПоИмени("Type").Значение;
		Аргументы = Совпадение.Группы.ПоИмени("Arguments").Значение;
		СовпадениеСообщения = ПолучитьПервоеСовпадение(Шаблоны.Message, Аргументы);

		Если СовпадениеСообщения <> Неопределено Тогда
			СообщениеИсключения = СовпадениеСообщения.Группы.ПоИмени("Message").Значение;
		КонецЕсли;
	Иначе
		Совпадение = ПолучитьПервоеСовпадение(Шаблоны.FactoryException, Выражение);
		Если Совпадение <> Неопределено Тогда
			ТипИсключения = Совпадение.Группы.ПоИмени("Type").Значение;
		Иначе
			Совпадение = ПолучитьПервоеСовпадение(Шаблоны.NamedException, Выражение);
			Если Совпадение <> Неопределено Тогда
				ТипИсключения = Совпадение.Группы.ПоИмени("Type").Значение;
			ИначеЕсли Шаблоны.Rethrow.Совпадает(Выражение)
				И ТипПерехваченногоИсключения <> Неопределено Тогда
				ТипИсключения = ТипПерехваченногоИсключения;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

	Если Шаблоны.ProgrammingError.Совпадает(ТипИсключения) Тогда
		Категория = "ProgrammingError";
	ИначеЕсли Шаблоны.OperationalError.Совпадает(ТипИсключения) Тогда
		Категория = "OperationalCandidate";
	Иначе
		Категория = "Unknown";
	КонецЕсли;

	Возврат Новый Структура(
		"File, Line, OneScriptObject, OneScriptMethod, ExceptionType, Message, Statement, Disposition",
		Файл,
		НомерСтроки,
		?(ОбъектOneScript = Неопределено, "", ОбъектOneScript),
		?(МетодOneScript = Неопределено, "", МетодOneScript),
		ТипИсключения,
		СообщениеИсключения,
		Выражение,
		Категория
	);

КонецФункции

Процедура ОбновитьГлубину(СтрокаИсходника, ГлубинаСкобок, ОбластиПерехвата, Шаблоны)

	ГлубинаСкобок.Значение = ГлубинаСкобок.Значение
		+ КоличествоСовпадений(Шаблоны.OpeningBrace, СтрокаИсходника)
		- КоличествоСовпадений(Шаблоны.ClosingBrace, СтрокаИсходника);

	Пока ОбластиПерехвата.Количество() > 0
		И ОбластиПерехвата[ОбластиПерехвата.ВГраница()].Depth > ГлубинаСкобок.Значение Цикл
		ОбластиПерехвата.Удалить(ОбластиПерехвата.ВГраница());
	КонецЦикла;

КонецПроцедуры

Процедура ОбработатьФайл(ПолныйПуть, ОтносительныйПуть, Исключения, Перехваченные, Шаблоны)

	Строки = ПрочитатьСтроки(ПолныйПуть);
	ИмяОбъекта = Неопределено;
	ИмяМетода = Неопределено;
	ОжидаемоеИмяОбъекта = Неопределено;
	ОжидаемоеИмяМетода = Неопределено;
	ОбластиПерехвата = Новый Массив;
	ОжидаемыйТипПерехвата = Неопределено;
	ГлубинаСкобок = Новый Структура("Значение", 0);

	Для Индекс = 0 По Строки.ВГраница() Цикл
		СтрокаИсходника = Строки[Индекс];

		Совпадение = ПолучитьПервоеСовпадение(Шаблоны.ContextClass, СтрокаИсходника);
		Если Совпадение <> Неопределено Тогда
			ОжидаемоеИмяОбъекта = Совпадение.Группы.ПоИмени("Name").Значение;
		ИначеЕсли Шаблоны.GlobalContext.Совпадает(СтрокаИсходника) Тогда
			ОжидаемоеИмяОбъекта = "GlobalContext";
		КонецЕсли;

		Совпадение = ПолучитьПервоеСовпадение(Шаблоны.ContextMethod, СтрокаИсходника);
		Если Совпадение <> Неопределено Тогда
			ОжидаемоеИмяМетода = Совпадение.Группы.ПоИмени("Name").Значение;
		ИначеЕсли Шаблоны.ScriptConstructor.Совпадает(СтрокаИсходника) Тогда
			ОжидаемоеИмяМетода = "Constructor";
		КонецЕсли;

		Совпадение = ПолучитьПервоеСовпадение(Шаблоны.Class, СтрокаИсходника);
		Если Совпадение <> Неопределено Тогда
			Если ОжидаемоеИмяОбъекта <> Неопределено Тогда
				ИмяОбъекта = ОжидаемоеИмяОбъекта;
				ОжидаемоеИмяОбъекта = Неопределено;
			ИначеЕсли ИмяОбъекта = Неопределено Тогда
				ИмяОбъекта = Совпадение.Группы.ПоИмени("Name").Значение;
			КонецЕсли;
		КонецЕсли;

		Совпадение = ПолучитьПервоеСовпадение(Шаблоны.Method, СтрокаИсходника);
		Если Совпадение <> Неопределено Тогда
			Если ОжидаемоеИмяМетода <> Неопределено Тогда
				ИмяМетода = ОжидаемоеИмяМетода;
				ОжидаемоеИмяМетода = Неопределено;
			Иначе
				ИмяМетода = Совпадение.Группы.ПоИмени("Name").Значение;
			КонецЕсли;

			ОбластиПерехвата.Очистить();
			ОжидаемыйТипПерехвата = Неопределено;
		ИначеЕсли ОжидаемоеИмяМетода <> Неопределено Тогда
			Совпадение = ПолучитьПервоеСовпадение(Шаблоны.Property, СтрокаИсходника);
			Если Совпадение <> Неопределено Тогда
				ИмяМетода = ОжидаемоеИмяМетода;
				ОжидаемоеИмяМетода = Неопределено;
				ОбластиПерехвата.Очистить();
				ОжидаемыйТипПерехвата = Неопределено;
			КонецЕсли;
		КонецЕсли;

		Совпадение = ПолучитьПервоеСовпадение(Шаблоны.Catch, СтрокаИсходника);
		Если Совпадение <> Неопределено Тогда
			ТипПерехваченногоИсключения = Совпадение.Группы.ПоИмени("Type").Значение;
			Перехваченные.Добавить(
				Новый Структура(
					"File, Line, OneScriptObject, OneScriptMethod, ExceptionType",
					ОтносительныйПуть,
					Индекс + 1,
					ИмяОбъекта,
					ИмяМетода,
					ТипПерехваченногоИсключения
				)
			);

			ДоПерехвата = Лев(СтрокаИсходника, Совпадение.Индекс);
			ПослеПерехвата = Сред(СтрокаИсходника, Совпадение.Индекс + Совпадение.Длина + 1);
			ГлубинаДоПерехвата = ГлубинаСкобок.Значение
				+ КоличествоСовпадений(Шаблоны.OpeningBrace, ДоПерехвата)
				- КоличествоСовпадений(Шаблоны.ClosingBrace, ДоПерехвата);

			Если Шаблоны.OpeningBrace.Совпадает(ПослеПерехвата) Тогда
				ОбластиПерехвата.Добавить(
					Новый Структура(
						"ExceptionType, Depth",
						ТипПерехваченногоИсключения,
						ГлубинаДоПерехвата + 1
					)
				);
			Иначе
				ОжидаемыйТипПерехвата = ТипПерехваченногоИсключения;
			КонецЕсли;
		ИначеЕсли ОжидаемыйТипПерехвата <> Неопределено
			И Шаблоны.OpeningBrace.Совпадает(СтрокаИсходника) Тогда
			ОбластиПерехвата.Добавить(
				Новый Структура(
					"ExceptionType, Depth",
					ОжидаемыйТипПерехвата,
					ГлубинаСкобок.Значение + 1
				)
			);
			ОжидаемыйТипПерехвата = Неопределено;
		КонецЕсли;

		СтрокаДляПоиска = УдалитьОднострочныйКомментарий(СтрокаИсходника);
		Если Не Шаблоны.Throw.Совпадает(СтрокаДляПоиска) Тогда
			ОбновитьГлубину(СтрокаИсходника, ГлубинаСкобок, ОбластиПерехвата, Шаблоны);
			Продолжить;
		КонецЕсли;

		Выражение = СокрЛП(СтрокаДляПоиска);
		ПоследняяСтрокаВыражения = Индекс;
		Пока СтрНайти(Выражение, ";") = 0 И ПоследняяСтрокаВыражения < Строки.ВГраница() Цикл
			ПоследняяСтрокаВыражения = ПоследняяСтрокаВыражения + 1;
			Выражение = Выражение + " "
				+ СокрЛП(УдалитьОднострочныйКомментарий(Строки[ПоследняяСтрокаВыражения]));
		КонецЦикла;

		АктивныйТипПерехвата = Неопределено;
		Если ОбластиПерехвата.Количество() > 0 Тогда
			АктивныйТипПерехвата = ОбластиПерехвата[ОбластиПерехвата.ВГраница()].ExceptionType;
		КонецЕсли;

		Исключения.Добавить(
			СоздатьЗаписьИсключения(
				Выражение,
				ОтносительныйПуть,
				Индекс + 1,
				ИмяОбъекта,
				ИмяМетода,
				АктивныйТипПерехвата,
				Шаблоны
			)
		);

		ОбновитьГлубину(СтрокаИсходника, ГлубинаСкобок, ОбластиПерехвата, Шаблоны);
	КонецЦикла;

КонецПроцедуры

Функция УдалитьОднострочныйКомментарий(СтрокаИсходника)

	ВСтроковомЛитерале = Ложь;
	Экранировано = Ложь;

	Для Индекс = 1 По СтрДлина(СтрокаИсходника) Цикл
		Символ = Сред(СтрокаИсходника, Индекс, 1);

		Если ВСтроковомЛитерале И Символ = "\\" И Не Экранировано Тогда
			Экранировано = Истина;
			Продолжить;
		КонецЕсли;
	
		Если Символ = """" И Не Экранировано Тогда
			ВСтроковомЛитерале = Не ВСтроковомЛитерале;
		КонецЕсли;

		Если Не ВСтроковомЛитерале И Символ = "/"
			И Сред(СтрокаИсходника, Индекс + 1, 1) = "/" Тогда
			Возврат Лев(СтрокаИсходника, Индекс - 1);
		КонецЕсли;

		Экранировано = Ложь;
	КонецЦикла;

	Возврат СтрокаИсходника;

КонецФункции

Функция ПолучитьФайлыИсходников(Каталоги)

	ТаблицаФайлов = Новый ТаблицаЗначений;
	ТаблицаФайлов.Колонки.Добавить("FullName");
	ТаблицаФайлов.Колонки.Добавить("File");

	Для Каждого Каталог Из Каталоги Цикл
		ФайлКаталога = Новый Файл(Каталог);
		Если Не ФайлКаталога.Существует() Или Не ФайлКаталога.ЭтоКаталог() Тогда
			ВызватьИсключение "Не найден каталог исходников: " + Каталог;
		КонецЕсли;
		
		Для Каждого ФайлИсходника Из НайтиФайлы(Каталог, "*.cs", Истина) Цикл
			Если Не ФайлИсходника.ЭтоФайл() Тогда
				Продолжить;
			КонецЕсли;

			Строка = ТаблицаФайлов.Добавить();
			Строка.FullName = ФайлИсходника.ПолноеИмя;
			Строка.File = ФайлИсходника;
		КонецЦикла;
	КонецЦикла;

	ТаблицаФайлов.Сортировать("FullName");
	Файлы = Новый Массив;

	Для Каждого Строка Из ТаблицаФайлов Цикл
		Файлы.Добавить(Строка.File);
	КонецЦикла;

	Возврат Файлы;

КонецФункции

Функция ОтсортироватьЗаписи(Записи)

	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("File");
	Таблица.Колонки.Добавить("Line");
	Таблица.Колонки.Добавить("ExceptionType");
	Таблица.Колонки.Добавить("Record");

	Для Каждого Запись Из Записи Цикл
		Строка = Таблица.Добавить();
		Строка.File = Запись.File;
		Строка.Line = Запись.Line;
		Строка.ExceptionType = Запись.ExceptionType;
		Строка.Record = Запись;
	КонецЦикла;

	Таблица.Сортировать("File, Line, ExceptionType");

	Результат = Новый Массив;
	Для Каждого Строка Из Таблица Цикл
		Результат.Добавить(Строка.Record);
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ОтобратьПоКатегории(Записи, Категория = Неопределено, ИсключитьКатегорию = Неопределено)

	Результат = Новый Массив;
	Для Каждого Запись Из Записи Цикл
		Если Категория <> Неопределено И Запись.Disposition <> Категория Тогда
			Продолжить;
		КонецЕсли;

		Если ИсключитьКатегорию <> Неопределено И Запись.Disposition = ИсключитьКатегорию Тогда
			Продолжить;
		КонецЕсли;

		Результат.Добавить(Запись);
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция РазобратьПараметры()

	Параметры = Новый Структура("EngineRoot, SourceDirectories, JsonPath, Quiet", "", Новый Массив, "", Ложь);
	Позиционные = Новый Массив;
	Индекс = 0;

	Пока Индекс < АргументыКоманднойСтроки.Количество() Цикл
		Аргумент = АргументыКоманднойСтроки[Индекс];
		Если Аргумент = "--quiet" Или Аргумент = "-q" Тогда
			Параметры.Quiet = Истина;
		ИначеЕсли Аргумент = "--engine-root" Или Аргумент = "-e" Тогда
			Индекс = Индекс + 1;
			ПроверитьЗначениеПараметра(Индекс, Аргумент);
			Параметры.EngineRoot = АргументыКоманднойСтроки[Индекс];
		ИначеЕсли Аргумент = "--source-directory" Или Аргумент = "-s" Тогда
			Индекс = Индекс + 1;
			ПроверитьЗначениеПараметра(Индекс, Аргумент);
			Параметры.SourceDirectories.Добавить(АргументыКоманднойСтроки[Индекс]);
		ИначеЕсли Аргумент = "--json-path" Или Аргумент = "-j" Тогда
			Индекс = Индекс + 1;
			ПроверитьЗначениеПараметра(Индекс, Аргумент);
			Параметры.JsonPath = АргументыКоманднойСтроки[Индекс];
		ИначеЕсли Лев(Аргумент, 1) = "-" Тогда
			ВызватьИсключение "Неизвестный параметр: " + Аргумент;
		Иначе
			Позиционные.Добавить(Аргумент);
		КонецЕсли;
		Индекс = Индекс + 1;
	КонецЦикла;

	Если Позиционные.Количество() = 1 И ПустаяСтрока(Параметры.JsonPath) Тогда
		Параметры.JsonPath = Позиционные[0];
	ИначеЕсли Позиционные.Количество() = 2
		И ПустаяСтрока(Параметры.EngineRoot)
		И ПустаяСтрока(Параметры.JsonPath) Тогда
		Параметры.EngineRoot = Позиционные[0];
		Параметры.JsonPath = Позиционные[1];
	ИначеЕсли Позиционные.Количество() > 0 Тогда
		ВызватьИсключение "Недопустимое сочетание позиционных параметров";
	КонецЕсли;
	Если ПустаяСтрока(Параметры.JsonPath) Тогда
		ВызватьИсключение "Путь JSON-отчета не указан";
	КонецЕсли;

	Возврат Параметры;

КонецФункции

Процедура ПроверитьЗначениеПараметра(Индекс, ИмяПараметра)

	Если Индекс >= АргументыКоманднойСтроки.Количество() Тогда
		ВызватьИсключение "Не указано значение параметра " + ИмяПараметра;
	КонецЕсли;

КонецПроцедуры

Функция ПолучитьНастройкиИсточников(Параметры)

	КаталогДвижка = Параметры.EngineRoot;
	КаталогиИсходников = Параметры.SourceDirectories;

	Если КаталогиИсходников.Количество() = 0 Тогда
		Если ПустаяСтрока(КаталогДвижка) Тогда
			КаталогПроекта = Новый Файл(ОбъединитьПути(ТекущийСценарий().Каталог, "../..")).ПолноеИмя;
			КаталогРазработки = Новый Файл(КаталогПроекта).Путь;
			КаталогДвижка = ОбъединитьПути(КаталогРазработки, "OneScript");
		КонецЕсли;

		КаталогиИсходников.Добавить(ОбъединитьПути(КаталогДвижка, "src", "OneScript.Core"));
		КаталогиИсходников.Добавить(ОбъединитьПути(КаталогДвижка, "src", "OneScript.Native"));
		КаталогиИсходников.Добавить(ОбъединитьПути(КаталогДвижка, "src", "OneScript.StandardLibrary"));
		КаталогиИсходников.Добавить(ОбъединитьПути(КаталогДвижка, "src", "OneScript.Web.Server"));
	КонецЕсли;

	Если Не ПустаяСтрока(КаталогДвижка) Тогда
		КореньИсходников = Новый Файл(КаталогДвижка).ПолноеИмя;
	ИначеЕсли КаталогиИсходников.Количество() = 1 Тогда
		КореньИсходников = Новый Файл(КаталогиИсходников[0]).ПолноеИмя;
	Иначе
		КореньИсходников = Новый Файл(КаталогиИсходников[0]).Путь;
	КонецЕсли;

	ПолныеКаталоги = Новый Массив;
	Для Каждого Каталог Из КаталогиИсходников Цикл
		ПолныеКаталоги.Добавить(Новый Файл(Каталог).ПолноеИмя);
	КонецЦикла;

	Возврат Новый Структура("Root, Directories", КореньИсходников, ПолныеКаталоги);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура СформироватьПоПараметрам(Параметры)

	Источники = ПолучитьНастройкиИсточников(Параметры);
	Шаблоны = СоздатьШаблоны();
	ФайлыИсходников = ПолучитьФайлыИсходников(Источники.Directories);
	Исключения = Новый Массив;
	ПерехваченныеИсключения = Новый Массив;

	Для Каждого ФайлИсходника Из ФайлыИсходников Цикл
		ОбработатьФайл(
			ФайлИсходника.ПолноеИмя,
			ПолучитьОтносительныйПуть(Источники.Root, ФайлИсходника.ПолноеИмя),
			Исключения,
			ПерехваченныеИсключения,
			Шаблоны
		);
	КонецЦикла;

	Исключения = ОтсортироватьЗаписи(Исключения);
	ОперационныеКандидаты = ОтобратьПоКатегории(Исключения, "OperationalCandidate");
	ОшибкиПрограммирования = ОтобратьПоКатегории(Исключения, "ProgrammingError");
	НеизвестныеИсключения = ОтобратьПоКатегории(Исключения, "Unknown");
	Кандидаты = ОтобратьПоКатегории(Исключения, Неопределено, "Unknown");
	СостояниеGit = ПолучитьСостояниеGit(Источники.Root, Источники.Directories);

	ОтносительныеКаталоги = Новый Массив;
	Для Каждого Каталог Из Источники.Directories Цикл
		ОтносительныеКаталоги.Добавить(ПолучитьОтносительныйПуть(Источники.Root, Каталог));
	КонецЦикла;

	Система = Новый СистемнаяИнформация;

	Отчет = Новый Структура;
	Отчет.Вставить("SchemaVersion", 1);
	Отчет.Вставить("SourceRevision", СостояниеGit.Revision);
	Отчет.Вставить("SourceDirty", СостояниеGit.Dirty);
	Отчет.Вставить("Environment", Новый Структура("OperatingSystem, DotNetVersion", Система.ВерсияОС, ""));
	Отчет.Вставить("SourceDirectories", ОтносительныеКаталоги);
	Отчет.Вставить("FileCount", ФайлыИсходников.Количество());
	Отчет.Вставить("ExceptionCount", Исключения.Количество());
	Отчет.Вставить("CaughtExceptionCount", ПерехваченныеИсключения.Количество());
	Отчет.Вставить("CandidateCount", Кандидаты.Количество());
	Отчет.Вставить("OperationalCandidateCount", ОперационныеКандидаты.Количество());
	Отчет.Вставить("ProgrammingErrorCount", ОшибкиПрограммирования.Количество());
	Отчет.Вставить("UnknownThrowCount", НеизвестныеИсключения.Количество());
	Отчет.Вставить("Candidates", Кандидаты);
	Отчет.Вставить("OperationalCandidates", ОперационныеКандидаты);
	Отчет.Вставить("ProgrammingErrors", ОшибкиПрограммирования);
	Отчет.Вставить("UnknownThrows", НеизвестныеИсключения);
	Отчет.Вставить("CaughtExceptions", ОтсортироватьЗаписи(ПерехваченныеИсключения));

	ЗаписатьJSONВФайл(Параметры.JsonPath, Отчет);

	Если Не Параметры.Quiet Тогда
		Сообщить(
			СтрШаблон(
				"Файлов: %1; исключений: %2; кандидатов: %3; операционных: %4; программных: %5; неизвестных: %6",
				Отчет.FileCount,
				Отчет.ExceptionCount,
				Отчет.CandidateCount,
				Отчет.OperationalCandidateCount,
				Отчет.ProgrammingErrorCount,
				Отчет.UnknownThrowCount
			)
		);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти
