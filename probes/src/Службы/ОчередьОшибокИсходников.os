#Область ПрограммныйИнтерфейс

// Возвращает элементы очереди сигнатур исключений исходников OneScript.
//
// Параметры:
//   ПутьКОтчету - Строка - путь к source-error-report.json.
//   ПутьКЖурналу - Строка - путь к source-error-review.json.
//   Лимит - Число - максимальное число возвращаемых элементов.
//   ВключаяРассмотренные - Булево - включать ли элементы со статусом из журнала.
//
// Возвращаемое значение:
//   Массив - элементы очереди.
//
// Исключения:
//   Вызывает исключение, если лимит не положителен или файл JSON не прочитан.
Функция ПолучитьЭлементы(ПутьКОтчету, ПутьКЖурналу, Лимит = 50, ВключаяРассмотренные = Ложь) Экспорт

	Если Лимит <= 0 Или Лимит <> Цел(Лимит) Тогда
		ВызватьИсключение "Limit must be a positive integer";
	КонецЕсли;

	Отчет = ПрочитатьДокументJSON(ПутьКОтчету);
	Журнал = ПрочитатьДокументJSON(ПутьКЖурналу);
	Рассмотренные = ИндексироватьРассмотренныеСигнатуры(Журнал.Reviewed);
	Группы = СгруппироватьСигнатуры(Отчет);
	Элементы = Новый Массив;

	Для Каждого Пара Из Группы Цикл
		Записи = Пара.Значение;
		УпорядочитьЗаписиПоСтроке(Записи);
		ПерваяЗапись = Записи[0];
		Ключ = ПолучитьКлючСигнатуры(ПерваяЗапись);
		ЗаписьЖурнала = Рассмотренные.Получить(Ключ);

		Статус = "Unreviewed";
		Код = "";
		Примечание = "";

		Если ЗаписьЖурнала <> Неопределено Тогда
			Статус = ЗаписьЖурнала.Status;
			Код = ЗаписьЖурнала.Code;
			Примечание = ЗаписьЖурнала.Note;
		КонецЕсли;

		Если Не ВключаяРассмотренные И Статус <> "Unreviewed" Тогда
			Продолжить;
		КонецЕсли;

		Элементы.Добавить(Новый Структура(
			"File,ExceptionType,Statement,Disposition,Message,Status,Code,Note,Locations,"
				+ "ПриоритетКатегории,ПриоритетИсходника,ПерваяСтрока",
			ПерваяЗапись.File,
			ПерваяЗапись.ExceptionType,
			ПерваяЗапись.Statement,
			ПерваяЗапись.Disposition,
			ПерваяЗапись.Message,
			Статус,
			Код,
			Примечание,
			ПолучитьРасположения(Записи),
			ПолучитьПриоритетКатегории(ПерваяЗапись.Disposition),
			ПолучитьПриоритетИсходника(ПерваяЗапись.File),
			ПерваяЗапись.Line
		));
	КонецЦикла;

	УпорядочитьЭлементы(Элементы);

	Пока Элементы.Количество() > Лимит Цикл
		Элементы.Удалить(Элементы.ВГраница());
	КонецЦикла;

	Возврат УдалитьПоляСортировки(Элементы);

КонецФункции

// Возвращает решения, для которых в текущем отчете больше нет сигнатуры.
Функция ПолучитьОсиротевшие(ПутьКОтчету, ПутьКЖурналу) Экспорт

	Отчет = ПрочитатьДокументJSON(ПутьКОтчету);
	Журнал = ПрочитатьДокументJSON(ПутьКЖурналу);
	КлючиОтчета = Новый Соответствие;

	ИменаКоллекций = Новый Массив;
	ИменаКоллекций.Добавить("UnknownThrows");
	ИменаКоллекций.Добавить("OperationalCandidates");
	ИменаКоллекций.Добавить("ProgrammingErrors");

	Для Каждого ИмяКоллекции Из ИменаКоллекций Цикл
		ЗначениеКоллекции = Неопределено;
		Отчет.Свойство(ИмяКоллекции, ЗначениеКоллекции);
		Для Каждого Запись Из ЗначениеКоллекции Цикл
			КлючиОтчета.Вставить(ПолучитьКлючСигнатуры(Запись), Истина);
		КонецЦикла;
	КонецЦикла;

	Результат = Новый Массив;
	Для Каждого Запись Из Журнал.Reviewed Цикл
		Если КлючиОтчета.Получить(ПолучитьКлючСигнатуры(Запись)) = Неопределено Тогда
			Результат.Добавить(Запись);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция УдалитьПоляСортировки(Элементы)

	Результат = Новый Массив;
	Для Каждого Элемент Из Элементы Цикл
		Результат.Добавить(Новый Структура(
			"File,ExceptionType,Statement,Disposition,Message,Status,Code,Note,Locations",
			Элемент.File,
			Элемент.ExceptionType,
			Элемент.Statement,
			Элемент.Disposition,
			Элемент.Message,
			Элемент.Status,
			Элемент.Code,
			Элемент.Note,
			Элемент.Locations
		));
	КонецЦикла;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПрочитатьДокументJSON(Путь)

	Чтение = Новый ЧтениеJSON;
	Чтение.ОткрытьФайл(Путь);

	Попытка
		Документ = ПрочитатьJSON(Чтение);
	Исключение
		Чтение.Закрыть();
		ВызватьИсключение;
	КонецПопытки;

	Чтение.Закрыть();

	Возврат Документ;

КонецФункции

Функция ИндексироватьРассмотренныеСигнатуры(ЗаписиЖурнала)

	Результат = Новый Соответствие;
	Для Каждого Запись Из ЗаписиЖурнала Цикл
		Ключ = ПолучитьКлючСигнатуры(Запись);
		Если Результат.Получить(Ключ) <> Неопределено Тогда
			ВызватьИсключение "Duplicate reviewed signature: " + Ключ;
		КонецЕсли;

		Результат.Вставить(Ключ, Запись);
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция СгруппироватьСигнатуры(Отчет)

	Результат = Новый Соответствие;
	ИменаКоллекций = Новый Массив;
	ИменаКоллекций.Добавить("UnknownThrows");
	ИменаКоллекций.Добавить("OperationalCandidates");
	ИменаКоллекций.Добавить("ProgrammingErrors");

	Для Каждого ИмяКоллекции Из ИменаКоллекций Цикл
		Для Каждого Запись Из Отчет[ИмяКоллекции] Цикл
			Ключ = ПолучитьКлючСигнатуры(Запись);
			Записи = Результат.Получить(Ключ);
			Если Записи = Неопределено Тогда
				Записи = Новый Массив;
				Результат.Вставить(Ключ, Записи);
			КонецЕсли;
			Записи.Добавить(Запись);
		КонецЦикла;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ПолучитьКлючСигнатуры(Запись)

	Возврат НРег(Запись.File + Символы.ПС + Запись.ExceptionType + Символы.ПС + Запись.Statement);

КонецФункции

Функция ПолучитьРасположения(Записи)

	Результат = Новый Массив;
	Для Каждого Запись Из Записи Цикл
		Результат.Добавить(Новый Структура(
			"Line,OneScriptObject,OneScriptMethod",
			Запись.Line,
			Запись.OneScriptObject,
			Запись.OneScriptMethod
		));
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ПолучитьПриоритетИсходника(Путь)

	НормализованныйПуть = НРег(СтрЗаменить(Путь, "\", "/"));
	Если СтрНайти(НормализованныйПуть, "/onescript.standardlibrary/") > 0 Тогда
		Возврат 0;
	ИначеЕсли СтрНайти(НормализованныйПуть, "/onescript.web.server/") > 0 Тогда
		Возврат 1;
	ИначеЕсли СтрНайти(НормализованныйПуть, "/onescript.native/") > 0 Тогда
		Возврат 2;
	ИначеЕсли СтрНайти(НормализованныйПуть, "/onescript.core/") > 0 Тогда
		Возврат 3;
	КонецЕсли;

	Возврат 4;

КонецФункции

Функция ПолучитьПриоритетКатегории(Категория)

	Если Категория = "Unknown" Тогда
		Возврат 0;
	ИначеЕсли Категория = "OperationalCandidate" Тогда
		Возврат 1;
	ИначеЕсли Категория = "ProgrammingError" Тогда
		Возврат 2;
	КонецЕсли;

	Возврат 3;

КонецФункции

Процедура УпорядочитьЗаписиПоСтроке(Записи)

	Для Индекс = 1 По Записи.ВГраница() Цикл
		ПредыдущийИндекс = Индекс - 1;
		Пока ПредыдущийИндекс >= 0 Цикл
			Если Записи[ПредыдущийИндекс].Line <= Записи[ПредыдущийИндекс + 1].Line Тогда
				Прервать;
			КонецЕсли;

			ОбменятьЭлементы(Записи, ПредыдущийИндекс, ПредыдущийИндекс + 1);
			ПредыдущийИндекс = ПредыдущийИндекс - 1;
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

Процедура УпорядочитьЭлементы(Элементы)

	Для Индекс = 1 По Элементы.ВГраница() Цикл
		ПредыдущийИндекс = Индекс - 1;
		Пока ПредыдущийИндекс >= 0 Цикл
			Если Не ДолженПредшествовать(Элементы[ПредыдущийИндекс + 1], Элементы[ПредыдущийИндекс]) Тогда
				Прервать;
			КонецЕсли;

			ОбменятьЭлементы(Элементы, ПредыдущийИндекс, ПредыдущийИндекс + 1);
			ПредыдущийИндекс = ПредыдущийИндекс - 1;
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

Функция ДолженПредшествовать(Левый, Правый)

	Если Левый.ПриоритетКатегории <> Правый.ПриоритетКатегории Тогда
		Возврат Левый.ПриоритетКатегории < Правый.ПриоритетКатегории;
	КонецЕсли;

	Если Левый.ПриоритетИсходника <> Правый.ПриоритетИсходника Тогда
		Возврат Левый.ПриоритетИсходника < Правый.ПриоритетИсходника;
	КонецЕсли;

	Если Левый.File <> Правый.File Тогда
		Возврат Левый.File < Правый.File;
	КонецЕсли;

	Возврат Левый.ПерваяСтрока < Правый.ПерваяСтрока;

КонецФункции

Процедура ОбменятьЭлементы(Коллекция, ПервыйИндекс, ВторойИндекс)

	ВременныйЭлемент = Коллекция[ПервыйИндекс];
	Коллекция[ПервыйИндекс] = Коллекция[ВторойИндекс];
	Коллекция[ВторойИндекс] = ВременныйЭлемент;

КонецПроцедуры

#КонецОбласти
