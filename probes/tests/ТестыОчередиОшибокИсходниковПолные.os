#Использовать asserts
#Использовать tempfiles
#Использовать "../src"

#Область ОбработчикиСобытий

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура ПодготовитьВременныеФайлы() Экспорт

	ВременныеФайлы.Удалить();

КонецПроцедуры

&ПослеКаждого
Процедура ПослеКаждого() Экспорт

	ВременныеФайлы.Удалить();

КонецПроцедуры

#КонецОбласти

#Область Тесты

&Тест
Процедура ТестДолжен_СформироватьПолнуюОчередьИсходныхОшибок() Экспорт

	// Подготовка
	Отчет = ПутьКФикстуре("worklist-report.json");
	Журнал = ПутьКФикстуре("worklist-review.json");
	Очередь = Новый ОчередьОшибокИсходников;

	// Действие
	Элементы = Очередь.ПолучитьЭлементы(Отчет, Журнал, 50);
	ВсеЭлементы = Очередь.ПолучитьЭлементы(Отчет, Журнал, 50, Истина);

	// Проверка
	Ожидаем.Что(Элементы.Количество()).Равно(4);
	Ожидаем.Что(Элементы[0].File).Равно("Engine\OneScript.StandardLibrary\FeatureLibrary.cs");
	Ожидаем.Что(СодержитФайл(Элементы, "Engine\FeatureA.cs")).Равно(Ложь);
	Ожидаем.Что(СодержитКатегорию(Элементы, "OperationalCandidate")).Равно(Истина);
	Ожидаем.Что(СодержитКатегорию(Элементы, "ProgrammingError")).Равно(Истина);
	Ожидаем.Что(ВсеЭлементы.Количество()).Равно(5);

	Рассмотренный = НайтиПоСтатусу(ВсеЭлементы, "Covered");
	Ожидаем.Что(Рассмотренный.Code).Равно("example.covered");
	Ожидаем.Что(Рассмотренный.Locations.Количество()).Равно(2);

КонецПроцедуры

&Тест
Процедура ТестДолжен_НайтиОсиротевшееРешениеИсходнойОшибки() Экспорт

	// Подготовка
	Очередь = Новый ОчередьОшибокИсходников;

	// Действие
	Элементы = Очередь.ПолучитьОсиротевшие(
		ПутьКФикстуре("worklist-report.json"),
		ПутьКФикстуре("worklist-review.json")
	);

	// Проверка
	Ожидаем.Что(Элементы.Количество()).Равно(1);
	Ожидаем.Что(Элементы[0].File).Равно("Engine\RemovedFeature.cs");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОтклонитьДубликатИЛимитОчередиИсходныхОшибок() Экспорт

	// Подготовка
	Очередь = Новый ОчередьОшибокИсходников;
	Отчет = ПутьКФикстуре("worklist-report.json");
	
	ПараметрыДубликата = Новый Массив;
	ПараметрыДубликата.Добавить(Отчет);
	ПараметрыДубликата.Добавить(ПутьКФикстуре("worklist-review-duplicate.json"));
	ПараметрыДубликата.Добавить(50);
	
	ПараметрыЛимита = Новый Массив;
	ПараметрыЛимита.Добавить(Отчет);
	ПараметрыЛимита.Добавить(ПутьКФикстуре("worklist-review.json"));
	ПараметрыЛимита.Добавить(0);
	
	ПараметрыДробногоЛимита = Новый Массив;
	ПараметрыДробногоЛимита.Добавить(Отчет);
	ПараметрыДробногоЛимита.Добавить(ПутьКФикстуре("worklist-review.json"));
	ПараметрыДробногоЛимита.Добавить(1.5);

	// Действие и Проверка
	Ожидаем.Что(Очередь)
		.Метод("ПолучитьЭлементы", ПараметрыДубликата)
		.ВыбрасываетИсключение("Duplicate reviewed signature");
	Ожидаем.Что(Очередь)
		.Метод("ПолучитьЭлементы", ПараметрыЛимита)
		.ВыбрасываетИсключение("Limit must be a positive integer");
	Ожидаем.Что(Очередь)
		.Метод("ПолучитьЭлементы", ПараметрыДробногоЛимита)
		.ВыбрасываетИсключение("Limit must be a positive integer");

КонецПроцедуры

&Тест
Процедура ТестДолжен_СохранитьПустуюОчередьJSONМассивом() Экспорт

	// Подготовка
	Каталог = ВременныеФайлы.СоздатьКаталог();

	ПутьКОтчету = ОбъединитьПути(Каталог, "report.json");
	ПутьКЖурналу = ОбъединитьПути(Каталог, "review.json");
	
	ЗаписатьДокумент(ПутьКОтчету, ПустойОтчет());
	ЗаписатьДокумент(ПутьКЖурналу, Новый Структура("Version,Reviewed", 1, Новый Массив));

	// Действие
	Очередь = Новый ОчередьОшибокИсходников;
	Элементы = Очередь.ПолучитьЭлементы(ПутьКОтчету, ПутьКЖурналу, 50);

	// Проверка
	Ожидаем.Что(Элементы.Количество()).Равно(0);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СодержитФайл(Элементы, ИмяФайла)

	Для Каждого Элемент Из Элементы Цикл
		Если Элемент.File = ИмяФайла Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

Функция СодержитКатегорию(Элементы, Категория)

	Для Каждого Элемент Из Элементы Цикл
		Если Элемент.Disposition = Категория Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

Функция НайтиПоСтатусу(Элементы, Статус)

	Для Каждого Элемент Из Элементы Цикл
		Если Элемент.Status = Статус Тогда
			Возврат Элемент;
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

Функция ПустойОтчет()

	Возврат Новый Структура(
		"SchemaVersion,SourceDirectories,FileCount,ExceptionCount,CaughtExceptionCount,CandidateCount,"
			+ "OperationalCandidateCount,ProgrammingErrorCount,UnknownThrowCount,Candidates,UnknownThrows,"
			+ "OperationalCandidates,ProgrammingErrors,CaughtExceptions",
		1, Новый Массив, 0, 0, 0, 0, 0, 0, 0, Новый Массив, Новый Массив,
		Новый Массив, Новый Массив, Новый Массив
	);

КонецФункции

Процедура ЗаписатьДокумент(Путь, Документ)

	Запись = Новый ЗаписьJSON;
	Запись.ОткрытьФайл(Путь);
	ЗаписатьJSON(Запись, Документ);
	Запись.Закрыть();

КонецПроцедуры

Функция ПутьКФикстуре(ИмяФайла)

	Возврат ОбъединитьПути(ТекущийСценарий().Каталог, "fixtures", ИмяФайла);

КонецФункции

Функция ПутьКПробам()

	Возврат Новый Файл(ОбъединитьПути(ТекущийСценарий().Каталог, "..")).ПолноеИмя;

КонецФункции

#КонецОбласти
