#Использовать asserts

#Область ОбработчикиСобытий

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

#КонецОбласти

#Область Тесты

&Тест
Процедура ТестДолжен_СодержатьСлужбыКлассыИДанные() Экспорт

	// Подготовка
	КаталогПроб = ПутьКПробам();
	КаталогСлужб = ОбъединитьПути(КаталогПроб, "src", "Службы");
	КаталогКлассов = ОбъединитьПути(КаталогПроб, "src", "Классы");
	КаталогДанных = ОбъединитьПути(КаталогПроб, "data");

	// Действие и Проверка
	Для Каждого ИмяФайла Из ИменаСлужб() Цикл
		Ожидаем.Что(Новый Файл(ОбъединитьПути(КаталогСлужб, ИмяФайла)).Существует()).Равно(Истина);
	КонецЦикла;

	Для Каждого ИмяФайла Из ИменаКлассов() Цикл
		Ожидаем.Что(Новый Файл(ОбъединитьПути(КаталогКлассов, ИмяФайла)).Существует()).Равно(Истина);
	КонецЦикла;

	Для Каждого ИмяФайла Из ИменаФайловДанных() Цикл
		Ожидаем.Что(Новый Файл(ОбъединитьПути(КаталогДанных, ИмяФайла)).Существует()).Равно(Истина);
	КонецЦикла;

	Ожидаем.Что(Новый Файл(ОбъединитьПути(КаталогПроб, "probes.os")).Существует()).Равно(Истина);

КонецПроцедуры

&Тест
Процедура ТестДолжен_НеСодержатьСсылкиНаPowerShellВИсполняемомКоде() Экспорт

	// Подготовка
	КаталогПроб = ПутьКПробам();

	Файлы = НайтиФайлы(ОбъединитьПути(КаталогПроб, "src"), "*.os", Истина);

	Файлы.Добавить(Новый Файл(ОбъединитьПути(КаталогПроб, "probes.os")));

	// Действие и Проверка
	Для Каждого Файл Из Файлы Цикл
		Текст = НРег(ПрочитатьТекст(Файл.ПолноеИмя));

		Ожидаем.Что(СтрНайти(Текст, ".ps1") = 0).Равно(Истина);
		Ожидаем.Что(СтрНайти(Текст, "powershell") = 0).Равно(Истина);
		Ожидаем.Что(СтрНайти(Текст, "pwsh") = 0).Равно(Истина);
	КонецЦикла;

КонецПроцедуры

&Тест
Процедура ТестДолжен_СобиратьИсходникиПередСтатическимОбновлением() Экспорт

	// Подготовка
	ПутьККоманде = ОбъединитьПути(
		ПутьКПробам(),
		"src",
		"Команды",
		"КомандаDataОбновитьИсходники.os"
	);
	ТекстКоманды = ПрочитатьТекст(ПутьККоманде);

	// Действие
	ПозицияСборки = СтрНайти(ТекстКоманды, "УстановитьКоманду(""dotnet"")");
	ПозицияАнализатораИсходников = СтрНайти(ТекстКоманды, "Новый АнализаторОшибокИсходников");
	ПозицияАнализатораГраниц = СтрНайти(ТекстКоманды, "Новый АнализаторВнешнихГраниц");

	// Проверка
	Ожидаем.Что(ПозицияСборки > 0).Равно(Истина);
	Ожидаем.Что(СтрНайти(ТекстКоманды, "OneScript.Web.Server.csproj") > 0).Равно(Истина);
	Ожидаем.Что(СтрНайти(ТекстКоманды, "УникальныйИдентификатор") > 0).Равно(Истина);
	Ожидаем.Что(ПозицияСборки < ПозицияАнализатораИсходников).Равно(Истина);
	Ожидаем.Что(ПозицияСборки < ПозицияАнализатораГраниц).Равно(Истина);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ИменаСлужб()

	Результат = Новый Массив;
	Результат.Добавить("АнализаторВнешнихГраниц.os");
	Результат.Добавить("АнализаторОшибокИсходников.os");
	Результат.Добавить("МатрицаОшибокБазовыхТиповЛокалей.os");

	Возврат Результат;

КонецФункции

Функция ИменаКлассов()

	Результат = Новый Массив;
	Результат.Добавить("АнализаторОшибокТестовOneScript.os");
	Результат.Добавить("МатрицаОшибокБазовыхТипов.os");

	Возврат Результат;

КонецФункции

Функция ИменаФайловДанных()

	Результат = Новый Массив;
	Результат.Добавить("source-error-report.json");
	Результат.Добавить("source-error-review.json");
	Результат.Добавить("external-call-boundaries.json");
	Результат.Добавить("external-call-boundary-review.json");
	Результат.Добавить("onescript-test-error-results.json");
	Результат.Добавить("base-type-error-matrix-results.json");

	Возврат Результат;

КонецФункции

Функция ПрочитатьТекст(Путь)

	Чтение = Новый ЧтениеТекста(Путь, КодировкаТекста.UTF8);
	Текст = Чтение.Прочитать();
	Чтение.Закрыть();

	Возврат Текст;

КонецФункции

Функция ПутьКПробам()

	Возврат Новый Файл(ОбъединитьПути(ТекущийСценарий().Каталог, "..")).ПолноеИмя;

КонецФункции

#КонецОбласти
