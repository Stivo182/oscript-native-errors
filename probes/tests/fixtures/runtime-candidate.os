Функция ПолучитьСписокТестов(Тесты) Экспорт

	СписокТестов = Новый Массив;
	СписокТестов.Добавить("ТестДолжен_ВызватьОшибкуНедопустимогоЗначения");
	СписокТестов.Добавить("ТестДолжен_ЗавершитьсяБезИсключения");
	СписокТестов.Добавить("ТестДолжен_ОбработатьВнутреннееИсключение");
	СписокТестов.Добавить("ТестДолжен_ПроверитьИсключениеЧерезОжидание");
	СписокТестов.Добавить("ТестДолжен_НеЛоматьКонструкциюБезТочкиСЗапятой");
	СписокТестов.Добавить("ТестДолжен_НормализоватьВременныйПуть");

	Возврат СписокТестов;

КонецФункции

Процедура ТестДолжен_ВызватьОшибкуНедопустимогоЗначения() Экспорт

	Попытка
		Массив = Новый Массив(-1);
	Исключение
		ВызватьИсключение "Тестовая ошибка";
	КонецПопытки;

КонецПроцедуры

Процедура ТестДолжен_НормализоватьВременныйПуть() Экспорт

	Попытка
		Чтение = Новый ЧтениеТекста;
		Чтение.Открыть(ОбъединитьПути(КаталогВременныхФайлов(), "missing-native-errors-probe.txt"));
	Исключение
		ВызватьИсключение "Тестовая ошибка";
	КонецПопытки;

КонецПроцедуры

Процедура ТестДолжен_НеЛоматьКонструкциюБезТочкиСЗапятой() Экспорт

	Для Индекс = 1 По 1 Цикл
		Попытка
			Прервать
		Исключение
			ВызватьИсключение "Тестовая ошибка";
		КонецПопытки
	КонецЦикла;

КонецПроцедуры

Процедура ТестДолжен_ОбработатьВнутреннееИсключение() Экспорт

	Попытка
		Попытка
			Массив = Новый Массив(-1);
		Исключение
			Значение = Неопределено;
		КонецПопытки;
	Исключение
		ВызватьИсключение "Тестовая ошибка";
	КонецПопытки;

КонецПроцедуры

Процедура ТестДолжен_ЗавершитьсяБезИсключения() Экспорт

	Попытка
		Значение = 1;
	Исключение
		ВызватьИсключение "Тестовая ошибка";
	КонецПопытки;

КонецПроцедуры

Процедура ТестДолжен_ПроверитьИсключениеЧерезОжидание() Экспорт

	Ожидаем.Что(
		ЭтотОбъект
	).Метод("ВызватьОшибкуНедопустимогоЗначения").ВыбрасываетИсключение("Неверное значение аргумента");

КонецПроцедуры

Процедура ВызватьОшибкуНедопустимогоЗначения() Экспорт

	Массив = Новый Массив(-1);

КонецПроцедуры
