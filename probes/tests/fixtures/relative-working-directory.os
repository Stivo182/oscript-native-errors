Функция ПолучитьСписокТестов(Тесты) Экспорт

	СписокТестов = Новый Массив;
	СписокТестов.Добавить("ТестДолжен_ПрочитатьОтносительнуюФикстуру");

	Возврат СписокТестов;

КонецФункции

Процедура ТестДолжен_ПрочитатьОтносительнуюФикстуру() Экспорт

	ЗапрещенныйПуть = "..\outside-marker.txt";

	Попытка
		Чтение = Новый ЧтениеТекста;
		Чтение.Открыть("relative-working-directory.txt");
		Чтение.Закрыть();

		КаталогСценария = Новый Файл(ТекущийСценарий().Источник).Путь;
		Чтение.Открыть(ОбъединитьПути(КаталогСценария, "relative-working-directory.txt"));
		Чтение.Закрыть();
	Исключение
		ВызватьИсключение "Тестовая ошибка";
	КонецПопытки;

КонецПроцедуры
