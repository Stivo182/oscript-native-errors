ПутьТеста = АргументыКоманднойСтроки[0];
ИмяКласса = "ТестПроб" + СтрЗаменить(Строка(Новый УникальныйИдентификатор), "-", "");
ПодключитьСценарий(ПутьТеста, ИмяКласса);
Тест = Новый(ИмяКласса);
Рефлектор = Новый Рефлектор;

Для Каждого ИмяТеста Из Тест.ПолучитьСписокТестов(Неопределено) Цикл
	Попытка
		Рефлектор.ВызватьМетод(Тест, ИмяТеста);
	Исключение
		Сообщить(ОписаниеОшибки());
	КонецПопытки;
КонецЦикла;
