&Тест
Процедура ТестДолжен_ОтклонитьНекатегоризированногоКандидата() Экспорт

	// Подготовка
	Документ = ПрочитатьДокумент(ПутьКДанным("source-error-report.json"));
	Документ.Candidates.Добавить(Новый Структура(
		"File,Line,ExceptionType,Statement",
		"Engine/UncategorizedCandidate.cs",
		1,
		"RuntimeException",
		"throw new RuntimeException();"
	));
	Документ.CandidateCount = Документ.CandidateCount + 1;
	Документ.ExceptionCount = Документ.ExceptionCount + 1;

	// Действие и Проверка
	ПроверитьОшибкаКонтракта(
		ЗаписатьВременныйДокумент(Документ),
		"SourceReport",
		"Source error report CandidateCount must equal categorized candidate counts"
	);

