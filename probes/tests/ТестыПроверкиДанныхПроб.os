	// Действие и Проверка
	Проверка.ПроверитьФайл(ПутьКДанным("source-error-report.json"), "SourceReport");
	Проверка.ПроверитьФайл(ПутьКДанным("source-error-review.json"), "SourceReview");
	Проверка.ПроверитьФайл(ПутьКДанным("onescript-test-error-results.json"), "RuntimeReport");
