&Тест
Процедура ТестДолжен_СопоставитьРешениеИсходниковБезУчетаРегистра() Экспорт

	// Подготовка
	КаталогФикстур = ПутьКФикстурам();
	
	Журнал = ПрочитатьДокумент(ОбъединитьПути(КаталогФикстур, "worklist-review.json"));
	Журнал.Reviewed.Удалить(1);
	Журнал.Reviewed[0].File = ВРег(Журнал.Reviewed[0].File);
	Журнал.Reviewed[0].ExceptionType = ВРег(Журнал.Reviewed[0].ExceptionType);
	Журнал.Reviewed[0].Statement = ВРег(Журнал.Reviewed[0].Statement);

	// Действие
	Решения = Новый ПроверкаДанныхПроб().ПолучитьОсиротевшиеРешения(
		ОбъединитьПути(КаталогФикстур, "worklist-report.json"),
		ЗаписатьВременныйДокумент(Журнал)
	);

	// Проверка
	Ожидаем.Что(Решения.Количество()).Равно(0);

