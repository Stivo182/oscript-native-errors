	// Действие и Проверка
	Проверка.ПроверитьВнешниеГраницы(
		ПутьКПробам(),
		ОбъединитьПути(КаталогФикстур, "external-boundary-report.json"),
		ОбъединитьПути(КаталогФикстур, "external-boundary-review.json")
	);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОтклонитьНеверныйСчетчикВнешнихГраниц() Экспорт

	// Подготовка
	КаталогФикстур = ПутьКФикстурам();
	Документ = ПрочитатьДокумент(ОбъединитьПути(КаталогФикстур, "external-boundary-report.json"));
	Документ.BoundaryCount = 0;
	ПутьКОтчету = ЗаписатьВременныйДокумент(Документ);
	Проверка = Новый ПроверкаДанныхПроб;

	// Действие и Проверка
	Попытка
		Проверка.ПроверитьВнешниеГраницы(
			ПутьКПробам(),
			ПутьКОтчету,
			ОбъединитьПути(КаталогФикстур, "external-boundary-review.json")
		);
		ВызватьИсключение "Ожидалась ошибка контракта внешних границ";
	Исключение
		Ожидаем.Что(ОписаниеОшибки()).Содержит("BoundaryCount does not match Boundaries.Count");
	КонецПопытки;

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОпубликоватьПодготовленныеДанныеИУдалитьРезерв() Экспорт

	// Подготовка
	КаталогКорня = СоздатьВременныйКаталог();
	КаталогПодготовки = ОбъединитьПути(КаталогКорня, "staging");
	КаталогДанных = ОбъединитьПути(КаталогКорня, "data");
	
	СоздатьКаталог(КаталогПодготовки);
	СоздатьКаталог(КаталогДанных);

	ЗаписатьТекст(ОбъединитьПути(КаталогПодготовки, "a.json"), "новое значение A");
	ЗаписатьТекст(ОбъединитьПути(КаталогПодготовки, "b.json"), "новое значение B");
	ЗаписатьТекст(ОбъединитьПути(КаталогДанных, "a.json"), "старое значение A");
	ЗаписатьТекст(ОбъединитьПути(КаталогДанных, "b.json"), "старое значение B");
	
	ИменаФайлов = Новый Массив;
	ИменаФайлов.Добавить("a.json");
	ИменаФайлов.Добавить("b.json");

	// Действие
	Обновление = Новый ОбновлениеRuntimeДанныхПроб;
	Обновление.Опубликовать(КаталогПодготовки, КаталогДанных, ИменаФайлов);

	// Проверка
	Ожидаем.Что(ПрочитатьТекст(ОбъединитьПути(КаталогДанных, "a.json"))).Равно("новое значение A");
	Ожидаем.Что(ПрочитатьТекст(ОбъединитьПути(КаталогДанных, "b.json"))).Равно("новое значение B");
	
	Резервы = НайтиФайлы(КаталогДанных, ".backup-*");
	Ожидаем.Что(Резервы.Количество()).Равно(0);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВосстановитьЗамененныйФайлПриОшибкеПубликации() Экспорт

	// Подготовка
	КаталогКорня = СоздатьВременныйКаталог();
	КаталогПодготовки = ОбъединитьПути(КаталогКорня, "staging");
	КаталогДанных = ОбъединитьПути(КаталогКорня, "data");
	
	СоздатьКаталог(КаталогПодготовки);
	СоздатьКаталог(КаталогДанных);

	ЗаписатьТекст(ОбъединитьПути(КаталогПодготовки, "a.json"), "новое значение A");
	ЗаписатьТекст(ОбъединитьПути(КаталогПодготовки, "b.json"), "новое значение B");
	ЗаписатьТекст(ОбъединитьПути(КаталогДанных, "a.json"), "старое значение A");
	ЗаписатьТекст(ОбъединитьПути(КаталогДанных, "b.json"), "старое значение B");
	
	ИменаФайлов = Новый Массив;
	ИменаФайлов.Добавить("a.json");
	ИменаФайлов.Добавить("b.json");
	
	Блокировка = Новый ФайловыйПоток(
		ОбъединитьПути(КаталогДанных, "b.json"),
		РежимОткрытияФайла.Открыть,
		ДоступКФайлу.Запись
	);

	Обновление = Новый ОбновлениеRuntimeДанныхПроб;
	ОшибкаПубликации = Неопределено;

	// Действие
	Попытка
		Обновление.Опубликовать(КаталогПодготовки, КаталогДанных, ИменаФайлов);
	Исключение
		ОшибкаПубликации = ИнформацияОбОшибке();
	КонецПопытки;

	Блокировка.Закрыть();

	// Проверка
	Ожидаем.Что(ОшибкаПубликации <> Неопределено).ЭтоИстина();
	Ожидаем.Что(ПрочитатьТекст(ОбъединитьПути(КаталогДанных, "a.json"))).Равно("старое значение A");
	Ожидаем.Что(ПрочитатьТекст(ОбъединитьПути(КаталогДанных, "b.json"))).Равно("старое значение B");
	Ожидаем.Что(НайтиФайлы(КаталогДанных, ".backup-*").Количество()).Равно(0);

КонецПроцедуры

&Тест
Процедура ТестДолжен_СохранитьПолныйРезервПриОшибкеОткатаПубликации() Экспорт

	// Подготовка
	КаталогКорня = СоздатьВременныйКаталог();
	КаталогПодготовки = ОбъединитьПути(КаталогКорня, "staging");
	КаталогДанных = ОбъединитьПути(КаталогКорня, "data");

	СоздатьКаталог(КаталогПодготовки);
	СоздатьКаталог(КаталогДанных);

	ИменаФайлов = Новый Массив;
	ИменаФайлов.Добавить("a.json");
	Для Индекс = 0 По 99 Цикл
		ИменаФайлов.Добавить("padding-" + Строка(Индекс) + ".json");
	КонецЦикла;
	ИменаФайлов.Добавить("b.json");

	Для Каждого ИмяФайла Из ИменаФайлов Цикл
		ЗаписатьТекст(ОбъединитьПути(КаталогПодготовки, ИмяФайла), "новое значение " + ИмяФайла);
		ЗаписатьТекст(ОбъединитьПути(КаталогДанных, ИмяФайла), "старое значение " + ИмяФайла);
	КонецЦикла;

	ПутьГотовности = ОбъединитьПути(КаталогКорня, "watcher-ready");
	ПутьБлокировки = ОбъединитьПути(КаталогКорня, "backup-locked");
	ПутьОсвобождения = ОбъединитьПути(КаталогКорня, "release-watcher");
	ПроцессБлокировки = ЗапуститьБлокировщикРезерва(
		КаталогДанных,
		"padding-50.json",
		ПутьГотовности,
		ПутьБлокировки,
		ПутьОсвобождения
	);

	ОжидатьПоявлениеФайла(ПутьГотовности, 30);

	БлокировкаНазначения = Новый ФайловыйПоток(
		ОбъединитьПути(КаталогДанных, "b.json"),
		РежимОткрытияФайла.Открыть,
		ДоступКФайлу.Запись
	);

	Обновление = Новый ОбновлениеRuntimeДанныхПроб;
	ОшибкаПубликации = Неопределено;

	// Действие
	Попытка
		Обновление.Опубликовать(КаталогПодготовки, КаталогДанных, ИменаФайлов);
	Исключение
		ОшибкаПубликации = ИнформацияОбОшибке();
	КонецПопытки;

	БлокировкаНазначения.Закрыть();
	
	ЗаписатьТекст(ПутьОсвобождения, "release");
	
	ПроцессБлокировки.ОжидатьЗавершения();
	ВыводБлокировщика = ПроцессБлокировки.ПотокВывода.Прочитать()
		+ ПроцессБлокировки.ПотокОшибок.Прочитать();

	// Проверка
	Ожидаем.Что(ПроцессБлокировки.КодВозврата).Равно(0);
	Ожидаем.Что(ВыводБлокировщика).Содержит("LOCKED");
	Ожидаем.Что(Новый Файл(ПутьБлокировки).Существует()).ЭтоИстина();
	Ожидаем.Что(ОшибкаПубликации <> Неопределено).ЭтоИстина();
	Ожидаем.Что(ОшибкаПубликации.Описание).Содержит("Probe data rollback failed");
	
	Резервы = НайтиФайлы(КаталогДанных, ".backup-*");
	Ожидаем.Что(Резервы.Количество()).Равно(1);
	Ожидаем.Что(ОшибкаПубликации.Описание).Содержит(Резервы[0].ПолноеИмя);
	
	Для Каждого ИмяФайла Из ИменаФайлов Цикл
		ПутьКРезервномуФайлу = ОбъединитьПути(Резервы[0].ПолноеИмя, ИмяФайла);
		Ожидаем.Что(Новый Файл(ПутьКРезервномуФайлу).Существует()).ЭтоИстина();
		Ожидаем.Что(ПрочитатьТекст(ПутьКРезервномуФайлу)).Равно("старое значение " + ИмяФайла);
	КонецЦикла;
	
	Ожидаем.Что(ПрочитатьТекст(ОбъединитьПути(КаталогДанных, "a.json"))).Равно("старое значение a.json");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОтклонитьПовторИмениПриПубликацииДанных() Экспорт

	// Подготовка
	КаталогКорня = СоздатьВременныйКаталог();
	КаталогПодготовки = ОбъединитьПути(КаталогКорня, "staging");
	КаталогДанных = ОбъединитьПути(КаталогКорня, "data");
	
	СоздатьКаталог(КаталогПодготовки);
	СоздатьКаталог(КаталогДанных);

	ЗаписатьТекст(ОбъединитьПути(КаталогПодготовки, "a.json"), "новое значение");
	ЗаписатьТекст(ОбъединитьПути(КаталогДанных, "a.json"), "старое значение");
	
	ИменаФайлов = Новый Массив;
	ИменаФайлов.Добавить("a.json");
	ИменаФайлов.Добавить("A.json");

	// Действие и Проверка
	Обновление = Новый ОбновлениеRuntimeДанныхПроб;
	Попытка
		Обновление.Опубликовать(КаталогПодготовки, КаталогДанных, ИменаФайлов);
		ВызватьИсключение "Ожидалась ошибка повторного имени";
	Исключение
		Ожидаем.Что(ОписаниеОшибки()).Содержит("Probe data file name must be unique");
	КонецПопытки;

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОтклонитьИзмененныеТестыДвижкаПриОбновленииRuntime() Экспорт

	// Подготовка
	КаталогИсходников = СоздатьВременныйКаталог();
	СоздатьКаталог(ОбъединитьПути(КаталогИсходников, "tests"));
	ЗаписатьТекст(ОбъединитьПути(КаталогИсходников, "tests", "НовыйТест.os"), "Тест");
	ИнициализироватьGitРепозиторий(КаталогИсходников);
	Обновление = Новый ОбновлениеRuntimeДанныхПроб;
	Ошибка = "";

	// Действие
	Попытка
		Обновление.Обновить(
			ПутьКПробам(),
			КаталогИсходников,
			ПутьКДанным("source-error-review.json")
		);
	Исключение
		Ошибка = ОписаниеОшибки();
	КонецПопытки;

	// Проверка
	Ожидаем.Что(Ошибка).Содержит("незакоммиченные изменения");
	Ожидаем.Что(Ошибка).Содержит("tests");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ДобавитьКонтрольнуюСуммуRuntimeБезПутиКФайлу() Экспорт

	// Подготовка
	ПутьКОтчетуВыполнения = ЗаписатьВременныйТекст("{""SchemaVersion"":1,""Results"":[]}");
	ПутьКОтчетуМатрицы = ЗаписатьВременныйТекст("{""SchemaVersion"":1,""Locales"":[]}");
	ПутьКOneScript = ПутьКДанным("source-error-review.json");
	ПутиКОтчетам = Новый Массив;
	ПутиКОтчетам.Добавить(ПутьКОтчетуВыполнения);
	ПутиКОтчетам.Добавить(ПутьКОтчетуМатрицы);

	// Действие
	Обновление = Новый ОбновлениеRuntimeДанныхПроб;
	Обновление.ДобавитьКонтрольнуюСуммуRuntime(ПутиКОтчетам, ПутьКOneScript);

	// Проверка
	Хеширование = Новый ХешированиеДанных(ХешФункция.SHA256);
	Хеширование.ДобавитьФайл(ПутьКOneScript);

	Для Каждого ПутьКОтчету Из ПутиКОтчетам Цикл
		Документ = ПрочитатьДокумент(ПутьКОтчету);
		Ожидаем.Что(Документ.RuntimeExecutableSha256).Равно(Хеширование.ХешСуммаСтрокой);
		Ожидаем.Что(СтрНайти(ПрочитатьТекст(ПутьКОтчету), ПутьКOneScript) = 0).ЭтоИстина();
	КонецЦикла;

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОтклонитьНеполнуюФормуМатрицыБазовыхТипов() Экспорт

	// Подготовка
	Документ = ПрочитатьДокумент(ПутьКДанным("base-type-error-matrix-results.json"));
	Локаль = Документ.Locales[0];
	Локаль.Types[0].Name = Локаль.Types[1].Name;

	// Действие и Проверка
	Проверка = Новый ПроверкаДанныхПроб;
	Попытка
		Проверка.ПроверитьФормуМатрицы(Локаль, "locale");
		ВызватьИсключение "Ожидалась ошибка формы матрицы";
	Исключение
		Ожидаем.Что(ОписаниеОшибки()).Содержит("does not contain exactly one");
	КонецПопытки;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПроверитьОшибкаКонтракта(Путь, Вид, ОжидаемыйТекст)

	Проверка = Новый ПроверкаДанныхПроб;
	Попытка
		Проверка.ПроверитьФайл(Путь, Вид);
		ВызватьИсключение "Ожидалась ошибка контракта";
	Исключение
		Ожидаем.Что(ОписаниеОшибки()).Содержит(ОжидаемыйТекст);
	КонецПопытки;

КонецПроцедуры

Функция ПрочитатьДокумент(Путь)

	Чтение = Новый ЧтениеJSON;
	Чтение.ОткрытьФайл(Путь);
	Документ = ПрочитатьJSON(Чтение);
	Чтение.Закрыть();

	Возврат Документ;

КонецФункции

Функция ЗаписатьВременныйДокумент(Документ)

	Путь = ВременныеФайлы.НовоеИмяФайла("json");

	Запись = Новый ЗаписьJSON;
	Запись.ОткрытьФайл(Путь);
	ЗаписатьJSON(Запись, Документ);
	Запись.Закрыть();

	Возврат Путь;

КонецФункции

Функция ЗаписатьВременныйТекст(Текст)

	Путь = ВременныеФайлы.НовоеИмяФайла("json");
	Запись = Новый ЗаписьТекста(Путь, КодировкаТекста.UTF8);
	Запись.Записать(Текст);
	Запись.Закрыть();

	Возврат Путь;

КонецФункции

Функция СоздатьВременныйКаталог()

	Возврат ВременныеФайлы.СоздатьКаталог();

КонецФункции

Процедура ЗаписатьТекст(Путь, Текст)

	Запись = Новый ЗаписьТекста(Путь, КодировкаТекста.UTF8);
	Запись.Записать(Текст);
	Запись.Закрыть();

КонецПроцедуры

Функция ПрочитатьТекст(Путь)

	Чтение = Новый ЧтениеТекста(Путь, КодировкаТекста.UTF8);
	Текст = Чтение.Прочитать();
	Чтение.Закрыть();

	Возврат Текст;

КонецФункции

Функция ПутьКДанным(ИмяФайла)

	Возврат ОбъединитьПути(ПутьКПробам(), "data", ИмяФайла);

КонецФункции

Функция ПутьКФикстурам()

	Возврат ОбъединитьПути(ТекущийСценарий().Каталог, "fixtures");

КонецФункции

Функция ПутьКПробам()

	Возврат ОбъединитьПути(ТекущийСценарий().Каталог, "..");

КонецФункции

Функция ЗапуститьБлокировщикРезерва(
	КаталогДанных,
	ИмяФайла,
	ПутьГотовности,
	ПутьБлокировки,
	ПутьОсвобождения
)

	КаталогПроекта = ОбъединитьПути(ПутьКФикстурам(), "backup-file-lock");
	ПутьКПроекту = ОбъединитьПути(КаталогПроекта, "BackupFileLock.csproj");
	Команда = "dotnet run --project """ + ПутьКПроекту + """ -- "
		+ """" + КаталогДанных + """ "
		+ """" + ИмяФайла + """ "
		+ """" + ПутьГотовности + """ "
		+ """" + ПутьБлокировки + """ "
		+ """" + ПутьОсвобождения + """";
	// shortcut: 1commands не перехватывает потоки фонового процесса; заменить после появления такого API.
	Процесс = СоздатьПроцесс(Команда, КаталогПроекта, Истина, Ложь, КодировкаТекста.UTF8);
	Процесс.Запустить();

	Возврат Процесс;

КонецФункции

Процедура ИнициализироватьGitРепозиторий(Каталог)

	Команда = Новый Команда;
	Команда.УстановитьСтрокуЗапуска("git init");
	Команда.УстановитьРабочийКаталог(Каталог);
	Команда.УстановитьКодировкуВывода(КодировкаТекста.UTF8);
	КодВозврата = Команда.Исполнить();

	Если КодВозврата <> 0 Тогда
		ВызватьИсключение "Не удалось инициализировать временный Git-репозиторий: "
			+ Команда.ПолучитьВывод();
	КонецЕсли;

КонецПроцедуры

Процедура ОжидатьПоявлениеФайла(Путь, ТаймаутСекунд)

	МоментОкончания = ТекущаяУниверсальнаяДатаВМиллисекундах() + ТаймаутСекунд * 1000;
	Пока Не Новый Файл(Путь).Существует()
		И ТекущаяУниверсальнаяДатаВМиллисекундах() < МоментОкончания Цикл
		Приостановить(10);
	КонецЦикла;
	
	Если Не Новый Файл(Путь).Существует() Тогда
		ВызватьИсключение "Не удалось дождаться готовности блокировщика резерва";
	КонецЕсли;

КонецПроцедуры

#КонецОбласти
