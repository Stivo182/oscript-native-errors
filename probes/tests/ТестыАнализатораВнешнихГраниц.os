#Использовать tempfiles
#Использовать 1commands

#Область ОбработчикиСобытий

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура ПодготовитьВременныеФайлы() Экспорт

	ВременныеФайлы.Удалить();

КонецПроцедуры

&ПослеКаждого
Процедура ПослеКаждого() Экспорт

	ВременныеФайлы.Удалить();

КонецПроцедуры

#КонецОбласти

#Область Тесты

&Тест
Процедура ТестДолжен_НайтиВнешниеГраницыВТестовойСборке() Экспорт

	// Подготовка
	ВременныйКаталог = СоздатьВременныйКаталог();
	КаталогСборок = ОбъединитьПути(ВременныйКаталог, "assemblies");
	КаталогАнализатора = ОбъединитьПути(ВременныйКаталог, "analyzer");
	ПутьКФикстуре = ОбъединитьПути(
		ТекущийСценарий().Каталог,
		"fixtures/external-call-boundaries/ExternalCallBoundaries.csproj"
	);
	КаталогПроекта = Новый Файл(ОбъединитьПути(ТекущийСценарий().Каталог, "../..")).ПолноеИмя;
	ПутьКПроекту = ОбъединитьПути(
		КаталогПроекта,
		"probes/tools/ExternalCallBoundaryAnalyzer/ExternalCallBoundaryAnalyzer.csproj"
	);

	ЗапуститьУспешно(
		"dotnet build " + ОбернутьКавычками(ПутьКФикстуре)
			+ " --output " + ОбернутьКавычками(КаталогСборок)
			+ " --nologo --artifacts-path "
			+ ОбернутьКавычками(ОбъединитьПути(ВременныйКаталог, "fixture-artifacts")),
		КаталогПроекта
	);

	УдалитьФайлы(ОбъединитьПути(КаталогСборок, "MissingBoundaryDependency.dll"));

	ЗапуститьУспешно(
		"dotnet build " + ОбернутьКавычками(ПутьКПроекту)
			+ " --output " + ОбернутьКавычками(КаталогАнализатора)
			+ " --nologo --artifacts-path "
			+ ОбернутьКавычками(ОбъединитьПути(ВременныйКаталог, "analyzer-artifacts")),
		КаталогПроекта
	);

	ПутьКАнализатору = ОбъединитьПути(КаталогАнализатора, "ExternalCallBoundaryAnalyzer.dll");

	// Действие
	Отчеты = Новый Массив;
	Для Номер = 1 По 2 Цикл
		ПутьКОтчету = ОбъединитьПути(ВременныйКаталог, "report-" + Строка(Номер) + ".json");
		ЗапуститьУспешно(
			"dotnet " + ОбернутьКавычками(ПутьКАнализатору)
				+ " --assembly-directory " + ОбернутьКавычками(КаталогСборок)
				+ " --output " + ОбернутьКавычками(ПутьКОтчету)
				+ " --entry-assembly ExternalCallBoundaries"
				+ " --internal-assembly ExternalCallBoundaries",
			КаталогПроекта
		);
		Отчеты.Добавить(ПрочитатьДокумент(ПутьКОтчету));
	КонецЦикла;

	// Проверка
	ПроверитьОтчет(Отчеты[0]);
	Ожидаем.Что(ПолучитьJSON(Отчеты[0].Boundaries)).Равно(ПолучитьJSON(Отчеты[1].Boundaries));

	ПроверитьОшибочныеПараметры(ПутьКАнализатору, КаталогПроекта);

КонецПроцедуры

&Тест
Процедура ТестДолжен_СформироватьОтчетЧерезOneScriptОбертку() Экспорт

	// Подготовка
	КаталогИсходников = СоздатьВременныйКаталог();
	КаталогСборок = ОбъединитьПути(
		ОбъединитьПути(
			ОбъединитьПути(
				ОбъединитьПути(КаталогИсходников, "src"),
				"OneScript.Web.Server"
			),
			"bin"
		),
		"Release/net8.0"
	);
	ПутьКФикстуре = ОбъединитьПути(
		ОбъединитьПути(
			ОбъединитьПути(ТекущийСценарий().Каталог, "fixtures"),
			"wrapper-boundary"
		),
		"OneScript.Core.csproj"
	);
	КаталогПроекта = Новый Файл(ОбъединитьПути(ТекущийСценарий().Каталог, "../..")).ПолноеИмя;

	ЗапуститьУспешно(
		"dotnet build " + ОбернутьКавычками(ПутьКФикстуре)
			+ " --output " + ОбернутьКавычками(КаталогСборок)
			+ " --nologo --artifacts-path "
			+ ОбернутьКавычками(ОбъединитьПути(КаталогИсходников, "artifacts")),
		КаталогПроекта
	);

	ИменаСборок = СтрРазделить("OneScript.Native|OneScript.StandardLibrary|OneScript.Web.Server", "|");
	Для Каждого ИмяСборки Из ИменаСборок Цикл
		КопироватьФайл(
			ОбъединитьПути(КаталогСборок, "OneScript.Core.dll"),
			ОбъединитьПути(КаталогСборок, ИмяСборки + ".dll")
		);
	КонецЦикла;

	ИнициализироватьGitРепозиторий(КаталогИсходников);

	ПутьКОбертке = ОбъединитьПути(ТекущийСценарий().Каталог, "../probes.os");
	ПутьКОтчету = ОбъединитьПути(КаталогИсходников, "report.json");

	// Действие
	Процесс = ЗапуститьКоманду(
		"oscript -encoding=utf-8 " + ОбернутьКавычками(ПутьКОбертке) + " worker external-boundaries"
			+ " --engine-root " + ОбернутьКавычками(КаталогИсходников)
			+ " --output-file " + ОбернутьКавычками(ПутьКОтчету),
		КаталогПроекта
	);

	// Проверка
	Ожидаем.Что(Процесс.КодВозврата).Равно(0);
	Отчет = ПрочитатьДокумент(ПутьКОтчету);
	Ожидаем.Что(Отчет.SchemaVersion).Равно(2);
	Ожидаем.Что(Отчет.BoundaryCount).Равно(Отчет.Boundaries.Количество());
	Ожидаем.Что(Отчет.BoundaryCount > 0).Равно(Истина);

	ПроверитьГраницу(Отчет, "Read", "System.IO.File", "ReadAllText");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПроверитьОтчет(Отчет)

	Ожидаем.Что(Отчет.SchemaVersion).Равно(2);
	Ожидаем.Что(ПустаяСтрока(Отчет.Environment.DotNetVersion)).Равно(Ложь);
	Ожидаем.Что(Отчет.BoundaryCount).Равно(Отчет.Boundaries.Количество());
	Ожидаем.Что(Отчет.BoundaryCount > 0).Равно(Истина);

	ПроверитьГраницу(Отчет, "Read", "System.IO.File", "ReadAllText");
	ПроверитьГраницу(Отчет, "", "System.Text.Encoding", "GetBytes", "EncodeHelper");
	ПроверитьГраницу(Отчет, "", "System.String", "Trim", "TrimHelper");
	ПроверитьГраницу(Отчет, "Construct", "System.IO.MemoryStream", ".ctor");
	ПроверитьГраницу(Отчет, "Property", "System.IO.Path", "GetTempPath");
	ПроверитьГраницу(Отчет, "", "System.IO.File", "Exists", "<Async>");
	ПроверитьГраницу(Отчет, "Now", "System.DateTime", "get_UtcNow");

	ПроверитьНеобработанныеГраницы(Отчет);
	ПроверитьЗакрытыеОбобщенныеВызовы(Отчет);

	Ожидаем.Что(КоличествоГраниц(Отчет, "Read", "", "ReadAllText")).Равно(1);
	Ожидаем.Что(КоличествоГраниц(Отчет, "", "", "Exit(")).Равно(0);

	Для Каждого Граница Из Отчет.Boundaries Цикл
		Ожидаем.Что(Граница.Свойство("EntryAssembly")).Равно(Ложь);
	КонецЦикла;

КонецПроцедуры

Процедура ПроверитьНеобработанныеГраницы(Отчет)

	Смещения = Новый Соответствие;
	Токены = Новый Соответствие;
	Количество = 0;

	Для Каждого Граница Из Отчет.Boundaries Цикл
		Если Граница.Resolved Тогда
			Продолжить;
		КонецЕсли;
	
		Количество = Количество + 1;

		Ожидаем.Что(Граница.OneScriptMember).Равно("Missing");
		Ожидаем.Что(Граница.MetadataToken <> 0).Равно(Истина);
		Ожидаем.Что(Граница.Instruction).Равно("call");

		Смещения.Вставить(Строка(Граница.IlOffset), Истина);
		Токены.Вставить(Строка(Граница.MetadataToken), Истина);
	КонецЦикла;

	Ожидаем.Что(Количество).Равно(2);
	Ожидаем.Что(Смещения.Количество()).Равно(2);
	Ожидаем.Что(Токены.Количество()).Равно(2);
	Ожидаем.Что(Отчет.UnresolvedCallCount).Равно(2);

КонецПроцедуры

Процедура ПроверитьЗакрытыеОбобщенныеВызовы(Отчет)

	Количество = 0;
	НайденоЦелое = Ложь;
	НайденаСтрока = Ложь;

	Для Каждого Граница Из Отчет.Boundaries Цикл
		Если Граница.OneScriptMember = "ExternalGeneric"
			И Граница.ExternalType = "System.Array"
			И СтрНайти(Граница.ExternalMember, "Empty") > 0 Тогда
			Количество = Количество + 1;
			НайденоЦелое = НайденоЦелое Или СтрНайти(Граница.ExternalMember, "System.Int32") > 0;
			НайденаСтрока = НайденаСтрока Или СтрНайти(Граница.ExternalMember, "System.String") > 0;
		КонецЕсли;
	КонецЦикла;

	Ожидаем.Что(Количество).Равно(2);
	Ожидаем.Что(НайденоЦелое).Равно(Истина);
	Ожидаем.Что(НайденаСтрока).Равно(Истина);

КонецПроцедуры

Процедура ПроверитьГраницу(Отчет, ЧленOneScript, ВнешнийТип, ВнешнийМетод, ФрагментВызывающего = "")

	Ожидаем.Что(
		КоличествоГраниц(Отчет, ЧленOneScript, ВнешнийТип, ВнешнийМетод, ФрагментВызывающего) > 0
	).Равно(Истина);

КонецПроцедуры

Функция КоличествоГраниц(Отчет, ЧленOneScript, ВнешнийТип, ВнешнийМетод, ФрагментВызывающего = "")

	Количество = 0;
	Для Каждого Граница Из Отчет.Boundaries Цикл
		Если Граница.OneScriptMember = ЧленOneScript
			И (ПустаяСтрока(ВнешнийТип) Или Граница.ExternalType = ВнешнийТип)
			И СтрНайти(Граница.ExternalMember, ВнешнийМетод) > 0
			И (ПустаяСтрока(ФрагментВызывающего)
				Или СтрНайти(Граница.CallerType + Граница.CallerMember, ФрагментВызывающего) > 0) Тогда
			Количество = Количество + 1;
		КонецЕсли;
	КонецЦикла;

	Возврат Количество;

КонецФункции

Процедура ПроверитьОшибочныеПараметры(ПутьКАнализатору, РабочийКаталог)

	Для Каждого Аргументы Из СтрРазделить("--unknown value|--output|--output --unknown", "|") Цикл
		Процесс = ЗапуститьКоманду(
			"dotnet " + ОбернутьКавычками(ПутьКАнализатору) + " " + Аргументы,
			РабочийКаталог
		);
		Ожидаем.Что(Процесс.КодВозврата = 0).Равно(Ложь);
	КонецЦикла;

КонецПроцедуры

Процедура ЗапуститьУспешно(Команда, РабочийКаталог)

	Результат = ЗапуститьКоманду(Команда, РабочийКаталог);
	Если Результат.КодВозврата <> 0 Тогда
		ВызватьИсключение Результат.Вывод;
	КонецЕсли;

КонецПроцедуры

Функция ЗапуститьКоманду(Команда, РабочийКаталог)

	ВнешняяКоманда = Новый Команда;
	ВнешняяКоманда.УстановитьСтрокуЗапуска(Команда);
	ВнешняяКоманда.УстановитьРабочийКаталог(РабочийКаталог);
	ВнешняяКоманда.УстановитьКодировкуВывода(КодировкаТекста.UTF8);
	КодВозврата = ВнешняяКоманда.Исполнить();

	Возврат Новый Структура("КодВозврата,Вывод", КодВозврата, ВнешняяКоманда.ПолучитьВывод());

КонецФункции

Функция СоздатьВременныйКаталог()

	Возврат ВременныеФайлы.СоздатьКаталог();

КонецФункции

Процедура ИнициализироватьGitРепозиторий(Каталог)

	ЗапуститьУспешно("git init --quiet", Каталог);
	ЗапуститьУспешно("git add .", Каталог);
	ЗапуститьУспешно(
		"git -c user.email=probes@example.invalid -c user.name=Probes commit --quiet -m baseline",
		Каталог
	);

КонецПроцедуры

Процедура СнятьПометкуТолькоЧтение(Каталог)

	Для Каждого Файл Из НайтиФайлы(Каталог, "*", Истина) Цикл
		Если Файл.ЭтоФайл() Тогда
			Файл.УстановитьТолькоЧтение(Ложь);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Функция ПрочитатьДокумент(Путь)

	Чтение = Новый ЧтениеJSON;
	Чтение.ОткрытьФайл(Путь);
	Документ = ПрочитатьJSON(Чтение);
	Чтение.Закрыть();

	Возврат Документ;

КонецФункции

Функция ПолучитьJSON(Значение)

	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Значение);

	Возврат Запись.Закрыть();

КонецФункции

Функция ОбернутьКавычками(Аргумент)

	Возврат """" + Аргумент + """";

КонецФункции

#КонецОбласти
