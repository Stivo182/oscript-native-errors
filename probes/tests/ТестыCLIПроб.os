#Использовать asserts
#Использовать tempfiles
#Использовать 1commands
#Использовать "../src"

#Область ОбработчикиСобытий

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура ПодготовитьВременныеФайлы() Экспорт

	ВременныеФайлы.Удалить();

КонецПроцедуры

&ПослеКаждого
Процедура ПослеКаждого() Экспорт

	ВременныеФайлы.Удалить();

КонецПроцедуры

#КонецОбласти

#Область Тесты

&Тест
Процедура ТестДолжен_ПоказатьОчередьИсходниковПоКоманде() Экспорт

	// Подготовка
	ПутьККомандномуПриложению = ОбъединитьПути(ТекущийСценарий().Каталог, "../probes.os");
	Команда = "oscript -encoding=utf-8 """ + ПутьККомандномуПриложению + """ review source --limit 1";

	// Действие
	Процесс = ЗапуститьКоманду(Команда);

	// Проверка
	Ожидаем.Что(Процесс.КодВозврата).Равно(0);
	Ожидаем.Что(СтрНайти(Процесс.Вывод, "[") > 0).Равно(Истина);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПоказатьОсиротевшиеВнешниеРешенияПоКоманде() Экспорт

	// Подготовка
	ПутьККомандномуПриложению = ОбъединитьПути(ТекущийСценарий().Каталог, "../probes.os");
	Команда = "oscript -encoding=utf-8 """ + ПутьККомандномуПриложению + """ review external --orphans";

	// Действие
	Процесс = ЗапуститьКоманду(Команда);
	Вывод = Процесс.Вывод;

	// Проверка
	Ожидаем.Что(Процесс.КодВозврата).Равно(0);
	Ожидаем.Что(СтрНайти(Вывод, "[") > 0).Равно(Истина);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВключитьРассмотренныеСигнатурыИсходниковПоКоманде() Экспорт

	// Подготовка
	ПутьККомандномуПриложению = ОбъединитьПути(ТекущийСценарий().Каталог, "../probes.os");
	Команда = "oscript -encoding=utf-8 """ + ПутьККомандномуПриложению + """ review source --include-reviewed --limit 1";

	// Действие
	Процесс = ЗапуститьКоманду(Команда);
	Вывод = Процесс.Вывод;

	// Проверка
	Ожидаем.Что(Процесс.КодВозврата).Равно(0);
	Ожидаем.Что(СтрНайти(Вывод, "[") > 0).Равно(Истина);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПроверитьКонтрактыВКомандеРазбораИсходников() Экспорт

	// Подготовка
	КаталогПроб = ПодготовитьКаталогПроб();
	ПутьКОтчету = ОбъединитьПути(КаталогПроб, "data", "source-error-report.json");
	Документ = ПрочитатьДокумент(ПутьКОтчету);
	Документ.UnknownThrowCount = Документ.UnknownThrowCount + 1;
	ЗаписатьДокумент(ПутьКОтчету, Документ);

	// Действие и Проверка
	ПроверитьОшибкуРазбораИсходников(
		КаталогПроб,
		"Source error report UnknownThrowCount does not match UnknownThrows.Count"
	);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПроверитьЧетыреКонтрактаВКомандеРазбораСледующего() Экспорт

	// Подготовка, Действие и Проверка
	ПроверитьОшибкуФайлаРазбораСледующего(
		"source-error-report.json",
		"Source error report UnknownThrowCount does not match UnknownThrows.Count"
	);
	ПроверитьОшибкуФайлаРазбораСледующего(
		"source-error-review.json",
		"Source review contains unknown status 'Unknown'"
	);
	ПроверитьОшибкуФайлаРазбораСледующего(
		"onescript-test-error-results.json",
		"Runtime report status counts do not match Results.Count"
	);
	ПроверитьОшибкуФайлаРазбораСледующего(
		"base-type-error-matrix-results.json",
		"Matrix report status counts do not match all locale results"
	);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПроверитьВнешниеКонтрактыВКомандеРазбораСледующего() Экспорт

	// Подготовка
	КаталогПроб = ПодготовитьКаталогПроб();
	КаталогДанных = ОбъединитьПути(КаталогПроб, "data");
	КаталогФикстур = ОбъединитьПути(ТекущийСценарий().Каталог, "fixtures");
	ПутьКОтчету = ОбъединитьПути(КаталогДанных, "external-call-boundaries.json");

	Документ = ПрочитатьДокумент(ОбъединитьПути(КаталогФикстур, "external-boundary-report.json"));
	Документ.BoundaryCount = 0;

	ЗаписатьДокумент(ПутьКОтчету, Документ);

	КопироватьФайл(
		ОбъединитьПути(КаталогФикстур, "external-boundary-review.json"),
		ОбъединитьПути(КаталогДанных, "external-call-boundary-review.json")
	);

	// Действие и Проверка
	ПроверитьОшибкуРазбораСледующего(КаталогПроб, "BoundaryCount does not match Boundaries.Count");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОтклонитьКаталогВместоИсполняемогоФайла() Экспорт

	// Подготовка
	ПутьККомандномуПриложению = ОбъединитьПути(ТекущийСценарий().Каталог, "../probes.os");
	Каталог = ОбъединитьПути(ТекущийСценарий().Каталог, "fixtures");
	Команда = "oscript -encoding=utf-8 """ + ПутьККомандномуПриложению + """ data refresh-runtime --oscript-path """
		+ Каталог + """";

	Процесс = ЗапуститьКоманду(Команда);
	Вывод = Процесс.Вывод;

	// Проверка
	Ожидаем.Что(Процесс.КодВозврата <> 0).Равно(Истина);
	Ожидаем.Что(Вывод).Содержит("Не найден исполняемый файл OneScript:");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ЗапуститьКоманду(СтрокаКоманды)

	ВнешняяКоманда = Новый Команда;
	ВнешняяКоманда.УстановитьСтрокуЗапуска(СтрокаКоманды);
	ВнешняяКоманда.УстановитьРабочийКаталог(ТекущийСценарий().Каталог);
	ВнешняяКоманда.УстановитьКодировкуВывода(КодировкаТекста.UTF8);
	КодВозврата = ВнешняяКоманда.Исполнить();

	Возврат Новый Структура("КодВозврата,Вывод", КодВозврата, ВнешняяКоманда.ПолучитьВывод());

КонецФункции

Процедура ПроверитьОшибкуРазбораИсходников(КаталогПроб, ОжидаемыйТекст)

	Команда = Новый КомандаReviewИсходники;
	Попытка
		Команда.ПоказатьОчередьИсходников(КаталогПроб, 1);
		ВызватьИсключение "Ожидалась ошибка контракта команды review source";
	Исключение
		Ожидаем.Что(ОписаниеОшибки()).Содержит(ОжидаемыйТекст);
	КонецПопытки;

КонецПроцедуры

Процедура ПроверитьОшибкуФайлаРазбораСледующего(ИмяФайла, ОжидаемыйТекст)

	КаталогПроб = ПодготовитьКаталогПроб();
	Путь = ОбъединитьПути(КаталогПроб, "data", ИмяФайла);
	Документ = ПрочитатьДокумент(Путь);

	Если ИмяФайла = "source-error-report.json" Тогда
		Документ.UnknownThrowCount = Документ.UnknownThrowCount + 1;
	ИначеЕсли ИмяФайла = "source-error-review.json" Тогда
		Документ.Reviewed[0].Status = "Unknown";
	ИначеЕсли ИмяФайла = "onescript-test-error-results.json" Тогда
		Документ.ClassifiedCount = Документ.ClassifiedCount + 1;
	ИначеЕсли ИмяФайла = "base-type-error-matrix-results.json" Тогда
		Документ.ClassifiedCount = Документ.ClassifiedCount + 1;
	КонецЕсли;

	ЗаписатьДокумент(Путь, Документ);

	ПроверитьОшибкуРазбораСледующего(КаталогПроб, ОжидаемыйТекст);

КонецПроцедуры

Процедура ПроверитьОшибкуРазбораСледующего(КаталогПроб, ОжидаемыйТекст)

	Команда = Новый КомандаReviewСледующая;
	Попытка
		Команда.ПоказатьСледующиеЭлементы(КаталогПроб, ПутьКПробам());
		ВызватьИсключение "Ожидалась ошибка контракта команды review next";
	Исключение
		Ожидаем.Что(ОписаниеОшибки()).Содержит(ОжидаемыйТекст);
	КонецПопытки;

КонецПроцедуры

Функция ПодготовитьКаталогПроб()

	КаталогПроб = ВременныеФайлы.СоздатьКаталог();
	КаталогДанных = ОбъединитьПути(КаталогПроб, "data");
	СоздатьКаталог(КаталогДанных);

	ИменаФайлов = Новый Массив;
	ИменаФайлов.Добавить("source-error-report.json");
	ИменаФайлов.Добавить("source-error-review.json");
	ИменаФайлов.Добавить("onescript-test-error-results.json");
	ИменаФайлов.Добавить("base-type-error-matrix-results.json");

	Для Каждого ИмяФайла Из ИменаФайлов Цикл
		КопироватьФайл(
			ОбъединитьПути(ПутьКПробам(), "data", ИмяФайла),
			ОбъединитьПути(КаталогДанных, ИмяФайла)
		);
	КонецЦикла;

	Возврат КаталогПроб;

КонецФункции

Функция ПрочитатьДокумент(Путь)

	Чтение = Новый ЧтениеJSON;
	Чтение.ОткрытьФайл(Путь);
	Документ = ПрочитатьJSON(Чтение);
	Чтение.Закрыть();

	Возврат Документ;

КонецФункции

Процедура ЗаписатьДокумент(Путь, Документ)

	Запись = Новый ЗаписьJSON;
	Запись.ОткрытьФайл(Путь);
	ЗаписатьJSON(Запись, Документ);
	Запись.Закрыть();

КонецПроцедуры

Функция ПутьКПробам()

	Возврат Новый Файл(ОбъединитьПути(ТекущийСценарий().Каталог, "..")).ПолноеИмя;

КонецФункции

#КонецОбласти
