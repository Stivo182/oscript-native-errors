#Использовать asserts
#Использовать tempfiles
#Использовать "../src"

#Область ОбработчикиСобытий

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура ПодготовитьВременныеФайлы() Экспорт

	ВременныеФайлы.Удалить();

КонецПроцедуры

&ПослеКаждого
Процедура ПослеКаждого() Экспорт

	ВременныеФайлы.Удалить();

КонецПроцедуры

&Тест
Процедура ТестДолжен_СформироватьМатрицуОшибокБазовыхТиповКлассом() Экспорт

	// Подготовка
	ПутьКОтчету = ВременныеФайлы.НовоеИмяФайла("json");
	Матрица = Новый МатрицаОшибокБазовыхТипов;

	// Действие
	Матрица.Сформировать(ПутьКОтчету);
	Отчет = ПрочитатьДокумент(ПутьКОтчету);

	// Проверка
	Ожидаем.Что(Отчет.TypeCount).Равно(7);
	Ожидаем.Что(Отчет.GroupCount).Равно(7);
	Ожидаем.Что(Отчет.ScenarioCount).Равно(611);
	Ожидаем.Что(Отчет.Results.Количество()).Равно(611);

КонецПроцедуры

#КонецОбласти

#Область Тесты

&Тест
Процедура ТестДолжен_СформироватьМатрицуДляРусскойИАнглийскойЛокалей() Экспорт

	// Подготовка
	ПутьКОтчету = ВременныеФайлы.НовоеИмяФайла("json");
	// Действие
	КаталогПроб = Новый Файл(ОбъединитьПути(ТекущийСценарий().Каталог, "..")).ПолноеИмя;
	КаталогПроекта = Новый Файл(ОбъединитьПути(КаталогПроб, "..")).ПолноеИмя;
	
	Матрица = Новый МатрицаОшибокБазовыхТиповЛокалей;
	Матрица.Сформировать(КаталогПроб, КаталогПроекта, ПутьКОтчету, "oscript");
	
	Отчет = ПрочитатьДокумент(ПутьКОтчету);

	// Проверка
	Ожидаем.Что(Отчет.SchemaVersion).Равно(1);
	Ожидаем.Что(ПустаяСтрока(Отчет.RuntimeVersion)).Равно(Ложь);
	Ожидаем.Что(Отчет.LocaleCount).Равно(2);
	Ожидаем.Что(Отчет.Locales.Количество()).Равно(2);
	Ожидаем.Что(Отчет.ScenarioCount).Равно(611);
	Ожидаем.Что(Отчет.RuntimeFailureCount).Равно(0);
	Ожидаем.Что(
		Отчет.ClassifiedCount + Отчет.UnclassifiedCount + Отчет.SuccessCount
	).Равно(1222);

	ПроверитьОтчетЛокали(НайтиЛокаль(Отчет.Locales, "ru"));
	ПроверитьОтчетЛокали(НайтиЛокаль(Отчет.Locales, "en"));

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПроверитьОтчетЛокали(Отчет)

	Ожидаем.Что(Отчет <> Неопределено).Равно(Истина);
	Ожидаем.Что(Отчет.TypeCount).Равно(7);
	Ожидаем.Что(Отчет.GroupCount).Равно(7);
	Ожидаем.Что(Отчет.ScenarioCount).Равно(611);
	Ожидаем.Что(Отчет.Types.Количество()).Равно(7);
	Ожидаем.Что(Отчет.Groups.Количество()).Равно(7);
	Ожидаем.Что(Отчет.Results.Количество()).Равно(611);

	НайденоДелениеНаНоль = Ложь;
	Для Каждого Результат Из Отчет.Results Цикл
		ПроверитьРезультат(Результат);
		Если Результат.Group = "Arithmetic"
			И (Результат.Operation = "/" Или Результат.Operation = "%")
			И Результат.Code = "numeric.division_by_zero" Тогда
			НайденоДелениеНаНоль = Истина;
		КонецЕсли;
	КонецЦикла;

	Ожидаем.Что(НайденоДелениеНаНоль).Равно(Истина);

КонецПроцедуры

Процедура ПроверитьРезультат(Результат)

	Для Каждого ИмяПоля Из ОбязательныеПоляРезультата() Цикл
		Ожидаем.Что(Результат.Свойство(ИмяПоля)).Равно(Истина);
	КонецЦикла;
	
	Ожидаем.Что(СтатусДопустим(Результат.Status)).Равно(Истина);

	Если Результат.Status = "Success" Тогда
		Ожидаем.Что(ПустаяСтрока(Результат.ResultType)).Равно(Ложь);
		Ожидаем.Что(Результат.Description).Равно("");
		Ожидаем.Что(Результат.Code).Равно("");
	ИначеЕсли Результат.Status = "Classified" Тогда
		Ожидаем.Что(Результат.ResultType).Равно("");
		Ожидаем.Что(ПустаяСтрока(Результат.Description)).Равно(Ложь);
		Ожидаем.Что(ПустаяСтрока(Результат.Code)).Равно(Ложь);
	Иначе
		Ожидаем.Что(Результат.ResultType).Равно("");
		Ожидаем.Что(ПустаяСтрока(Результат.Description)).Равно(Ложь);
		Ожидаем.Что(Результат.Code).Равно("");
	КонецЕсли;

КонецПроцедуры

Функция ОбязательныеПоляРезультата()

	Возврат СтрРазделить(
		"Name,Group,LeftType,RightType,Operation,Expression,Status,ResultType,Description,Code",
		","
	);

КонецФункции

Функция СтатусДопустим(Статус)

	Возврат Статус = "Success" Или Статус = "Classified" Или Статус = "Unclassified";

КонецФункции

Функция НайтиЛокаль(Отчеты, Локаль)

	Для Каждого Отчет Из Отчеты Цикл
		Если Отчет.Locale = Локаль Тогда
			Возврат Отчет;
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

Функция ПрочитатьДокумент(Путь)

	Чтение = Новый ЧтениеJSON;
	Чтение.ОткрытьФайл(Путь);
	Документ = ПрочитатьJSON(Чтение);
	Чтение.Закрыть();

	Возврат Документ;

КонецФункции

Функция ОбернутьКавычками(Аргумент)

	Возврат """" + Аргумент + """";

КонецФункции

#КонецОбласти
