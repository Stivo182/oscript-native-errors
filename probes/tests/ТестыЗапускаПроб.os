#Использовать asserts
#Использовать 1commands
#Использовать "../src"

#Область ОбработчикиСобытий

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

#КонецОбласти

#Область Тесты

&Тест
Процедура ТестДолжен_ЗапуститьОсновныеКомандыCLIБезИзмененияДанных() Экспорт

	// Подготовка
	КаталогПроб = ПутьКПробам();
	ПутьККомандномуПриложению = ОбъединитьПути(КаталогПроб, "probes.os");
	Снимок = ПолучитьСнимокДанных(КаталогПроб);

	// Действие
	Справка = ЗапуститьCLI(ПутьККомандномуПриложению, "--help");
	Очередь = ЗапуститьCLI(ПутьККомандномуПриложению, "review next");

	// Проверка
	Ожидаем.Что(Справка.КодВозврата).Равно(0);
	Ожидаем.Что(Справка.Вывод).Содержит("review");
	Ожидаем.Что(Справка.Вывод).Содержит("test");
	Ожидаем.Что(Очередь.КодВозврата).Равно(0);
	Ожидаем.Что(Очередь.Вывод).Содержит("Следующая сигнатура ошибки исходников:");
	Ожидаем.Что(Очередь.Вывод).Содержит("Следующая граница внешнего вызова:");

	ПроверитьСнимокДанных(КаталогПроб, Снимок);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ЗавершитьНеизвестнуюКомандуСОшибкой() Экспорт

	// Подготовка
	ПутьККомандномуПриложению = ОбъединитьПути(ПутьКПробам(), "probes.os");

	// Действие
	Результат = ЗапуститьCLI(ПутьККомандномуПриложению, "unknown-action");

	// Проверка
	Ожидаем.Что(Результат.КодВозврата <> 0).Равно(Истина);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ТребоватьПутьКOneScriptДляОбновленияRuntime() Экспорт

	// Подготовка
	ПутьККомандномуПриложению = ОбъединитьПути(ПутьКПробам(), "probes.os");

	// Действие
	Результат = ЗапуститьCLI(ПутьККомандномуПриложению, "data refresh-runtime");

	// Проверка
	Ожидаем.Что(Результат.КодВозврата <> 0).Равно(Истина);
	Ожидаем.Что(Результат.Вывод).Содержит("укажите --oscript-path");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ЗапуститьCLI(ПутьККомандномуПриложению, Аргументы)

	ВнешняяКоманда = Новый Команда;
	ВнешняяКоманда.УстановитьСтрокуЗапуска("oscript -encoding=utf-8 """ + ПутьККомандномуПриложению + """ " + Аргументы);
	ВнешняяКоманда.УстановитьРабочийКаталог(ПутьКПробам());
	ВнешняяКоманда.УстановитьКодировкуВывода(КодировкаТекста.UTF8);
	КодВозврата = ВнешняяКоманда.Исполнить();

	Возврат Новый Структура("КодВозврата,Вывод", КодВозврата, ВнешняяКоманда.ПолучитьВывод());

КонецФункции

Функция ПолучитьСнимокДанных(КаталогПроб)

	Результат = Новый Соответствие;
	Для Каждого ИмяФайла Из ИменаФайловДанных() Цикл
		Результат.Вставить(ИмяФайла, ПрочитатьТекст(ОбъединитьПути(КаталогПроб, "data", ИмяФайла)));
	КонецЦикла;

	Возврат Результат;

КонецФункции

Процедура ПроверитьСнимокДанных(КаталогПроб, Снимок)

	Для Каждого ИмяФайла Из ИменаФайловДанных() Цикл
		ФактическийТекст = ПрочитатьТекст(ОбъединитьПути(КаталогПроб, "data", ИмяФайла));
		Ожидаем.Что(ФактическийТекст).Равно(Снимок.Получить(ИмяФайла));
	КонецЦикла;

КонецПроцедуры

Функция ИменаФайловДанных()

	Результат = Новый Массив;
	Результат.Добавить("source-error-report.json");
	Результат.Добавить("source-error-review.json");
	Результат.Добавить("external-call-boundaries.json");
	Результат.Добавить("external-call-boundary-review.json");
	Результат.Добавить("onescript-test-error-results.json");
	Результат.Добавить("base-type-error-matrix-results.json");

	Возврат Результат;

КонецФункции

Функция ПрочитатьТекст(Путь)

	Чтение = Новый ЧтениеТекста(Путь, КодировкаТекста.UTF8);
	Текст = Чтение.Прочитать();
	Чтение.Закрыть();

	Возврат Текст;

КонецФункции

Функция ПутьКПробам()

	Возврат Новый Файл(ОбъединитьПути(ТекущийСценарий().Каталог, "..")).ПолноеИмя;

КонецФункции

#КонецОбласти
