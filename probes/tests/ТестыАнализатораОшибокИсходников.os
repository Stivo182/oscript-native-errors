#Использовать 1commands

#Область ОбработчикиСобытий

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура ПодготовитьВременныеФайлы() Экспорт

	ВременныеФайлы.Удалить();

КонецПроцедуры

&ПослеКаждого
Процедура ПослеКаждого() Экспорт

	ВременныеФайлы.Удалить();

КонецПроцедуры

#КонецОбласти

#Область Тесты

&Тест
Процедура ТестДолжен_СформироватьОтчетПоИсходникамБезPowerShell() Экспорт

	// Подготовка
	КаталогИсходников = СоздатьВременныйКаталог();
	КопироватьФайл(
		ОбъединитьПути(ТекущийСценарий().Каталог, "fixtures", "context-exceptions.cs"),
		ОбъединитьПути(КаталогИсходников, "context-exceptions.cs")
	);

	ЗапуститьGit("init --quiet", КаталогИсходников);
	ЗапуститьGit("add context-exceptions.cs", КаталогИсходников);
	ЗапуститьGit(
		"-c user.email=probes@example.invalid -c user.name=Probes commit --quiet -m baseline",
		КаталогИсходников
	);

	ПутьКОтчету = ОбъединитьПути(КаталогИсходников, "report.json");
	ПутьКАнализатору = ОбъединитьПути(
		ТекущийСценарий().Каталог,
		"../probes.os"
	);

	Команда = "oscript -encoding=utf-8 """ + ПутьКАнализатору + """ worker source-errors --source-directory """
		+ КаталогИсходников + """ --output-file """ + ПутьКОтчету + """";

	// Действие
	Процесс = ЗапуститьКоманду(Команда, ТекущийСценарий().Каталог);

	Отчет = ПрочитатьДокумент(ПутьКОтчету);

	// Проверка
	Ожидаем.Что(Процесс.КодВозврата).Равно(0);
	Ожидаем.Что(Отчет.FileCount).Равно(1);
	Ожидаем.Что(Отчет.ExceptionCount).Равно(7);
	Ожидаем.Что(Отчет.CaughtExceptionCount).Равно(3);
	Ожидаем.Что(Отчет.CandidateCount).Равно(5);
	Ожидаем.Что(Отчет.OperationalCandidateCount).Равно(4);
	Ожидаем.Что(Отчет.ProgrammingErrorCount).Равно(1);
	Ожидаем.Что(Отчет.UnknownThrowCount).Равно(2);
	Ожидаем.Что(Отчет.SchemaVersion).Равно(1);
	Ожидаем.Что(Отчет.Environment <> Неопределено).Равно(Истина);
	Ожидаем.Что(СтрНайти(Отчет.Candidates[0].File, ":")).Равно(0);
	Ожидаем.Что(Лев(Отчет.Candidates[0].File, 1) = "/").Равно(Ложь);

	ПроверитьСигнатурыИсключений(Отчет);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОтклонитьИсходникиВнеGitРепозитория() Экспорт

	// Подготовка
	КаталогИсходников = СоздатьВременныйКаталог();
	КопироватьФайл(
		ОбъединитьПути(ТекущийСценарий().Каталог, "fixtures", "context-exceptions.cs"),
		ОбъединитьПути(КаталогИсходников, "context-exceptions.cs")
	);
	ПутьКАнализатору = ОбъединитьПути(
		ТекущийСценарий().Каталог,
		"../probes.os"
	);
	Команда = "oscript -encoding=utf-8 " + ОбернутьКавычками(ПутьКАнализатору) + " worker source-errors"
		+ " --source-directory " + ОбернутьКавычками(КаталогИсходников)
		+ " --output-file " + ОбернутьКавычками(ОбъединитьПути(КаталогИсходников, "report.json"));

	// Действие
	Процесс = ЗапуститьКоманду(Команда, КаталогИсходников);
	Вывод = Процесс.Вывод;

	// Проверка
	Ожидаем.Что(Процесс.КодВозврата = 0).Равно(Ложь);
	Ожидаем.Что(СтрНайти(Вывод, "Не удалось определить ревизию исходников") > 0).Равно(Истина);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОтклонитьОтсутствующийПутьКОтчету() Экспорт

	// Подготовка
	ПутьКАнализатору = ОбъединитьПути(
		ТекущийСценарий().Каталог,
		"../probes.os"
	);
	Команда = "oscript -encoding=utf-8 " + ОбернутьКавычками(ПутьКАнализатору)
		+ " worker source-errors --source-directory " + ОбернутьКавычками(ТекущийСценарий().Каталог);

	// Действие
	Процесс = ЗапуститьКоманду(Команда, ТекущийСценарий().Каталог);
	Вывод = Процесс.Вывод;

	// Проверка
	Ожидаем.Что(Процесс.КодВозврата = 0).Равно(Ложь);
	Ожидаем.Что(СтрНайти(Вывод, "укажите --output-file") > 0).Равно(Истина);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ЗафиксироватьИзменениеТолькоАнализируемыхИсходников() Экспорт

	// Подготовка
	КореньДвижка = СоздатьВременныйКаталог();
	КаталогИсходников = ОбъединитьПути(КореньДвижка, "src", "OneScript.Core");

	Для Каждого ИмяКаталога Из СтрРазделить(
		"OneScript.Core,OneScript.Native,OneScript.StandardLibrary,OneScript.Web.Server",
		","
	) Цикл
		СоздатьКаталог(ОбъединитьПути(КореньДвижка, "src", ИмяКаталога));
	КонецЦикла;

	ПутьИсходника = ОбъединитьПути(КаталогИсходников, "context-exceptions.cs");
	КопироватьФайл(
		ОбъединитьПути(ТекущийСценарий().Каталог, "fixtures", "context-exceptions.cs"),
		ПутьИсходника
	);

	ЗапуститьGit("init --quiet", КореньДвижка);
	ЗапуститьGit("add src", КореньДвижка);
	ЗапуститьGit(
		"-c user.email=probes@example.invalid -c user.name=Probes commit --quiet -m baseline",
		КореньДвижка
	);

	СоздатьКаталог(ОбъединитьПути(КореньДвижка, "tests"));
	ЗаписатьТекст(ОбъединитьПути(КореньДвижка, "tests", "fixture.txt"), "fixture");
	ПутьКОтчету = ОбъединитьПути(КореньДвижка, "report.json");

	// Действие
	ЗапуститьАнализаторДвижка(КореньДвижка, ПутьКОтчету);
	ЧистыйОтчет = ПрочитатьДокумент(ПутьКОтчету);

	ЗаписатьТекст(ПутьИсходника, ПрочитатьТекст(ПутьИсходника) + Символы.ПС + "// dirty");
	ЗапуститьАнализаторДвижка(КореньДвижка, ПутьКОтчету);

	ИзмененныйОтчет = ПрочитатьДокумент(ПутьКОтчету);

	// Проверка
	Ожидаем.Что(Лев(ЧистыйОтчет.SourceDirectories[0], 18)).Равно("src/OneScript.Core");
	Ожидаем.Что(СтрНайти(ЧистыйОтчет.Candidates[0].File, "src/OneScript.Core/")).Равно(1);
	Ожидаем.Что(ЧистыйОтчет.SourceDirty).Равно(Ложь);
	Ожидаем.Что(ИзмененныйОтчет.SourceDirty).Равно(Истина);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПроверитьСигнатурыИсключений(Отчет)

	Копирование = НайтиПоМетоду(Отчет.OperationalCandidates, "Copy");
	Ожидаем.Что(Копирование.ExceptionType).Равно("System.IO.IOException");
	
	Повтор = НайтиПоМетоду(Отчет.OperationalCandidates, "Retry", Истина);
	Ожидаем.Что(Повтор.ExceptionType).Равно("System.IO.IOException");
	
	ЗакрытыйПоток = НайтиПоМетоду(Отчет.OperationalCandidates, "Write");
	Ожидаем.Что(ЗакрытыйПоток.ExceptionType).Равно("RuntimeException.ClosedStream");
	
	ОшибкаПрограммирования = НайтиПоМетоду(Отчет.ProgrammingErrors, "Configure");
	Ожидаем.Что(ОшибкаПрограммирования.ExceptionType).Равно("RuntimeException.InvalidArgumentValue");
	
	Фабрика = НайтиПоМетоду(Отчет.UnknownThrows, "Compile");
	Ожидаем.Что(Фабрика.ExceptionType).Равно("CompilerException.Failed");

КонецПроцедуры

Функция НайтиПоМетоду(Записи, ИмяМетода, Последняя = Ложь)

	Результат = Неопределено;
	Для Каждого Запись Из Записи Цикл
		Если Запись.OneScriptMethod = ИмяМетода Тогда
			Результат = Запись;
			Если Не Последняя Тогда
				Прервать;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	Ожидаем.Что(Результат <> Неопределено).Равно(Истина);

	Возврат Результат;

КонецФункции

Функция ПрочитатьДокумент(Путь)

	Чтение = Новый ЧтениеJSON;
	Чтение.ОткрытьФайл(Путь);
	Документ = ПрочитатьJSON(Чтение);
	Чтение.Закрыть();

	Возврат Документ;

КонецФункции

Функция СоздатьВременныйКаталог()

	Возврат ВременныеФайлы.СоздатьКаталог();

КонецФункции

Процедура ЗапуститьАнализаторДвижка(КореньДвижка, ПутьКОтчету)

	ПутьКАнализатору = ОбъединитьПути(
		ТекущийСценарий().Каталог,
		"../probes.os"
	);
	Команда = "oscript -encoding=utf-8 " + ОбернутьКавычками(ПутьКАнализатору)
		+ " worker source-errors --engine-root " + ОбернутьКавычками(КореньДвижка)
		+ " --output-file " + ОбернутьКавычками(ПутьКОтчету);
	
	Процесс = ЗапуститьКоманду(Команда, ТекущийСценарий().Каталог);

	Ожидаем.Что(Процесс.КодВозврата).Равно(0);

КонецПроцедуры

Процедура ЗапуститьGit(Аргументы, РабочийКаталог)

	Процесс = ЗапуститьКоманду("git -C " + ОбернутьКавычками(РабочийКаталог) + " " + Аргументы, РабочийКаталог);
	Ожидаем.Что(Процесс.КодВозврата).Равно(0);

КонецПроцедуры

Функция ЗапуститьКоманду(Команда, РабочийКаталог)

	ВнешняяКоманда = Новый Команда;
	ВнешняяКоманда.УстановитьСтрокуЗапуска(Команда);
	ВнешняяКоманда.УстановитьРабочийКаталог(РабочийКаталог);
	ВнешняяКоманда.УстановитьКодировкуВывода(КодировкаТекста.UTF8);
	КодВозврата = ВнешняяКоманда.Исполнить();

	Возврат Новый Структура("КодВозврата,Вывод", КодВозврата, ВнешняяКоманда.ПолучитьВывод());

КонецФункции

Процедура ЗаписатьТекст(Путь, Текст)

	Запись = Новый ЗаписьТекста(Путь, КодировкаТекста.UTF8);
	Запись.Записать(Текст);
	Запись.Закрыть();

КонецПроцедуры

Функция ПрочитатьТекст(Путь)

	Чтение = Новый ЧтениеТекста(Путь, КодировкаТекста.UTF8);
	Текст = Чтение.Прочитать();
	Чтение.Закрыть();

	Возврат Текст;

КонецФункции

Функция ОбернутьКавычками(Аргумент)

	Возврат """" + Аргумент + """";

КонецФункции

Процедура СнятьПометкуТолькоЧтение(Каталог)

	Для Каждого Файл Из НайтиФайлы(Каталог, "*", Истина) Цикл
		Если Файл.ЭтоФайл() Тогда
			Файл.УстановитьТолькоЧтение(Ложь);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти
