#Использовать asserts
#Использовать tempfiles
#Использовать "../src"

Перем _КаталогПроб; // Строка
Перем _ПутьКОтчету; // Строка
Перем _ПутьКЖурналу; // Строка

#Область ОбработчикиСобытий

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт

	_КаталогПроб = Новый Файл(ОбъединитьПути(ТекущийСценарий().Каталог, "..")).ПолноеИмя;
	_ПутьКОтчету = ПутьКФикстуре("external-boundary-report.json");
	_ПутьКЖурналу = ПутьКФикстуре("external-boundary-review.json");

КонецПроцедуры

&ПередВсеми
Процедура ПодготовитьВременныеФайлы() Экспорт

	ВременныеФайлы.Удалить();

КонецПроцедуры

&ПослеКаждого
Процедура ПослеКаждого() Экспорт

	ВременныеФайлы.Удалить();

КонецПроцедуры

#КонецОбласти

#Область Тесты

&Тест
Процедура ТестДолжен_СгруппироватьНерассмотренныеВнешниеГраницы() Экспорт

	// Подготовка
	Очередь = Новый ОчередьВнешнихГраниц;
	ТекстЖурнала = ПрочитатьТекст(_ПутьКЖурналу);

	// Действие
	ТекстJSON = Очередь.ПолучитьЭлементы(_КаталогПроб, _ПутьКОтчету, _ПутьКЖурналу, 50);
	Элементы = ПрочитатьJSONИзСтроки(ТекстJSON);

	// Проверка
	Ожидаем.Что(Элементы.Количество()).Равно(2);
	Группа = НайтиПоПолю(Элементы, "Resolved", Истина);
	
	Ожидаем.Что(Группа.BoundaryCount).Равно(2);
	Ожидаем.Что(Группа.PendingCount).Равно(1);
	Ожидаем.Что(Группа.Representatives.Количество()).Равно(1);
	Ожидаем.Что(Группа.Representatives[0].CallerType).Равно("ZHelper");
	Ожидаем.Что(Группа.Representatives[0].OneScriptObject).Равно("");
	Ожидаем.Что(Группа.Codes.Количество()).Равно(0);
	Ожидаем.Что(Группа.Evidence.Количество()).Равно(0);
	Ожидаем.Что(Группа.Note).Равно("");

	Неразрешенная = НайтиПоПолю(Элементы, "Resolved", Ложь);
	Ожидаем.Что(Неразрешенная.IlOffset).Равно(20);
	Ожидаем.Что(Неразрешенная.MetadataToken).Равно(167772163);
	Ожидаем.Что(ПрочитатьТекст(_ПутьКЖурналу)).Равно(ТекстЖурнала);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВключитьРассмотренныеГраницыИТочноСохранитьИхПоля() Экспорт

	// Подготовка
	Очередь = Новый ОчередьВнешнихГраниц;

	// Действие
	ПервыйJSON = Очередь.ПолучитьЭлементы(
		_КаталогПроб,
		_ПутьКОтчету,
		_ПутьКЖурналу,
		50,
		"--include-reviewed"
	);
	ВторойJSON = Очередь.ПолучитьЭлементы(
		_КаталогПроб,
		_ПутьКОтчету,
		_ПутьКЖурналу,
		50,
		"--include-reviewed"
	);
	Элементы = ПрочитатьJSONИзСтроки(ПервыйJSON);

	// Проверка
	Ожидаем.Что(Элементы.Количество()).Равно(3);
	Ожидаем.Что(ПервыйJSON).Равно(ВторойJSON);
	
	Группа = НайтиПоПолю(Элементы, "Resolved", Истина);
	Ожидаем.Что(Группа.OverrideCount).Равно(1);
	Ожидаем.Что(Группа.Overrides[0].CallerType).Равно("aHelper");
	Ожидаем.Что(Группа.Overrides[0].Codes.Количество()).Равно(2);
	Ожидаем.Что(Группа.Overrides[0].Codes[0]).Равно("encoding.invalid_argument");
	Ожидаем.Что(Группа.Overrides[0].Codes[1]).Равно("encoding.invalid_data");
	Ожидаем.Что(Группа.Overrides[0].Evidence[0]).Равно("tests/EncodingErrors.os");
	Ожидаем.Что(Группа.Overrides[0].Note).Равно("The helper boundary has runtime evidence.");
	Ожидаем.Что(Элементы[0].Resolved).Равно(Истина);
	Ожидаем.Что(Элементы[1].IlOffset).Равно(10);
	Ожидаем.Что(Элементы[1].Status).Равно("Deferred");
	Ожидаем.Что(Элементы[2].IlOffset).Равно(20);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПрименитьЛимитПослеСортировкиВнешнихГраниц() Экспорт

	// Подготовка
	Очередь = Новый ОчередьВнешнихГраниц;

	// Действие
	ТекстJSON = Очередь.ПолучитьЭлементы(_КаталогПроб, _ПутьКОтчету, _ПутьКЖурналу, 1);
	Элементы = ПрочитатьJSONИзСтроки(ТекстJSON);

	// Проверка
	Ожидаем.Что(Элементы.Количество()).Равно(1);
	Ожидаем.Что(Элементы[0].ExternalType).Равно("System.Text.Encoding");
	Ожидаем.Что(Лев(СокрЛП(ТекстJSON), 1)).Равно("[");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОтклонитьНекорректныеПараметрыВнешнейОчереди() Экспорт

	// Подготовка, Действие и Проверка
	ПроверитьОшибкуОчереди(
		_ПутьКОтчету,
		ПутьКФикстуре("external-boundary-review-duplicate.json"),
		50,
		"",
		"Duplicate reviewed boundary"
	);
	ПроверитьОшибкуОчереди(_ПутьКОтчету + ".missing", _ПутьКЖурналу, 50, "", "report was not found");
	ПроверитьОшибкуОчереди(_ПутьКОтчету, _ПутьКЖурналу, 0, "", "Limit must be a positive integer");
	ПроверитьОшибкуОчереди(_ПутьКОтчету, _ПутьКЖурналу, -1, "", "Limit must be a positive integer");
	ПроверитьОшибкуОчереди(_ПутьКОтчету, _ПутьКЖурналу, 1.5, "", "Limit must be a positive integer");
	ПроверитьОшибкуОчереди(
		ПутьКФикстуре("external-boundary-report-duplicate-count.json"),
		_ПутьКЖурналу,
		50,
		"--validate",
		"contains duplicate BoundaryCount"
	);
	ПроверитьОшибкуОчереди(
		ПутьКФикстуре("external-boundary-report-duplicate-version.json"),
		_ПутьКЖурналу,
		50,
		"--validate",
		"contains duplicate SchemaVersion"
	);
	ПроверитьОшибкуОчереди(
		_ПутьКОтчету,
		ПутьКФикстуре("external-boundary-review-missing-evidence.json"),
		50,
		"--validate",
		"Default Evidence must be an array of strings"
	);
	ПроверитьОшибкуОчереди(
		_ПутьКОтчету,
		ПутьКФикстуре("external-boundary-review-missing-note.json"),
		50,
		"--validate",
		"Default Note must be a string"
	);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПроверитьИОчиститьОсиротевшиеРешенияВнешнихГраниц() Экспорт

	// Подготовка
	Каталог = ВременныеФайлы.СоздатьКаталог();

		ПутьКЖурналу = ОбъединитьПути(Каталог, "review.json");
		Журнал = ПрочитатьДокумент(_ПутьКЖурналу);

		Свидетельства = Новый Массив;
		Свидетельства.Добавить("Explicit default evidence");
		
		ПоУмолчанию = Новый Структура(
			"ExternalAssembly,ExternalType,ExternalMember,Status,Codes,Evidence,Note",
			"System.Private.CoreLib",
			"System.Text.Encoding",
			"GetBytes",
			"NotApplicable",
			Новый Массив,
			Свидетельства,
			"Applies to remaining callers."
		);
		Журнал.Defaults.Добавить(ПоУмолчанию);

		Осиротевший = Клонировать(Журнал.Reviewed[0]);
		Осиротевший.CallerType = "RemovedHelper";
		Осиротевший.Status = "NotApplicable";
		Журнал.Reviewed.Добавить(Осиротевший);
	
		Сохраняемый = Клонировать(Журнал.Reviewed[0]);
		Сохраняемый.CallerType = "RetainedHelper";
		Журнал.Reviewed.Добавить(Сохраняемый);
		
		ОсиротевшееУмолчание = Клонировать(ПоУмолчанию);
		ОсиротевшееУмолчание.ExternalMember = "RemovedMember";
		Журнал.Defaults.Добавить(ОсиротевшееУмолчание);
		
		ЗаписатьДокумент(ПутьКЖурналу, Журнал);
		Очередь = Новый ОчередьВнешнихГраниц;

		// Действие
		Осиротевшие = ПрочитатьJSONИзСтроки(Очередь.ПолучитьЭлементы(
			_КаталогПроб,
			_ПутьКОтчету,
			ПутьКЖурналу,
			50,
			"--orphans"
		));
		Удалено = ПрочитатьJSONИзСтроки(Очередь.ПолучитьЭлементы(
			_КаталогПроб,
			_ПутьКОтчету,
			ПутьКЖурналу,
			50,
			"--remove-not-applicable-orphans"
		));
		Очередь.ПолучитьЭлементы(_КаталогПроб, _ПутьКОтчету, ПутьКЖурналу, 50, "--validate");
		Оставшиеся = ПрочитатьJSONИзСтроки(Очередь.ПолучитьЭлементы(
			_КаталогПроб,
			_ПутьКОтчету,
			ПутьКЖурналу,
			50,
			"--orphans"
		));

		// Проверка
		Ожидаем.Что(Осиротевшие.Количество()).Равно(3);
		Ожидаем.Что(Удалено.Reviewed).Равно(1);
		Ожидаем.Что(Удалено.Defaults).Равно(1);
		Ожидаем.Что(Оставшиеся.Количество()).Равно(1);
		Ожидаем.Что(Оставшиеся[0].CallerType).Равно("RetainedHelper");
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПроверитьОшибкуОчереди(ПутьКОтчету, ПутьКЖурналу, Лимит, Режим, ОжидаемыйТекст)

	Попытка
		Результат = Новый ОчередьВнешнихГраниц().ПолучитьЭлементы(
			_КаталогПроб,
			ПутьКОтчету,
			ПутьКЖурналу,
			Лимит,
			Режим
		);
		ВызватьИсключение "Ожидалась ошибка внешней очереди";
	Исключение
		Ожидаем.Что(ОписаниеОшибки()).Содержит(ОжидаемыйТекст);
	КонецПопытки;

КонецПроцедуры

Функция НайтиПоПолю(Элементы, ИмяПоля, Значение)

	Для Каждого Элемент Из Элементы Цикл
		Если Элемент[ИмяПоля] = Значение Тогда
			Возврат Элемент;
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

Функция Клонировать(Значение)

	Возврат ПрочитатьJSONИзСтроки(ЗаписатьJSONВСтроку(Значение));

КонецФункции

Функция ПрочитатьДокумент(Путь)

	Чтение = Новый ЧтениеJSON;
	Чтение.ОткрытьФайл(Путь);
	Документ = ПрочитатьJSON(Чтение);
	Чтение.Закрыть();

	Возврат Документ;

КонецФункции

Функция ПрочитатьJSONИзСтроки(Текст)

	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(Текст);

	Возврат ПрочитатьJSON(Чтение);

КонецФункции

Функция ЗаписатьJSONВСтроку(Значение)

	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Значение);

	Возврат Запись.Закрыть();

КонецФункции

Процедура ЗаписатьДокумент(Путь, Документ)

	Запись = Новый ЗаписьJSON;
	Запись.ОткрытьФайл(Путь);
	ЗаписатьJSON(Запись, Документ);
	Запись.Закрыть();

КонецПроцедуры

Функция ПрочитатьТекст(Путь)

	Чтение = Новый ЧтениеТекста(Путь, КодировкаТекста.UTF8);
	Текст = Чтение.Прочитать();
	Чтение.Закрыть();

	Возврат Текст;

КонецФункции

Функция ПутьКФикстуре(ИмяФайла)

	Возврат ОбъединитьПути(ТекущийСценарий().Каталог, "fixtures", ИмяФайла);

КонецФункции

#КонецОбласти
