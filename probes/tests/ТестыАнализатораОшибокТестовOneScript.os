#КонецОбласти

#Область Тесты

&Тест
Процедура ТестДолжен_КлассифицироватьКандидатовОднимЗапускомНаФайл() Экспорт

	// Подготовка
	РабочийКаталог = СоздатьВременныйКаталог();
	КаталогПроекта = ОбъединитьПути(РабочийКаталог, "project");
	КаталогТестов = ОбъединитьПути(КаталогПроекта, "tests");
	КаталогИсходников = ОбъединитьПути(КаталогПроекта, "src");
	
	СоздатьКаталог(КаталогТестов);
	СоздатьКаталог(КаталогИсходников);

	СкопироватьФикстуру("runtime-candidate.os", КаталогТестов);
	СкопироватьФикстуру("relative-working-directory.os", КаталогТестов);
	СкопироватьФикстуру("relative-working-directory.txt", КаталогТестов);
	СкопироватьФикстуру("parent-relative-working-directory.os", КаталогТестов);
	
	ЗаписатьТекст(ОбъединитьПути(КаталогИсходников, "parent-relative-working-directory.txt"), "fixture");
	ИнициализироватьGitРепозиторий(КаталогПроекта);
	
	ПутьКОтчету = ОбъединитьПути(РабочийКаталог, "result.json");
	КаталогБиблиотеки = Новый Файл(ОбъединитьПути(ТекущийСценарий().Каталог, "../..")).ПолноеИмя;
	ПутьКЗапускателю = ОбъединитьПути(ТекущийСценарий().Каталог, "fixtures", "testrunner.os");
	Анализатор = Новый АнализаторОшибокТестовOneScript;

	// Действие
	Анализатор.Сформировать(
		КаталогТестов,
		ПутьКОтчету,
		ПутьКЗапускателю,
		КаталогБиблиотеки,
		"oscript"
	);
	Отчет = ПрочитатьДокумент(ПутьКОтчету);

	// Проверка
	Ожидаем.Что(Отчет.SchemaVersion).Равно(1);
	Ожидаем.Что(ПустаяСтрока(Отчет.RuntimeVersion)).Равно(Ложь);
	Ожидаем.Что(Отчет.TestDirectory).Равно(".");
	Ожидаем.Что(Отчет.FileCount).Равно(3);
	Ожидаем.Что(Отчет.CandidateCount).Равно(9);
	Ожидаем.Что(Отчет.Results.Количество()).Равно(9);
	Ожидаем.Что(Отчет.ExecutionCount).Равно(3);
	Ожидаем.Что(Отчет.ClassifiedCount).Равно(4);
	Ожидаем.Что(Отчет.NoExceptionCount).Равно(4);
	Ожидаем.Что(Отчет.NotObservedCount).Равно(1);
	Ожидаем.Что(Отчет.RuntimeFailureCount).Равно(0);

	ПроверитьРезультаты(Отчет.Results);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ИспользоватьУказанныйRuntimeДляЗапускаТестов() Экспорт

	// Подготовка
	РабочийКаталог = СоздатьВременныйКаталог();
	КаталогПроекта = ОбъединитьПути(РабочийКаталог, "project");
	КаталогТестов = ОбъединитьПути(КаталогПроекта, "tests");

	СоздатьКаталог(КаталогТестов);
	СкопироватьФикстуру("runtime-candidate.os", КаталогТестов);
	ИнициализироватьGitРепозиторий(КаталогПроекта);

	ПутьКОтчету = ОбъединитьПути(РабочийКаталог, "result.json");
	КаталогБиблиотеки = Новый Файл(ОбъединитьПути(ТекущийСценарий().Каталог, "../..")).ПолноеИмя;
	ПутьКЗапускателю = ОбъединитьПути(ТекущийСценарий().Каталог, "fixtures", "testrunner.os");
	ПутьКНесуществующемуИсполняемомуФайлу = ОбъединитьПути(РабочийКаталог, "missing-oscript");
	Анализатор = Новый АнализаторОшибокТестовOneScript;

	// Действие
	Анализатор.Сформировать(
		КаталогТестов,
		ПутьКОтчету,
		ПутьКЗапускателю,
		КаталогБиблиотеки,
		ПутьКНесуществующемуИсполняемомуФайлу
	);
	Отчет = ПрочитатьДокумент(ПутьКОтчету);

	// Проверка
	Ожидаем.Что(Отчет.RuntimeFailureCount).Равно(Отчет.CandidateCount);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ЧитатьUTF8ВыводПриOEMКодировкеХоста() Экспорт

	// Подготовка
	РабочийКаталог = СоздатьВременныйКаталог();
	КаталогПроекта = ОбъединитьПути(РабочийКаталог, "project");
	КаталогТестов = ОбъединитьПути(КаталогПроекта, "tests");

	СоздатьКаталог(КаталогТестов);
	СкопироватьФикстуру("runtime-candidate.os", КаталогТестов);
	ИнициализироватьGitРепозиторий(КаталогПроекта);

	ПутьКОтчету = ОбъединитьПути(РабочийКаталог, "result.json");
	КаталогБиблиотеки = Новый Файл(ОбъединитьПути(ТекущийСценарий().Каталог, "../..")).ПолноеИмя;
	ПутьКЗапускателю = ОбъединитьПути(ТекущийСценарий().Каталог, "fixtures", "testrunner.os");
	Анализатор = Новый АнализаторОшибокТестовOneScript;
	ИсходнаяКодировка = Консоль.КодировкаВыходногоПотока;
	Консоль.КодировкаВыходногоПотока = КодировкаТекста.OEM;

	// Действие
	Попытка
		Анализатор.Сформировать(
			КаталогТестов,
			ПутьКОтчету,
			ПутьКЗапускателю,
			КаталогБиблиотеки,
			"oscript"
		);
	Исключение
		Консоль.КодировкаВыходногоПотока = ИсходнаяКодировка;
		ВызватьИсключение;
	КонецПопытки;

	Консоль.КодировкаВыходногоПотока = ИсходнаяКодировка;
	Отчет = ПрочитатьДокумент(ПутьКОтчету);

	// Проверка
	Кандидат = НайтиПоМетоду(Отчет.Results, "ТестДолжен_ВызватьОшибкуНедопустимогоЗначения");
	Ожидаем.Что(Кандидат.Description).Равно("Неверное значение аргумента номер 1");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ИнициализироватьGitРепозиторий(Каталог)

	ЗапуститьGit("init --quiet", Каталог);
	ЗапуститьGit("add .", Каталог);
	ЗапуститьGit(
		"-c user.email=probes@example.invalid -c user.name=Probes commit --quiet -m baseline",
		Каталог
	);

КонецПроцедуры

Процедура ЗапуститьGit(Аргументы, Каталог)

	Результат = ЗапуститьКоманду("git " + Аргументы, Каталог);
	Если Результат.КодВозврата <> 0 Тогда
		ВызватьИсключение Результат.Вывод;
	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьРезультаты(Результаты)

	Кандидат = НайтиПоМетоду(Результаты, "ТестДолжен_ВызватьОшибкуНедопустимогоЗначения");
	
	Ожидаем.Что(Кандидат.Status).Равно("Classified");
	Ожидаем.Что(Кандидат.Code).Равно("argument.invalid_value");
	Ожидаем.Что(Кандидат.Description).Равно("Неверное значение аргумента номер 1");
	Ожидаем.Что(
		НайтиПоМетоду(Результаты, "ТестДолжен_ЗавершитьсяБезИсключения").Status
	).Равно("NoException");
	
	ВременныйПуть = НайтиПоМетоду(Результаты, "ТестДолжен_НормализоватьВременныйПуть");
	Ожидаем.Что(ВременныйПуть.Status).Равно("Classified");
	Ожидаем.Что(СтрНайти(ВременныйПуть.Description, "<Temp>\<temporary>") > 0).Равно(Истина);
	Ожидаем.Что(
		НайтиПоМетоду(Результаты, "ТестДолжен_ОбработатьВнутреннееИсключение").Status
	).Равно("NoException");
	Ожидание = НайтиПоИсточнику(Результаты, "ОжиданиеИсключения");
	Ожидаем.Что(Ожидание.Status).Равно("Classified");
	Ожидаем.Что(Ожидание.Code).Равно("argument.invalid_value");
	Ожидаем.Что(
		НайтиПоМетоду(Результаты, "ТестДолжен_ПрочитатьОтносительнуюФикстуру").Status
	).Равно("NoException");
	Ожидаем.Что(
		НайтиПоМетоду(Результаты, "ТестДолжен_ПрочитатьФикстуруИзСоседнегоКаталога").Status
	).Равно("NoException");
	Ожидаем.Что(
		НайтиПоМетоду(Результаты, "ТестДолжен_НеЛоматьКонструкциюБезТочкиСЗапятой").Status
	).Равно("NotObserved");

КонецПроцедуры

Функция НайтиПоМетоду(Результаты, ИмяМетода)

	Для Каждого Результат Из Результаты Цикл
		Если Результат.TestMethod = ИмяМетода Тогда
			Возврат Результат;
		КонецЕсли;
	КонецЦикла;

	ВызватьИсключение "Не найден результат метода " + ИмяМетода;

КонецФункции

Функция НайтиПоИсточнику(Результаты, Источник)

	Для Каждого Результат Из Результаты Цикл
		Если Результат.Source = Источник Тогда
			Возврат Результат;
		КонецЕсли;
	КонецЦикла;

	ВызватьИсключение "Не найден результат источника " + Источник;

КонецФункции

Процедура СкопироватьФикстуру(Имя, КаталогНазначения)

	КопироватьФайл(
		ОбъединитьПути(ТекущийСценарий().Каталог, "fixtures", Имя),
		ОбъединитьПути(КаталогНазначения, Имя)
	);

КонецПроцедуры

Функция СоздатьВременныйКаталог()

	Возврат ВременныеФайлы.СоздатьКаталог();

КонецФункции

Функция ЗапуститьКоманду(Команда, РабочийКаталог)

	ВнешняяКоманда = Новый Команда;
	ВнешняяКоманда.УстановитьСтрокуЗапуска(Команда);
	ВнешняяКоманда.УстановитьРабочийКаталог(РабочийКаталог);
	ВнешняяКоманда.УстановитьКодировкуВывода(КодировкаТекста.UTF8);
	КодВозврата = ВнешняяКоманда.Исполнить();

	Возврат Новый Структура("КодВозврата,Вывод", КодВозврата, ВнешняяКоманда.ПолучитьВывод());

КонецФункции

Функция ПрочитатьДокумент(Путь)

	Чтение = Новый ЧтениеJSON;
	Чтение.ОткрытьФайл(Путь);
	Документ = ПрочитатьJSON(Чтение);
	Чтение.Закрыть();

	Возврат Документ;

КонецФункции

Процедура ЗаписатьТекст(Путь, Текст)

	Запись = Новый ЗаписьТекста(Путь, КодировкаТекста.UTF8);
	Запись.Записать(Текст);
	Запись.Закрыть();

КонецПроцедуры

Процедура СнятьПометкуТолькоЧтение(Каталог)

	Для Каждого Файл Из НайтиФайлы(Каталог, "*", Истина) Цикл
		Если Файл.ЭтоФайл() Тогда
			Файл.УстановитьТолькоЧтение(Ложь);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти
