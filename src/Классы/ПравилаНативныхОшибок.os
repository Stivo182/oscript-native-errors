#Использовать errors

Перем _Правила; // ФиксированныйМассив из ПравилоКлассификацииОшибок

#Область ОбработчикиСобытий

// Создает каталог встроенных правил классификации нативных ошибок.
Процедура ПриСозданииОбъекта()

	Правила = Новый Массив;

	ДобавитьПравилаФайловойСистемы(Правила);
	ДобавитьПравилаПроцессов(Правила);
	ДобавитьПравилаПотоков(Правила);
	ДобавитьПравилаJSON(Правила);
	ДобавитьПравилаXML(Правила);
	ДобавитьПравилаZIP(Правила);
	ДобавитьПравилаТекста(Правила);
	ДобавитьПравилаСтроковыхОпераций(Правила);
	ДобавитьПравилаЛокали(Правила);
	ДобавитьПравилаДвоичныхДанных(Правила);
	ДобавитьПравилаОбъектов(Правила);
	ДобавитьПравилаHTTP(Правила);
	ДобавитьПравилаВебСервера(Правила);
	ДобавитьПравилаВнешнихКомпонент(Правила);
	ДобавитьПравилаCOM(Правила);
	ДобавитьПравилаКонсоли(Правила);

	_Правила = Новый ФиксированныйМассив(Правила);

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Возвращает встроенные правила классификации нативных ошибок.
//
// Возвращаемое значение:
//  ФиксированныйМассив из ПравилоКлассификацииОшибок - Правила классификации.
Функция Все() Экспорт

	Возврат _Правила;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ДобавитьПравилаФайловойСистемы(Правила)

	СообщениеРесурсНеНайден = "ru = 'Файл или каталог не найден'; en = 'File or directory not found'";

	Правила.Добавить(
		Новый ПравилоКлассификацииОшибок()
			.СНативнымТипом("System.UnauthorizedAccessException")
			.СИдентификатором("filesystem.access_denied")
			.КлассифицируетКак(
				КодыНативныхОшибок.ФайловаяСистемаДоступЗапрещен(),
				"ru = 'Доступ к файлу или каталогу запрещен'; en = 'Access to file or directory is denied'"
			)
	);
	Правила.Добавить(
		Новый ПравилоКлассификацииОшибок()
			.СНативнымТипом("System.IO.IOException")
			.Содержит("ru = 'Файл '''; en = 'The file '''")
			.ОканчиваетсяНа("ru = ''' уже существует.'; en = ''' already exists.'")
			.СИдентификатором("filesystem.already_exists.file_path")
			.КлассифицируетКак(
				КодыНативныхОшибок.ФайловаяСистемаРесурсУжеСуществует(),
				"ru = 'Файл уже существует'; en = 'File already exists'"
			)
	);
	Правила.Добавить(
		Новый ПравилоКлассификацииОшибок()
			.СНативнымТипом("System.IO.IOException")
			.Содержит("Cannot create '")
			.ОканчиваетсяНа("' because a file or directory with the same name already exists.")
			.СИдентификатором("filesystem.already_exists.directory_path")
			.КлассифицируетКак(
				КодыНативныхОшибок.ФайловаяСистемаРесурсУжеСуществует(),
				"ru = 'Файл или каталог уже существует'; en = 'File or directory already exists'"
			)
	);
	Правила.Добавить(
		Новый ПравилоКлассификацииОшибок()
			.СНативнымТипом("System.IO.IOException")
			.ОканчиваетсяНа(
				"ru = 'Невозможно создать файл, так как он уже существует.';"
				+ "en = 'Cannot create a file when that file already exists.'"
			)
			.СИдентификатором("filesystem.already_exists.file_win32")
			.КлассифицируетКак(
				КодыНативныхОшибок.ФайловаяСистемаРесурсУжеСуществует(),
				"ru = 'Файл уже существует'; en = 'File already exists'"
			)
	);
	Правила.Добавить(
		Новый ПравилоКлассификацииОшибок()
			.СНативнымТипом("System.IO.IOException")
			.Содержит(
				"ru = 'Процесс не может получить доступ к файлу ''';"
				+ "en = 'The process cannot access the file '''"
			)
			.ОканчиваетсяНа(
				"ru = ''', так как этот файл используется другим процессом.';"
				+ "en = ''' because it is being used by another process.'"
			)
			.СИдентификатором("filesystem.resource_busy")
			.КлассифицируетКак(
				КодыНативныхОшибок.ФайловаяСистемаРесурсЗанят(),
				"ru = 'Файл уже используется'; en = 'File is already in use'"
			)
	);
	Правила.Добавить(
		Новый ПравилоКлассификацииОшибок()
			.СНативнымТипом("System.IO.FileNotFoundException")
			.СИдентификатором("filesystem.not_found.file_type")
			.КлассифицируетКак(
				КодыНативныхОшибок.ФайловаяСистемаРесурсНеНайден(),
				СообщениеРесурсНеНайден
			)
	);
	Правила.Добавить(
		Новый ПравилоКлассификацииОшибок()
			.СНативнымТипом("System.IO.DirectoryNotFoundException")
			.СИдентификатором("filesystem.not_found.directory_type")
			.КлассифицируетКак(
				КодыНативныхОшибок.ФайловаяСистемаРесурсНеНайден(),
				СообщениеРесурсНеНайден
			)
	);
	Правила.Добавить(
		Новый ПравилоКлассификацииОшибок()
			.НачинаетсяС("Could not find file '")
			.СИдентификатором("filesystem.not_found.file_message")
			.КлассифицируетКак(
				КодыНативныхОшибок.ФайловаяСистемаРесурсНеНайден(),
				СообщениеРесурсНеНайден
			)
	);
	Правила.Добавить(
		Новый ПравилоКлассификацииОшибок()
			.НачинаетсяС("Could not find a part of the path '")
			.СИдентификатором("filesystem.not_found.directory_message")
			.КлассифицируетКак(
				КодыНативныхОшибок.ФайловаяСистемаРесурсНеНайден(),
				СообщениеРесурсНеНайден
			)
	);
	Правила.Добавить(
		Новый ПравилоКлассификацииОшибок()
			.СНативнымТипом("System.ArgumentException")
			.Содержит("Invalid File or Directory attributes value.")
			.СИдентификатором("filesystem.not_found.file_attributes")
			.КлассифицируетКак(
				КодыНативныхОшибок.ФайловаяСистемаРесурсНеНайден(),
				СообщениеРесурсНеНайден
			)
	);

КонецПроцедуры

Процедура ДобавитьПравилаПроцессов(Правила)

	Правила.Добавить(
		Новый ПравилоКлассификацииОшибок()
			.СНативнымТипом("System.ComponentModel.Win32Exception")
			.Содержит("An error occurred trying to start process '")
			.ОканчиваетсяНа("ru = 'Не удается найти указанный файл.'; en = 'The system cannot find the file specified.'")
			.СИдентификатором("process.executable_not_found")
			.КлассифицируетКак(
				КодыНативныхОшибок.ПроцессИсполняемыйФайлНеНайден(),
				"ru = 'Исполняемый файл приложения не найден'; en = 'Application executable was not found'"
			)
	);
	Правила.Добавить(
		Новый ПравилоКлассификацииОшибок()
			.СНативнымТипом("System.ComponentModel.Win32Exception")
			.Содержит("An error occurred trying to start process '")
			.ОканчиваетсяНа("ru = 'Нет такого файла или каталога'; en = 'No such file or directory'")
			.СИдентификатором("process.executable_not_found.unix")
			.КлассифицируетКак(
				КодыНативныхОшибок.ПроцессИсполняемыйФайлНеНайден(),
				"ru = 'Исполняемый файл приложения не найден'; "
				+ "en = 'Application executable was not found'"
			)
	);
	Правила.Добавить(
		Новый ПравилоКлассификацииОшибок()
			.СНативнымТипом("System.InvalidOperationException")
			.ОканчиваетсяНа("Process must exit before requested information can be determined.")
			.СИдентификатором("process.exit_code_unavailable")
			.КлассифицируетКак(
				КодыНативныхОшибок.ПроцессКодВозвратаНедоступен(),
				"ru = 'Код возврата недоступен до завершения процесса'; "
				+ "en = 'Exit code is unavailable until the process exits'"
			)
	);

КонецПроцедуры

Процедура ДобавитьПравилаПотоков(Правила)

	Правила.Добавить(
		Новый ПравилоКлассификацииОшибок()
			.СНативнымТипом("System.ArgumentException")
			.ОканчиваетсяНа("Stream was not readable.")
			.СИдентификатором("stream.not_readable")
			.КлассифицируетКак(
				КодыНативныхОшибок.ПотокНедоступенДляЧтения(),
				"ru = 'Поток недоступен для чтения'; en = 'Stream is not readable'"
			)
	);
	Правила.Добавить(
		Новый ПравилоКлассификацииОшибок()
			.СовпадаетС(
				"ru = 'Попытка записи в поток не поддерживающий запись';"
				+ "en = 'Cannot write to a stream that does not support writing'"
			)
			.СИдентификатором("stream.not_writable")
			.КлассифицируетКак(
				КодыНативныхОшибок.ПотокНеПоддерживаетЗапись(),
				"ru = 'Поток не поддерживает запись'; en = 'Stream does not support writing'"
			)
	);
	Правила.Добавить(
		Новый ПравилоКлассификацииОшибок()
			.СовпадаетС("ru = 'Ошибка обращения к закрытому потоку'; en = 'Cannot access a closed stream'")
			.СИдентификатором("stream.closed.onescript")
			.КлассифицируетКак(
				КодыНативныхОшибок.ПотокЗакрыт(),
				"ru = 'Поток закрыт'; en = 'Stream is closed'"
			)
	);
	Правила.Добавить(
		Новый ПравилоКлассификацииОшибок()
			.СНативнымТипом("System.ObjectDisposedException")
			.ОканчиваетсяНа("ru = 'Доступ к закрытому потоку невозможен.'; en = 'Cannot access a closed Stream.'")
			.СИдентификатором("stream.closed.dotnet_stream")
			.КлассифицируетКак(
				КодыНативныхОшибок.ПотокЗакрыт(),
				"ru = 'Поток закрыт'; en = 'Stream is closed'"
			)
	);
	Правила.Добавить(
		Новый ПравилоКлассификацииОшибок()
			.СНативнымТипом("System.ObjectDisposedException")
			.ОканчиваетсяНа("Cannot access a closed file.")
			.СИдентификатором("stream.closed.dotnet_file")
			.КлассифицируетКак(
				КодыНативныхОшибок.ПотокЗакрыт(),
				"ru = 'Поток закрыт'; en = 'Stream is closed'"
			)
	);
	Правила.Добавить(
		Новый ПравилоКлассификацииОшибок()
			.СНативнымТипом("System.ObjectDisposedException")
			.ОканчиваетсяНа("Object name: 'System.Net.Sockets.TcpClient'.")
			.СИдентификатором("stream.closed.tcp_client")
			.КлассифицируетКак(
				КодыНативныхОшибок.ПотокЗакрыт(),
				"ru = 'Поток закрыт'; en = 'Stream is closed'"
			)
	);
	Правила.Добавить(
		Новый ПравилоКлассификацииОшибок()
			.СНативнымТипом("System.ArgumentOutOfRangeException")
			.Содержит(
				"ru = 'Смещение и длина находились вне границ массива.';"
				+ "en = 'Offset and length were out of bounds for the array or count is greater than the number "
				+ "of elements from index to the end of the source collection.'"
			)
			.СИдентификатором("stream.buffer_range")
			.КлассифицируетКак(
				КодыНативныхОшибок.ПотокВыходЗаГраницыБуфера(),
				"ru = 'Диапазон буфера выходит за допустимые границы';"
				+ "en = 'Buffer range is outside the allowed bounds'"
			)
	);
	Правила.Добавить(
		Новый ПравилоКлассификацииОшибок()
			.СНативнымТипом("System.InvalidOperationException")
			.ОканчиваетсяНа("Timeouts are not supported on this stream.")
			.СИдентификатором("stream.timeout_not_supported")
			.КлассифицируетКак(
				КодыНативныхОшибок.ПотокНеПоддерживаетТаймауты(),
				"ru = 'Поток не поддерживает таймауты'; en = 'Stream does not support timeouts'"
			)
	);

КонецПроцедуры

Процедура ДобавитьПравилаКонсоли(Правила)

	СообщениеЧтенияКлавиши = "Cannot read keys when either application does not have a console "
		+ "or when console input has been redirected.";
	СообщениеПроверкиКлавиши = "Cannot see if a key has been pressed when either application does not have a "
		+ "console or when console input has been redirected from a file.";

	Правила.Добавить(
		Новый ПравилоКлассификацииОшибок()
			.СНативнымТипом("System.InvalidOperationException")
			.Содержит(СообщениеЧтенияКлавиши)
			.СИдентификатором("console.unavailable.read_key")
			.КлассифицируетКак(
				КодыНативныхОшибок.КонсольНедоступна(),
				"ru = 'Системная консоль недоступна'; en = 'System console is unavailable'"
			)
	);
	Правила.Добавить(
		Новый ПравилоКлассификацииОшибок()
			.СНативнымТипом("System.InvalidOperationException")
			.Содержит(СообщениеПроверкиКлавиши)
			.СИдентификатором("console.unavailable.key_available")
			.КлассифицируетКак(
				КодыНативныхОшибок.КонсольНедоступна(),
				"ru = 'Системная консоль недоступна'; en = 'System console is unavailable'"
			)
	);
КонецПроцедуры

Процедура ДобавитьПравилаJSON(Правила)

	Правила.Добавить(
		Новый ПравилоКлассификацииОшибок()
			.СНативнымТипом("Newtonsoft.Json.JsonReaderException")
			.Содержит("Error reading JObject from JsonReader. Path '")
			.СИдентификатором("json.invalid_syntax.jobject")
			.КлассифицируетКак(
				КодыНативныхОшибок.JSONНекорректныйСинтаксис(),
				"ru = 'Некорректные данные JSON'; en = 'Invalid JSON data'"
			)
	);
	Правила.Добавить(
		Новый ПравилоКлассификацииОшибок()
			.СНативнымТипом("Newtonsoft.Json.JsonWriterException")
			.СИдентификатором("json.invalid_write_state")
			.КлассифицируетКак(
				КодыНативныхОшибок.JSONНекорректноеСостояниеЗаписи(),
				"ru = 'Недопустимая операция записи JSON'; en = 'Invalid JSON writing operation'"
			)
	);
	Правила.Добавить(
		Новый ПравилоКлассификацииОшибок()
			.СовпадаетС("ru = 'Источник данных JSON не открыт'; en = 'JSON data source is not opened'")
			.СИдентификатором("json.reader_not_open")
			.КлассифицируетКак(
				КодыНативныхОшибок.JSONЧтениеНеОткрыто(),
				"ru = 'Недопустимое состояние объекта JSON'; en = 'Invalid JSON object state'"
			)
	);
	Правила.Добавить(
		Новый ПравилоКлассификацииОшибок()
			.СовпадаетС("ru = 'Приемник данных JSON не открыт'; en = 'JSON data target is not opened'")
			.СИдентификатором("json.writer_not_open")
			.КлассифицируетКак(
				КодыНативныхОшибок.JSONЗаписьНеОткрыта(),
				"ru = 'Недопустимое состояние объекта JSON'; en = 'Invalid JSON object state'"
			)
	);
	Правила.Добавить(
		Новый ПравилоКлассификацииОшибок()
			.СовпадаетС("ru = 'Текущее значение JSON не может быть получено'; en = 'Cannot get current JSON value'")
			.СИдентификатором("json.current_value_unavailable")
			.КлассифицируетКак(
				КодыНативныхОшибок.JSONТекущееЗначениеНедоступно(),
				"ru = 'Недопустимое состояние объекта JSON'; en = 'Invalid JSON object state'"
			)
	);
	Правила.Добавить(
		Новый ПравилоКлассификацииОшибок()
			.СовпадаетС("ru = 'Формат даты JavaScript не поддерживается.'; en = 'JavaScript date format is not supported'")
			.СИдентификатором("json.unsupported_date_format")
			.КлассифицируетКак(
				КодыНативныхОшибок.JSONФорматДатыНеПоддерживается(),
				"ru = 'Выбранный формат даты не поддерживается'; en = 'Selected date format is not supported'"
			)
	);
	Правила.Добавить(
		Новый ПравилоКлассификацииОшибок()
			.СовпадаетС(
				"ru = 'Представление даты имеет неверный формат.';"
				+ "en = 'Invalid date presentation format'"
			)
			.СИдентификатором("json.invalid_date_presentation")
			.КлассифицируетКак(
				КодыНативныхОшибок.JSONНекорректноеПредставлениеДаты(),
				"ru = 'Представление даты JSON имеет неверный формат';"
				+ "en = 'JSON date presentation has an invalid format'"
			)
	);
	Правила.Добавить(
		Новый ПравилоКлассификацииОшибок()
			.СовпадаетС(
				"ru = 'Невозможно сохранить локальную дату в формате JavaScript';"
				+ "en = 'Cannot save local date in JavaScript format'"
			)
			.СИдентификатором("json.local_date.javascript")
			.КлассифицируетКак(
				КодыНативныхОшибок.JSONЛокальнаяДатаНеПоддерживается(),
				"ru = 'Выбранный формат даты требует UTC'; en = 'Selected date format requires UTC'"
			)
	);
	Правила.Добавить(
		Новый ПравилоКлассификацииОшибок()
			.СовпадаетС(
				"ru = 'Невозможно сохранить локальную дату в формате Microsoft';"
				+ "en = 'Cannot save local date in Microsoft format'"
			)
			.СИдентификатором("json.local_date.microsoft")
			.КлассифицируетКак(
				КодыНативныхОшибок.JSONЛокальнаяДатаНеПоддерживается(),
				"ru = 'Выбранный формат даты требует UTC'; en = 'Selected date format requires UTC'"
			)
	);
	Правила.Добавить(
		Новый ПравилоКлассификацииОшибок()
			.НачинаетсяС("ru = 'Запись значения типа '; en = 'Cannot write value of type '")
			.ОканчиваетсяНа("ru = ' не поддерживается'; en = ''")
			.СИдентификатором("json.unsupported_value_type")
			.КлассифицируетКак(
				КодыНативныхОшибок.JSONНеподдерживаемыйТипЗначения(),
				"ru = 'Тип значения не поддерживается ЗаписьюJSON';"
				+ "en = 'Value type is not supported by JSONWriter'"
			)
	);
	Правила.Добавить(
		Новый ПравилоКлассификацииОшибок()
			.НачинаетсяС(
				"ru = 'Недопустимое состояние потока чтения JSON в строке';"
				+ "en = 'Invalid JSON reader state at line'"
			)
			.СИдентификатором("json.invalid_syntax.reader_state")
			.КлассифицируетКак(
				КодыНативныхОшибок.JSONНекорректныйСинтаксис(),
				"ru = 'Некорректные данные JSON'; en = 'Invalid JSON data'"
			)
	);
	Правила.Добавить(
