			.СовпадаетС("ru = 'Заголовок Date задан неправильно'; en = 'Header Date is invalid'")
			.СИдентификатором("http.invalid_header.date")
			.КлассифицируетКак(
				КодОшибки,
				Сообщение
			)
	);
	Правила.Добавить(
		Новый ПравилоКлассификацииОшибок()
			.СовпадаетС("ru = 'Заголовок If-Modified-Since задан неправильно'; en = 'Header If-Modified-Since is invalid'")
			.СИдентификатором("http.invalid_header.if_modified_since")
			.КлассифицируетКак(
				КодОшибки,
				Сообщение
			)
	);
	Правила.Добавить(
		Новый ПравилоКлассификацииОшибок()
			.СовпадаетС("ru = 'Заголовок Range задан неправильно'; en = 'Header Range is invalid'")
			.СИдентификатором("http.invalid_header.range")
			.КлассифицируетКак(
				КодОшибки,
				Сообщение
			)
	);
	Правила.Добавить(
		Новый ПравилоКлассификацииОшибок()
			.СНативнымТипом("System.ArgumentException")
			.Содержит("Chunked encoding must be set via the SendChunked property.")
			.СИдентификатором("http.invalid_header.transfer_encoding")
			.КлассифицируетКак(
				КодОшибки,
				Сообщение
			)
	);
	Правила.Добавить(
		Новый ПравилоКлассификацииОшибок()
			.СНативнымТипом("System.ArgumentException")
			.Содержит("Keep-Alive and Close may not be set using this property.")
			.СИдентификатором("http.invalid_header.connection")
			.КлассифицируетКак(
				КодОшибки,
				Сообщение
			)
	);
	Правила.Добавить(
		Новый ПравилоКлассификацииОшибок()
			.СНативнымТипом("System.ArgumentException")
			.Содержит("The specified value is not a valid Host header string.")
			.СИдентификатором("http.invalid_header.host")
			.КлассифицируетКак(
				КодОшибки,
				Сообщение
			)
	);

КонецПроцедуры

Процедура ДобавитьПравилаCOM(Правила)

	Правила.Добавить(
		Новый ПравилоКлассификацииОшибок()
			.СНативнымТипом("System.NotSupportedException")
			.ОканчиваетсяНа("Getting object by classname not supported on net6+")
			.СИдентификатором("com.active_object_not_supported")
			.КлассифицируетКак(
				КодыНативныхОшибок.COMПолучениеАктивногоОбъектаНеПоддерживается(),
				"ru = 'Получение активного COM-объекта не поддерживается';"
				+ "en = 'Getting an active COM object is not supported'"
			)
	);

КонецПроцедуры

Процедура ДобавитьПравилаВнешнихКомпонент(Правила)

	Правила.Добавить(
		Новый ПравилоКлассификацииОшибок()
			.СНативнымТипом("System.BadImageFormatException")
			.Содержит("Bad IL format. The format of the file")
			.СИдентификатором("component.invalid_format")
			.КлассифицируетКак(
				КодыНативныхОшибок.ВнешняяКомпонентаНекорректныйФормат(),
				"ru = 'Некорректный формат внешней компоненты';"
				+ "en = 'External component has an invalid format'"
			)
	);
	Правила.Добавить(
		Новый ПравилоКлассификацииОшибок()
			.НачинаетсяС("Не удалось создать объект `")
			.Содержит(" внешней компоненты `")
			.СИдентификатором("component.creation_failed")
			.КлассифицируетКак(
				КодыНативныхОшибок.ВнешняяКомпонентаОбъектНеСоздан(),
				"ru = 'Не удалось создать объект внешней компоненты';"
				+ "en = 'External component object could not be created'"
			)
	);

КонецПроцедуры

#КонецОбласти
