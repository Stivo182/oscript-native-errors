			.ОканчиваетсяНа("(InvalidResponse)")
			.СИдентификатором("http.invalid_response.chunk_terminator")
			.КлассифицируетКак(
				КодОшибки,
				Сообщение
			)
	);

КонецПроцедуры

Процедура ДобавитьПравилаHTTPЗаголовков(Правила)

	КодОшибки = КодыНативныхОшибок.HTTPНекорректныйЗаголовок();
	Сообщение = "ru = 'Недопустимый HTTP-заголовок'; en = 'Invalid HTTP header'";

	Правила.Добавить(
		Новый ПравилоКлассификацииОшибок()
			.СовпадаетС("ru = 'Заголовок Content-Length задан неправильно'; en = 'Header Content-Length is invalid'")
			.СИдентификатором("http.invalid_header.content_length")
			.КлассифицируетКак(
				КодОшибки,
				Сообщение
			)
	);
	Правила.Добавить(
