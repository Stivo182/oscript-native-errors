Функция ПолучитьОшибкуКонструктораСценария(ИмяФайла, КоличествоАргументов)

	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	ПутьСценария = ОбъединитьПути(КаталогТестов, "fixtures", ИмяФайла);
	ИмяТипа = "Конструктор" + СтрЗаменить(Строка(Новый УникальныйИдентификатор), "-", "");
	ПодключитьСценарий(ПутьСценария, ИмяТипа);

	Попытка
		Объект = Новый(ИмяТипа, Новый Массив(КоличествоАргументов));
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	ВызватьИсключение "Ожидаемая ошибка конструктора сценария не возникла";

КонецФункции

