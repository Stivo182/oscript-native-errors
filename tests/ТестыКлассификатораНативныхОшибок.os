Функция ПолучитьОшибкуВыходаДатыЗаДиапазонПриУстановкеСрокаДействияCookie() Экспорт

	// Подготовка
	ПараметрыCookie = Новый ПараметрыCookie;
	ДатаНаГраницеДиапазона = Дата(1, 1, 1);
	ИсходныйЧасовойПояс = ЧасовойПояс();
	ПолучитьПереключательЧасовогоПояса().УстановитьПоложительнуюЗону();

	// Действие
	Ошибка = Неопределено;
	Попытка
		Попытка
			ПараметрыCookie.Истекает = ДатаНаГраницеДиапазона;
		Исключение
			Ошибка = ИнформацияОбОшибке();
		КонецПопытки;
	Исключение
		ПолучитьПереключательЧасовогоПояса().ВосстановитьИсходнуюЗону();
		ВызватьИсключение;
	КонецПопытки;

	ПолучитьПереключательЧасовогоПояса().ВосстановитьИсходнуюЗону();

	// Проверка
	Ожидаем.Что(ЧасовойПояс()).Равно(ИсходныйЧасовойПояс);
	Если Ошибка <> Неопределено Тогда
		Возврат Ошибка;
	КонецЕсли;

	ВызватьИсключение "Ожидаемая ошибка выхода даты за диапазон не возникла";

КонецФункции

