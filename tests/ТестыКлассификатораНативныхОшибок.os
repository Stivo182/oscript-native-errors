&Тест
Процедура ТестДолжен_КлассифицироватьНативнуюОшибкуПоставщикомПравилПоТипу() Экспорт

	// Подготовка
	Классификатор = Новый КлассификаторОшибок;
	Классификатор.ДобавитьПоставщикаПравил(Тип("ПравилаНативныхОшибок"));
	ИсходнаяОшибка = ПолучитьОшибкуНекорректногоJSON();

	// Действие
	Результат = Классификатор.Классифицировать(ИсходнаяОшибка);

	// Проверка
	Ожидаем.Что(ДиагностикаОшибок.КодОшибки(Результат))
		.Равно(КодыНативныхОшибок.JSONНекорректныйСинтаксис());

КонецПроцедуры

