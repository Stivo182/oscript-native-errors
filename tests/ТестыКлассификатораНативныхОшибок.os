Функция ОбернутьКонтекстами(Ошибка, Количество)

	Результат = Ошибка;
	Для Номер = 1 По Количество Цикл
		Параметры = Новый Структура("Источник", "Тест");
		Результат = Новый ИнформацияОбОшибке(
			"Тестовый контекст " + Номер,
			Параметры,
			Результат
		);
	КонецЦикла;

	Возврат Результат;

