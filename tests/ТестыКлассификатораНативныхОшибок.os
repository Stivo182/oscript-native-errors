&Тест
Процедура ТестДолжен_ВыбиратьXMLПричинуВместоВнешнегоJSONСообщения() Экспорт

	// Подготовка
	Причина = ПолучитьОшибкуНекорректногоXML();
	Параметры = Новый Структура("Источник", "Тест");
	ИсходнаяОшибка = Новый ИнформацияОбОшибке(
		"Источник данных JSON не открыт",
		Параметры,
		Причина
	);
	Классификатор = Новый КлассификаторОшибок;
	Классификатор.ДобавитьПоставщикаПравил(Тип("ПравилаНативныхОшибок"));

	// Действие
	Результат = Классификатор.Классифицировать(ИсходнаяОшибка);

	// Проверка
	Ожидаем.Что(Результат).ИмеетТип("ИнформацияОбОшибке");
	Ожидаем.Что(ДиагностикаОшибок.КодОшибки(Результат))
		.Равно(КодыНативныхОшибок.XMLНекорректныйСинтаксис());

