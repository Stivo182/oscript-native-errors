&Тест
Процедура ТестДолжен_КлассифицироватьДобавленнымПравиломСБольшимПриоритетом() Экспорт

	// Подготовка
	Классификатор = Новый КлассификаторОшибок;
	Классификатор.ДобавитьПоставщикаПравил(Тип("ПравилаНативныхОшибок"));
	Правила = Новый Массив;
	Правила.Добавить(
		Новый ПравилоКлассификацииОшибок()
			.СовпадаетС("Источник данных JSON не открыт")
			.СПриоритетом(1)
			.КлассифицируетКак(
				"custom.json_source_not_open",
				"Пользовательская ошибка"
			)
	);
	Классификатор.ДобавитьПравила(Правила);
	ИсходнаяОшибка = ПолучитьОшибкуССообщением("Источник данных JSON не открыт");

	// Действие
	Результат = Классификатор.Классифицировать(ИсходнаяОшибка);

	// Проверка
	Ожидаем.Что(ДиагностикаОшибок.КодОшибки(Результат)).Равно("custom.json_source_not_open");

КонецПроцедуры

