#Использовать errors
#Использовать "../src"
#Использовать "./internal"

#Область ОбработчикиСобытий

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

#КонецОбласти

#Область Тесты

&ПараметризованныйТест
&ИсточникВыражение("() -> ПараметрыИсточниковОшибок()")
Процедура ТестДолжен_КлассифицироватьИсточникОшибки(ИдентификаторПравила, ИмяИсточника) Экспорт

	МатрицаИсточниковОшибок.ПроверитьИсточник(ЭтотОбъект, ИмяИсточника);

КонецПроцедуры

Функция ПараметрыИсточниковОшибок() Экспорт

	Возврат МатрицаИсточниковОшибок.ПараметрыИсточников(ЭтотОбъект, 5);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&ОжидаемыйКодОшибки("ДелениеНаНоль")
&ОжидаемоеПравилоОшибки("number.division_by_zero")
Функция ПолучитьОшибкуДеленияНаНоль() Экспорт

	Попытка
		Результат = 1 / 0;
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	ВызватьИсключение "Ожидаемая ошибка деления на ноль не возникла";

КонецФункции

&ОжидаемыйКодОшибки("ДелениеНаНоль")
&ОжидаемоеПравилоОшибки("number.division_by_zero")
Функция ПолучитьОшибкуОстаткаОтДеленияНаНоль() Экспорт

	Попытка
		Результат = 1 % 0;
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	ВызватьИсключение "Ожидаемая ошибка остатка от деления на ноль не возникла";

КонецФункции

&ОжидаемыйКодОшибки("ПереполнениеЧисловогоЗначения")
&ОжидаемоеПравилоОшибки("number.overflow")
Функция ПолучитьОшибкуПереполненияПриУмножении() Экспорт

	Попытка
		Результат = 79228162514264337593543950335 * 10;
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	ВызватьИсключение "Ожидаемая ошибка переполнения при умножении не возникла";

КонецФункции

&ОжидаемыйКодОшибки("ПереполнениеЧисловогоЗначения")
&ОжидаемоеПравилоОшибки("number.overflow")
Функция ПолучитьОшибкуНепредставимогоКвадратногоКорня() Экспорт

	Попытка
		Результат = Sqrt(-1);
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	ВызватьИсключение "Ожидаемая ошибка вычисления квадратного корня не возникла";

КонецФункции

&ОжидаемыйКодОшибки("НедопустимоеЗначениеАргумента")
&ОжидаемоеПравилоОшибки("argument.invalid_value.round_digits")
Функция ПолучитьОшибкуНекорректногоКоличестваРазрядовОкругления() Экспорт

	// Действие
	Попытка
		Результат = Окр(1, 29);
	Исключение
		// Проверка
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	ВызватьИсключение "Ожидаемая ошибка некорректного количества разрядов округления не возникла";

КонецФункции

#КонецОбласти
