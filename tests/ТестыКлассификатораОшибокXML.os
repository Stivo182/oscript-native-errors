	Попытка
		Чтение = Новый ЧтениеXML;
		Чтение.УстановитьСтроку("<root><child></root>");
		Пока Чтение.Прочитать() Цикл
		КонецЦикла;
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	ВызватьИсключение "Ожидаемая ошибка чтения XML не возникла";

КонецФункции

&ОжидаемыйКодОшибки("XSLНекорректнаяТаблицаСтилей")
&ОжидаемоеПравилоОшибки("xsl.invalid_stylesheet.load")
Функция ПолучитьОшибкуНекорректнойТаблицыСтилейXSL() Экспорт

	// Подготовка
	ИмяФайла = ОбъединитьПути(
		ТекущийСценарий().Каталог,
		"fixtures/некорректная-таблица-стилей.xsl"
	);
	Ошибка = Неопределено;

	// Действие
	Попытка
		Преобразование = Новый ПреобразованиеXSL;
		Преобразование.ЗагрузитьТаблицуСтилейXSLИзФайла(ИмяФайла);
	Исключение
		Ошибка = ИнформацияОбОшибке();
	КонецПопытки;

	// Проверка
	Если Ошибка <> Неопределено Тогда
		Возврат Ошибка;
	КонецЕсли;

	ВызватьИсключение "Ожидаемая ошибка некорректной таблицы стилей XSL не возникла";

КонецФункции

