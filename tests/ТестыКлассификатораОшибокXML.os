Функция СигнатурыВнешнихОшибокXML()

	Сигнатуры = Новый ТаблицаЗначений;
	Сигнатуры.Колонки.Добавить("НативныйТип");
	Сигнатуры.Колонки.Добавить("Сообщение");
	Сигнатуры.Колонки.Добавить("ПохожееСообщение");
	ДобавитьСигнатуру(
		Сигнатуры,
		"System.InvalidOperationException",
		"There was no XML start tag open.",
		"There was no start tag open."
	);
	ДобавитьСигнатуру(
		Сигнатуры,
		"System.InvalidOperationException",
		"Token EndAttribute in state Start would result in an invalid XML document.",
		"Token EndAttribute in state Start would result in an invalid JSON document."
	);
	ДобавитьСигнатуру(
		Сигнатуры,
		"System.InvalidOperationException",
		"Token StartAttribute in state Content would result in an invalid XML document.",
		"Token StartAttribute in state Content would result in an invalid JSON document."
	);
	ДобавитьСигнатуру(
		Сигнатуры,
		"System.InvalidOperationException",
		"WriteStartDocument needs to be the first call.",
		"WriteStartObject needs to be the first call."
	);
	ДобавитьСигнатуру(
		Сигнатуры,
		"System.ArgumentException",
		"Cannot have ']]>' inside an XML CDATA block.",
		"Cannot have ']]>' inside a text block."
	);
	ДобавитьСигнатуру(
		Сигнатуры,
		"System.ArgumentException",
		"Cannot have '?>' inside an XML processing instruction.",
		"Cannot have '?>' inside a processing instruction."
	);
	ДобавитьСигнатуру(
		Сигнатуры,
		"System.ArgumentException",
		"Invalid name character in 'value'.",
		"Invalid name character in value."
	);
	ДобавитьСигнатуру(
		Сигнатуры,
		"System.ArgumentException",
		"Prefixes beginning with ""xml"" (regardless of whether the characters are uppercase, lowercase, "
			+ "or some combination thereof) are reserved for use by XML.",
		"Prefixes beginning with ""xml"" are reserved for use by XML."
	);
	ДобавитьСигнатуру(
		Сигнатуры,
		"System.ArgumentException",
		"Cannot bind to the reserved namespace.",
		"Cannot bind to a reserved namespace."
	);
	ДобавитьСигнатуру(
		Сигнатуры,
		"System.ArgumentException",
		"The surrogate pair (0xD800, 0xD800) is invalid. A high surrogate character "
			+ "(0xD800 - 0xDBFF) must always be paired with a low surrogate character (0xDC00 - 0xDFFF).",
		"The surrogate pair is malformed."
	);
	ДобавитьСигнатуру(
		Сигнатуры,
		"System.ArgumentException",
		"The surrogate pair is invalid. Missing a low surrogate character.",
		"A surrogate pair is invalid. Missing a low surrogate character."
	);
	ДобавитьСигнатуру(
		Сигнатуры,
		"System.ArgumentException",
		"An XML comment cannot contain '--', and '-' cannot be the last character.",
		"A comment cannot contain '--', and '-' cannot be the last character."
	);
	ДобавитьСигнатуру(
		Сигнатуры,
		"System.FormatException",
		"The string 'value' is not a valid Boolean value.",
		"String 'value' was not recognized as a valid Boolean."
	);
	ДобавитьСигнатуру(
		Сигнатуры,
		"System.FormatException",
		"The string 'value' is not a valid AllXsd value.",
		"The string 'value' is not a valid date value."
	);
	ДобавитьСигнатуру(
		Сигнатуры,
		"System.FormatException",
		"The input is not a valid Base-64 string as it contains a non-base 64 character, "
			+ "more than two padding characters, or an illegal character among the padding characters.",
		"The input is not a valid Base-64 string."
	);
	ДобавитьСигнатуру(
		Сигнатуры,
		"System.ArgumentOutOfRangeException",
		"i ('-1') must be a non-negative value. (Parameter 'i')" + Символы.ПС + "Actual value was -1.",
		"i ('-1') must be a positive value. (Parameter 'index')" + Символы.ПС + "Actual value was -1."
	);

	Возврат Сигнатуры;

КонецФункции

Процедура ДобавитьСигнатуру(Сигнатуры, НативныйТип, Сообщение, ПохожееСообщение)

	Сигнатура = Сигнатуры.Добавить();
	Сигнатура.НативныйТип = НативныйТип;
	Сигнатура.Сообщение = Сообщение;
	Сигнатура.ПохожееСообщение = ПохожееСообщение;

КонецПроцедуры

Процедура ПроверитьНеклассифицированностьСообщения(Сообщение)

	Ошибка = Новый ИнформацияОбОшибке(Сообщение, Новый Структура("Источник", "Тест"));
	ТестовыйПробросПодробногоПредставления.ПроверитьНеклассифицированностьВариантами(Ошибка);

КонецПроцедуры

