	Сообщение = "External exception (System.ArgumentOutOfRangeException): "
		+ "i ('-1') must be a non-negative value. (Parameter 'index')" + Символы.ПС
		+ "Actual value was -1.";

	Попытка
		ВызватьИсключение Сообщение;
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

