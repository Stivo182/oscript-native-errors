&Тест
Процедура ТестДолжен_ОпределятьСемантическиеГруппыНативныхКодов() Экспорт

	// Проверка XML-записи
	Ошибка = ФабрикаОшибок.Создать(КодыНативныхОшибок.XMLЗаписьНеОткрыта(), "Тест");
	Ожидаем.Что(ДиагностикаОшибок.СодержитГруппу(Ошибка, "xml.writer")).Равно(Истина);
	Ожидаем.Что(ДиагностикаОшибок.СодержитГруппу(Ошибка, "xml.reader")).Равно(Ложь);

	// Проверка JSON-даты
	Ошибка = ФабрикаОшибок.Создать(КодыНативныхОшибок.JSONНекорректноеПредставлениеДаты(), "Тест");
	Ожидаем.Что(ДиагностикаОшибок.СодержитГруппу(Ошибка, "json.date")).Равно(Истина);
	Ожидаем.Что(ДиагностикаОшибок.СодержитГруппу(Ошибка, "json.writer")).Равно(Ложь);

	// Проверка двоичного буфера
	Ошибка = ФабрикаОшибок.Создать(КодыНативныхОшибок.ДвоичныеДанныеТолькоДляЧтения(), "Тест");
	Ожидаем.Что(ДиагностикаОшибок.СодержитГруппу(Ошибка, "binary.buffer")).Равно(Истина);
	Ожидаем.Что(ДиагностикаОшибок.СодержитГруппу(Ошибка, "binary.format")).Равно(Ложь);

	// Проверка сетевого адреса
	Ошибка = ФабрикаОшибок.Создать(КодыНативныхОшибок.СетьНекорректныйIPАдрес(), "Тест");
	Ожидаем.Что(ДиагностикаОшибок.СодержитГруппу(Ошибка, "network.endpoint.address")).Равно(Истина);
	Ожидаем.Что(ДиагностикаОшибок.СодержитГруппу(Ошибка, "network.connection")).Равно(Ложь);

	// Проверка самостоятельного домена XSL
	Ошибка = ФабрикаОшибок.Создать(КодыНативныхОшибок.XSLВыполнениеПрервано(), "Тест");
	Ожидаем.Что(ДиагностикаОшибок.СодержитГруппу(Ошибка, "xsl.execution")).Равно(Истина);
	Ожидаем.Что(ДиагностикаОшибок.СодержитГруппу(Ошибка, "xml")).Равно(Ложь);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПеречислятьКодыПеременнойСредыИXSL() Экспорт

	// Действие
	Коды = КодыНативныхОшибок.Все();

	// Проверка
	Ожидаем.Что(Коды.Найти(КодыНативныхОшибок.ПустоеИмяПеременнойСреды()) <> Неопределено)
		.Равно(Истина);
	Ожидаем.Что(Коды.Найти(КодыНативныхОшибок.XSLНекорректнаяТаблицаСтилей()) <> Неопределено)
		.Равно(Истина);
	Ожидаем.Что(Коды.Найти(КодыНативныхОшибок.XSLВыполнениеПрервано()) <> Неопределено)
		.Равно(Истина);

КонецПроцедуры

#КонецОбласти
