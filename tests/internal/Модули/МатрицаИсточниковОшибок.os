#Использовать asserts
#Использовать annotations
#Использовать collectionos
#Использовать errors
#Использовать fluent
#Использовать semver

#Область ПрограммныйИнтерфейс

// Воспроизводит источники с аннотацией ОжидаемыйКодОшибки и проверяет их классификацию.
// Аннотация ОжидаемоеПравилоОшибки дополнительно проверяет конкретное встроенное правило.
// Источники с ВключенДляOneScript воспроизводятся только в подходящей версии OneScript.
// Источники с ВключенНаОС воспроизводятся только в подходящей операционной системе.
//
// Параметры:
//  Контекст - Произвольный - Тестовый набор с экспортными функциями источников.
//  ОжидаемоеКоличество - Число - Количество источников в наборе.
Процедура Проверить(Контекст, ОжидаемоеКоличество) Экспорт

	Методы = ПолучитьМетодыИсточников(Контекст);
	Ожидаем.Что(Методы.Количество(), "Количество объявленных источников ошибок")
		.Равно(ОжидаемоеКоличество);

	Для Каждого Метод Из Методы Цикл
		Если Не ИсточникДоступенВТекущейВерсииOneScript(Метод)
			Или Не ИсточникДоступенВТекущейОС(Метод) Тогда
			Продолжить;
		КонецЕсли;

		ПроверитьИсточникМетода(Контекст, Метод);
	КонецЦикла;

КонецПроцедуры

// Проверяет классификацию ошибки, воспроизводимой указанной функцией тестового набора.
// Не вызывает источник, недоступный в текущей ОС или версии OneScript.
//
// Параметры:
//  Контекст - Произвольный - Тестовый набор с экспортной функцией источника.
//  ИмяИсточника - Строка - Имя функции, воспроизводящей ошибку.
//
// Исключения:
//  Выбрасывает исключение, если функция не найдена или ее классификация не соответствует аннотациям.
Процедура ПроверитьИсточник(Контекст, ИмяИсточника) Экспорт

	Для Каждого Метод Из ПолучитьМетодыИсточников(Контекст) Цикл
		Если Метод.Имя = ИмяИсточника Тогда
			Если Не ИсточникДоступенВТекущейВерсииOneScript(Метод)
				Или Не ИсточникДоступенВТекущейОС(Метод) Тогда
				Возврат;
			КонецЕсли;

			ПроверитьИсточникМетода(Контекст, Метод);
			Возврат;
		КонецЕсли;
	КонецЦикла;

	ВызватьИсключение "Не найден источник ошибки: " + ИмяИсточника;

КонецПроцедуры

// Возвращает параметры доступных источников для параметризованного теста.
// Ограничения ВключенДляOneScript и ВключенНаОС читаются с самой функции-источника.
//
// Параметры:
//  Контекст - Произвольный - Тестовый набор с экспортными функциями источников.
//  ОжидаемоеКоличество - Число - Количество всех источников в наборе, включая недоступные.
//
// Возвращаемое значение:
//  ПроцессорКоллекций - Набор списков с идентификатором правила и именем функции-источника.
Функция ПараметрыИсточников(Контекст, ОжидаемоеКоличество) Экспорт

	Методы = ПолучитьМетодыИсточников(Контекст);
	Ожидаем.Что(Методы.Количество(), "Количество объявленных источников ошибок")
		.Равно(ОжидаемоеКоличество);
	Результат = Новый Массив;

	Для Каждого Метод Из Методы Цикл
		Если Не ИсточникДоступенВТекущейВерсииOneScript(Метод)
			Или Не ИсточникДоступенВТекущейОС(Метод) Тогда
			Продолжить;
		КонецЕсли;

		ОжидаемыеПравила = ПолучитьОжидаемыеПравила(Метод);
		Если ОжидаемыеПравила.Количество() = 0 Тогда
			Результат.Добавить(Списки.ИзЭлементов("без встроенного правила", Метод.Имя));
			Продолжить;
		КонецЕсли;

		Для Каждого ОжидаемоеПравило Из ОжидаемыеПравила Цикл
			Результат.Добавить(Списки.ИзЭлементов(ОжидаемоеПравило, Метод.Имя));
		КонецЦикла;
	КонецЦикла;

	Возврат ПроцессорыКоллекций.ИзКоллекции(Результат);

КонецФункции

// Возвращает объявленные источники конкретных встроенных правил без их выполнения.
// Источник обязан иметь также аннотацию ОжидаемыйКодОшибки. Учитываются оба варианта ru/en.
//
// Параметры:
//  Контекст - Произвольный - Тестовый набор с экспортными функциями источников.
//
// Возвращаемое значение:
//  Массив из Структура - Объявленные источники:
//   * Правило - Строка - Идентификатор встроенного правила.
//   * КодОшибки - Строка - Ожидаемый публичный код.
//   * Метод - Строка - Имя функции, воспроизводящей ошибку.
Функция ИсточникиПравил(Контекст) Экспорт

	Результат = Новый Массив;
	Рефлектор = Новый Рефлектор;
	Методы = ПолучитьМетодыИсточников(Контекст);

	Для Каждого Метод Из Методы Цикл
		Идентификаторы = Новый Соответствие;
		Для Каждого Язык Из СтрРазделить("ru,en", ",") Цикл
			Для Каждого Правило Из ПолучитьОжидаемыеПравила(Метод, Язык) Цикл
				Идентификаторы.Вставить(Правило, Истина);
			КонецЦикла;
		КонецЦикла;

		Если Идентификаторы.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;

		АннотацияКода = РаботаСАннотациями.ПолучитьАннотацию(Метод, "ОжидаемыйКодОшибки");
		Ожидаем.Что(АннотацияКода <> Неопределено, "Аннотация ОжидаемыйКодОшибки источника " + Метод.Имя)
			.Равно(Истина);

		ИмяМетодаКода = РаботаСАннотациями.ПолучитьЗначениеПараметраАннотации(АннотацияКода);
		КодОшибки = Рефлектор.ВызватьМетод(КодыНативныхОшибок, ИмяМетодаКода, Новый Массив);

		Для Каждого Идентификатор Из Идентификаторы Цикл
			Результат.Добавить(Новый Структура(
				"Правило, КодОшибки, Метод",
				Идентификатор.Ключ,
				КодОшибки,
				Метод.Имя
			));
		КонецЦикла;
	КонецЦикла;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПолучитьМетодыИсточников(Контекст)

	Рефлектор = Новый Рефлектор;
	Результат = Новый Массив;
	Методы = РаботаСАннотациями.НайтиМетодыСАннотацией(
		Рефлектор.ПолучитьТаблицуМетодов(Контекст),
		"ОжидаемыйКодОшибки"
	);

	Для Каждого Метод Из Методы Цикл
		Если РаботаСАннотациями.ПолучитьАннотацию(Метод, "Выключен") <> Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Результат.Добавить(Метод);
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ПолучитьОжидаемыеПравила(Метод, Язык = "")

	Результат = Новый Массив;
	Аннотации = РаботаСАннотациями.ПолучитьАннотации(Метод, "ОжидаемоеПравилоОшибки");
	Для Каждого Аннотация Из Аннотации Цикл
		Правило = РаботаСАннотациями.ПолучитьЗначениеПараметраАннотации(Аннотация);
		Ожидаем.Что(Правило, "Значение аннотации ОжидаемоеПравилоОшибки")
			.ИмеетТип("Строка");

		НачалоАннотации = НРег(СтрЗаменить(СтрЗаменить(Правило, " ", ""), Символы.Таб, ""));
		Если СтрНачинаетсяС(НачалоАннотации, "ru=") Или СтрНачинаетсяС(НачалоАннотации, "en=") Тогда
			Правило = ?(ПустаяСтрока(Язык), НСтр(Правило), НСтр(Правило, Язык));
		КонецЕсли;

		Ожидаем.Что(ПустаяСтрока(Правило), "Идентификатор ожидаемого правила")
			.Равно(Ложь);

		Результат.Добавить(Правило);
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ИсточникДоступенВТекущейВерсииOneScript(Метод)

	Аннотация = РаботаСАннотациями.ПолучитьАннотацию(Метод, "ВключенДляOneScript");
	Если Аннотация = Неопределено Тогда
		Возврат Истина;
	КонецЕсли;

	ДиапазонВерсий = РаботаСАннотациями.ПолучитьЗначениеПараметраАннотации(Аннотация);
	Возврат Версии.ВерсияВДиапазоне(Новый СистемнаяИнформация().Версия, ДиапазонВерсий);

КонецФункции

Функция ИсточникДоступенВТекущейОС(Метод)

	Аннотация = РаботаСАннотациями.ПолучитьАннотацию(Метод, "ВключенНаОС");
	Если Аннотация = Неопределено Тогда
		Возврат Истина;
	КонецЕсли;

	ОперационнаяСистема = РаботаСАннотациями.ПолучитьЗначениеПараметраАннотации(Аннотация);
	ТекущаяОС = Новый СистемнаяИнформация().ТипПлатформы;

	Если ОперационнаяСистема = "Windows" Тогда
		Возврат ТекущаяОС = ТипПлатформы.Windows_x86 Или ТекущаяОС = ТипПлатформы.Windows_x86_64;
	ИначеЕсли ОперационнаяСистема = "Linux" Тогда
		Возврат ТекущаяОС = ТипПлатформы.Linux_x86 Или ТекущаяОС = ТипПлатформы.Linux_x86_64;
	Иначе
		Возврат ТекущаяОС = ТипПлатформы.MacOS_x86 Или ТекущаяОС = ТипПлатформы.MacOS_x86_64;
	КонецЕсли;

КонецФункции

Процедура ПроверитьИсточникМетода(Контекст, Метод)

	ИсходнаяОшибка = Неопределено;

	Попытка
		Рефлектор = Новый Рефлектор;
		Аннотация = РаботаСАннотациями.ПолучитьАннотацию(Метод, "ОжидаемыйКодОшибки");
		ИмяМетодаКода = РаботаСАннотациями.ПолучитьЗначениеПараметраАннотации(Аннотация);
		КодОшибки = Рефлектор.ВызватьМетод(КодыНативныхОшибок, ИмяМетодаКода, Новый Массив);
		ИсходнаяОшибка = Рефлектор.ВызватьМетод(Контекст, Метод.Имя, Новый Массив);
		ОжидаемыеПравила = ПолучитьОжидаемыеПравила(Метод);
		НеопределяемаяОбертка = РаботаСАннотациями.ПолучитьЗначениеПараметраАннотации(
			Аннотация,
			"НеопределяемаяОбертка",
			Ложь
		);

		Если НеопределяемаяОбертка Тогда
			ТестовыйПробросПодробногоПредставления.ПроверитьКодСНеопределяемойОберткой(
				ИсходнаяОшибка,
				КодОшибки
			);
		Иначе
			ТестовыйПробросПодробногоПредставления.ПроверитьКодВариантами(
				ИсходнаяОшибка,
				КодОшибки
			);
		КонецЕсли;

		Для Каждого ОжидаемоеПравило Из ОжидаемыеПравила Цикл
			Классификатор = КлассификаторОжидаемогоПравила(ОжидаемоеПравило);
			ПроверитьСовпадениеПравила(Классификатор, ИсходнаяОшибка, ОжидаемоеПравило, КодОшибки);

			Если Не НеопределяемаяОбертка Тогда
				ОбернутаяОшибка = ТестовыйПробросПодробногоПредставления.ПолучитьОбернутуюОшибку(ИсходнаяОшибка);
				ПроверитьСовпадениеПравила(Классификатор, ОбернутаяОшибка, ОжидаемоеПравило, КодОшибки);
			КонецЕсли;
		КонецЦикла;
	Исключение
		ВызватьИсключение СтрШаблон(
			"Не пройдена проверка источника %1 (%3): %2",
			Метод.Имя,
			ОписаниеОшибки(),
			ПолучитьДиагностикуРезультатаИсточника(ИсходнаяОшибка)
		);
	КонецПопытки;

КонецПроцедуры

Функция ПолучитьДиагностикуРезультатаИсточника(Результат)

	Если Результат = Неопределено Тогда
		Возврат "Источник вернул Неопределено";
	КонецЕсли;

	Если ТипЗнч(Результат) = Тип("ИнформацияОбОшибке") Тогда
		Возврат СтрШаблон(
			"Описание: %1. Подробное представление: %2",
			Результат.Описание,
			ПодробноеПредставлениеОшибки(Результат)
		);
	КонецЕсли;

	Возврат "Источник вернул значение типа " + Строка(ТипЗнч(Результат));

КонецФункции

Функция КлассификаторОжидаемогоПравила(Идентификатор)

	Для Каждого Правило Из Новый ПравилаНативныхОшибок().Все() Цикл
		Если Правило.Идентификатор() = Идентификатор Тогда
			Правила = Новый Массив;
			Правила.Добавить(Правило);

			Классификатор = Новый КлассификаторОшибок;
			Классификатор.ДобавитьПравила(Правила);

			Возврат Классификатор;
		КонецЕсли;
	КонецЦикла;

	ВызватьИсключение "Неизвестное встроенное правило: " + Идентификатор;

КонецФункции

Процедура ПроверитьСовпадениеПравила(Классификатор, Ошибка, ОжидаемоеПравило, ОжидаемыйКод)

	Результат = Классификатор.Классифицировать(Ошибка);

	Ожидаем.Что(Результат <> Неопределено, "Не совпало правило " + ОжидаемоеПравило).ЭтоИстина();

	Снимок = Новый СнимокКадраОшибки(Результат);
	Ожидаем.Что(Снимок.Данные().Правило, "Правило результата: " + ОжидаемоеПравило)
		.Равно(ОжидаемоеПравило);
	Ожидаем.Что(Снимок.КодОшибки(), "Код результата: " + ОжидаемыйКод)
		.Равно(ОжидаемыйКод);

КонецПроцедуры

#КонецОбласти
