#Использовать errors
#Использовать "../src"
#Использовать "./internal"

#Область ОбработчикиСобытий

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

#КонецОбласти

#Область Тесты

&ПараметризованныйТест
&ИсточникВыражение("() -> ПараметрыИсточниковОшибок()")
Процедура ТестДолжен_КлассифицироватьИсточникОшибки(ИдентификаторПравила, ИмяИсточника) Экспорт

	МатрицаИсточниковОшибок.ПроверитьИсточник(ЭтотОбъект, ИмяИсточника);

КонецПроцедуры

Функция ПараметрыИсточниковОшибок() Экспорт

	Возврат МатрицаИсточниковОшибок.ПараметрыИсточников(ЭтотОбъект, 7);

КонецФункции

&Тест
Процедура ТестДолжен_НеКлассифицироватьНеверныйДескрипторКакНедоступностьКонсоли() Экспорт

	// Подготовка
	Ошибка = Новый ИнформацияОбОшибке(
		"External exception (System.IO.IOException): The handle is invalid.",
		Новый Структура("Источник", "Тест")
	);

	// Действие и Проверка
	ТестовыйПробросПодробногоПредставления.ПроверитьНеклассифицированностьВариантами(Ошибка);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&ОжидаемыйКодОшибки("КонсольНедоступна")
&ОжидаемоеПравилоОшибки("console.unavailable.read_key")
Функция ПолучитьОшибкуНедоступногоЧтенияКлавишиКонсоли() Экспорт

	Попытка
		КодКлавиши = Консоль.Прочитать();
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	ВызватьИсключение "Ожидаемая ошибка чтения клавиши недоступной консоли не возникла";

КонецФункции

&ОжидаемыйКодОшибки("КонсольНедоступна")
&ОжидаемоеПравилоОшибки("console.unavailable.key_available")
Функция ПолучитьОшибкуПроверкиКлавишиНедоступнойКонсоли() Экспорт

	Попытка
		КлавишаНажата = Консоль.НажатаКлавиша;
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	ВызватьИсключение "Ожидаемая ошибка проверки клавиши недоступной консоли не возникла";

КонецФункции

&ОжидаемыйКодОшибки("СвойствоОбъектаНедоступноДляЗаписи")
&ОжидаемоеПравилоОшибки("object.property_not_writable.console_global")
Функция ПолучитьОшибкуЗаписиВГлобальноеСвойствоКонсоль() Экспорт

	Попытка
		Консоль = Неопределено;
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	ВызватьИсключение "Ожидаемая ошибка записи в глобальное свойство Консоль не возникла";

КонецФункции

&ОжидаемыйКодОшибки("ПотокНеПоддерживаетЗапись")
&ОжидаемоеПравилоОшибки("stream.not_writable.dotnet_stream")
Функция ПолучитьОшибкуУстановкиЗакрытогоПотокаВыводаКонсоли() Экспорт

	// Подготовка
	ИсходныйПотокВывода = Консоль.ОткрытьСтандартныйПотокВывода();
	ПотокВывода = Новый ПотокВПамяти;
	ПотокВывода.Закрыть();

	// Действие и Проверка
	Попытка
		Консоль.УстановитьПотокВывода(ПотокВывода);
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	Консоль.УстановитьПотокВывода(ИсходныйПотокВывода);
	ВызватьИсключение "Ожидаемая ошибка установки закрытого потока вывода консоли не возникла";

КонецФункции

&ОжидаемыйКодОшибки("ПотокНеПоддерживаетЗапись")
&ОжидаемоеПравилоОшибки("stream.not_writable.dotnet_stream")
Функция ПолучитьОшибкуУстановкиЗакрытогоПотокаОшибокКонсоли() Экспорт

	// Подготовка
	ИсходныйПотокОшибок = Консоль.ОткрытьСтандартныйПотокОшибок();
	ПотокОшибок = Новый ПотокВПамяти;
	ПотокОшибок.Закрыть();

	// Действие и Проверка
	Попытка
		Консоль.УстановитьПотокОшибок(ПотокОшибок);
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	Консоль.УстановитьПотокОшибок(ИсходныйПотокОшибок);
	ВызватьИсключение "Ожидаемая ошибка установки закрытого потока ошибок консоли не возникла";

КонецФункции

&ОжидаемыйКодОшибки("ПотокЗакрыт")
&ОжидаемоеПравилоОшибки("stream.closed.dotnet_stream")
Функция ПолучитьОшибкуВыводаСтрокиВЗакрытыйПотокКонсоли() Экспорт

	// Подготовка
	ИсходныйПотокВывода = Консоль.ОткрытьСтандартныйПотокВывода();
	ПотокВывода = Новый ПотокВПамяти;
	Консоль.УстановитьПотокВывода(ПотокВывода);
	ПотокВывода.Закрыть();
	Ошибка = Неопределено;

	// Действие
	Попытка
		Консоль.ВывестиСтроку("Тест");
	Исключение
		Ошибка = ИнформацияОбОшибке();
	КонецПопытки;
	Консоль.УстановитьПотокВывода(ИсходныйПотокВывода);

	// Проверка
	Если Ошибка <> Неопределено Тогда
		Возврат Ошибка;
	КонецЕсли;

	ВызватьИсключение "Ожидаемая ошибка вывода строки в закрытый поток консоли не возникла";

КонецФункции

&ОжидаемыйКодОшибки("ПотокЗакрыт")
&ОжидаемоеПравилоОшибки("stream.closed.dotnet_stream")
Функция ПолучитьОшибкуВыводаВЗакрытыйПотокКонсоли() Экспорт

	// Подготовка
	ИсходныйПотокВывода = Консоль.ОткрытьСтандартныйПотокВывода();
	ПотокВывода = Новый ПотокВПамяти;
	Консоль.УстановитьПотокВывода(ПотокВывода);
	ПотокВывода.Закрыть();
	Ошибка = Неопределено;

	// Действие
	Попытка
		Консоль.Вывести("Тест");
	Исключение
		Ошибка = ИнформацияОбОшибке();
	КонецПопытки;
	Консоль.УстановитьПотокВывода(ИсходныйПотокВывода);

	// Проверка
	Если Ошибка <> Неопределено Тогда
		Возврат Ошибка;
	КонецЕсли;

	ВызватьИсключение "Ожидаемая ошибка вывода в закрытый поток консоли не возникла";

КонецФункции

