	// Подготовка
	Описание = "External exception (System.InvalidCastException): "
		+ "Unable to cast object of type 'System.Numerics.BigInteger' to type 'System.IConvertible'. Details";
	Ошибка = Новый ИнформацияОбОшибке(Описание, Новый Структура("Источник", "Тест"));

	// Действие и Проверка
	ТестовыйПробросПодробногоПредставления.ПроверитьНеклассифицированностьВариантами(Ошибка);

КонецПроцедуры

&Тест
Процедура ТестДолжен_НеСчитатьПревышениеГлубиныКорректногоJSONОшибкойСинтаксиса() Экспорт

	// Подготовка
	ТекстJSON = "0";
	Для Уровень = 1 По 65 Цикл
		ТекстJSON = "{""value"":" + ТекстJSON + "}";
	КонецЦикла;
	Извлечение = Новый ИзвлечениеДанныхJSON;
	Ошибка = Неопределено;

	// Действие
	Попытка
		Извлечение.УстановитьСтроку(ТекстJSON);
	Исключение
		Ошибка = ИнформацияОбОшибке();
	КонецПопытки;

	// Проверка
	Ожидаем.Что(Ошибка).ИмеетТип("ИнформацияОбОшибке");
	Ожидаем.Что(Ошибка.Описание).Содержит("Newtonsoft.Json.JsonReaderException");
	Ожидаем.Что(Ошибка.Описание).Содержит("MaxDepth");
	ТестовыйПробросПодробногоПредставления.ПроверитьНеклассифицированностьВариантами(Ошибка);

КонецПроцедуры

&Тест
Процедура ТестДолжен_НеСопоставлятьПризнакиОшибкиСинтаксисаJSONИзРазныхКадров() Экспорт

	// Подготовка
	Причина = Новый ИнформацияОбОшибке(
		"Error reading JObject from JsonReader. Path '', line 1, position 1.",
		Новый Структура("Источник", "Тест")
	);
	Ошибка = Новый ИнформацияОбОшибке(
		"External exception (Newtonsoft.Json.JsonReaderException): Other reader error.",
		Новый Структура("Источник", "Тест"),
		Причина
	);

	// Действие и Проверка
	ТестовыйПробросПодробногоПредставления.ПроверитьНеклассифицированностьВариантами(Ошибка);

КонецПроцедуры

#КонецОбласти

