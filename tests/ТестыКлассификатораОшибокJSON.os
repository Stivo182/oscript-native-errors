#Использовать errors
#Использовать "../src"
#Использовать "./internal"

#Область ОбработчикиСобытий

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

#КонецОбласти

#Область Тесты

&ПараметризованныйТест
&ИсточникВыражение("() -> ПараметрыИсточниковОшибок()")
Процедура ТестДолжен_КлассифицироватьИсточникОшибки(ИдентификаторПравила, ИмяИсточника) Экспорт

	МатрицаИсточниковОшибок.ПроверитьИсточник(ЭтотОбъект, ИмяИсточника);

КонецПроцедуры

Функция ПараметрыИсточниковОшибок() Экспорт

	Возврат МатрицаИсточниковОшибок.ПараметрыИсточников(ЭтотОбъект, 23);

КонецФункции

&Тест
Процедура ТестДолжен_НеКлассифицироватьСообщенияNewtonsoftБезСоответствующегоТипа() Экспорт

	// Подготовка
	Описания = Новый Массив;
	Описания.Добавить("Error reading JObject from JsonReader. Path '', line 1, position 1.");
	Описания.Добавить("No token to close. Path ''.");
	Описания.Добавить("External exception (Other.JsonReaderException): "
		+ "Error reading JObject from JsonReader. Path '', line 1, position 1.");
	Описания.Добавить("External exception (Other.JsonWriterException): No token to close. Path ''.");
	Описания.Добавить("External exception (Newtonsoft.Json.JsonException): No token to close. Path ''.");

	// Действие и Проверка
	Для Каждого Описание Из Описания Цикл
		Ошибка = Новый ИнформацияОбОшибке(Описание, Новый Структура("Источник", "Тест"));
		ТестовыйПробросПодробногоПредставления.ПроверитьНеклассифицированностьВариантами(Ошибка);
	КонецЦикла;

КонецПроцедуры

&Тест
Процедура ТестДолжен_НеКлассифицироватьНеточнуюСигнатуруНезавершенногоИндексатораJSONPath() Экспорт

	// Подготовка
	Описание = "External exception (Newtonsoft.Json.JsonException): "
		+ "Path ended with open indexer. Details";
	Ошибка = Новый ИнформацияОбОшибке(Описание, Новый Структура("Источник", "Тест"));

	// Действие и Проверка
	ТестовыйПробросПодробногоПредставления.ПроверитьНеклассифицированностьВариантами(Ошибка);

КонецПроцедуры

