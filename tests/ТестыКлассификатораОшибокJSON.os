Функция ПолучитьОшибкуЗаписиЛокальнойДатыВФорматеJavaScript() Экспорт

	Попытка
		Выполнить("ЗаписатьДатуJSON(ТекущаяДата(), ФорматДатыJSON.JavaScript)");
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	ВызватьИсключение "Ожидаемая ошибка записи локальной даты в формате JavaScript не возникла";

КонецФункции

&ВключенДляOneScript(">=2.2.0")
&ОжидаемыйКодОшибки("JSONЛокальнаяДатаНеПоддерживается")
&ОжидаемоеПравилоОшибки("json.local_date.microsoft")
Функция ПолучитьОшибкуЗаписиЛокальнойДатыВФорматеMicrosoft() Экспорт

	Попытка
		Выполнить("ЗаписатьДатуJSON(ТекущаяДата(), ФорматДатыJSON.Microsoft)");
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	ВызватьИсключение "Ожидаемая ошибка записи локальной даты в формате Microsoft не возникла";

КонецФункции

&ВключенДляOneScript(">=2.2.0")
&ОжидаемыйКодОшибки("ПотокНеПоддерживаетЗапись")
&ОжидаемоеПравилоОшибки("stream.not_writable")
Функция ПолучитьОшибкуПотокаБезПоддержкиЗаписи() Экспорт

	Попытка
		Поток = Новый ПотокВПамяти;
		ПотокТолькоДляЧтения = Поток.ПолучитьПотокТолькоДляЧтения();
		Запись = Новый ЗаписьJSON;
		Запись.ОткрытьПоток(ПотокТолькоДляЧтения);
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	ВызватьИсключение "Ожидаемая ошибка потока без поддержки записи не возникла";

КонецФункции

#КонецОбласти
