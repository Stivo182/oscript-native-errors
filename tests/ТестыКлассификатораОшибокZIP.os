#Использовать errors
#Использовать "../src"
#Использовать "./internal"

#Область ОбработчикиСобытий

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

#КонецОбласти

#Область Тесты

&ПараметризованныйТест
&ИсточникВыражение("() -> ПараметрыИсточниковОшибок()")
Процедура ТестДолжен_КлассифицироватьИсточникОшибки(ИдентификаторПравила, ИмяИсточника) Экспорт

	МатрицаИсточниковОшибок.ПроверитьИсточник(ЭтотОбъект, ИмяИсточника);

КонецПроцедуры

Функция ПараметрыИсточниковОшибок() Экспорт

	Возврат МатрицаИсточниковОшибок.ПараметрыИсточников(ЭтотОбъект, 3);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&ОжидаемыйКодОшибки("АрхивНеОткрыт")
&ОжидаемоеПравилоОшибки("zip.not_open")
Функция ПолучитьОшибкуЧтенияZIPДоОткрытия() Экспорт

	Попытка
		Чтение = Новый ЧтениеZipФайла;
		Элементы = Чтение.Элементы;
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	ВызватьИсключение "Ожидаемая ошибка чтения ZIP до открытия не возникла";

КонецФункции

&ОжидаемыйКодОшибки("АрхивНеОткрыт")
&ОжидаемоеПравилоОшибки("zip.not_open")
Функция ПолучитьОшибкуЗаписиZIPДоОткрытия() Экспорт

	Попытка
		Запись = Новый ЗаписьZipФайла;
		Запись.Записать();
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	ВызватьИсключение "Ожидаемая ошибка записи ZIP до открытия не возникла";

КонецФункции

&ОжидаемыйКодОшибки("АрхивНеверныйПароль")
&ОжидаемоеПравилоОшибки("zip.invalid_password")
Функция ПолучитьОшибкуНеверногоПароляZIPПриИзвлеченииВсех() Экспорт

	// Подготовка
	// Фиксированный заголовок Zip20 исключает случайное совпадение проверочного байта.
	ПутьАрхива = ОбъединитьПути(ТекущийСценарий().Каталог, "fixtures/неверный-пароль.zip");
	КаталогИзвлечения = ОбъединитьПути(
		КаталогВременныхФайлов(),
		"native-errors-zip-password-" + СтрЗаменить(Строка(Новый УникальныйИдентификатор), "-", "")
	);
	СоздатьКаталог(КаталогИзвлечения);
	Ошибка = Неопределено;

	// Действие
	Попытка
		Чтение = Новый ЧтениеZipФайла(ПутьАрхива, "НеверныйПароль");
		Чтение.ИзвлечьВсе(КаталогИзвлечения);
	Исключение
		Ошибка = ИнформацияОбОшибке();
	КонецПопытки;

	Чтение.Закрыть();
	УдалитьФайлы(КаталогИзвлечения);

	// Проверка
	Если Ошибка <> Неопределено Тогда
		Возврат Ошибка;
	КонецЕсли;

	ВызватьИсключение "Ожидаемая ошибка неверного пароля ZIP не возникла";

КонецФункции

#КонецОбласти
