Функция ПолучитьОшибкуПереполненияСверткиТаблицыЗначений() Экспорт

	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Ключ");
	Таблица.Колонки.Добавить("Сумма");

	ПерваяСтрока = Таблица.Добавить();
	ПерваяСтрока.Ключ = "Группа";
	ПерваяСтрока.Сумма = 79228162514264337593543950335;

	ВтораяСтрока = Таблица.Добавить();
	ВтораяСтрока.Ключ = "Группа";
	ВтораяСтрока.Сумма = 1;

	Попытка
		Таблица.Свернуть("Ключ", "Сумма");
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	ВызватьИсключение "Ожидаемая ошибка переполнения свертки таблицы значений не возникла";

КонецФункции

