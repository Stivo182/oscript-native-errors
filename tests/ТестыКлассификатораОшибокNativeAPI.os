#Использовать asserts
#Использовать errors
#Использовать "../src"
#Использовать "./internal"

Перем _ИдентификаторКомпоненты; // Строка
Перем _КомпонентаПодключена; // Булево

#Область ОбработчикиСобытий

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт

	_ИдентификаторКомпоненты = "NativeErrors" + СтрЗаменить(Строка(Новый УникальныйИдентификатор), "-", "");
	_КомпонентаПодключена = Ложь;

КонецПроцедуры

#КонецОбласти

#Область Тесты

&ПараметризованныйТест
&ИсточникВыражение("() -> ПараметрыИсточниковОшибок()")
Процедура ТестДолжен_КлассифицироватьИсточникОшибки(ИдентификаторПравила, ИмяИсточника) Экспорт

	МатрицаИсточниковОшибок.ПроверитьИсточник(ЭтотОбъект, ИмяИсточника);

КонецПроцедуры

Функция ПараметрыИсточниковОшибок() Экспорт

	Возврат МатрицаИсточниковОшибок.ПараметрыИсточников(ЭтотОбъект, 4);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&ВключенНаОС("Windows", Причина = "Тестовая компонента собрана только для Windows")
&ВключенДляOneScript(">=2.2.0")
&ОжидаемыйКодОшибки("ВнешняяКомпонентаОбъектНеСоздан")
&ОжидаемоеПравилоОшибки("component.creation_failed")
Функция ПолучитьОшибкуСозданияОбъектаВнешнейКомпоненты() Экспорт

	ПодключитьТестовуюКомпоненту();
	ИмяТипа = "AddIn." + _ИдентификаторКомпоненты + ".ЗаведомоНетТакого";

	Попытка
		Компонента = Новый(ИмяТипа);
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	ВызватьИсключение "Ожидаемая ошибка создания объекта внешней компоненты не возникла";

КонецФункции

&ВключенНаОС("Windows", Причина = "Тестовая компонента собрана только для Windows")
&ВключенДляOneScript(">=2.2.0")
&ОжидаемыйКодОшибки("СвойствоОбъектаНедоступноДляЧтения")
&ОжидаемоеПравилоОшибки("object.property_not_readable")
Функция ПолучитьОшибкуНедоступногоДляЧтенияСвойства() Экспорт

	ПодключитьТестовуюКомпоненту();
	ИмяТипа = "AddIn." + _ИдентификаторКомпоненты + ".CAddInNative";
	Компонента = Новый(ИмяТипа);

	Попытка
		Значение = Компонента.СтрокаТолькоЗапись;
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	ВызватьИсключение "Ожидаемая ошибка чтения write-only свойства внешней компоненты не возникла";

КонецФункции

&ВключенНаОС("Windows", Причина = "Тестовая компонента собрана только для Windows")
&ОжидаемыйКодОшибки("ФайловаяСистемаРесурсНеНайден")
&ОжидаемоеПравилоОшибки("filesystem.not_found.directory_type")
Функция ПолучитьОшибкуОтсутствующегоВременногоКаталогаПакетаВнешнейКомпоненты() Экспорт

	// Подготовка
	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	ПутьПакета = ОбъединитьПути(КаталогВременныхФайлов(), Строка(Новый УникальныйИдентификатор) + ".zip");
	ЗаписьZIP = Новый ЗаписьZipФайла(ПутьПакета);
	ЗаписьZIP.Добавить(
		ОбъединитьПути(КаталогТестов, "fixtures", "AddInNativeWin64.dll"),
		РежимСохраненияПутейZIP.НеСохранятьПути
	);
	ЗаписьZIP.Добавить(
		ОбъединитьПути(КаталогТестов, "fixtures", "manifest.xml"),
		РежимСохраненияПутейZIP.НеСохранятьПути
	);
	ЗаписьZIP.Записать();
	ИсходныйTEMP = ПолучитьПеременнуюСреды("TEMP");
	ИсходныйTMP = ПолучитьПеременнуюСреды("TMP");
	НесуществующийКаталог = ОбъединитьПути(КаталогВременныхФайлов(), Строка(Новый УникальныйИдентификатор));

	// Действие
	УстановитьПеременнуюСреды("TEMP", НесуществующийКаталог);
	УстановитьПеременнуюСреды("TMP", НесуществующийКаталог);
	Попытка
		ПодключитьВнешнююКомпоненту(
			ПутьПакета,
			"MissingTemp" + СтрЗаменить(Строка(Новый УникальныйИдентификатор), "-", ""),
			ТипВнешнейКомпоненты.Native
		);
	Исключение
		Ошибка = ИнформацияОбОшибке();
	КонецПопытки;
	УстановитьПеременнуюСреды("TEMP", ИсходныйTEMP);
	УстановитьПеременнуюСреды("TMP", ИсходныйTMP);

	// Проверка
	Если Ошибка <> Неопределено Тогда
		Возврат Ошибка;
	КонецЕсли;

	ВызватьИсключение "Ожидаемая ошибка отсутствующего временного каталога не возникла";

КонецФункции

&ВключенНаОС("Windows", Причина = "Тестовая компонента собрана только для Windows")
&ОжидаемыйКодОшибки("АрхивНекорректныйФормат")
&ОжидаемоеПравилоОшибки("zip.invalid_format")
Функция ПолучитьОшибкуОбрезанногоZIPПакетаВнешнейКомпоненты() Экспорт

	// Подготовка
	ПутьПакета = ПолучитьИмяВременногоФайла();
	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	ЗаписьZIP = Новый ЗаписьZipФайла(ПутьПакета);
	ЗаписьZIP.Добавить(
		ОбъединитьПути(КаталогТестов, "fixtures", "manifest.xml"),
		РежимСохраненияПутейZIP.НеСохранятьПути
	);
	ЗаписьZIP.Записать();
	РазмерПакета = Новый Файл(ПутьПакета).Размер();
	Поток = ФайловыеПотоки.Создать(ПутьПакета);
	Поток.УстановитьРазмер(РазмерПакета / 2);
	Поток.Закрыть();

	// Действие
	Ошибка = Неопределено;
	Попытка
		ПодключитьВнешнююКомпоненту(
			ПутьПакета,
			"TruncatedZIP" + СтрЗаменить(Строка(Новый УникальныйИдентификатор), "-", ""),
			ТипВнешнейКомпоненты.Native
		);
	Исключение
		Ошибка = ИнформацияОбОшибке();
	КонецПопытки;
	УдалитьФайлы(ПутьПакета);

	// Проверка
	Если Ошибка <> Неопределено Тогда
		Возврат Ошибка;
	КонецЕсли;

	ВызватьИсключение "Ожидаемая ошибка обрезанного ZIP-пакета внешней компоненты не возникла";

КонецФункции

Процедура ПодключитьТестовуюКомпоненту()

	Если _КомпонентаПодключена Тогда
		Возврат;
	КонецЕсли;

	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	ПутьКомпоненты = ОбъединитьПути(КаталогТестов, "fixtures", "AddInNativeWin64.dll");
	_КомпонентаПодключена = ПодключитьВнешнююКомпоненту(
		ПутьКомпоненты,
		_ИдентификаторКомпоненты,
		ТипВнешнейКомпоненты.Native
	);

	Если Не _КомпонентаПодключена Тогда
		ВызватьИсключение "Не удалось подключить тестовую Native API-компоненту";
	КонецЕсли;

КонецПроцедуры

#КонецОбласти
