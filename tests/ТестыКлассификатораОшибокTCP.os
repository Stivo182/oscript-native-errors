#Область Тесты

&ПараметризованныйТест
&ИсточникВыражение("() -> ПараметрыИсточниковОшибок()")
Процедура ТестДолжен_КлассифицироватьИсточникОшибки(ИдентификаторПравила, ИмяИсточника) Экспорт

	МатрицаИсточниковОшибок.ПроверитьИсточник(ЭтотОбъект, ИмяИсточника);

КонецПроцедуры

Функция ПараметрыИсточниковОшибок() Экспорт

	Возврат МатрицаИсточниковОшибок.ПараметрыИсточников(ЭтотОбъект, 13);

КонецФункции

&Тест
Процедура ТестДолжен_КлассифицироватьОбеЛокалиСообщенияОЗанятомTCPАдресе() Экспорт

	// Подготовка
	Для Каждого Сообщение Из СообщенияОЗанятомTCPАдресе() Цикл
		Ошибка = ПолучитьТекстовуюОшибку("External exception (System.Net.Sockets.SocketException): " + Сообщение);

		// Действие и Проверка
		ТестовыйПробросПодробногоПредставления.ПроверитьКодВариантами(
			Ошибка,
			КодыНативныхОшибок.СетьАдресЗанят()
		);
	КонецЦикла;

КонецПроцедуры

&Тест
Процедура ТестДолжен_НеКлассифицироватьНеточныеСигнатурыЗанятогоTCPАдреса() Экспорт

	// Подготовка
	Описания = Новый Массив;
	Для Каждого Сообщение Из СообщенияОЗанятомTCPАдресе() Цикл
		Описания.Добавить(Сообщение);
		Описания.Добавить("External exception (System.IO.IOException): " + Сообщение);
		Описания.Добавить("External exception (System.Net.Sockets.SocketException): " + Сообщение + " Details");
	КонецЦикла;
	Описания.Добавить("External exception (System.Net.Sockets.SocketException): Socket address is unavailable.");

	// Действие и Проверка
	Для Каждого Описание Из Описания Цикл
		Ошибка = ПолучитьТекстовуюОшибку(Описание);
		ТестовыйПробросПодробногоПредставления.ПроверитьНеклассифицированностьВариантами(Ошибка);
	КонецЦикла;

КонецПроцедуры

&Тест
Процедура ТестДолжен_НеСопоставлятьПризнакиЗанятогоTCPАдресаИзРазныхКадров() Экспорт

	// Подготовка
	Для Каждого Сообщение Из СообщенияОЗанятомTCPАдресе() Цикл
		Причина = ПолучитьТекстовуюОшибку(Сообщение);
		Ошибка = ПолучитьТекстовуюОшибку(
			"External exception (System.Net.Sockets.SocketException): Other socket error.",
			Причина
		);

		// Действие и Проверка
		ТестовыйПробросПодробногоПредставления.ПроверитьНеклассифицированностьВариантами(Ошибка);
	КонецЦикла;

КонецПроцедуры

&Тест
Процедура ТестДолжен_НеКлассифицироватьНеточныеСигнатурыЗакрытогоTCPКлиента() Экспорт

	// Подготовка
	Описания = Новый Массив;
	Описания.Добавить("Cannot access a disposed object. Object name: 'System.Net.Sockets.TcpClient'.");
	Описания.Добавить("External exception (System.InvalidOperationException): "
		+ "Cannot access a disposed object. Object name: 'System.Net.Sockets.TcpClient'.");
	Описания.Добавить("External exception (System.ObjectDisposedException): "
		+ "Cannot access a disposed object. Object name: 'System.Net.Http.HttpClient'.");
	Описания.Добавить("External exception (System.ObjectDisposedException): "
		+ "Cannot access a disposed object. Object name: 'System.Net.Sockets.TcpClientExtra'.");
	Описания.Добавить("External exception (System.ObjectDisposedException): "
		+ "Cannot access a disposed object. Object name: 'System.Net.Sockets.TcpClient'. Details");

	// Действие и Проверка
	Для Каждого Описание Из Описания Цикл
		Ошибка = ПолучитьТекстовуюОшибку(Описание);
		ТестовыйПробросПодробногоПредставления.ПроверитьНеклассифицированностьВариантами(Ошибка);
	КонецЦикла;

КонецПроцедуры

&Тест
Процедура ТестДолжен_НеСопоставлятьПризнакиЗакрытогоTCPКлиентаИзРазныхКадров() Экспорт

	// Подготовка
	Причина = ПолучитьТекстовуюОшибку("Cannot access a disposed object. Object name: 'System.Net.Sockets.TcpClient'.");
	Ошибка = ПолучитьТекстовуюОшибку(
		"External exception (System.ObjectDisposedException): Other disposed object.",
		Причина
	);

	// Действие и Проверка
	ТестовыйПробросПодробногоПредставления.ПроверитьНеклассифицированностьВариантами(Ошибка);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПолучитьТекстовуюОшибку(Описание, Причина = Неопределено)

	Попытка
		ВызватьИсключение Новый ИнформацияОбОшибке(Описание, Новый Структура("Источник", "Тест"), Причина);
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

КонецФункции

Функция СообщенияОЗанятомTCPАдресе()

	Сообщения = Новый Массив;
	Сообщения.Добавить("Обычно разрешается только одно использование адреса сокета (протокол/сетевой адрес/порт).");
	Сообщения.Добавить("Only one usage of each socket address (protocol/network address/port) is normally permitted.");
	Сообщения.Добавить("Address already in use");

	Возврат Сообщения;

КонецФункции

&ВключенНаОС("Windows", Причина = "Сообщение SocketException для Windows")
&ОжидаемыйКодОшибки("СетьАдресЗанят")
&ОжидаемоеПравилоОшибки("network.address_in_use.socket")
Функция ПолучитьОшибкуЗанятогоПортаTCPСервераWindows() Экспорт

	Возврат ПолучитьОшибкуЗанятогоПортаTCPСервера();

КонецФункции

&ВключенНаОС("Linux", Причина = "Сообщение SocketException для Linux")
&ОжидаемыйКодОшибки("СетьАдресЗанят")
&ОжидаемоеПравилоОшибки("network.address_in_use.socket_unix")
Функция ПолучитьОшибкуЗанятогоПортаTCPСервераLinux() Экспорт

	Возврат ПолучитьОшибкуЗанятогоПортаTCPСервера();

КонецФункции

&ВключенНаОС("MacOS", Причина = "Сообщение SocketException для macOS")
&ОжидаемыйКодОшибки("СетьАдресЗанят")
&ОжидаемоеПравилоОшибки("network.address_in_use.socket_unix")
Функция ПолучитьОшибкуЗанятогоПортаTCPСервераMacOS() Экспорт

	Возврат ПолучитьОшибкуЗанятогоПортаTCPСервера();

КонецФункции

Функция ПолучитьОшибкуЗанятогоПортаTCPСервера() Экспорт

	Порт = ТестовыеСетевыеФикстуры.ПолучитьСвободныйПорт();
	Сервер = Новый TCPСервер(Порт);
	Сервер.Запустить();
	ВторойСервер = Новый TCPСервер(Порт);
	Ошибка = Неопределено;

	Попытка
		ВторойСервер.Запустить();
	Исключение
		Ошибка = ИнформацияОбОшибке();
	КонецПопытки;

	ВторойСервер.Остановить();
	Сервер.Остановить();
	Если Ошибка = Неопределено Тогда
		ВызватьИсключение "Ожидаемая ошибка занятого порта TCP-сервера не возникла";
	КонецЕсли;

	Возврат Ошибка;

КонецФункции

&ОжидаемыйКодОшибки("ПереполнениеЧисловогоЗначения")
&ОжидаемоеПравилоОшибки("number.overflow")
Функция ПолучитьОшибкуПереполненияПортаTCPСервера() Экспорт

	// Действие и Проверка
	Попытка
		Сервер = Новый TCPСервер(2147483648);
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	ВызватьИсключение "Ожидаемая ошибка переполнения порта TCP-сервера не возникла";

КонецФункции

&ОжидаемыйКодОшибки("СетьНекорректныйПорт")
