Функция СоздатьЗакрытоеTCPСоединение()

	Порт = ТестовыеСетевыеФикстуры.ПолучитьСвободныйПорт();
	Сервер = Новый TCPСервер(Порт);
	Сервер.Запустить();
	Попытка
		Соединение = Новый TCPСоединение("127.0.0.1", Порт);
		Соединение.Закрыть();
	Исключение
		Сервер.Остановить();
		ВызватьИсключение;
	КонецПопытки;
	Сервер.Остановить();

	Возврат Соединение;

КонецФункции

#КонецОбласти
