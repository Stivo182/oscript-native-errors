&ОжидаемоеПравилоОшибки("binary.buffer_range.value_type")
Функция ПолучитьОшибкуЧтенияНеполногоЦелого32ИзПотока() Экспорт

	// Подготовка
	Поток = Новый ПотокВПамяти;
	Поток.Записать(Новый БуферДвоичныхДанных(3), 0, 3);
	Поток.Перейти(0);
	Чтение = Новый ЧтениеДанных(Поток);

	// Действие и Проверка
	Попытка
		Число = Чтение.ПрочитатьЦелое32();
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	ВызватьИсключение "Ожидаемая ошибка чтения неполного целого 32 из потока не возникла";

КонецФункции

