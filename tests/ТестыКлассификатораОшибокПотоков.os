Функция ПолучитьОшибкуОткрытияОтсутствующегоФайлаЧтениемДанных() Экспорт

	Путь = ОбъединитьПути(
		ТекущийСценарий().Каталог,
		"fixtures/гарантированно-отсутствующий-файл-чтения-данных.bin"
	);
	Ожидаем.Что(Новый Файл(Путь).Существует()).Равно(Ложь);

	Попытка
		Чтение = Новый ЧтениеДанных(Путь);
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	ВызватьИсключение "Ожидаемая ошибка открытия отсутствующего файла чтением данных не возникла";

