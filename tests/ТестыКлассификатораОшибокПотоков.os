Функция ПолучитьОшибкуЗаписиБайтаВЗакрытыйПоток() Экспорт

	// Подготовка
	Поток = Новый ПотокВПамяти;
	Запись = Новый ЗаписьДанных(Поток);
	Поток.Закрыть();
	ИсходнаяОшибка = Неопределено;

	// Действие
	Попытка
		Запись.ЗаписатьБайт(1);
	Исключение
		ИсходнаяОшибка = ИнформацияОбОшибке();
	КонецПопытки;

	// Проверка
	Если ИсходнаяОшибка <> Неопределено Тогда
		Возврат ИсходнаяОшибка;
	КонецЕсли;

	ВызватьИсключение "Ожидаемая ошибка записи байта в закрытый поток не возникла";

КонецФункции

