		"Cannot create a file when that file already exists.",
		Новый Структура("Источник", "Тест")
	);
	Ошибка = Новый ИнформацияОбОшибке(
		"External exception (System.IO.IOException): Other filesystem error.",
		Новый Структура("Источник", "Тест"),
		Причина
	);

	// Действие и Проверка
	ТестовыйПробросПодробногоПредставления.ПроверитьНеклассифицированностьВариантами(Ошибка);

КонецПроцедуры

