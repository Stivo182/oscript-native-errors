Функция ПолучитьОшибкуКопированияОтсутствующегоФайла() Экспорт

	Источник = ОбъединитьПути(
		ТекущийСценарий().Каталог,
		"fixtures/гарантированно-отсутствующий-источник-native-errors.txt"
	);
	Приемник = ПолучитьИмяВременногоФайла();
	Ожидаем.Что(Новый Файл(Источник).Существует()).Равно(Ложь);
	Ошибка = Неопределено;

	Попытка
		КопироватьФайл(Источник, Приемник);
	Исключение
		Ошибка = ИнформацияОбОшибке();
	КонецПопытки;

	УдалитьФайлы(Приемник);
	Если Ошибка <> Неопределено Тогда
		Возврат Ошибка;
	КонецЕсли;

	ВызватьИсключение "Ожидаемая ошибка копирования отсутствующего файла не возникла";

КонецФункции

