		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	ВызватьИсключение "Ожидаемая ошибка подключения отсутствующей внешней компоненты не возникла";

КонецФункции

&ОжидаемыйКодОшибки("ФайловаяСистемаРесурсУжеСуществует")
&ОжидаемоеПравилоОшибки("filesystem.already_exists.file_path")
Функция ПолучитьОшибкуСозданияСуществующегоФайла() Экспорт

	ИмяФайла = ПолучитьИмяВременногоФайла();
	Запись = Новый ЗаписьТекста(ИмяФайла);
	Запись.Закрыть();

	Попытка
		Поток = Новый ФайловыйПоток(
			ИмяФайла,
			РежимОткрытияФайла.СоздатьНовый,
			ДоступКФайлу.Запись
		);
	Исключение
		Ошибка = ИнформацияОбОшибке();
	КонецПопытки;

	УдалитьФайлы(ИмяФайла);
	Если Ошибка <> Неопределено Тогда
		Возврат Ошибка;
	КонецЕсли;

	ВызватьИсключение "Ожидаемая ошибка создания существующего файла не возникла";

КонецФункции

&ВключенНаОС("Windows", Причина = "Эксклюзивная блокировка файлов Windows")
&ОжидаемыйКодОшибки("ФайловаяСистемаРесурсЗанят")
&ОжидаемоеПравилоОшибки("filesystem.resource_busy")
Функция ПолучитьОшибкуИспользуемогоФайла() Экспорт

	ИмяФайла = ПолучитьИмяВременногоФайла();
	Запись = Новый ЗаписьТекста(ИмяФайла);
	Запись.Закрыть();
	ПервыйПоток = Новый ФайловыйПоток(
		ИмяФайла,
		РежимОткрытияФайла.Открыть,
		ДоступКФайлу.Запись
	);

	Попытка
		ВторойПоток = Новый ФайловыйПоток(
			ИмяФайла,
			РежимОткрытияФайла.Открыть,
			ДоступКФайлу.Запись
		);
	Исключение
		Ошибка = ИнформацияОбОшибке();
	КонецПопытки;

	ПервыйПоток.Закрыть();
	УдалитьФайлы(ИмяФайла);
	Если Ошибка <> Неопределено Тогда
		Возврат Ошибка;
	КонецЕсли;

	ВызватьИсключение "Ожидаемая ошибка используемого файла не возникла";

КонецФункции

&ВключенНаОС("Windows", Причина = "Эксклюзивная блокировка файлов Windows")
&ОжидаемыйКодОшибки("ФайловаяСистемаРесурсЗанят")
&ОжидаемоеПравилоОшибки("filesystem.resource_busy")
Функция ПолучитьОшибкуУдаленияИспользуемогоФайла() Экспорт

	ИмяФайла = "native-errors-delete-files-"
		+ СтрЗаменить(Строка(Новый УникальныйИдентификатор), "-", "")
		+ ".txt";
	Путь = ОбъединитьПути(ТекущийСценарий().Каталог, ИмяФайла);
	Запись = Новый ЗаписьТекста(Путь);
	Ошибка = Неопределено;

	Попытка
		УдалитьФайлы(ТекущийСценарий().Каталог, ИмяФайла);
	Исключение
		Ошибка = ИнформацияОбОшибке();
	КонецПопытки;

	Запись.Закрыть();
	УдалитьФайлы(ТекущийСценарий().Каталог, ИмяФайла);
	Если Ошибка <> Неопределено Тогда
		Возврат Ошибка;
	КонецЕсли;

	ВызватьИсключение "Ожидаемая ошибка удаления используемого файла не возникла";

КонецФункции

