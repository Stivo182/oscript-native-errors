	Запись.Закрыть();
	КаталогПриемника = ОбъединитьПути(
		ТекущийСценарий().Каталог,
		"fixtures/гарантированно-отсутствующий-каталог-копирования-native-errors"
	);
	Приемник = ОбъединитьПути(КаталогПриемника, "file.txt");
	Ожидаем.Что(Новый Файл(КаталогПриемника).Существует()).Равно(Ложь);
	Ошибка = Неопределено;

	Попытка
		КопироватьФайл(Источник, Приемник);
	Исключение
		Ошибка = ИнформацияОбОшибке();
	КонецПопытки;

	УдалитьФайлы(Источник);
	Если Ошибка <> Неопределено Тогда
		Возврат Ошибка;
	КонецЕсли;

	ВызватьИсключение "Ожидаемая ошибка копирования в отсутствующий каталог не возникла";

