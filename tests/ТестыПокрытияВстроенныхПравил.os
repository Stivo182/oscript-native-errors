#Использовать asserts
#Использовать errors
#Использовать "../src"
#Использовать "./internal"

#Область Тесты

&Тест
Процедура ТестДолжен_ИметьРусскийИАнглийскийВариантыСообщенияКаждогоВстроенногоПравила() Экспорт

	// Действие и Проверка
	Для Каждого Правило Из Новый ПравилаНативныхОшибок().Все() Цикл
		НормализованноеОписаниеОшибки = СтрЗаменить(НРег(Правило.ОписаниеРезультата()), " ", "");
		Ожидаем.Что(СтрНайти(НормализованноеОписаниеОшибки, "ru=")).Больше(0);
		Ожидаем.Что(СтрНайти(НормализованноеОписаниеОшибки, "en=")).Больше(0);
	КонецЦикла;

КонецПроцедуры

&Тест
Процедура ТестДолжен_НеСопоставлятьОтрицательныеВариантыВсехТекстовыхПравил() Экспорт

	// Подготовка
	КоличествоТекстовыхПравил = 0;

	// Действие и Проверка
	Для Каждого Правило Из Новый ПравилаНативныхОшибок().Все() Цикл
		Если Не ЭтоТекстовоеПравило(Правило) Тогда
			Продолжить;
		КонецЕсли;

		КоличествоТекстовыхПравил = КоличествоТекстовыхПравил + 1;
		
		Правила = Новый Массив;
		Правила.Добавить(Правило);

		Классификатор = Новый КлассификаторОшибок;
		Классификатор.ДобавитьПравила(Правила);

		ПоложительныйРезультат = Классификатор.Классифицировать(
			ПолучитьОшибкуССообщением(ПолучитьПоложительныйВариант(Правило))
		);

		Ожидаем.Что(Новый СнимокКадраОшибки(ПоложительныйРезультат).КодОшибки())
			.Равно(Правило.КодОшибки());

		Результат = Классификатор.Классифицировать(
			ПолучитьОшибкуССообщением(ПолучитьОтрицательныйВариант(Правило))
		);
		Ожидаем.Что(Результат, "Отрицательный вариант правила " + Правило.Идентификатор())
			.Равно(Неопределено);
	КонецЦикла;

	Ожидаем.Что(КоличествоТекстовыхПравил).Больше(0);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ИметьНепустыеУникальныеИдентификаторыВстроенныхПравил() Экспорт

	// Подготовка
	Правила = Новый ПравилаНативныхОшибок().Все();
	Идентификаторы = Новый Соответствие;

	// Действие и Проверка
	Для Каждого Правило Из Правила Цикл
		Ожидаем.Что(ПустаяСтрока(Правило.Идентификатор())).Равно(Ложь);
		Ожидаем.Что(Идентификаторы.Получить(Правило.Идентификатор())).Равно(Неопределено);
		Идентификаторы.Вставить(Правило.Идентификатор(), Истина);
	КонецЦикла;

КонецПроцедуры

&Тест
Процедура ТестДолжен_ИметьАннотированныйИсточникДляКаждогоВстроенногоПравила() Экспорт

	// Подготовка
	Правила = Новый ПравилаНативныхОшибок().Все();

	ПравилаПоИдентификаторам = Новый Соответствие;
	Для Каждого Правило Из Правила Цикл
		ПравилаПоИдентификаторам.Вставить(Правило.Идентификатор(), Правило);
	КонецЦикла;

	ПокрытыеПравила = Новый Соответствие;
	ФайлыНаборов = НайтиФайлы(ТекущийСценарий().Каталог, "ТестыКлассификатора*.os");

	// Действие
	Для Каждого ФайлНабора Из ФайлыНаборов Цикл
		Контекст = ЗагрузитьСценарий(ФайлНабора.ПолноеИмя);
		Для Каждого Источник Из МатрицаИсточниковОшибок.ИсточникиПравил(Контекст) Цикл
			Правило = ПравилаПоИдентификаторам.Получить(Источник.Правило);
			Если Правило = Неопределено Тогда
				ВызватьИсключение СтрШаблон(
					"Источник %1.%2 ссылается на неизвестное правило %3",
					ФайлНабора.Имя,
					Источник.Метод,
					Источник.Правило
				);
			КонецЕсли;
			Ожидаем.Что(Источник.КодОшибки).Равно(Правило.КодОшибки());
			ПокрытыеПравила.Вставить(Источник.Правило, Истина);
		КонецЦикла;
	КонецЦикла;

	// Проверка
	НепокрытыеПравила = Новый Массив;
	Для Каждого Правило Из Правила Цикл
		Если ПокрытыеПравила.Получить(Правило.Идентификатор()) <> Истина Тогда
			НепокрытыеПравила.Добавить(Правило.Идентификатор() + " (" + Правило.КодОшибки() + ")");
		КонецЕсли;
	КонецЦикла;

	Если НепокрытыеПравила.Количество() > 0 Тогда
		ВызватьИсключение "Нет аннотированных воспроизводимых источников у правил: "
			+ СтрСоединить(НепокрытыеПравила, ", ");
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ЭтоТекстовоеПравило(Правило)

	Возврат Не ПустаяСтрока(Правило.ИсходноеСообщение())
		Или Не ПустаяСтрока(Правило.Префикс())
		Или Не ПустаяСтрока(Правило.Фрагмент())
		Или Не ПустаяСтрока(Правило.Окончание());

КонецФункции

Функция ПолучитьПоложительныйВариант(Правило)

	Если Не ПустаяСтрока(Правило.ИсходноеСообщение()) Тогда
		Сообщение = ТекстШаблона(Правило.ИсходноеСообщение());
		Если Не ПустаяСтрока(Правило.НативныйТип()) Тогда
			Возврат СообщениеСНативнымТипом(Правило, Сообщение);
		КонецЕсли;

		Возврат Сообщение;
	КонецЕсли;

	Возврат СобратьСообщениеПравила(Правило);

КонецФункции

Функция ПолучитьОтрицательныйВариант(Правило)

	Если Не ПустаяСтрока(Правило.ИсходноеСообщение()) Тогда
		Сообщение = ТекстШаблона(Правило.ИсходноеСообщение()) + "!";
		Если Не ПустаяСтрока(Правило.НативныйТип()) Тогда
			Возврат СообщениеСНативнымТипом(Правило, Сообщение);
		КонецЕсли;

		Возврат Сообщение;
	КонецЕсли;

	Префикс = ТекстШаблона(Правило.Префикс());
	Фрагмент = ТекстШаблона(Правило.Фрагмент());
	Окончание = ТекстШаблона(Правило.Окончание());

	Если Не ПустаяСтрока(Префикс) Тогда
		Префикс = ИспортитьНачало(Префикс);
	ИначеЕсли Не ПустаяСтрока(Фрагмент) Тогда
		Фрагмент = ИспортитьНачало(Фрагмент);
	Иначе
		Окончание = ИспортитьНачало(Окончание);
	КонецЕсли;

	Возврат СобратьСообщениеПравила(Правило, Префикс, Фрагмент, Окончание);

КонецФункции

Функция СобратьСообщениеПравила(
	Правило,
	Префикс = Неопределено,
	Фрагмент = Неопределено,
	Окончание = Неопределено)

	Если Префикс = Неопределено Тогда
		Префикс = Правило.Префикс();
	КонецЕсли;

	Если Фрагмент = Неопределено Тогда
		Фрагмент = Правило.Фрагмент();
	КонецЕсли;

	Если Окончание = Неопределено Тогда
		Окончание = Правило.Окончание();
	КонецЕсли;

	Сообщение = "изменяемая часть";
	Если Не ПустаяСтрока(Префикс) Тогда
		Сообщение = ТекстШаблона(Префикс) + " " + Сообщение;
	КонецЕсли;

	Если Не ПустаяСтрока(Фрагмент) Тогда
		Сообщение = Сообщение + " " + ТекстШаблона(Фрагмент);
	КонецЕсли;

	Если Не ПустаяСтрока(Окончание) Тогда
		Сообщение = Сообщение + " " + ТекстШаблона(Окончание);
	КонецЕсли;

	Если Не ПустаяСтрока(Правило.НативныйТип()) Тогда
		Возврат СообщениеСНативнымТипом(Правило, Сообщение);
	КонецЕсли;

	Возврат Сообщение;

КонецФункции

Функция ИспортитьНачало(Текст)

	Возврат Символ(1) + Сред(Текст, 2);

КонецФункции

Функция СообщениеСНативнымТипом(Правило, Сообщение)

	Возврат "External exception (" + Правило.НативныйТип() + "): " + Сообщение;

КонецФункции

Функция ТекстШаблона(Шаблон)

	НормализованныйШаблон = СтрЗаменить(НРег(Шаблон), " ", "");
	Если СтрНайти(НормализованныйШаблон, "ru=") > 0 Тогда
		Возврат НСтр(Шаблон, "ru");
	ИначеЕсли СтрНайти(НормализованныйШаблон, "en=") > 0 Тогда
		Возврат НСтр(Шаблон, "en");
	КонецЕсли;

	Возврат Шаблон;

КонецФункции

Функция ПолучитьОшибкуССообщением(Описание)

	Попытка
		ВызватьИсключение Новый ИнформацияОбОшибке(Описание, Новый Структура("Источник", "Тест"));
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

КонецФункции

#КонецОбласти
