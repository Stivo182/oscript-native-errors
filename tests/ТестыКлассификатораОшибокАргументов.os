#Использовать errors
#Использовать "../src"
#Использовать "./internal"

#Область ОбработчикиСобытий

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

#КонецОбласти

#Область Тесты

&ПараметризованныйТест
&ИсточникВыражение("() -> ПараметрыИсточниковОшибок()")
Процедура ТестДолжен_КлассифицироватьИсточникОшибки(ИдентификаторПравила, ИмяИсточника) Экспорт

	МатрицаИсточниковОшибок.ПроверитьИсточник(ЭтотОбъект, ИмяИсточника);

КонецПроцедуры

Функция ПараметрыИсточниковОшибок() Экспорт

	Возврат МатрицаИсточниковОшибок.ПараметрыИсточников(ЭтотОбъект, 6);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&ОжидаемыйКодОшибки("НедопустимоеЗначениеАргумента")
&ОжидаемоеПравилоОшибки("argument.invalid_value.named_en")
Функция ПолучитьАнглийскуюОшибкуНедопустимогоЗначенияАргумента() Экспорт

	Попытка
		ВызватьИсключение Новый ИнформацияОбОшибке(
			"Invalid value for argument 256",
			Новый Структура("Источник", "Тест")
		);
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

КонецФункции

&ОжидаемыйКодОшибки("НедопустимоеЗначениеАргумента")
&ОжидаемоеПравилоОшибки("argument.invalid_value.generic")
Функция ПолучитьОшибкуНедопустимогоДиапазонаСлучайногоЧисла() Экспорт

	Попытка
		Генератор = Новый ГенераторСлучайныхЧисел;
		Результат = Генератор.СлучайноеЧисло(10, 1);
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	ВызватьИсключение "Ожидаемая ошибка недопустимого диапазона случайного числа не возникла";

КонецФункции

&ОжидаемыйКодОшибки("НедопустимоеЗначениеАргумента")
&ОжидаемоеПравилоОшибки("ru='argument.invalid_value.named'; en='argument.invalid_value.named_en'")
Функция ПолучитьОшибкуНекорректногоСмещенияЧасовогоПояса() Экспорт

	Попытка
		Представление = ПредставлениеЧасовогоПояса("GMT+444");
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	ВызватьИсключение "Ожидаемая ошибка некорректного смещения часового пояса не возникла";

КонецФункции

&ОжидаемыйКодОшибки("НедопустимоеЗначениеАргумента")
&ОжидаемоеПравилоОшибки("argument.invalid_value.context_parameter")
Функция ПолучитьОшибкуПустогоШаблонаПоискаНачалаСтроки() Экспорт

	Попытка
		Результат = СтрНачинаетсяС("Строка", "");
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	ВызватьИсключение "Ожидаемая ошибка пустого шаблона поиска начала строки не возникла";

КонецФункции

&ОжидаемыйКодОшибки("НедопустимоеЗначениеАргумента")
&ОжидаемоеПравилоОшибки("argument.invalid_value.context_parameter")
Функция ПолучитьОшибкуПустогоШаблонаПоискаОкончанияСтроки() Экспорт

	Попытка
		Результат = СтрЗаканчиваетсяНа("Строка", "");
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	ВызватьИсключение "Ожидаемая ошибка пустого шаблона поиска окончания строки не возникла";

КонецФункции

&ОжидаемыйКодОшибки("ПустоеИмяПеременнойСреды")
&ОжидаемоеПравилоОшибки("environment.empty_variable_name")
Функция ПолучитьОшибкуПустогоИмениПеременнойСреды() Экспорт

	// Действие и Проверка
	Попытка
		УстановитьПеременнуюСреды("", "value");
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	ВызватьИсключение "Ожидаемая ошибка пустого имени переменной среды не возникла";

КонецФункции

#КонецОбласти
