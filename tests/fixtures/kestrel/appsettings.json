{
  "Kestrel": {
    "Limits": {
      "MaxRequestBodySize": 1024,
      "MaxRequestLineSize": 256,
      "MaxRequestHeadersTotalSize": 512,
      "MaxRequestHeaderCount": 8,
      "RequestHeadersTimeout": "00:00:02",
      "MinRequestBodyDataRate": {
        "BytesPerSecond": 1024,
        "GracePeriod": "00:00:02"
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "None"
    }
  }
}
