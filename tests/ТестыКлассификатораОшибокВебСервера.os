Процедура ТестДолжен_ПрочитатьКорректныеЗавершающиеЗаголовки() Экспорт

	Тело = "1;name=value" + CRLF() + "a" + CRLF() + "0" + CRLF()
		+ "X-Trailer: value" + CRLF() + CRLF();
	Статус = ВыполнитьСыройЗапрос(ЗапросСТелом("Transfer-Encoding: chunked", Тело));
	Ожидаем.Что(Статус).Равно(200);
	Ожидаем.Что(_РезультатЗапроса.Ошибка).Равно(Неопределено);
	Ожидаем.Что(_РезультатЗапроса.Прочитано).Равно(1);

