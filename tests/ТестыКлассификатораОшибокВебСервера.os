Функция ПолучитьОшибкуТелаЗапроса(Заголовки, Тело, ОжидаемыйСтатус, ОборватьТело = Ложь, Путь = "/body")

	Статус = ВыполнитьСыройЗапрос(ЗапросСТелом(Заголовки, Тело, Путь), ОборватьТело);

	Ожидаем.Что(Статус).Равно(ОжидаемыйСтатус);
	Ожидаем.Что(_РезультатЗапроса.ОбработчикВызван).ЭтоИстина();
	Ожидаем.Что(_РезультатЗапроса.Завершен).ЭтоИстина();
	Ожидаем.Что(_РезультатЗапроса.Ошибка).ИмеетТип("ИнформацияОбОшибке");

	Возврат _РезультатЗапроса.Ошибка;

КонецФункции

Функция ВыполнитьСыройЗапрос(Запрос, ОборватьТело = Ложь)

	ОстановитьВебСервер();

	_РезультатЗапроса = Новый Структура(
		"ОбработчикВызван, Завершен, Ошибка, Прочитано",
		Ложь, Ложь, Неопределено, 0
	);

	ЗапуститьВебСервер(Истина);
	ПолучитьОтветВебСервера("/ready");

	_TCPСоединение = Новый TCPСоединение("127.0.0.1", _ПортВебСервера);
	_TCPСоединение.ТаймаутОтправки = 15000;
	_TCPСоединение.ТаймаутЧтения = 15000;
	_TCPСоединение.ОтправитьСтроку(Запрос, "utf-8");

	Если ОборватьТело Тогда
		ДождатьсяСостоянияЗапроса("ОбработчикВызван");
		_TCPСоединение.Закрыть();
		_TCPСоединение = Неопределено;
		ДождатьсяСостоянияЗапроса("Завершен");
		Возврат 0;
	КонецЕсли;

	Ответ = "";
	Пока Истина Цикл
		Часть = _TCPСоединение.ПрочитатьСтроку();
		Если ПустаяСтрока(Часть) Тогда
			Прервать;
		КонецЕсли;

		Ответ = Ответ + Часть;
	КонецЦикла;

	_TCPСоединение.Закрыть();
	_TCPСоединение = Неопределено;

	Ожидаем.Что(СтрНачинаетсяС(Ответ, "HTTP/1.1 "), Ответ).ЭтоИстина();

	Возврат Число(Сред(Ответ, 10, 3));

КонецФункции

Процедура ДождатьсяСостоянияЗапроса(Состояние)

	Срок = ТекущаяУниверсальнаяДатаВМиллисекундах() + 15000;
	Пока Не _РезультатЗапроса[Состояние] Цикл
		Если ТекущаяУниверсальнаяДатаВМиллисекундах() > Срок Тогда
			ВызватьИсключение "Тестовый HTTP-запрос не достиг состояния " + Состояние;
		КонецЕсли;
		Приостановить(10);
	КонецЦикла;

КонецПроцедуры

Функция ЗапросСТелом(Заголовки, Тело = "", Путь = "/body")

	Возврат "POST " + Путь + " HTTP/1.1" + CRLF() + "Host: localhost" + CRLF()
		+ "Connection: close" + CRLF() + Заголовки + CRLF() + CRLF() + Тело;

КонецФункции

Функция МногоЗаголовков()

	Заголовки = Новый Массив;
	Для Номер = 1 По 10 Цикл
		Заголовки.Добавить("X-" + Номер + ": a");
	КонецЦикла;
	Возврат СтрСоединить(Заголовки, CRLF());

КонецФункции

Функция СтрокаЗаданнойДлины(Длина)

	Результат = "";
	Для Номер = 1 По Длина Цикл
		Результат = Результат + "a";
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция CRLF()
	Возврат Символ(13) + Символ(10);
КонецФункции

Процедура ВыполнитьВебСервер(ВебСервер) Экспорт

	ВебСервер.Запустить();

КонецПроцедуры

Процедура ОбработатьЗапрос(
	Контекст,
	СледующийОбработчик
) Экспорт

	Если _ЧитатьТелоЗапроса Тогда
		Если Контекст.Запрос.Путь = "/ready" Тогда
			Контекст.Ответ.Записать("ready");
		Иначе
			ПрочитатьТелоЗапроса(Контекст);
		КонецЕсли;
		Возврат;
	КонецЕсли;

	Попытка
		Соединение = Контекст.Соединение;
		Соединение.УдаленныйIPАдрес = "не-IP-адрес";
	Исключение
		_ОшибкаIPАдреса = ИнформацияОбОшибке();
	КонецПопытки;
	Контекст.Ответ.Записать("Проверка IP-адреса завершена");

КонецПроцедуры

Процедура ПрочитатьТелоЗапроса(Контекст)

	_РезультатЗапроса.ОбработчикВызван = Истина;
	Попытка
		ВыполнитьОперациюВебЗапроса(Контекст);
	Исключение
		_РезультатЗапроса.Ошибка = ИнформацияОбОшибке();
	КонецПопытки;
	_РезультатЗапроса.Завершен = Истина;

	Если Контекст.ЗапросПрерван Тогда
		Возврат;
	КонецЕсли;
	Если Контекст.Ответ.Начат Тогда
		Возврат;
	КонецЕсли;
	Если _РезультатЗапроса.Ошибка <> Неопределено Тогда
		Классификатор = Новый КлассификаторОшибок;
		Классификатор.ДобавитьПоставщикаПравил(Тип("ПравилаНативныхОшибок"));
		Ошибка = Классификатор.Классифицировать(_РезультатЗапроса.Ошибка);
		Контекст.Ответ.КодСостояния = 500;
		Если Ошибка <> Неопределено Тогда
			Код = Новый СнимокКадраОшибки(Ошибка).КодОшибки();
			Если Код = КодыНативныхОшибок.HTTPТелоЗапросаСлишкомБольшое() Тогда
				Контекст.Ответ.КодСостояния = 413;
			ИначеЕсли Код = КодыНативныхОшибок.HTTPТаймаутЧтенияТелаЗапроса() Тогда
				Контекст.Ответ.КодСостояния = 408;
			ИначеЕсли Код = КодыНативныхОшибок.HTTPЗаголовкиЗапросаСлишкомБольшие() Тогда
				Контекст.Ответ.КодСостояния = 431;
			ИначеЕсли Код = КодыНативныхОшибок.HTTPНекорректноеТелоЗапроса()
				Или Код = КодыНативныхОшибок.HTTPНеполноеТелоЗапроса()
				Или Код = КодыНативныхОшибок.HTTPНекорректныйЗаголовок() Тогда
				Контекст.Ответ.КодСостояния = 400;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	Контекст.Ответ.ДлинаКонтента = Неопределено;
	Контекст.Ответ.Записать("Тело запроса проверено");

КонецПроцедуры

Процедура ВыполнитьОперациюВебЗапроса(Контекст)

	Путь = Контекст.Запрос.Путь;
	Буфер = Новый БуферДвоичныхДанных(256);
	Если Путь = "/copy_request_oversize" Или Путь = "/copy_request_oversize_buffered" Тогда
		Приемник = Новый ПотокВПамяти;
		Если Путь = "/copy_request_oversize_buffered" Тогда
			Контекст.Запрос.Тело.КопироватьВ(Приемник, 256);
		Иначе
			Контекст.Запрос.Тело.КопироватьВ(Приемник);
		КонецЕсли;
	ИначеЕсли Путь = "/reader_request_oversize" Тогда
		Чтение = Новый ЧтениеДанных(Контекст.Запрос.Тело);
		Чтение.Прочитать(1);
	ИначеЕсли Путь = "/reader_buffer_request_oversize" Тогда
		Чтение = Новый ЧтениеДанных(Контекст.Запрос.Тело);
		Чтение.ПрочитатьВБуферДвоичныхДанных(Буфер, 0, 256);
	ИначеЕсли Путь = "/reader_chars_request_oversize" Тогда
		Чтение = Новый ЧтениеДанных(Контекст.Запрос.Тело);
		Чтение.ПрочитатьСимволы(1);
	ИначеЕсли Путь = "/request_length" Тогда
		Контекст.Запрос.Тело.Размер();
	ИначеЕсли Путь = "/request_position" Тогда
		Контекст.Запрос.Тело.ТекущаяПозиция();
	ИначеЕсли Путь = "/request_seek" Тогда
		Контекст.Запрос.Тело.Перейти(0);
	ИначеЕсли Путь = "/request_set_length" Тогда
		Контекст.Запрос.Тело.УстановитьРазмер(0);
	ИначеЕсли Путь = "/reader_request_all_chars" Тогда
		Чтение = Новый ЧтениеДанных(Контекст.Запрос.Тело);
		Чтение.ПрочитатьСимволы();
	ИначеЕсли Путь = "/response_write_overlength" Тогда
		Контекст.Ответ.ДлинаКонтента = 1;
		Контекст.Ответ.Тело.Записать(Буфер, 0, 2);
	ИначеЕсли Путь = "/response_write_no_body" Тогда
		Контекст.Ответ.КодСостояния = 204;
		Контекст.Ответ.Тело.Записать(Буфер, 0, 2);
	ИначеЕсли Путь = "/copy_response_overlength" Или Путь = "/copy_response_overlength_buffered" Тогда
		Контекст.Ответ.ДлинаКонтента = 1;
		Источник = Новый ПотокВПамяти;
		Источник.Записать(Буфер, 0, 2);
		Источник.Перейти(0);
		Если Путь = "/copy_response_overlength_buffered" Тогда
			Источник.КопироватьВ(Контекст.Ответ.Тело, 256);
		Иначе
			Источник.КопироватьВ(Контекст.Ответ.Тело);
		КонецЕсли;
	ИначеЕсли Путь = "/writer_response_overlength" Тогда
		Контекст.Ответ.ДлинаКонтента = 1;
		Запись = Новый ЗаписьДанных(Контекст.Ответ.Тело);
		Запись.ЗаписатьЦелое32(123);
	ИначеЕсли Путь = "/headers_invalid_value" Тогда
		Контекст.Ответ.Заголовки["X-Test"] = "a" + Символ(10) + "b";
	ИначеЕсли Путь = "/headers_after_start" Тогда
		Контекст.Ответ.Тело.СброситьБуферы();
		Контекст.Ответ.Заголовки["X-Test"] = "a";
	ИначеЕсли Путь = "/status_after_start" Тогда
		Контекст.Ответ.Тело.СброситьБуферы();
		Контекст.Ответ.КодСостояния = 400;
	Иначе
		Пока Истина Цикл
			Прочитано = Контекст.Запрос.Тело.Прочитать(Буфер, 0, 256);
			Если Прочитано = 0 Тогда
				Прервать;
			КонецЕсли;
			_РезультатЗапроса.Прочитано = _РезультатЗапроса.Прочитано + Прочитано;
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти
