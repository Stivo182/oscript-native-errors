&ПараметризованныйТест
&ИсточникЗначение("Строка", 414)
&ИсточникЗначение("РазмерЗаголовков", 431)
&ИсточникЗначение("КоличествоЗаголовков", 431)
&ИсточникЗначение("ТаймаутЗаголовков", 408)
&ИсточникЗначение("НекорректныйЗаголовок", 400)
&ИсточникЗначение("НекорректнаяСтрока", 400)
&ИсточникЗначение("Версия", 505)
Процедура ТестДолжен_ОтклонитьРаннююОшибкуДоОбработчика(Сценарий, ОжидаемыйСтатус) Экспорт

	Если Сценарий = "Строка" Тогда
		Запрос = "GET /" + СтрокаЗаданнойДлины(300) + " HTTP/1.1" + CRLF()
			+ "Host: localhost" + CRLF() + CRLF();
	ИначеЕсли Сценарий = "РазмерЗаголовков" Тогда
		Запрос = ЗапросСТелом("X-Large: " + СтрокаЗаданнойДлины(600));
	ИначеЕсли Сценарий = "КоличествоЗаголовков" Тогда
		Запрос = ЗапросСТелом(МногоЗаголовков());
	ИначеЕсли Сценарий = "ТаймаутЗаголовков" Тогда
		Запрос = "GET / HTTP/1.1" + CRLF() + "Host: localhost" + CRLF() + "X-Test: ";
	ИначеЕсли Сценарий = "НекорректныйЗаголовок" Тогда
		Запрос = ЗапросСТелом("Bad Header: value");
	ИначеЕсли Сценарий = "НекорректнаяСтрока" Тогда
		Запрос = "GET /" + CRLF() + "Host: localhost" + CRLF() + CRLF();
	Иначе
		Запрос = "GET / HTTP/1.X" + CRLF() + "Host: localhost" + CRLF() + CRLF();
	КонецЕсли;

	Ожидаем.Что(ВыполнитьСыройЗапрос(Запрос)).Равно(ОжидаемыйСтатус);
	Ожидаем.Что(_РезультатЗапроса.ОбработчикВызван).ЭтоЛожь();
	Ожидаем.Что(_РезультатЗапроса.Ошибка).Равно(Неопределено);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ЗапуститьВебСервер(ЧитатьТелоЗапроса = Ложь)

	_ЧитатьТелоЗапроса = ЧитатьТелоЗапроса;
	_ПортВебСервера = ТестовыеСетевыеФикстуры.ПолучитьСвободныйПорт();
	_ВебСервер = Новый ВебСервер(_ПортВебСервера);
	Если ЧитатьТелоЗапроса Тогда
		_ВебСервер.УстановитьКаталогСервера(ОбъединитьПути(ТекущийСценарий().Каталог, "fixtures/kestrel"));
	КонецЕсли;
	_ВебСервер.ДобавитьОбработчикЗапросов(
		ЭтотОбъект,
		"ОбработатьЗапрос"
	);

	Параметры = Новый Массив;
	Параметры.Добавить(_ВебСервер);
	_ЗаданиеВебСервера = ФоновыеЗадания.Выполнить(
		ЭтотОбъект,
		"ВыполнитьВебСервер",
		Параметры
	);

КонецПроцедуры

Процедура ОстановитьВебСервер()

	Если _TCPСоединение <> Неопределено Тогда
		_TCPСоединение.Закрыть();
		_TCPСоединение = Неопределено;
	КонецЕсли;

	Если _ВебСервер <> Неопределено Тогда
		_ВебСервер.Остановить();
		_ВебСервер = Неопределено;
	КонецЕсли;

	Если _ЗаданиеВебСервера <> Неопределено Тогда
		_ЗаданиеВебСервера.ОжидатьЗавершения(3000);
		_ЗаданиеВебСервера = Неопределено;
	КонецЕсли;

	ФоновыеЗадания.Очистить();

КонецПроцедуры

Функция ПолучитьОтветВебСервера(Путь = "/")

	Для ПопыткаНомера = 1 По 30 Цикл
		Попытка
			Соединение = Новый HTTPСоединение(
				"http://127.0.0.1:" + _ПортВебСервера
			);
			Ответ = Соединение.Получить(Новый HTTPЗапрос(Путь));
			Возврат Ответ.ПолучитьТелоКакСтроку();
		Исключение
			Приостановить(100);
		КонецПопытки;
	КонецЦикла;

	ВызватьИсключение "Тестовый веб-сервер не запустился";

КонецФункции

&ОжидаемыйКодОшибки("СетьНекорректныйIPАдрес")
&ОжидаемоеПравилоОшибки("network.invalid_ip_address")
Функция ПолучитьОшибкуНекорректногоIPАдресаСоединения() Экспорт

	_ОшибкаIPАдреса = Неопределено;
	ЗапуститьВебСервер();
	ПолучитьОтветВебСервера();
	ОстановитьВебСервер();

	Если _ОшибкаIPАдреса <> Неопределено Тогда
		Возврат _ОшибкаIPАдреса;
	КонецЕсли;

	ВызватьИсключение "Ожидаемая ошибка некорректного IP-адреса соединения не возникла";

КонецФункции

&ОжидаемыйКодОшибки("СетьАдресЗанят")
