&ПараметризованныйТест
&ИсточникЗначение("", 1023)
&ИсточникЗначение("", 1024)
&ИсточникЗначение("3F3", 1011)
&ИсточникЗначение("3F4", 1012)
Процедура ТестДолжен_ПрочитатьТелоВПределахЛимита(РазмерChunk, РазмерТела) Экспорт

	Тело = СтрокаЗаданнойДлины(РазмерТела);
	Если ПустаяСтрока(РазмерChunk) Тогда
		Заголовки = "Content-Length: " + РазмерТела;
	Иначе
		Заголовки = "Transfer-Encoding: chunked";
		Тело = РазмерChunk + CRLF() + Тело + CRLF() + "0" + CRLF() + CRLF();
	КонецЕсли;

	Статус = ВыполнитьСыройЗапрос(ЗапросСТелом(Заголовки, Тело));
	Ожидаем.Что(Статус).Равно(200);
	Ожидаем.Что(_РезультатЗапроса.Ошибка).Равно(Неопределено);
	Ожидаем.Что(_РезультатЗапроса.Прочитано).Равно(РазмерТела);

КонецПроцедуры

