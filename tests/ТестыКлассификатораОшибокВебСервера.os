Процедура ТестДолжен_КлассифицироватьОшибкуТелаВФизическойПричине(ИмяИсточника, ОжидаемыйКод) Экспорт

	Ошибка = Новый Рефлектор().ВызватьМетод(ЭтотОбъект, ИмяИсточника, Новый Массив);
	Попытка
		ВызватьИсключение Новый ИнформацияОбОшибке(
			"Чтение входящего запроса", Новый Структура("Источник", "Тест"), Ошибка);
	Исключение
		Обертка = ИнформацияОбОшибке();
	КонецПопытки;
	Классификатор = Новый КлассификаторОшибок;
	Классификатор.ДобавитьПоставщикаПравил(Тип("ПравилаНативныхОшибок"));
	Результат = Классификатор.Классифицировать(Обертка);
	Ожидаем.Что(Результат).ИмеетТип("ИнформацияОбОшибке");
	Ожидаем.Что(Новый СнимокКадраОшибки(Результат).КодОшибки()).Равно(ОжидаемыйКод);
	Ожидаем.Что(Результат.Причина).Идентично(Обертка);

КонецПроцедуры

&Тест
Процедура ТестДолжен_НеКлассифицироватьНеточныеСигнатурыПревышенияРазмера() Экспорт

	ТипИсключения = "Microsoft.AspNetCore.Server.Kestrel.Core.BadHttpRequestException";
	Описания = Новый Массив;
	Описания.Добавить("Request body too large.");
	Описания.Добавить("External exception (System.InvalidOperationException): Request body too large.");
	Описания.Добавить("External exception (Microsoft.AspNetCore.Http.BadHttpRequestException): Request body too large.");
	Описания.Добавить("External exception (" + ТипИсключения + "): Prefix Request body too large.");
	Описания.Добавить("External exception (" + ТипИсключения + "): Request body too large!");
	Описания.Добавить("External exception (" + ТипИсключения + "): Other request error.");
	Для Каждого Описание Из Описания Цикл
		Ошибка = Новый ИнформацияОбОшибке(Описание, Новый Структура("Источник", "Тест"));
		ТестовыйПробросПодробногоПредставления.ПроверитьНеклассифицированностьВариантами(Ошибка);
	КонецЦикла;

	Причина = Новый ИнформацияОбОшибке("Request body too large.", Новый Структура("Источник", "Тест"));
	Ошибка = Новый ИнформацияОбОшибке(
		"External exception (" + ТипИсключения + "): Other request error.",
		Новый Структура("Источник", "Тест"), Причина);
	ТестовыйПробросПодробногоПредставления.ПроверитьНеклассифицированностьВариантами(Ошибка);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("Response Content-Length mismatch: too many bytes written (2 of 1).")
&ИсточникЗначение("Writing to the response body is invalid for responses with status code 204.")
&ИсточникЗначение("Invalid non-ASCII or control character in header: 0x000A")
&ИсточникЗначение("Headers are read-only, response has already started.")
&ИсточникЗначение("StatusCode cannot be set because the response has already started.")
Процедура ТестДолжен_НеКлассифицироватьНеточныеСигнатурыОтвета(Сообщение) Экспорт

	Описание = "External exception (System.ArgumentException): " + Сообщение;
	Ошибка = Новый ИнформацияОбОшибке(Описание, Новый Структура("Источник", "Тест"));
	ТестовыйПробросПодробногоПредставления.ПроверитьНеклассифицированностьВариантами(Ошибка);

	Описание = "External exception (System.InvalidOperationException): Prefix " + Сообщение;
	Ошибка = Новый ИнформацияОбОшибке(Описание, Новый Структура("Источник", "Тест"));
	ТестовыйПробросПодробногоПредставления.ПроверитьНеклассифицированностьВариантами(Ошибка);

КонецПроцедуры

