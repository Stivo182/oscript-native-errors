Функция ПолучитьОшибкуОтсутствующегоКаталогаВебСервера() Экспорт

	// Подготовка
	Каталог = ОбъединитьПути(
		ТекущийСценарий().Каталог,
		"fixtures/гарантированно-отсутствующий-каталог-веб-сервера"
	);
	Ожидаем.Что(Новый Файл(Каталог).Существует()).ЭтоЛожь();

	// Действие и Проверка
	Попытка
		ВебСервер = Новый ВебСервер;
		ВебСервер.УстановитьКаталогСервера(Каталог);
		ВебСервер.Запустить();
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	ВызватьИсключение "Ожидаемая ошибка отсутствующего каталога веб-сервера не возникла";

