#Использовать errors
#Использовать "../src"
#Использовать "./internal"

#Область ОбработчикиСобытий

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

#КонецОбласти

#Область Тесты

&ПараметризованныйТест
&ИсточникВыражение("() -> ПараметрыИсточниковОшибок()")
Процедура ТестДолжен_КлассифицироватьИсточникОшибки(ИдентификаторПравила, ИмяИсточника) Экспорт

	МатрицаИсточниковОшибок.ПроверитьИсточник(ЭтотОбъект, ИмяИсточника);

КонецПроцедуры

Функция ПараметрыИсточниковОшибок() Экспорт

	Возврат МатрицаИсточниковОшибок.ПараметрыИсточников(ЭтотОбъект, 16);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&ОжидаемыйКодОшибки("НедопустимоеЗначениеАргумента")
&ОжидаемоеПравилоОшибки("ru='argument.invalid_value.named'; en='argument.invalid_value.named_en'")
Функция ПолучитьОшибкуНедопустимогоЗначенияБайтаБуфера() Экспорт

	Попытка
		Буфер = Новый БуферДвоичныхДанных(1);
		Буфер.Установить(0, 256);
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	ВызватьИсключение "Ожидаемая ошибка недопустимого значения байта не возникла";

КонецФункции

&ОжидаемыйКодОшибки("ОперацияНеРеализована")
