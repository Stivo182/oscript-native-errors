	КонецПопытки;

	ВызватьИсключение "Ожидаемая ошибка создания временного файлового потока не возникла";

КонецФункции

&ОжидаемыйКодОшибки("ПотокЗакрыт")
&ОжидаемоеПравилоОшибки("stream.closed.dotnet_stream")
Функция ПолучитьОшибкуЗаписиДвоичныхДанныхВЗакрытыйПотокВПамяти() Экспорт

	// Подготовка
	Данные = ПолучитьДвоичныеДанныеИзСтроки("Текст");
	Поток = Новый ПотокВПамяти;
	Поток.Закрыть();

	// Действие и Проверка
	Попытка
		Данные.Записать(Поток);
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	ВызватьИсключение "Ожидаемая ошибка записи двоичных данных в закрытый поток не возникла";

КонецФункции

&ОжидаемыйКодОшибки("ПотокНеПоддерживаетЗапись")
&ОжидаемоеПравилоОшибки("stream.not_writable.dotnet_not_supported")
Функция ПолучитьОшибкуЗаписиФайловыхДвоичныхДанныхВПотокДляЧтения() Экспорт

	// Подготовка
	Путь = ПолучитьИмяВременногоФайла();
	ПотокФайла = ФайловыеПотоки.Создать(Путь);
	ПотокФайла.УстановитьРазмер(50 * 1024 * 1024);
	ПотокФайла.Закрыть();
	Данные = Новый ДвоичныеДанные(Путь);
	УдалитьФайлы(Путь);
	ПотокДляЧтения = Данные.ОткрытьПотокДляЧтения();

	// Действие
	Попытка
		Данные.Записать(ПотокДляЧтения);
	Исключение
		Ошибка = ИнформацияОбОшибке();
	КонецПопытки;
	ПотокДляЧтения.Закрыть();

	// Проверка
	Если Ошибка <> Неопределено Тогда
		Возврат Ошибка;
	КонецЕсли;

	ВызватьИсключение "Ожидаемая ошибка записи файловых двоичных данных в поток для чтения не возникла";

КонецФункции

