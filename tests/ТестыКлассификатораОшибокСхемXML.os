#Использовать errors
#Использовать "../src"
#Использовать "./internal"

#Область ОбработчикиСобытий

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

#КонецОбласти

#Область Тесты

&ПараметризованныйТест
&ИсточникВыражение("() -> ПараметрыИсточниковОшибок()")
Процедура ТестДолжен_КлассифицироватьИсточникОшибки(ИдентификаторПравила, ИмяИсточника) Экспорт

	МатрицаИсточниковОшибок.ПроверитьИсточник(ЭтотОбъект, ИмяИсточника);

КонецПроцедуры

Функция ПараметрыИсточниковОшибок() Экспорт

	Возврат МатрицаИсточниковОшибок.ПараметрыИсточников(ЭтотОбъект, 6);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&ОжидаемыйКодОшибки("НедопустимоеЗначениеАргумента")
&ОжидаемоеПравилоОшибки("argument.invalid_value.xml_schema_writer")
Функция ПолучитьОшибкуЗаписиСхемыXMLДоОткрытия() Экспорт

	Попытка
		Сериализатор = Новый СериализаторXDTO;
		Запись = Новый ЗаписьXML;
		Сериализатор.ЗаписатьXML(Запись, Новый СхемаXML);
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	ВызватьИсключение "Ожидаемая ошибка записи XML-схемы до открытия не возникла";

КонецФункции

&ОжидаемыйКодОшибки("ОперацияНеРеализована")
&ОжидаемоеПравилоОшибки("operation.not_implemented")
Функция ПолучитьОшибкуКлонированияСхемыXML() Экспорт

	Попытка
		Схема = Новый СхемаXML;
		Схема.КлонироватьКомпоненту();
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	ВызватьИсключение "Ожидаемая ошибка нереализованного клонирования XML-схемы не возникла";

КонецФункции

&ОжидаемыйКодОшибки("ОперацияНеРеализована")
&ОжидаемоеПравилоОшибки("operation.not_implemented")
Функция ПолучитьОшибкуОбновленияЭлементаDOMСхемыXML() Экспорт

	Попытка
		Схема = Новый СхемаXML;
		Схема.ОбновитьЭлементDOM();
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	ВызватьИсключение "Ожидаемая ошибка нереализованного обновления XML-схемы не возникла";

КонецФункции

&ОжидаемыйКодОшибки("ПереполнениеЧисловогоЗначения")
&ОжидаемоеПравилоОшибки("number.overflow")
Функция ПолучитьОшибкуПереполненияИндексаИменованнойКоллекцииXS() Экспорт

	Попытка
		Схема = Новый СхемаXML;
		Схема.ОбъявленияЭлементов.Получить(999999999999);
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	ВызватьИсключение "Ожидаемая ошибка переполнения индекса именованной коллекции XS не возникла";

КонецФункции

&ОжидаемыйКодОшибки("НедопустимоеЗначениеАргумента")
&ОжидаемоеПравилоОшибки("argument.invalid_value.format")
Функция ПолучитьОшибкуНекорректногоЗначенияФасетаКоличестваРазрядов() Экспорт

	Попытка
		Фасет = Новый ФасетКоличестваРазрядовДробнойЧастиXS;
		Фасет.ЛексическоеЗначение = "другое";
		Результат = Фасет.Значение;
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	ВызватьИсключение "Ожидаемая ошибка некорректного значения фасета XML-схемы не возникла";

КонецФункции

&ОжидаемыйКодОшибки("ИндексКоллекцииВнеДиапазона")
&ОжидаемоеПравилоОшибки("argument.invalid_value.collection_index_bounds")
Функция ПолучитьОшибкуИндексаНабораСхемXML() Экспорт

	Попытка
		НаборСхем = Новый НаборСхемXML;
		НаборСхем.Получить(0);
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	ВызватьИсключение "Ожидаемая ошибка индекса набора XML-схем не возникла";

КонецФункции

#КонецОбласти
