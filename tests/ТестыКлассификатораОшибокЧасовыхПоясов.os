#Использовать errors
#Использовать "../src"
#Использовать "./internal"

#Область ОбработчикиСобытий

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

#КонецОбласти

#Область Тесты

&ПараметризованныйТест
&ИсточникВыражение("() -> ПараметрыИсточниковОшибок()")
Процедура ТестДолжен_КлассифицироватьИсточникОшибки(ИдентификаторПравила, ИмяИсточника) Экспорт

	МатрицаИсточниковОшибок.ПроверитьИсточник(ЭтотОбъект, ИмяИсточника);

КонецПроцедуры

Функция ПараметрыИсточниковОшибок() Экспорт

	Возврат МатрицаИсточниковОшибок.ПараметрыИсточников(ЭтотОбъект, 1);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&ОжидаемыйКодОшибки("НедопустимоеЗначениеАргумента")
&ОжидаемоеПравилоОшибки("argument.invalid_value.format")
Функция ПолучитьОшибкуНекорректногоЧисловогоСмещенияGMT() Экспорт

	Попытка
		ПредставлениеЧасовогоПояса("GMT+abc");
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	ВызватьИсключение "Ожидаемая ошибка некорректного числового смещения GMT не возникла";

КонецФункции

#КонецОбласти
